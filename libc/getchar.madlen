 GETCHAR:,NAME,
C===========================================================
C getchar() - read one character from STDIN, with C stream semantics
C (PASEOLSY for end-of-line, 0 at EOF).  Equivalent to fgetc(stdin).
C
C   int getchar() assembler;
C
C No argument of its own: FGETC (libc/fgetc.madlen) wants the FCB
C address in ACC, so this loads &STDIN there and tails into it --
C M13 rides through unchanged, since FGETC returns through the same
C link that reached here.
C===========================================================
 FGETC:,SUBP,                 . fgetc(fcb), this project's libc/fgetc.madlen
 STDIN:,LC,30                 . 30-word FILE record of INPUT
 14,VTM,STDIN                 . M14 := &STDIN
 ,ITA,14                      . ACC := M14
 ,UJ,FGETC
 ,END,
