 C/7A:,NAME,
C===========================================================
C C/7A - write exactly M10 packed characters starting at M11
C to the file at M12.  This is the annotated Madlen port of
C P/7A; embedded NULs are data and do not terminate the output.
C
C   M10 = character count
C   M11 = word address of the packed characters
C   M12 = the FILE record
C   M13 = return link
C
C Six eight-bit characters occupy each word, most significant
C first.  The word being shifted lives in runtime scratch M1+5
C because YTA replaces ACC with each extracted character.
C
C P/HIDE saves M6..M8 and M13.  C/7AD is the shared entry used
C after a caller has already saved them and copied the address
C and count to M8 and M7 respectively.
C===========================================================
 P/PF:          ,SUBP,        . Put f^ and advance the file
 P/HIDE:        ,SUBP,        . Save M6, M7, M8 and M13
 P/EDIH:        ,SUBP,        . Restore them
              14,VJM,P/HIDE
              11,MTJ,8        . M8 := packed-character word address
              10,MTJ,7        . M7 := remaining character count
C===========================================================
 C/7AD:         ,ENTRY,
C===========================================================
 NEXTWRD:      6,VTM,-5       . Six characters in this word
               8,XTA,         . ACC := next packed word
               1,ATX,5        . Save the shifting copy
 NEXTCH:       1,XTA,5
                ,ASN,64-8     . Shift the high character into Y
               1,ATX,5        . Save the remaining packed characters
                ,YTA,         . ACC := extracted character
              12,WTC,         . Address f^ through FILE[0]
                ,ATX,         . f^ := character
              13,VJM,P/PF     . Put it
               7,UTM,-1       . One fewer character remains
               7,VZM,DONE
               6,VLM,NEXTCH   . Continue within this word
               8,UTM,1        . Advance to the next packed word
                ,UJ,NEXTWRD
 DONE:        14,VJM,P/EDIH
              13,UJ,
                ,END,
