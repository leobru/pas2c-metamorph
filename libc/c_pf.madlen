 C/PF:,NAME,DTRAN  /01.06.84/    . Put one element to a file
C===========================================================
C C/PF - put one element from f^ to FILE @ M12.
C  Mirror of C/GF: bumps FILE[9] (counter), updates the bit
C  cursor at FILE[0], optionally packs via C/PK and trips
C  the disk-write helpers when the window fills up.
C  Errors "PUT(F) NOT AT EOF" if FILE[2] is clear: a put is
C  legal only at the end of the file.  C/TF sets FILE[2] when
C  a file is opened for output and C/GF sets it on reading the
C  last element, C/RE2 clears it for an input file - so an
C  input file read to EOF stands open for appending.
C
C C/OB - thin shim that saves M13 and drops into C/PF's
C  disk-write path; C/CO and C/OR use it to flush a buffer.
C
C C/RS - the runtime's short return tail; see its entry below.
C
C  Labelled in p_sys.asm: C/OB = *0642B, C/RS = *0632B.
C===========================================================
C Register convention (see FILE.md):
C   M12 = base of the FILE record being acted on
C   M1  = runtime constant table ([M1+8] = 1U, [M1+9] = integer-tag
C         mask, [M1+12] = positive-mantissa mask, [M1+25B] = MSB;
C         [M1+3..5] and [M1+35B..37B] are runtime scratch)
C   M13 = link register set by the calling VJM
C   M14 = secondary link (used inside packed-mode helpers)
 C*IOBIT:,LC,1              . FILE[23] stdin/stdout tag bit
 C/AH:,SUBP,                 . fatal-error abort handler
 C/PK:,SUBP,                 . pack ACC into the buffer slot
 C/GIVEP:,SUBP,             . flush a partial packed-output word
 C/CTRP:,SUBP,              . pre-allocate disk tracks
 C/ZI:,SUBP,                 . read/write a disk zone via *70
 C/CT:,SUBP,                 . validate the track table
 C/CB:,SUBP,                 . close the current buffer window
 C/FL:,SUBP,                 . flush a record to the line printer
 ,NTR,3
 12,XTA,2                    . ACC := FILE[2]
 ,UZA,ERRPUT                 . clear -> not at EOF
 12,XTA,11B
 1,ARX,10B                   . FILE[9] += 1U
 12,ATX,11B
 12,XTA,
 12,ARX,21B                  . FILE[0] += FILE[17]
 12,ATX,
 12,AEX,1                    . compare with FILE[1]
 13,U1A,                     . not wrapped -> return
 12,XTA,22B                  . ACC := FILE[18] (elem width)
 ,UZA,TXTPUT                 . text mode -> TXTPUT
 14,VJM,C/PK                 . packed: pack into buffer
 12,XTA,23B
 12,A+X,21B                  . FILE[19] += FILE[17]
 12,ATX,23B
 12,AEX,15B                  . compare with FILE[13]
 13,U1A,
 TXTPUT:12,XTA,27B           . ACC := FILE[23]
 ,UTC,C*IOBIT
 ,AAX,
 ,U1A,C/FL                   . stdin/out -> the printer path
 ,ITA,13
 WRITEBUF:12,XTS,6           . push link, ACC := FILE[6]
 ,ATI,10
 ,XTA,
 12,ATX,16B                  . FILE[14] := 0
 12,XTA,22B                  . ACC := FILE[18]
 ,U1A,HAVETRKS
 12,XTA,
 12,ATX,23B                  . FILE[19] := FILE[0]
 HAVETRKS:12,XTA,7
 ,U1A,SETUPWR
 13,VJM,C/GIVEP             . flush partial via C/GIVEP
 13,VJM,C/CTRP              . request more tracks (C/CTRP)
 SETUPWR:12,WTC,7
 ,XTA,1
 ,ATI,9
 9,UTM,1777B                 . M9 += 01777
 12,XTA,23B
 ,ATI,13
 12,XTA,13B
 ,ATI,14
 WRLOOP:10,VLM,WRWORD        . VLM disk-write loop
 ,UJ,WRTAIL                  . join end-of-write tail
C---------------------------------------------------------------
 WRWORD:13,UTC,-1            . disk-write inner VLM body
 14,XTA,
 9,UTC,
 10,ATX,
 14,VLM,WRLOOP
 ,ITA,10
 12,ATX,6                    . FILE[6] := M10
 14,VJM,C/CB                 . trailing close-buffer helper
C===========================================
 C/RS:,ENTRY,
C===========================================
C C/RS - return through the address sitting at the stack top,
C  without dropping anything.  The disk-write loop above falls
C  straight in after its close-buffer call; C/CO, C/GF, C/GL and
C  C/RF reach it by name.
 15,WTC,                     . WT := mem[SP+0] (saved link)
 ,UJ,                        . indirect jump to it
C ---- WRTAIL: tail of WRLOOP disk-write loop ----
 WRTAIL:,ITA,14
 ,ITS,13
 ,ITS,12                     . save M12/M13/M14 on stack
 15,ATX,
 13,VJM,C/ZI                 . request more output tracks
 13,VJM,C/CT                 . and validate the track-table
 15,XTA,                     . restore stack frame
 ,STI,12
 ,STI,13
 ,ATI,14
 10,VTM,76001B               . VLM seed (one zone = 1024 words)
 ,UJ,WRWORD                  . resume disk-write loop
C---------------------------------------------------------------
C C/OB: save the link, then join the disk-write path above.
 C/OB:,ENTRY,
 ,ITA,13
 ,UJ,WRITEBUF
C---------------------------------------------------------------
 ERRPUT:10,VTM,MSGPUTF.=6H PUT(F
 ,UJ,C/AH
 MSGPUTF:,ISO,18H PUT(F) NOT AT EOF
 ,END,
