 FGETC:,NAME,
C===========================================================
C fgetc(fcb) - read one character with C stream semantics.
C
C Calling convention (single argument, in ACC):
C   ACC = pointer to the 30-word FILE control block
C   M13 = return link
C
C Result:
C   ACC = current character, with PASEOLSY returned for EOL;
C         zero at EOF.
C
C P/GF owns ordinary cursor movement and buffer/refill state.  It
C does nothing once FILE[2] is set, so FILE[2] is tested here to
C produce the zero word C wants as its EOF sentinel.  A
C synthetic stdin line boundary is recorded in FILE[24] with a
C space in f^.  At that boundary, compare MONCARD* with PASEOFCD
C before READ*; a match marks EOF and preserves the monitor card.
C Return LF for the synthetic boundary.  Save the result and the
C caller's M13 while P/GF advances to the next element.
C===========================================================
 P/GF:          ,SUBP,
 PASEOLSY:      ,LC  ,1
 PASEOFCD:      ,LC  ,1
 MONCARD*:      ,LC  ,1
                ,ATI ,12     . M12 := fcb
            12  ,XTA ,2      . FILE[2] != 0 means EOF
             1  ,AEX ,8
            13  ,UZA ,       . C EOF sentinel is a zero word
            12  ,XTA ,30B    . FILE[24]: synthetic stdin EOL
                ,UZA ,CHAR
                ,UTC ,MONCARD*
                ,XTA ,       . inspect the next monitor card ahead of READ*
                ,UTC ,PASEOFCD
                ,AEX ,
                ,U1A ,EOL
             1  ,XTA ,8      . preserve the sentinel card and mark EOF
            12  ,ATX ,2
                ,UTC ,PASEOLSY
                ,XTA ,
            13  ,UJ  ,
 EOL:           ,UTC ,PASEOLSY
                ,XTA ,       . C newline byte (ASCII LF)
                ,UJ  ,SAVE
 CHAR:      12  ,WTC ,       . WT := FILE[0] (current cursor)
                ,XTA ,       . ACC := current f^ character
 SAVE:          ,ITS ,13     . push result; ACC := caller's M13
            15  ,ATX ,       . push caller's M13
            13  ,VJM ,P/GF   . advance/refill using Pascal runtime
            15  ,XTA ,       . pop caller's M13
                ,STI ,13     . pop saved character result
            13  ,UJ  ,       . return it
                ,END ,
