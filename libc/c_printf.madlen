 C/PRINTF:,NAME,
C===========================================================
C C/PRINTF - formatted output for the P2C PRINTF standProc.
C
C The compiler does not inspect the format.  It pushes the format pointer
C and every actual, all as one-word C-like values, then leaves in M10 the
C negative total word count (format included).  Thus SP+M10 is the format
C slot and the following words are the actuals in source order.
C
C Dubna uppercases the format; only uppercase conversion letters are checked.
C A decimal width is accepted for all conversions; .precision is used by F/E
C and otherwise ignored.  Unknown percent sequences are copied literally and
C consume no actual.
C===========================================================
 C/WI:          ,SUBP,
 P/WO:          ,SUBP,
 P/WR:          ,SUBP,
 P/WC:          ,SUBP,
 P/CW:          ,SUBP,
 P/A6:          ,SUBP,
 P/6A:          ,SUBP,
 P/WOLN:        ,SUBP,
 P/SP:          ,SUBP,
 PUTS:          ,SUBP,
 STRLEN:        ,SUBP,
 PASTPR:        ,SUBP,
 P/HIDE:        ,SUBP,
 P/EDIH:        ,SUBP,
 P/08:          ,SUBP,
 P/LDAR:        ,SUBP,
 *OUTPUT*:      ,LC,30
C P/HIDE saves M13 and the three scratch registers M6..M8.  M6 then bases the
C constants and static scratch storage below; only P/HIDE's four words use SP.
                 ,NTR,3
               14,VJM,P/HIDE
                6,BASE,NEWLINE
               15,MTJ,8
                8,UTM,-4
                8,MTJ,7
               10,J+M,7
                 ,ITA,7
                 ,ATX,ARGBASE
                 ,ITA,8
                 ,ATX,ENTRYSP
                7,XTA,
                 ,ATX,FMTPTR
                7,UTM,1
                 ,ITA,7
                 ,ATX,ARGPTR
 LOOP:         13,VJM,NEXTCH
                 ,UZA,DONE
               14,UTM,-45B
               14,VZM,PCT
               13,VJM,OUTCH
                 ,UJ,LOOP
C Begin one conversion.  Save the address after '%' for literal recovery and
C collect an optional decimal width and precision without consuming an arg.
 PCT:            ,XTA,FMTPTR
                 ,ATX,PCTPTR
                 ,XTA,
                 ,ATX,WIDTH
                 ,ATX,PREC
                 ,ATX,HASWIDTH
                 ,ATX,HASPREC
 DIGCHK:       13,VJM,NEXTCH
                 ,A-X,ASCII0
                 ,U1A,NODIG
                 ,X-A,NINE
                 ,U1A,NODIG
                 ,X-A,NINE
                 ,ATX,VALUE
                 ,XTA,HASPREC
                 ,U1A,PRECDIG
                1,XTA,8
                 ,ATX,HASWIDTH
                 ,XTA,WIDTH
                 ,A*X,E48TEN
                 ,YTA,64
                 ,ARX,VALUE
                 ,ATX,WIDTH
                 ,UJ,DIGCHK
 PRECDIG:        ,XTA,PREC
                 ,A*X,E48TEN
                 ,YTA,64
                 ,ARX,VALUE
                 ,ATX,PREC
                 ,UJ,DIGCHK
 NODIG:        14,UTM,-56B
               14,V1M,NONPER
                1,XTA,8
                 ,ATX,HASPREC
                 ,UJ,DIGCHK
C Conversion dispatch; Dubna has already uppercased the format letters.
 NONPER:       14,UTM,56B
 DISPATCH:     14,VZM,UNKNOWN
               14,UTM,-45B
               14,VZM,FMPCT
               14,UTM,45B-101B
               14,VZM,FMA
               14,UTM,101B-103B
               14,VZM,FMC
               14,UTM,103B-104B
               14,VZM,FMD
               14,UTM,104B-105B
               14,VZM,FMREAL
               14,UTM,105B-106B
               14,VZM,FMREAL
               14,UTM,106B-117B
               14,VZM,FMO
               14,UTM,117B-123B
               14,VZM,FMS
               14,UTM,123B-124B
               14,VZM,FMT
                 ,UJ,UNKNOWN
 FMPCT:         ,XTA,PERCENT
               13,VJM,OUTCH
                 ,UJ,LOOP
 FMD:          13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,U1A,DWIDTH
                 ,XTA,W10
                 ,ATX,WIDTH
 DWIDTH:         ,XTA,WIDTH
                1,AOX,9
                 ,XTS,
                 ,XTA,VALUE
               12,VTM,*OUTPUT*
               13,VJM,C/WI
                 ,UJ,LOOP
 FMO:          13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,U1A,OWIDTH
                 ,XTA,W17
                 ,ATX,WIDTH
 OWIDTH:         ,XTA,WIDTH
                1,AOX,9
                 ,XTS,
                 ,XTA,VALUE
               12,VTM,*OUTPUT*
               13,VJM,P/WO
                 ,UJ,LOOP
 FMC:          13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,UZA,CNOWID
                 ,XTA,WIDTH
                1,AOX,9
                 ,XTS,
                 ,XTA,VALUE
               12,VTM,*OUTPUT*
               13,VJM,P/WC
                 ,UJ,LOOP
 CNOWID:         ,XTA,VALUE
               12,VTM,*OUTPUT*
               13,VJM,P/CW
                 ,UJ,LOOP
 FMA:          13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,UZA,ANOWID
                 ,XTA,WIDTH
                1,AOX,9
                 ,XTS,
                 ,XTA,VALUE
               10,VTM,6
               12,VTM,*OUTPUT*
               13,VJM,P/A6
                 ,UJ,LOOP
 ANOWID:         ,XTA,VALUE
               10,VTM,6
               12,VTM,*OUTPUT*
               13,VJM,P/6A
                 ,UJ,LOOP
 FMREAL:       13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,U1A,RWIDTH
                 ,XTA,W14
                 ,ATX,WIDTH
 RWIDTH:         ,XTA,HASPREC
                 ,U1A,RPREC
                 ,XTA,W4
                 ,ATX,PREC
 RPREC:          ,XTA,WIDTH
                1,AOX,9
                 ,XTS,
                 ,XTA,PREC
                1,AOX,9
                 ,XTS,
                 ,XTA,VALUE
               12,VTM,*OUTPUT*
               13,VJM,P/WR
                 ,UJ,LOOP
C PUTS already understands arbitrary byte alignment, NUL and LF.  An
C explicit width is left padding only; precision is deliberately ignored.
 FMS:          13,VJM,GETARG
                 ,XTA,HASWIDTH
                 ,UZA,SOUT
                 ,XTA,WIDTH
                1,AOX,9
                 ,ATX,PREC
                 ,XTA,VALUE
               13,VJM,STRLEN
                1,AEX,9
                 ,A-X,PREC
               12,VTM,*OUTPUT*
                 ,CALL,P/SP
 SOUT:           ,XTA,VALUE
               13,VJM,PUTS
                 ,UJ,LOOP
 FMT:          13,VJM,GETARG
                 ,XTA,VALUE
               13,VJM,PASTPR
                 ,UJ,LOOP
C Print the '%' of an unknown sequence, then let the main loop resume at the
C character immediately following it.  No actual argument is consumed.
 UNKNOWN:        ,XTA,PERCENT
               13,VJM,OUTCH
                 ,XTA,PCTPTR
                 ,ATX,FMTPTR
                 ,UJ,LOOP
C Return the next actual.  The entry-SP word is the exclusive end; a missing
C actual terminates formatting without looking beyond the compiler's frame.
 GETARG:         ,XTA,ARGPTR
                 ,AEX,ENTRYSP
                 ,UZA,DONE
                 ,XTA,ARGPTR
                1,ARX,8
                 ,ATX,ARGPTR
                 ,WTC,ARGPTR
                 ,XTA,-1
                 ,ATX,VALUE
               13,UJ,
C Load through the runtime's packed-char descriptor, then advance the format
C byte pointer by one.
 NEXTCH:         ,ITA,13
                 ,XTS,FMTPTR
                 ,XTS,FMTPTR
                1,ARX,8
                 ,STX,FMTPTR
               14,VTM,
               11,VTM,P/08
               13,VJM,P/LDAR
                 ,ATI,14
               15,WTC,
                 ,UJ,
C One literal format byte.  LF terminates OUTPUT exactly as PUTS does.
 OUTCH:        15,ATX,1
                 ,ITA,13
               15,XTS,
                 ,AEX,NEWLINE
                 ,UZA,OUTNL
                 ,AEX,NEWLINE
               12,VTM,*OUTPUT*
               13,VJM,P/CW
                 ,UJ,OUTRET
 OUTNL:        13,VJM,P/WOLN
 OUTRET:       15,WTC,
                 ,UJ,
C Let P/EDIH restore M6..M8 and M13, then discard the caller's contiguous
C argument sequence by assigning its base to SP.
 DONE:           ,XTA,ARGBASE
                 ,ATI,10
                 ,XTA,ENTRYSP
                 ,ATI,8
                8,MTJ,15
               15,UTM,4
               14,VTM,RET
                 ,UJ,P/EDIH
 RET:          10,MTJ,15
               13,UJ,
 NEWLINE:        ,LOG,0000 0000 0000 0012
 PERCENT:        ,LOG,0000 0000 0000 0045
 NINE:           ,LOG,11
 ASCII0:         ,LOG,60
 E48TEN:         ,LOG,4000000000000012
 W4:             ,INT,4
 W10:            ,INT,10
 W14:            ,INT,14
 W17:            ,INT,17
 ARGBASE:        ,BSS,1
 ENTRYSP:        ,BSS,1
 FMTPTR:         ,BSS,1
 ARGPTR:         ,BSS,1
 PCTPTR:         ,BSS,1
 WIDTH:          ,BSS,1
 PREC:           ,BSS,1
 HASWIDTH:       ,BSS,1
 HASPREC:        ,BSS,1
 VALUE:          ,BSS,1
                 ,END,
