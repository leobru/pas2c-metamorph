 C/PRINTF:,NAME,
C===========================================================
C C/PRINTF - formatted output for the P2C PRINTF standProc.
C
C The compiler does not inspect the format.  It pushes the format pointer
C and every actual, all as one-word C-like values, then leaves in M10 the
C negative total word count (format included).  Thus SP+M10 is the format
C slot and the following words are the actuals in source order.
C
C The destination is the FILE record addressed by M12, which the caller wires
C up exactly as it does for write - PRINTF takes the same optional leading file
C argument.  Every routine reached from here leaves M12 alone, so it is set
C once, by the caller, and never reloaded.
C
C Dubna uppercases the format; only uppercase conversion letters are checked.
C A decimal width is accepted for all conversions; .precision is used by F/E
C and otherwise ignored.  A leading zero in the width is the fill flag, which
C only %O reads.  L and H are length modifiers: every actual is one word, so
C they are accepted and ignored, and a format written for a host C compiler
C reads the same here.  Unknown percent sequences are copied literally and
C consume no actual.
C===========================================================
 C/WI:          ,SUBP,
 C/WO:          ,SUBP,
 C/WR:          ,SUBP,
 C/WC:          ,SUBP,
 P/CW:          ,SUBP,
 C/A6:          ,SUBP,
 C/6A:          ,SUBP,
 C/WXD:         ,SUBP,
 P/WL:          ,SUBP,
 C/SP:          ,SUBP,
 C/PUTS:        ,SUBP,
 STRLEN:        ,SUBP,
 P/HIDE:        ,SUBP,
 P/EDIH:        ,SUBP,
 P/08:          ,SUBP,
 P/LDAR:        ,SUBP,
C P/HIDE saves M13 and the three scratch registers M6..M8.  M6 then bases the
C constants and static scratch storage below; only P/HIDE's four words use SP.
                 ,NTR,3
               14,VJM,P/HIDE
                6,BASE,NEWLINE
               15,MTJ,8
                8,UTM,-4
                8,MTJ,7
               10,J+M,7
                 ,ITA,7
                 ,ATX,ARGBASE
                 ,ITA,8
                 ,ATX,ENTRYSP
                7,XTA,
                 ,ATX,FMTPTR
                7,UTM,1
 LOOP:         13,VJM,NEXTCH
                 ,UZA,DONE
               14,UTM,-45B
               14,VZM,PCT
               13,VJM,OUTCH
                 ,UJ,LOOP
C Begin one conversion.  Save the address after '%' for literal recovery and
C collect an optional decimal width and precision without consuming an arg.
 PCT:            ,XTA,FMTPTR
                 ,ATX,PCTPTR
                 ,XTA,
                 ,ATX,WIDTH
                 ,ATX,PREC
                 ,ATX,HASPREC
                 ,ATX,ZEROFIL
                8,VTM,WIDTH              . Parsed digits initially target width
 DIGCHK:       13,VJM,NEXTCH
C Try a conversion before treating the same character as format syntax.
C The UTM chain leaves ACC untouched, so its failure restores M14 from ACC.
 DISPATCH:     14,VZM,UNKNOWN
               14,UTM,-45B
               14,VZM,FMPCT
               14,UTM,45B-101B
               14,VZM,FMA
               14,UTM,101B-103B
               14,VZM,FMC
               14,UTM,103B-104B
               14,VZM,FMD
               14,UTM,104B-105B
               14,VZM,FMREAL
               14,UTM,105B-106B
               14,VZM,FMREAL
               14,UTM,106B-117B
               14,VZM,FMO
               14,UTM,117B-123B
               14,VZM,FMS
               14,UTM,123B-124B
               14,VZM,FMT
               14,UTM,124B-114B
               14,VZM,DIGCHK            . 'L': a length modifier, ignored
               14,UTM,114B-110B
               14,VZM,DIGCHK            . 'H': likewise
                 ,ATI,14
 CHECKDIG:     14,UTM,-52B              . '*' takes the next argument
               14,VZM,STARARG
               14,UTM,52B
                 ,A-X,ASCII0
                 ,U1A,NODIG
                 ,X-A,NINE
                 ,U1A,NODIG
                 ,X-A,NINE
                 ,ATX,DIGIT
C The zero that opens a width is the fill flag rather than a digit: the three
C are all non-negative, so one OR says the digit is zero, no width digit has
C arrived and no '.' has either.  Anywhere else a zero is a digit like any
C other, and the OR is the accumulator the digit path reloads anyway.
                 ,AOX,WIDTH
                 ,AOX,HASPREC
                 ,UZA,ZFLAG
                8,XTA,
                 ,A*X,E48TEN
                 ,YTA,64
                 ,ARX,DIGIT
                8,ATX,
                 ,UJ,DIGCHK
 ZFLAG:         1,XTA,8                  . [M1+8] is the runtime's 1U
                 ,ATX,ZEROFIL
                 ,UJ,DIGCHK
 NODIG:        14,UTM,-56B
               14,V1M,UNKNOWN
                1,XTA,8
                 ,ATX,HASPREC
                8,VTM,PREC               . Digits after '.' target precision
                 ,UJ,DIGCHK
 STARARG:      13,VJM,GETARG
                8,ATX,                   . Save argument to current M8 target
                 ,UJ,DIGCHK
 FMPCT:         ,XTA,PERCENT
               13,VJM,OUTCH
                 ,UJ,LOOP
 FMD:          13,VJM,GETARG
                 ,XTA,WIDTH
                 ,U1A,DWIDTH
                 ,XTA,                   . No extra spaces by default
                 ,ATX,WIDTH
 DWIDTH:         ,XTA,WIDTH
                7,XTS,-1
               13,VJM,C/WI
                 ,UJ,LOOP
C An octal field is C's: the value's own digits, the width a minimum, and the
C padding blanks unless a leading zero in the format asked for zeros, which
C C/WO lays down itself.  Either way the digits the value needs are what is
C written, so a width below them widens the field rather than truncating it.
 FMO:          13,VJM,GETARG
                1,AOX,8                  . a zero has a digit too, and a set
                 ,ANX,                   .  bit 1 moves no higher one
                 ,X-A,FIFTYONE           . n: 1 for bit 48 ... 48 for bit 1
                 ,A*X,INV3               . (51 - n) bits, three to a digit
                 ,ATX,OCTDIG
                 ,XTA,ZEROFIL
                 ,U1A,OFILL
                 ,XTA,OCTDIG             . blanks up to the width, if any
                 ,A-X,WIDTH
                 ,CALL,C/SP
                 ,XTA,OCTDIG
                 ,UJ,OWRITE
 OFILL:          ,XTA,WIDTH              . C/WO zero-fills a field wider than
                 ,A-X,OCTDIG             . the digits; a narrower one is the
                 ,U1A,ODIGITS            . digits
                 ,XTA,WIDTH
                 ,UJ,OWRITE
 ODIGITS:        ,XTA,OCTDIG
 OWRITE:        7,XTS,-1
               13,VJM,C/WO
                 ,UJ,LOOP
 FMC:          13,VJM,GETARG
                 ,XTA,WIDTH
                 ,UZA,CNOWID
                 ,XTA,WIDTH
                7,XTS,-1
               13,VJM,C/WC
                 ,UJ,LOOP
 CNOWID:        7,XTA,-1
               13,VJM,P/CW
                 ,UJ,LOOP
 FMA:          13,VJM,GETARG
                 ,XTA,WIDTH
                 ,UZA,ANOWID
                 ,XTA,WIDTH
                7,XTS,-1
               10,VTM,6
               13,VJM,C/A6
                 ,UJ,LOOP
 ANOWID:        7,XTA,-1
               10,VTM,6
               13,VJM,C/6A
                 ,UJ,LOOP
 FMREAL:       13,VJM,GETARG
                 ,XTA,WIDTH
                 ,U1A,RWIDTH
                 ,XTA,W14
                 ,ATX,WIDTH
 RWIDTH:         ,XTA,HASPREC
                 ,U1A,RPREC
                 ,XTA,W4
                 ,ATX,PREC
 RPREC:          ,XTA,WIDTH
                 ,XTS,PREC
                7,XTS,-1
               13,VJM,C/WR
                 ,UJ,LOOP
C C/PUTS already understands arbitrary byte alignment, NUL and LF.  An
C explicit width is left padding only; precision is deliberately ignored.
 FMS:          13,VJM,GETARG
                 ,XTA,WIDTH
                 ,UZA,SOUT
                 ,XTA,WIDTH
                 ,ATX,PREC
                7,XTA,-1
               13,VJM,STRLEN
                 ,NTR,7
                 ,A-X,PREC
                 ,CALL,C/SP
 SOUT:          7,XTA,-1
               13,VJM,C/PUTS
                 ,UJ,LOOP
 FMT:          13,VJM,GETARG
                 ,XTA,WIDTH
                7,XTS,-1
               13,VJM,C/WXD
                 ,UJ,LOOP
C Print the '%' of an unknown sequence, then let the main loop resume at the
C character immediately following it.  No actual argument is consumed.
 UNKNOWN:        ,XTA,PERCENT
               13,VJM,OUTCH
                 ,XTA,PCTPTR
                 ,ATX,FMTPTR
                 ,UJ,LOOP
C Return the next actual through M7.  The entry-SP word is the exclusive end;
C a missing actual terminates formatting without looking beyond the frame.
 GETARG:         ,ITA,7
                 ,AEX,ENTRYSP
                ,UZA,DONE
               7,XTA,
                7,UTM,1
               13,UJ,
C Load through the runtime's packed-char descriptor, then advance the format
C byte pointer by one.
 NEXTCH:         ,ITA,13
                 ,XTS,FMTPTR
                 ,XTS,FMTPTR
                1,ARX,8
                 ,STX,FMTPTR
               14,VTM,
               11,VTM,P/08
               13,VJM,P/LDAR
                 ,ATI,14
               15,WTC,
                 ,UJ,
C One literal format byte.  LF terminates the line exactly as C/PUTS does.
 OUTCH:        15,ATX,1
                 ,ITA,13
               15,XTS,
                 ,AEX,NEWLINE
                 ,UZA,OUTNL
                 ,AEX,NEWLINE
               13,VJM,P/CW
                 ,UJ,OUTRET
 OUTNL:        13,VJM,P/WL
 OUTRET:       15,WTC,
                 ,UJ,
C Let P/EDIH restore M6..M8 and M13, then discard the caller's contiguous
C argument sequence by assigning its base to SP.
 DONE:           ,XTA,ARGBASE
                 ,ATI,10
                 ,XTA,ENTRYSP
                 ,ATI,8
                8,MTJ,15
               15,UTM,4
               14,VTM,RET
                 ,UJ,P/EDIH
 RET:          10,MTJ,15
               13,UJ,
 NEWLINE:        ,LOG,0000 0000 0000 0012
 PERCENT:        ,LOG,0000 0000 0000 0045
 NINE:           ,LOG,11
 ASCII0:         ,LOG,60
 E48TEN:         ,LOG,4000000000000012
 W4:             ,LOG,4
 W14:            ,LOG,16
 FIFTYONE:       ,LOG,63
 INV3:           ,LOG,4005252525252526    . E48 | ceil(2**40 / 3)
 ARGBASE:        ,BSS,1
 ENTRYSP:        ,BSS,1
 FMTPTR:         ,BSS,1
 PCTPTR:         ,BSS,1
 WIDTH:          ,BSS,1
 PREC:           ,BSS,1
 HASPREC:        ,BSS,1
 DIGIT:          ,BSS,1
 ZEROFIL:        ,BSS,1
 OCTDIG:         ,BSS,1
                 ,END,
