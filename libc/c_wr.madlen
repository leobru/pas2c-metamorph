 14,VTM,PASPLUS*
 15,XTA,-8
 ,NTR,23B
 ,UZA,POSEXP
 ,AVX,MINUS9
 15,ATX,-8
 14,VTM,PASMINS*
 POSEXP:,XTA,TEN
 13,VJM,P/CW
 14,VTM,TEN
 ,XTA,TWO
 15,XTS,-9
 13,VJM,C/WI
C Restore the shared blank and return past value, width and precision.
 DONE:15,XTA,-1
 ,UTC,SPACE*
 ,ATX,
 15,UTM,-8
 15,WTC,3
 ,UJ,
 FIXED:15,XTA,-8
 ,A-X,ONE
 15,ATX,-3
 13,VTM,NEXTDIG
C Add the signed 0.5*10^-precision rounding constant.
 ADDROUND:11,VTM,
 15,XTA,-6
 ,NTR,20B
 ,UZA,POSROUND
 11,VTM,MINUS9
 POSROUND:,NTR,
 15,WTC,-7
 ,XTA,TWO
 11,AVX,
 15,A+X,-6
 15,ATX,-6
 13,UJ,
C===========================================================
C Plain integer constants and floating-point scale tables.
C TWO must remain immediately before the rounding table: precision
C is applied to it with WTC above.
C===========================================================
 MINUSZERO:,ISO,2H-0
 ONE:,LOG,1
 TEN:,LOG,12
 MINUS9:,LOG,7777 7777 7777 7767
 EIGHT:,LOG,10
 FOUR:,LOG,4
 BIAS:,LOG,100
 LOGTEN2:,REAL,3.0102E-01
 EMARK:,ISO,6H′′′′′′′′′′E
 TWO:,LOG,2
 ,REAL,5.E-02
 ,REAL,5.E-03
 ,REAL,5.E-04
 ,REAL,5.00000000001E-05
 ,REAL,5.00000000001E-06
 ,REAL,5.00000000002E-07
 ,REAL,5.E-08
 ,REAL,5.00000000001E-09
 ,REAL,5.00000000002E-10
 ,REAL,5.00000000002E-11
 C/TENS:,ENTRY,
 REAL1:,REAL,1.
 REAL10:,REAL,1.E01
 ,REAL,1.E02
 ,REAL,1.E03
 ,REAL,1.E04
