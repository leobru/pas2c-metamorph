 ,REAL,1.E16
 ,REAL,1.E17
 ,REAL,1.E18
 ,LOG,7757 7777 7777 7777
 ,DATA,
 /0212B:,ISO,6H′′′′′′′′′′.
 /0213B:,ISO,6H′′′′′′′′′′+
 1,SET,/0212B
 1,,PASPERID
 1,SET,/0213B
 1,,PASPLUS*
 ,END,
