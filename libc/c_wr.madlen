 C/WR:,NAME,
C===========================================================
C C/WR - format a REAL for output in C width.precision style.
C
C   In:  [SP-2] = plain field width (minimum; left-pad with blanks)
C        [SP-1] = plain precision (digits after the decimal point)
C        ACC    = REAL value
C        M14    = 0 exponential (%E), 1 fixed-point (%F)
C   Out: formatted field through FILE in M12; width and precision
C        are removed from the stack.
C
C M14 is saved into [SP-4] before this routine bases M14 on its
C constant block.  Precision is clamped to 1..10 (rounding table).
C===========================================================
 SPACE*:,LC,1
 PASZERO*:,LC,1
 PASMINS*:,LC,1
 C*PERID:,LC,1
 C*PLUS*:,LC,1
 C/CW:,SUBP,
 C/SP:,SUBP,
 C/TR:,SUBP,
 C/A7:,SUBP,
 C/WI:,SUBP,
 ,NTR,
 ,AVX,
 ,NTR,3
 14,MTJ,11                   . keep mode in M11 across BASE
 ,ITS,13                     . push value; ACC := return link
 ,XTS,
 14,BASE,TEN
 ,XTS,
 15,UTM,3
 ,ITA,11                     . mode back from M11
 15,ATX,-4
C Frame: [SP-4]=mode, [SP-6]=value, [SP-7]=precision, [SP-8]=width.
C Clamp precision to 1..10.  Stay in NTR,3 for all width/prec integer math.
 15,XTA,-7
 ,UZA,PSET1
 ,A-X,TEN
 ,UZA,PMAXOK
 ,NTR,20B
 ,U1A,PMAXOK
 ,NTR,3
 ,XTA,TEN
 15,ATX,-7
 ,UJ,PMAXOK
 PSET1:,XTA,ONE
 15,ATX,-7
 PMAXOK:,NTR,3
 15,XTA,-4
 ,U1A,FIXED
C Exponential: leading spaces = width - prec - 7
C (sign + digit + '.' + frac + 'E' + exp sign + 2 exp digits).
 15,XTA,-8
 15,A-X,-7
 ,A-X,ONE
 ,A-X,FOUR
 ,A-X,TWO                    . width - prec - 7
 15,ATX,-1
 15,XTA,-1
 ,UZA,SIGN
 ,AVX,MINUS9                 . C/SP wants -count
 13,VJM,C/SP
 14,VTM,TEN
 ,UJ,SIGN
C Print the value sign and make the working value positive.
 SIGN:15,XTA,-6
 ,NTR,20B
 ,U1A,MINUS
 ,UTC,SPACE*
 ,XTA,
 ,UJ,PUTSIGN
 ISZERO:,XTA,ONE
 ,UJ,SAVEDEXP
 MINUS:,AVX,MINUS9
 15,ATX,-6
 ,UTC,PASMINS*
 ,XTA,
 PUTSIGN:13,VJM,C/CW
 14,VTM,TEN
 15,XTA,-6
 ,UZA,ISZERO
C Convert the binary exponent to a plain decimal exponent.
 ,ASN,64+41
 ,A-X,BIAS
 1,AEX,11B
 ,NTR,
 ,A*X,LOGTEN2
 ,NTR,3
 1,A+X,11B
 1,AEX,11B
 SAVEDEXP:15,ATX,-8
 ,AMX,
 ,ATI,13
 14,J+M,13
 15,XTA,-8
 ,NTR,20B
 ,U1A,NEGEXP
 15,XTA,-6
 13,A/X,22B
 ,UJ,SCALED
 NEGEXP:15,XTA,-6
 13,A*X,22B
 SCALED:15,ATX,-6
 ,A-X,REAL1
 ,UZA,ROUND
 15,XTA,-6
 ,A*X,REAL10
 15,ATX,-6
 15,XTA,-8
 ,NTR,3
 ,A-X,ONE
 15,ATX,-8
 ROUND:13,VJM,ADDROUND
 ,X-A,REAL10
 ,UZA,DIGITS
 15,XTA,-6
 ,A/X,REAL10
 15,ATX,-6
 15,XTA,-8
 ,NTR,3
 ,A+X,ONE
 15,ATX,-8
 DIGITS:,XTA,ONE
 15,ATX,-3
 NEXTDIG:15,XTA,-6
 13,VJM,C/TR
 15,ATX,-2
 1,AEX,11B
 ,NTR,
 15,X-A,-6
 ,AMX,
 15,WTC,-7
 ,A*X,REAL1
 ,NTR,3
 1,A+X,11B
 1,AEX,11B
 1,ATX,4
 15,XTA,-2
 ,U1A,PUTINT
 15,XTA,-6
 ,NTR,20B
 ,UZA,PUTINT
 15,XTA,-3
 11,VTM,MINUSZERO
 10,VTM,2
 15,ATX,
 13,VJM,C/A7
 ,UJ,PUTFRAC
 PUTINT:15,XTA,-3
 15,XTS,-3
 13,VJM,C/WI
 PUTFRAC:,UTC,C*PERID
 ,XTA,
 13,VJM,C/CW
 13,VTM,SPACE*
 13,XTA,
 15,ATX,-1
 ,UTC,PASZERO*
 ,XTA,
 13,ATX,
 15,XTA,-7
 1,XTS,4
 13,VJM,C/WI
 15,XTA,-4
 ,U1A,DONE
 14,VTM,TEN
 ,XTA,EMARK
 13,VJM,C/CW
 14,VTM,C*PLUS*
 15,XTA,-8
 ,NTR,23B
 ,UZA,POSEXP
 ,AVX,MINUS9
 15,ATX,-8
 14,VTM,PASMINS*
 POSEXP:,XTA,TEN
 13,VJM,C/CW
 14,VTM,TEN
 ,XTA,TWO
 15,XTS,-9
 13,VJM,C/WI
 DONE:15,XTA,-1
 ,UTC,SPACE*
 ,ATX,
 15,UTM,-8
 15,WTC,3
 ,UJ,
C Fixed-point: optional '-', then C/WI width = width - prec - 1.
 FIXED:15,XTA,-6
 ,NTR,20B
 ,UZA,FNOSIGN
 ,AVX,MINUS9
 15,ATX,-6
 ,UTC,PASMINS*
 ,XTA,
 13,VJM,C/CW
 14,VTM,TEN
 FNOSIGN:,NTR,3
 15,XTA,-8                   . width
 15,A-X,-7                   . minus precision
 ,A-X,ONE                    . minus '.'
 15,ATX,-3                   . C/WI field for the integer part
 13,VTM,NEXTDIG
 ADDROUND:11,VTM,
 15,XTA,-6
 ,NTR,20B
 ,UZA,POSROUND
 11,VTM,MINUS9
 POSROUND:,NTR,
 15,WTC,-7
 ,XTA,TWO
 11,AVX,
 15,A+X,-6
 15,ATX,-6
 13,UJ,
 MINUSZERO:,ISO,2H-0
 ONE:,LOG,1
 TEN:,LOG,12
 MINUS9:,LOG,7777 7777 7777 7767
 CWR8:,LOG,10                    . spacer: 22B power table is M14-relative
 FOUR:,LOG,4
 BIAS:,LOG,100
 LOGTEN2:,REAL,3.0102E-01
 EMARK:,ISO,6H′′′′′′′′′′E
 TWO:,LOG,2
 ,REAL,5.E-02
 ,REAL,5.E-03
 ,REAL,5.E-04
 ,REAL,5.00000000001E-05
 ,REAL,5.00000000001E-06
 ,REAL,5.00000000002E-07
 ,REAL,5.E-08
 ,REAL,5.00000000001E-09
 ,REAL,5.00000000002E-10
 ,REAL,5.00000000002E-11
 C/TENS:,ENTRY,
 REAL1:,REAL,1.
 REAL10:,REAL,1.E01
 ,REAL,1.E02
 ,REAL,1.E03
 ,REAL,1.E04
 ,REAL,1.E05
 ,REAL,1.E06
 ,REAL,1.E07
 ,REAL,1.E08
 ,REAL,1.E09
 ,REAL,1.E10
 ,REAL,1.E11
 ,REAL,1.E12
 ,REAL,1.E13
 ,REAL,1.E14
 ,REAL,1.E15
 ,REAL,1.E16
 ,REAL,1.E17
 ,REAL,1.E18
 ,LOG,7757 7777 7777 7777
 ,DATA,
 /0212B:,ISO,6H′′′′′′′′′′.
 /0213B:,ISO,6H′′′′′′′′′′+
 1,SET,/0212B
 1,,C*PERID
 1,SET,/0213B
 1,,C*PLUS*
 ,END,
