 FPUTW:,NAME,
C===========================================================
C fputw(value, f) - store one word in f^ and advance the file.
C
C Calling convention for a two-argument ASSEMBLER routine:
C   ACC        = f (pointer to the FCB)
C   [SP-1]     = value
C
C C/PF expects M12 to address the FCB and f^ to contain the
C value being written.  It is already an ENTRY in p_sys.asm.
C
C One word is pushed for the two arguments, so exactly one is
C taken back, and STI is the whole of the pop: ATX stores f^
C without touching the stack, where STX would pop a second time.
C===========================================================
 C/PF:          ,SUBP,
                ,STI ,12     . M12 := f; ACC := value
            12  ,WTC ,       . address f^ through FILE[0]
                ,ATX ,       . f^ := value
                ,UJ  ,C/PF   . tail call to put(f)
                ,END ,
