 longjmp:       , name,
C===========================================================
C longjmp(env, val) - non-local jump back to a setjmp point.
C   In:  ACC        = val (the value setjmp should return; a 0 is
C                     forced to 1),
C        stack top  = env (pointer to the six-word jmp_buf).
C   env[0] packs  (saved frame pointer << 15) | setjmp-return-address,
C   so its low 15 bits are where setjmp was called (dest) and its
C   high part is the target frame pointer (frame).  env[1] through
C   env[5] hold the display registers M2 through M6 as they stood
C   at the setjmp call; the frames longjmp steps over never reach
C   C/E, which is what would otherwise put them back, so they are
C   popped from the jmp_buf here, while ACC still addresses it.
C   The last pop leaves env[0] in the accumulator.
C   longjmp then walks the C frame chain (M7 = frame pointer) up to
C   the saved frame, calling any per-frame cleanup handler on the
C   way, unwinds the saved-context chain at [M1+6] down to that
C   level, and jumps to the setjmp return address with ACC = val.
C   M12 bases the local cells (dest, frame, ret, e30to16).
C
C C/RC (ENTRY below) is the same walk with a different front and
C the same tail: M13 is the stop-frame sentinel, M14 the return
C link (14,VJM).  dest/frame/ret hold that link, the sentinel and
C 0 so the shared *0020b exit returns through dest with ACC = 0.
C===========================================================
                , ntr , 7      . R := 7 (raw integer / bit mode)
            12  , base, area   . M12 = base register for the local cells
                , u1a , nonzero . val != 0 -> keep it (nonzero)
             1  , xta , 8       . val == 0: ACC := [M1+8] = 1 (return 1)
 nonzero :      , stx , ret     . ret := val; pop -> ACC := env (the jmp_buf)
C --- restore the display registers by popping the jmp_buf ---
            15  , mtj , 14     . M14 := M15, the caller's stack pointer
                , ati , 15     . M15 := env
            15  , utm , 6      . M15 := env+6, one past the display
            15  , xta ,        . pop: ACC := env[5]
                , sti , 6      . M6 := env[5]; ACC := env[4]
                , sti , 5      . M5 := env[4]; ACC := env[3]
                , sti , 4      . M4 := env[3]; ACC := env[2]
                , sti , 3      . M3 := env[2]; ACC := env[1]
                , sti , 2      . M2 := env[1]; ACC := env[0]
            14  , mtj , 15     . M15 := the caller's stack pointer again
                , atx , dest     . dest := env[0] (its low 15 bits = setjmp addr)
                , asn , 64+15    . right-shift 15
                , atx , frame    . frame := env[0] >> 15 (target frame pointer)
                , uj  , walk
C===========================================================
 C/RC:          , entry,
C===========================================================
C C/RC - walk the activation chain rooted at M7 until M7 equals
C the sentinel in M13 (usually M1), running any cleanup linked
C from each frame's state word at mem[M7+1], then pop the
C saved-context chain at [M1+6].  Called 14,VJM; returns via M14.
C Port of P/RC, sharing longjmp's unwind tail.
C===========================================================
                , ntr , 3
            12  , base, area   . same M12 map as longjmp
                , ita , 14       . ACC := return link
                , atx , dest     . dest := M14 (shared exit jumps here)
                , ita , 13       . ACC := stop-frame sentinel
                , atx , frame
                , xta ,          . ACC := 0
                , atx , ret      . shared exit loads ret into ACC
C --- walk: unwind the frame chain (M7) up to the target frame ---
 walk    :      , ita , 7       . ACC := M7 (current frame pointer)
                , aex , frame    . compare with the target frame
                , uza , ctxpop   . reached it -> pop saved contexts
             7  , xta , 1        . ACC := mem[M7+1] (this frame's link word)
                , aax , e30to16 . =77 7770 0000  . isolate the cleanup-handler field
                , uza , nextfr   . no handler -> skip the call
                , asn , 64+15    . right-shift 15 -> handler address
                , ati , 13       . M13 := handler address
            13  , utc ,          . C := M13
            13  , vjm ,          . call the per-frame cleanup handler
 nextfr  :  12  , vtm , area     . M12 := area (restore the base after the call)
             7  , mtj , 15       . SP := M7 (drop this frame)
             7  , xta ,          . ACC := mem[M7] (previous frame pointer)
                , ati , 7        . M7 := previous frame
                , uj  , walk
C --- pop the saved-context chain at [M1+6] to this level ---
 ctxpop  :      , ita , 15       . ACC := SP (target stack level)
             1  , a-x , 6        . compare with [M1+6] (chain head)
                , uza , done     . reached the target level
             1  , wtc , 6        . C := [M1+6]
                , xta ,          . ACC := mem[[M1+6]] (next chain link)
             1  , atx , 6        . [M1+6] := that (pop one saved context)
                , uj  , ctxpop
C --- done: longjmp resumes setjmp; C/RC returns through dest ---
 done    :      , xta , ret      . ACC := ret (setjmp value, or 0 for C/RC)
                , wtc , dest     . C := dest (setjmp addr, or C/RC return link)
                , uj  ,           . jump there
C --- local cells (M12-relative) ---
 area    :      , bss ,          . base anchor (0 words)
 dest    :      , log ,          . setjmp return address, or C/RC's M14
 frame   :      , log ,          . target frame pointer / C/RC sentinel
 ret     :      , log ,          . setjmp return value, or 0 for C/RC
 e30to16 :      , log , 77 7770 0000   . mask for bits 16..30 (handler field)
                , end ,
