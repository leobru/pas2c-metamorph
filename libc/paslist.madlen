 PASLIST:,NAME,
C===========================================================
C PASLIST - computes the default listing verbosity: 2 if FULISFL* is
C set, 0 if NOLISFL* is set, else 1.  workmain.p2c calls it directly
C (listMode = PASLIST()) at the start of every compile; neither flag
C is ever set by this project's own job control, so the "neither set"
C branch is the only one exercised in practice, and a source-level
C {$L=n} pseudo-comment is what actually varies listMode afterward.
C
C This is a verbatim port of the Pascal runtime's PASLIST
C (paslib/paslist.dtran) -- fully self-contained, no SUBP dependencies.
C===========================================================
 FULISFL*:,LC,1
 NOLISFL*:,LC,1
                ,XTA ,FULISFL*
                ,UZA ,CHECKNO
           14   ,VTM ,TWO.=I2
                ,UJ  ,DONE
 CHECKNO:       ,XTA ,NOLISFL*
                ,UZA ,SETONE
           14   ,VTM ,ZERO.=I0
                ,UJ  ,DONE
 SETONE:   14   ,VTM ,ONE.=I1
 DONE:     14   ,XTA ,
           13   ,UJ  ,
 TWO:            ,INT ,2
 ZERO:            ,INT ,0
 ONE:             ,INT ,1
                ,END ,
