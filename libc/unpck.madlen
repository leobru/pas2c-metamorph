 UNPCK:,NAME,
C===========================================================
C unpck(value, p) - unpack one word into six characters.
C
C Calling convention for a two-argument ASSEMBLER routine:
C   ACC    = p, the word address of six characters
C   [SP-1] = value, the word the characters come from
C   M13    = return link
C
C   void unpck(int, int *) assembler;
C
C Result:
C   p[0]..p[5] hold the six eight-bit characters of value, the
C   most significant byte of it in p[0].
C
C The word is the pushed argument and the address arrives in the
C accumulator, so STI is the whole of the entry sequence: it
C takes the address for M12 and pops the word into the
C accumulator in one instruction.  That is what makes this order
C of the two arguments the convenient one.
C
C This is the Pascal runtime's P/UN (paslib/p_un.dtran), inlined instead of
C tail-called.  Each pass shifts the remaining word left 8 bits -- ASN
C clears Y first, so a left shift moves exactly the top byte that fell out
C of the accumulator into Y's low bits -- then YTA copies that byte back
C into the accumulator to store.  Six passes (M14 = -5..0, via VLM's
C check-then-increment order) place p[0]..p[5] in order, most significant
C byte first.
C===========================================================
                ,NTR ,7      . ABI requirement
                ,STI ,12     . M12 := p; ACC := value
           15   ,ATX ,1      . [SP+1] := value, the word being unpacked
           14   ,VTM ,-5     . M14 := -5, a 6-pass loop counter
 LOOP:     15   ,XTA ,1      . ACC := [SP+1], the remaining word
                ,ASN ,64-8   . [Y,A] <<= 8: Y := the top byte shifted out
           15   ,ATX ,1      . [SP+1] := ACC, the shifted remainder
                ,YTA ,       . ACC := Y, the extracted byte
           14   ,UTC ,       . C := M14, the byte offset (-5..0)
           12   ,ATX ,5      . p[5+M14] := ACC
           14   ,VLM ,LOOP   . M14 += 1; loop while the old M14 was nonzero
           13   ,UJ  ,       . return
                ,END ,
