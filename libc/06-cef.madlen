c===========================================
 c/e     :      ,entry,
c===========================================
                , ntr , 7
c   Put back the display C/2..C/6 saved in the frame: the
c   routine that clobbered a register is the one that restores
c   it, so nothing has to be rebuilt at the call site.  WTC and
c   VTM leave the accumulator alone, which is where a function
c   result is sitting.
            7   , wtc , 3
            2   , vtm ,
            7   , wtc , 4
            3   , vtm ,
            7   , wtc , 5
            4   , vtm ,
            7   , wtc , 6
            5   , vtm ,
            7   , wtc , 7
            6   , vtm ,
            7   , mtj , 15
            7   , wtc ,
            7   , vtm ,
            15  , wtc , 1
                , uj  ,
                , data,
 /0006b  :      , log , 60
 /0007b  :      , log , 55
 /0010b  :      , log , 40
 /0011b  :      , iso , 6h/*
 /0012b  :      , log , 12
            1   , set , /0012b
            1   ,     , paseolsy
            1   , set , /0006b
            1   ,     , paszero*
            1   , set , /0007b
            1   ,     , pasmins*
            1   , set , /0010b
            1   ,     , space*
            1   , set , /0011b
            1   ,     , paseofcd
            1   , set , /0012b
            1   ,     , pasends*
                , end ,
