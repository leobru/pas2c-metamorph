void initTables() { /* initTables */
int idx, jdx;

//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void initInsnTemplates() {
operator op;
    for (idx = 1; idx < 16; ++idx)
        indexreg[idx]  =  idx << 20;
    jumpType  =  KUJ;
    for (op = MUL; op <= ASSIGNOP; ++op) {
        opFlags[op]  =  opfCOMM;
        opToInsn[op]  =  0;
        if (op IN [MUL, RDIVOP, PLUSOP, MINUSOP]) {
            opToMode[op]  =  3;
        } else if (op IN [IDIVOP, IMODOP]) {
            opToMode[op]  =  2;
        } else if (op IN [IMULOP, INTPLUS, INTMINUS]) {
            opToMode[op]  =  1;
        } else {
            opToMode[op]  =  0;
        }
    }
    opToInsn[MUL]  =  KMUL;
    opToInsn[RDIVOP]  =  KDIV;
    opToInsn[IDIVOP]  =  11; /* C/DI */
    opToInsn[IMODOP]  =  7; /* C/MD */
    opToInsn[PLUSOP]  =  KADD;
    opToInsn[MINUSOP]  =  KSUB;
    opToInsn[IMULOP]  =  KMUL;
    opToInsn[SETAND]  =  KAAX;
    opToInsn[SETXOR]  =  KAEX;
    opToInsn[SETOR]  =  KAOX;
    opToInsn[INTPLUS]  =  KADD;
    opToInsn[INTMINUS]  =  KSUB;
    opToInsn[SHLEFT]  =  56;
    opToInsn[SHRIGHT]  =  57;
    opFlags[ANDOP]  =  opfAND;
    opFlags[IDIVOP]  =  opfDIV;
    opFlags[OROP]  =  opfOR;
    opFlags[IMULOP]  =  opfMULMSK;
    opFlags[IMODOP]  =  opfMOD;
    opFlags[ASSIGNOP]  =  opfASSN;
    opFlags[SHLEFT]  =  opfSHIFT;
    opFlags[SHRIGHT]  =  opfSHIFT;
} /* initInsnTemplates */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void regKeywords() { /*=A3 regKeywords */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    SY  =  EXPROP;
    charClass  =  INOP;
    regResWord('      IN');
    SY  =  CONSTSY;
    charClass  =  NOOP;
    /* CONSTSY..RETURNSY are 19 consecutive reserved words. TYPESY sits just
       before CONSTSY so it is outside this range -- no skip needed; the
       predefined type names are registered as TYPESY keywords later, by
       mainProgram, and markTypeSym still raises user typedef names to
       TYPESY. */
    for (idx = 0; idx <= 18; ++idx) {
        regResWord(resWordName[idx]);
        ++SY;
    }
} /*=A2 regKeywords */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    FcstCnt  =  0;
    FcstCount  =  0;
    initInsnTemplates();
    skipToSet  =  blockBegSys | statBegSys & (~[SWITCHSY]);
    unpack(*pasinfor.a3, iso2text, '\052'); /* '*' */
    iso2text['_'] = iso2text['*'];
    ftruncate(&_CHILD_);
    for (jdx = 1; jdx <= 10; ++jdx)
        fputw(0, &_CHILD_);
    regKeywords();
    internHead  =  NULL;
    numLabTop  =  0;
    totalErrors  =  0;
    heapCallsCnt  =  0;
    putLeft  =  true;
    readNext  =  true;
    curFrameRegTemplate  =  frameRegTemplate;
    curProcNesting  =  1;
} /* initTables */
