        c = idx->expr2;
        if ((c->op == GETENUM) && (c->typ == intType)) {
            if (idx->op == INTPLUS)
                *offset += c->num1;
            else
                *offset -= c->num1;
            idx = idx->expr1;
        } else if ((idx->op == INTPLUS) &&
                   (idx->expr1->op == GETENUM) &&
                   (idx->expr1->typ == intType)) {
