//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void outputObjFile() {
int idx;
    padToLeft();
    for (idx = 1; idx < (objHalfIdx >> 1); ++idx)
        fputw(objBuffer.words[idx], &_CHILD_);
    lineStartOffset  =  moduleOffset;
    prevOpcode  =  0;
} /* outputObjFile */
