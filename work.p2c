            curDeclarator.foundRec->pck.p.cl == ROUTINEID &&
            curDeclarator.foundRec->list == NULL &&
            curDeclarator.foundRec->r2.preDefLink &&
            /* The whole header is restated, so the return type must agree.
               A disagreement falls through to the "previous declaration was
               not a forward declaration" arm below. */
            curDeclarator.foundRec->typ == typedRetType) {
            isPredefined  =  true;
        } else if (curDeclarator.ptrOnly && SY == LPAREN &&
                   curDeclarator.foundRec &&
                   curDeclarator.foundRec->id == curDeclarator.name &&
                   /* A routine record.  A name may shadow an enum constant
                      or a variable of an outer scope, and identifiers
                      collide at 8 characters (standProc the routine and the
                      STANDPROC operator). */
                   curDeclarator.foundRec->pck.p.cl == ROUTINEID) {
            error(errIdentAlreadyDefined);
            printErrMsg(82); /* errPrevDeclWasNotForward */
        }
        // A name carrying nothing but '*' ops -- 'name', '*name', '**name'
        // -- is a routine when followed by '(', and a plain variable
        // otherwise. A '[]' or a parenthesized group makes it a variable: an
        // array, or a pointer to a routine. Every routine carries explicit
        // parens, a definition completing an earlier declaration included, so
        // no lookahead past ';' is needed.
        declIsRoutine  =  curDeclarator.ptrOnly && (SY == LPAREN);
        if (staticDecl && declIsRoutine)
            error(errBadSymbol);
        if (externDecl && declIsRoutine) {
            error(errBadSymbol);
            skip(skipToSet | [SEMICOLON]);
            if (SY == SEMICOLON)
                inSymbol();
            markTypeSym();
            continue;
        }
        if (! declIsRoutine) {
            /* ---- variable declarator list ---- */
            lookupMode  =  lookUse;
            moreDecls  =  true;
            while (moreDecls) {
                if (externDecl && (curProcNesting == 1)) {
                    curIdent  =  curDeclarator.name;
                    if ((curIdent == litInput) || (curIdent == litOutput))
                        error(errIdentAlreadyDefined);
                    else
                        defExtern();
                }
                /* Declaring a name this scope already has is an error, not a
                   silent shadow: the record below would go in front of the
                   older one, which keeps storage of its own and becomes
                   unreachable.  Shadowing an outer scope stays legal --
                   lookDef stops its walk at the first record from one. */
                if (curDeclarator.wasDefined)
                    error(errIdentAlreadyDefined);
                curIdRec = malloc(offsetof(identrec, szIdent));
                { register identrec *ir = curIdRec;
                    ir->id  =  curDeclarator.name;
                    ir->pck.p.offset  =  curFrameRegTemplate;
                    ir->pck.p.next  =  symHash[curDeclarator.bucket];
                    ir->pck.p.cl  =  staticDecl ? STATICID : VARID;
                    ir->list  =  NULL;
                    ir->typ  =  curDeclarator.typ;
                }
                symHash[curDeclarator.bucket]  =  curIdRec;
                jj  =  typeSize(curDeclarator.typ);
                /* 'int a[] = { ... }' is sized by its initializer, which has
                   not been read yet, so it allocates nothing here and comes
                   back for its storage below.  Without an initializer there
                   is nothing to take a size from. */
                if (curDeclarator.typ.p.pk == kindArray &&
                    curDeclarator.typ.rep->asize == 0 && SY != BECOMES)
                    error(64); /* errIncorrectRangeDefinition */
                l2bool8z  =  true;
                if (curProcNesting == 1) {
                    curExternFile  =  externFileList;
                    l2var12z  =  curDeclarator.name;
                    curVal.i  =  jj;
                    toAlloc  =  curVal.i & halfWord | [24,27,28,29];
                    while (l2bool8z && curExternFile) {
                        if (curExternFile->id == l2var12z) {
                            l2bool8z  =  false;
                            if (curExternFile->line == 0) {
                                curVal.i  =  curExternFile->offset;
                                curIdRec->value  =  allocExtSymbol(toAlloc);
                                curExternFile->line  =  lineCnt;
                            }
                        } else {
                            curExternFile  =  curExternFile->next;
                        }
                    }
                }
                if (l2bool8z) {
                    if ((curProcNesting == 1) || staticDecl)
                        curIdRec->value  =  moduleDataSize;
                    else
                        curIdRec->value  =  localSize;
                    if (PASINFOR.listMode == 3) {
                        write("VARIABLE ":26);
                        printTextWord(curDeclarator.name);
                        writeln(" OFFSET (", curProcNesting:0, ") ",
                                curIdRec->value:5 oct, "B. WORDS=",
                                jj:5 oct, 'B');
                    }
                    if ((curProcNesting == 1) || staticDecl) {
                        moduleDataSize += jj;
                        if (curProcNesting == 1)
                            localSize  =  moduleDataSize;
                    } else
                        localSize += jj;
                    curExternFile  =  NULL;
                }
                if (SY == BECOMES) {
                    if ((curProcNesting != 1) && ! staticDecl)
                        error(errVarTooComplex); /* load-time init: globals only */
                    initVar  =  curIdRec;
                    freeRegs  =  initRegs;
                    statement();
                    if (curDeclarator.typ.p.pk == kindArray &&
                        curDeclarator.typ.rep->asize == 0) {
                        /* The initializer places whole words, so a packed
                           array holds perword elements in each of them and
                           an unpacked one an element every typeSize words. */
                        if (curDeclarator.typ.p.pad)
                            jj  =  initWords * curDeclarator.typ.rep->perword;
                        else
                            jj  =  initWords /
                                   typeSize(curDeclarator.typ.rep->base);
                        curIdRec->typ  =  makeArrayType(jj,
                                              curDeclarator.typ.rep->base,
                                              curDeclarator.typ.p.pad != 0);
                        if ((curProcNesting == 1) || staticDecl) {
                            moduleDataSize += typeSize(curIdRec->typ);
                            if (curProcNesting == 1)
                                localSize  =  moduleDataSize;
                        } else
                            localSize += typeSize(curIdRec->typ);
                    }
                }
                moreDecls  =  (SY == COMMA);
                if (moreDecls) {
                    lookup2  =  lookupMode  =  lookDef;   /* the next name is a definition too */
                    inSymbol();
                    noExtentOk  =  true;
                    parseOneDeclarator(&curDeclarator, l2typ13z, isPacked, isForwardRef);
                    lookup2  =  lookupMode  =  lookUse;
                    noExtentOk  =  false;
                }
            }
            checkSymAndRead(SEMICOLON);
        } else {
            /* ---- routine ---- */
            curIdent  =  curDeclarator.name;
            bucket  =  curDeclarator.bucket;
            isDefined  =  curDeclarator.wasDefined;
            hashTravPtr  =  curDeclarator.foundRec;
            if (! isPredefined) {
                curIdRec = malloc(offsetof(identrec, szRoutine));
                { register identrec *ir = curIdRec;
                    ir->id  =  curIdent;
                    ir->pck.p.offset  =  curFrameRegTemplate;
                    ir->pck.p.next  =  symHash[bucket];
                    ir->typ  =  voidType;
                    symHash[bucket]  =  curIdRec;
                    ir->pck.p.cl  =  ROUTINEID;
                    ir->list  =  NULL;
                    ir->value  =  0;
                    ir->r1.sig  =  NULL;
                    ir->r2.preDefLink  =  NULL;
                    ir->flags  =  declEntry ? [0:15,22] : [0:15];
                    ir->r1.pos  =  0;
                    curFrameRegTemplate += frameRegTemplate;
                    l2int18z  =  l2bool8z ? 8 : 9;
                }
                ++curProcNesting;
                /* The display takes one index register per level, and
                   freeRegs is [curProcNesting+1:6]: level 6 would leave the
                   expression evaluator none. */
                if (5 < curProcNesting)
                    error(81); /* errProcNestingTooDeep */
