tptr valueType;
kind l4var5z;
state l4st6z;
int isSimple;
    { register insnltyp *il = insnList;
        valueType  =  il->typ;
        switch (il->ilm) {
        case ilCONST:
            curVal.i  =  il->payload;
            if (typeSize(valueType) == 1)
                curVal.i  =  getFCSToffset();
            addToInsnList(constRegTemplate + curInsnTemplate + curVal.i);
            break;
        case ilLVAL: {
            helper  =  il->addrmd;
            l4int2z  =  il->payload;
            l4int3z  =  il->disp;
            if (15 < helper) {
                /* empty */
            } else if (helper == 15) {
                addToInsnList(macro + mcACC2ADDR);
            } else {
                helper  =  indexreg[il->addrmd];
