                           insnCopy.typ.p.pad;
                switch (insnCopy.st) {
                case stWORD: insnCopy.shift  =  l5var6z; break;
                case stSLICE: insnCopy.shift  =  insnCopy.shift + l5var6z +
                                           typeBits(insnCopy.typ) - 48; break;
                case stPACKED: error(errUsingVarAfterIndexingPackedArray);
                } /* switch */
                insnCopy.width  =  insnCopy.typ.p.pad;
                insnCopy.st  =  stSLICE;
            }  else {
                insnCopy.disp  =  curVal.i  * typeSize(l5var26z) +
                                  insnCopy.disp;
            }
        } else {
            if (l5var8z != 1) {
                prepLoad();
                addToInsnList(insnCopy.typ.rep->perword);
                insnList->tail->mode  =  1;
                if (l5var7z >= 0)
                    addToInsnList(KYTA+64);
                else
                    addToInsnList(macro + mcMULTI);
           }
           if ((l5ilm28z == ilCOND) ||
              (l5ilm28z == ilLVAL) &&
              (insnList->st != stWORD))
               prepLoad();
           l5var23z  =  insnCopy.regsused | insnList->regsused;
           if (! isPacked) {
               if (insnCopy.addrmd == 18) {
                    if (insnList->ilm == ilRVAL) {
                        insnCopy.addrmd  =  15;
                    } else {
                        insnCopy.addrmd  =  16;
                        curInsnTemplate  =  KWTC;
                        prepLoad();
                        curInsnTemplate  =  KXTA;
                    }
                    insnCopy.tail  =  insnList->tail;
                    insnCopy.head  =  insnList->head;
                } else {
                    if (insnCopy.addrmd >= 15) {
                        l5var1z  =   minel(l5var22z);
                        if (0 >= l5var1z) {
                            l5var1z  =  minel(freeRegs & (~ insnCopy.regsused));
                            if (0 >= l5var1z)
                                l5var1z  =  9;
                        }
                        saved  =  insnList;
                        insnList  =  copyPtr;
                        l5var23z |= E48 >> l5var1z;
                        if (insnCopy.addrmd == 15) {
                            addToInsnList(KATI + l5var1z);
                        } else {
                            addToInsnList(indexreg[l5var1z] + KVTM);
                        }
                        insnCopy.addrmd  =  l5var1z;
                        insnCopy.regsused |= E48 >> l5var1z;
                        insnList  =  saved;
                    } else {
                            l5var1z  =  insnCopy.addrmd;
                    }
                    if (has(insnList->regsused, l5var1z)) {
                         push();
                         insnList->tail->next  =  insnCopy.head;
                         insnCopy.head  =  insnList->head;
                         insnList  =  copyPtr;
                         addInsnAndOffset(macro+mcADDSTK2REG, l5var1z);
                    } else {
                         if (insnList->ilm == ilRVAL) {
                             addInsnAndOffset(macro+mcADDACC2REG, l5var1z);
                         } else {
                             curInsnTemplate  =  KWTC;
                             prepLoad();
                             curInsnTemplate  =  KXTA;
                             addToInsnList(indexreg[l5var1z] + KUTM);
                         }
                         insnCopy.tail->next  =  insnList->head;
                         insnCopy.tail  =  insnList->tail;
                     }
                }
           } else {
                if (insnCopy.st == stWORD) {
                    prepLoad();
                    if (l5var7z) {
                        curVal.i  =  0 - l5var7z;
                        addToInsnList(KADD+I8 + getFCSToffset());
                        insnList->tail->mode  =  1;
                    }
                    l5var24z  =  insnCopy.regsused >> (47-0);
                    if (l5var24z)
                        addToInsnList(macro + mcPUSH);
                    saved  =  insnList;
                    insnList  =  copyPtr;
                    setAddrTo(14);
                    if (l5var24z)
                        addToInsnList(macro + mcPOP);
                    l5var23z |= [0, 10, 11, 13, 14];
                    insnCopy.st  =  stPACKED;
                    insnCopy.disp  =  0;
                    insnCopy.payload  =  0;
                    insnCopy.width  =  insnCopy.typ.p.pad;
                    curVal.i  =  insnCopy.width;
                    if (curVal.i == 24)
                        curVal.i  =  7;
                    curVal.i <<= 24;
                    addToInsnList(allocSymtab(  /* P/00C */
                        helperNames[21] | curVal.i)+(KVTM+I11));
                    insnCopy.addrmd  =  16;
                    insnCopy.shift  =  0;
                    saved->tail->next  =  insnCopy.head;
                    insnCopy.head  =  saved->head;
                } else {
                    error(errUsingVarAfterIndexingPackedArray);
                }
            }
            insnCopy.regsused  =  l5var23z;
        }
        insnCopy.typ  =  l5var26z;
    }
    insnList  =  l5ins21z;
    *insnList  =  insnCopy;
} /* genGetElt */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genEntry() { /* genEntry */
/* A struct argument at least this wide is streamed onto the stack by
   C/LNGPAR instead of by one load per word.  The call is three instructions,
   or four where the struct is the first argument and has to load word 0
   itself, whatever the width; below this the unrolled run is shorter.  The
   width is where size turns, not speed: C/LNGPAR runs about three
   instructions per word against the unrolled one. */
const int loopArgSz = 4;
eptr l5exp1z, l5exp2z, calleeExp;
irptr l5idr5z;
/* needPush says the accumulator holds a value that has to be pushed before
   another is loaded over it -- which is the same thing as "this is not the
   first argument", and after the list the same thing again as "argument 1 is
   on the stack" for the indirect call's tail macro. */
int isProc, needPush, isIndir, isFortrn, isAssembler, allByRef;
int calleeFl, frameSiz, manyArgs, tailMacro, slot;
int isVarArg, tailWords, tailDisp;
insnltyp *l5inl20z;
eptr tailExp, l5exp3z;
tptr routTyp, resTyp;
sigptr curSig, l5sig19z;
//
    l5exp1z  =  exprToGen->expr1;
    isIndir  =  exprToGen->op == INDCALL;
    tailExp  =  NULL;
    tailWords  =  0;
    if (isIndir) {
        /* Everything about the callee comes from the type it is reached
           through: the result, the parameter list, and the flags that shape
           the call.  Nothing is known about the registers the routine at the
           other end uses, so every one of them counts as clobbered. */
        calleeExp  =  exprToGen->expr2;
        routTyp  =  ptrBase(calleeExp->typ);
        resTyp  =  routTyp.rep->rresult;
        curSig  =  routTyp.rep->rparams;
        manyArgs  =  argWords(curSig) >= 2;
        calleeFl  =  routTyp.rep->rflags | [0:15];
    } else {
        l5idr5z  =  exprToGen->id2;
        resTyp  =  l5idr5z->typ;
        curSig  =  l5idr5z->r1.sig;
        manyArgs  =  argWords(curSig) >= 2;
        calleeFl  =  l5idr5z->flags;
    }
    isProc  =  resTyp == voidType;
    frameSiz  =  isProc ? 8 : 9;
    isVarArg  =  (calleeFl >> (47-23)) & 1;
    isFortrn  =  (calleeFl >> (47-21)) & 1;
    isAssembler  =  (calleeFl >> (47-26)) & 1;
    allByRef  =  (calleeFl >> (47-24)) & 1;
    insnList = malloc(sizeof(insnltyp));
    insnList->head  =  NULL;
    insnList->tail  =  NULL;
    insnList->typ  =  resTyp;
    /* The display registers the callee names are not the caller's business:
       calleeSaved is put back before the call returns.  Leaving them in
       regsused would fold them into usedRegs when the list is emitted, and
       genOneOp would then take a base pinned there out of liveRegs. */
    insnList->regsused  =  ((calleeFl & ~calleeSaved) | [7:15]) & [0:8, 10:15];
    insnList->ilm  =  ilRVAL;
    insnList->st  =  stWORD;   /* prepLoad reads st on every ilRVAL list */
    if (isFortrn) {
        needPush  =  isProc;
        if (checkFortran) {
            addToInsnList(getHelperProc(25)); /* "P/MF" */
        }
    } else {
        /* The first argument travels in the accumulator and the ones after it
           are pushed.  An assembler routine reads those off the stack top and
           has no frame of its own, so nothing is skipped for it. */
        needPush  =  false;
        if (isVarArg) {
            /* The tail goes down first, so it sits below the frame and the
               mandatory actuals still land on the slots the declaration
               fixed.  Each is one word and each is pushed where it stands --
               none of them is the argument left in the accumulator, which is
               the pointer built at the end. */
            tailDisp  =  argWords(curSig) - 1;   /* the marker is one word */
            tailExp  =  l5exp1z;
            l5sig19z  =  curSig;
            while (tailExp && l5sig19z && l5sig19z->next) {
                tailExp  =  tailExp->expr1;
                l5sig19z  =  l5sig19z->next;
            }
            l5exp3z  =  tailExp;
            while (l5exp3z) {
                l5inl20z  =  insnList;
                genFullExpr(l5exp3z->expr2);
                prepLoad();
                addToInsnList(macro + mcPUSH);
                if (l5inl20z->tail) {
                    l5inl20z->tail->next  =  insnList->head;
                    insnList->head  =  l5inl20z->head;
                }
                insnList->regsused  =  insnList->regsused | l5inl20z->regsused;
                ++tailWords;
                l5exp3z  =  l5exp3z->expr1;
            }
        }
        /* A variadic call always skips the frame: the tail is already down,
           so the mandatory actuals must not land on the header. */
        if (! isAssembler && (manyArgs || isVarArg)) {
            addToInsnList(KUTM+SP + frameSiz);
        }
    }
    while (l5exp1z && l5exp1z != tailExp) {
        l5exp2z  =  l5exp1z->expr2;
        l5exp1z  =  l5exp1z->expr1;
        l5inl20z  =  insnList;
        genFullExpr(l5exp2z);
        /* The formal says how many argument slots the actual fills, since it
           is the formal that laid the callee's frame out.  One wider than a
           word claims that many, and the struct's own words go into them:
           passed by value in the literal sense.  Each push fuses with the
           load that follows it into an XTS, and the last word is left in the
           accumulator, where an argument of one word would have been.
           A formal one word wide takes an address instead of a value when the
           value does not fit one -- which is how a file reaches a pointer
           formal -- and FORTRAN takes an address whatever the widths. */
        if (allByRef || curSig == NULL || typeSize(curSig->ptyp) == 1) {
            if (! allByRef && typeSize(insnList->typ) == 1) {
                prepLoad();
            } else {
                setAddrTo(14);
                addToInsnList(KITA+14);
            }
        } else if (typeSize(curSig->ptyp) < loopArgSz) {
            setAddrTo(14);
            for (slot = 0; slot < typeSize(curSig->ptyp); ++slot) {
                if (slot)
                    addToInsnList(macro + mcPUSH);
                addInsnAndOffset(I14 + KXTA, slot);
            }
        } else {
            /* C/LNGPAR streams the words instead.  Its opening XTS pushes
               whatever is in the accumulator, which is the previous argument
               -- so that push is the one this loop would have prepended, and
               word 0 is read from where the address register already points.
               As the first argument there is nothing to push ahead of the
               struct, so word 0 is loaded here and the register starts one
               past it. */
            slot  =  typeSize(curSig->ptyp) - 1;
            if (! needPush) {
                ++insnList->disp;
                setAddrTo(14);
                addInsnAndOffset(I14 + KXTA, -1);
                --slot;
            } else {
                setAddrTo(14);
                needPush  =  false;
            }
            addToInsnList(KVTM+I12 + getValueOrAllocSymtab(-slot));
            addToInsnList(getHelperProc(19)); /* "C/LNGPAR" */
            insnList->regsused |= (E48 >> 12) | (E48 >> 13);
        }
        if (curSig)
            curSig  =  curSig->next;
        if (needPush)
            prependToInsnList(macro + mcPUSH);
        needPush  =  true;
        if (l5inl20z->tail) {
            l5inl20z->tail->next  =  insnList->head;
            insnList->head  =  l5inl20z->head;
        }
        insnList->regsused  =  insnList->regsused | l5inl20z->regsused;
    }
    if (isVarArg) {
        /* The last argument is the pointer to the tail.  Everything between
           it and the tail's first word is known here -- the tail itself, the
           frame the bump skipped, and the mandatory words already pushed --
           so the address is that much below where the stack now stands. */
        /* The last mandatory actual is still in the accumulator; push it
           where it stands, since the pointer is about to load over it.
           Appended, not prepended: the deferred push belongs in front of the
           next actual's own code, and there is no next actual. */
        if (needPush)
            addToInsnList(macro + mcPUSH);
        needPush  =  true;
        tailDisp += tailWords;
        if (! isAssembler)
            tailDisp += frameSiz;
        addToInsnList(KMTJ + SP + 14);
        addToInsnList(KUTM + I14 + getValueOrAllocSymtab(-tailDisp));
        addToInsnList(KITA + 14);
    }
    if (isFortrn) {
        addToInsnList(KNTR+2);
        insnList->tail->mode  =  4;
    }
    if (isIndir) {
        /* A directly addressable pointer -- one whose whole insnList is a
           deferred address -- is reached by WTC, which puts the entry address
           in C for the VJM and touches neither the accumulator, where
           argument 1 is sitting, nor the mode register.
           Any other pointer has to be loaded, and the load wants the
           accumulator, so it is marshalled like one more argument: the push
           takes argument 1 out of the accumulator and fuses with the load
           that follows into a single XTS.  STI then does both halves of the
           call at once, taking the address into M14 and popping argument 1
           back.  With no arguments there is nothing to pop and ATI serves. */
        l5inl20z  =  insnList;
        genFullExpr(calleeExp);
        if (insnList->head || insnList->ilm != ilLVAL ||
            insnList->st != stWORD || insnList->addrmd == 15) {
            prepLoad();
            if (needPush)
                prependToInsnList(macro + mcPUSH);
            tailMacro  =  mcACC2ADDR - needPush;
        } else {
            curInsnTemplate  =  KWTC;
            prepLoad();
            curInsnTemplate  =  KXTA;
            tailMacro  =  0;
        }
        if (l5inl20z->tail) {
            l5inl20z->tail->next  =  insnList->head;
            insnList->head  =  l5inl20z->head;
        }
        insnList->regsused  =  insnList->regsused | l5inl20z->regsused;
        if (tailMacro)
            addToInsnList(macro + tailMacro);
        addToInsnList(KVJM+I13);
    } else {
        addToInsnList(allocGlobalObject(l5idr5z) + (KVJM+I13));
    }
    insnList->tail->mode  =  2;
    if (tailWords) {
        /* The callee's exit puts the stack back to its own frame, which
           begins above the tail, so the tail is still there.  Drop it here:
           a call that leaks would be invisible at statement level and would
           corrupt the argument block of any call it sits inside. */
        addToInsnList(KUTM + SP + getValueOrAllocSymtab(-tailWords));
    }
    /* Nothing follows the call: the display registers a callee disturbs are
       the ones its own entry helper saved in its frame, and C/E puts them
       back.  A frameless routine has no helper to do that, which is why one
       that uses a display register does not get to stay frameless. */
    if (! isAssembler &&
        (isIndir || [20, 21] & calleeFl)) {
        addToInsnList(KVTM+040074001);
    }
    /* Registers 2..6 are callee-saved, so a pinned base in one of them already
       survives the call.  Reload only a spilled base in a caller-clobbered
       fallback register (normally M14).  WTC takes the saved address from the
       slot into C, VTM then lands it in the register; neither touches the
       accumulator, which may hold a function result. */
    l5exp2z  =  pinList;
    while (l5exp2z) {
        if (l5exp2z->typ.p.psize &&
            6 < l5exp2z->typ.p.pad &&
            E48 >> l5exp2z->typ.p.pad & calleeFl) {
            addInsnAndOffset(curFrameRegTemplate + KWTC, l5exp2z->typ.p.psize - 1);
            addToInsnList(KVTM + indexreg[l5exp2z->typ.p.pad]);
        }
        l5exp2z  =  l5exp2z->expr1;
    }
    usedRegs  =  (usedRegs | (calleeFl & ~calleeSaved)) & [1:15];
    if (isFortrn) {
        addToInsnList(checkFortran ? getHelperProc(26) /* "P/FM" */
                                   : KNTR+7);
        insnList->tail->mode  =  2;
    }
    if (! isProc) {
        insnList->typ  =  resTyp;
        insnList->regsused  =  insnList->regsused | E48;
        insnList->ilm  =  ilRVAL;
        liveRegs &= ~(calleeFl & ~calleeSaved);
    }
} /* genEntry */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void startInsnList() {
    insnList = malloc(sizeof(insnltyp));
    insnList->tail  =  NULL;
    insnList->head  =  NULL;
    insnList->typ  =  exprToGen->typ;
    insnList->regsused  =  0U;
    insnList->ilm  =  ilCONST;
    insnList->payload  =  exprToGen->num1;
    insnList->addrmd  =  exprToGen->num2;
    insnList->st  =  stWORD;
} /* startInsnList */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genCopy() {
int size;
insnltyp *lhsIns, *rhsIns;
    size  =  typeSize(insnList->typ);
    if (size == 1) {
        lhsIns  =  insnList;
        insnList  =  otherIns;
        prepLoad();
        rhsIns  =  insnList;
        insnList  =  lhsIns;
        prepStore();
        lhsIns  =  insnList;
        if (rhsIns->tail == NULL) {
            rhsIns->head  =  lhsIns->head;
        } else {
            rhsIns->tail->next  =  lhsIns->head;
        }
        if (lhsIns->tail)
            rhsIns->tail  =  lhsIns->tail;
        rhsIns->regsused  =  rhsIns->regsused | lhsIns->regsused | E48;
        rhsIns->ilm  =  ilRVAL;
        insnList  =  rhsIns;
    } else {
        prepMultiWord();
        genOneOp();
        --size;
        formAndAlign(KVTM+I13 + getValueOrAllocSymtab(-size));
        work  =  moduleOffset;
        form2Insn(KUTC+I14 + size, KXTA+I13);
        form3Insn(KUTC+I12 + size, KATX+I13,
                  KVLM+I13 + work);
        usedRegs |= [12:14];
    }
} /* genCopy */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genComparison() {
/* Which comparison, as its distance from NEOP: the pair for one relation is
   adjacent, so the low bit is the negated sense and comes off into negate. */
int cmpIdx;
kind curVarKind;
int negate;
int mode, size;
    cmpIdx  =  curOP - NEOP;
    negate  =  cmpIdx & 1U;
    cmpIdx -= negate;
    l2typ13z  =  insnList->typ;
    curVarKind  =  l2typ13z.p.pk;
    size  =  typeSize(l2typ13z);
    if (l2typ13z == realType) {
        work  =  1;
    } else if (curVarKind == kindScalar)
        work  =  3;
    else {
        work  =  4;
    }
    if (size != 1) {
        prepMultiWord();
        addInsnAndOffset(KVTM+I11, 1 - size);
        work = cmpIdx == 4 ? 26 : 23 + (cmpIdx >> 1);
        addToInsnList(getHelperProc(work)); /* P/EQ */
        insnList->ilm  =  ilRVAL;
        negate  =  ! negate;
    } else if (cmpIdx == 0) {
        nextInsn  =  KAEX;
        tryFlip(true);
L7504:      insnList->ilm  =  ilCOND;
        insnList->payload  =  0;
    } else {
        switch (work) {
        case 1:
            mode  =  3;
L7514:          nextInsn  =  KSUB;
            tryFlip(false);
            insnList->tail->mode  =  mode;
            if (mode == 3) {
                addToInsnList(KNTR+023);
                insnList->tail->mode  =  2;
            }
            goto L7504;
        case 3:
            mode  =  1;
            goto L7514;
        case 4:
            nextInsn  =  KARX;
            prepLoad();
            addToInsnList(KAEX+ALLONES);
            tryFlip(true);
            goto L7504;
        } /* switch */
    }
    insnList->regsused  =  insnList->regsused & (~[16]);
    if (negate)
         negateCond();
} /* genComparison */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genCondOp() {
/*
 * Code generation for the ternary conditional operator
 *      exprToGen = CONDOP{cond, ALTERN{then, else}}
 *
 * Strategy: build a single deferred ilRVAL insnList that, when committed by
 * the surrounding expression via genOneOp, emits the full branching
 * sequence and leaves the result in the accumulator. Both branches simply
 * leave their value in ACC -- no PUSH/POP is needed inside genCondOp,
 * because the framework (tryFlip / genCopy / genEntry) takes care of
 * spilling ACC to the hardware stack only when the surrounding expression
 * actually contends for reg 0.
 *
 * The emitted layout is:
 *
 *      <cond chain>             ; sets ACC, leaving sign per direction
 *      UZA/U1A elseLab          ; jump to elseLab on FALSE
 *      <then chain>             ; ACC := then-value
 *      UJ   endLab
 *  elseLab:
 *      <else chain>             ; ACC := else-value
 *  endLab:
 *                               ; result of CONDOP is in ACC
 *
 * Building this deferred chain reuses the same macro machinery that
 * genBoolAnd / genComparison use to express forward jumps and labels:
 *
 *   macro + 0, label           -> UZA forward jump to label (jump on FALSE)
 *   macro + 1, label           -> U1A forward jump to label (jump on TRUE-side
 *                                 of an inverted/negated condition)
 *   macro + 2, hi*010000 + lo  -> UJ to label `hi` AND define label `lo` here
 *   macro + 21, label          -> define label here (no jump)
 *
 * Labels are simply unique integers drawn from condLabCnt. When genOneOp later
 * processes a macro+0/1/2 entry, addJumpInsn looks up an existing label
 * record by `mode = label`; if found (findLabel), the new jump is linked into
 * that record's chain in the object buffer, so several jumps to the same
 * logical label share one record and are all patched together by fixup.
 */
eptr altExpr;
int elseLab, endLab;
insnltyp *condChain, *thenChain;
    altExpr = exprToGen->expr2;
    /* Allocate two unique forward-label identifiers from the global
       counter used by genBoolAnd. */
    elseLab = condLabCnt;
    ++condLabCnt;
    endLab = condLabCnt;
    ++condLabCnt;

    /* Build the condition sub-chain: <cond chain> + branch-to-elseLab-if-false.
       We set forValue := false before generating the condition so that
       genComparison / genBoolAnd leave the chain in ilCOND form (deferred
       conditional), avoiding the wasteful mcCOND2INT sequence that would
       first materialize a 0/1 in ACC and then re-test it.
       Direction = (regsused >> (47-16)) & 1 follows the convention used by
       formOperator(BRANCH): when set, the embedded condition is "negated"
       and a true-condition path is selected by U1A (macro+1); otherwise
       UZA (macro+0) jumps when ACC>=0 (sign clear), i.e., on FALSE. */
    forValue = false;
    curExpr = exprToGen->expr1;
    genFullExpr(curExpr);
    if (insnList->ilm == ilCOND && insnList->payload) {
        /* Compound boolean (a && b, a || b, ...): the chain already has an
           embedded forward jump to label `payload`. */
        if ((insnList->regsused >> (47-16)) & 1)
            /* Set: an OR, which genBoolAnd built by De Morgan and negateCond
               flipped, so the embedded jumps fire on TRUE.  Send the
               fall-through to elseLab and define payload here, where the
               then-branch starts, so those jumps land on it. */
            addInsnAndOffset(macro + 2,
                             (elseLab << 12) + insnList->payload);
        else
            /* Clear: an AND, whose short-circuit jumps already fire on
               FALSE, which is where elseLab wants them.  Adopt their label
               and emit nothing. */
            elseLab = insnList->payload;
    } else {
        /* Simple ilCOND (single comparison, payload=0), or ilLVAL/ilRVAL/ilCONST:
           prepLoad with forValue=false is a no-op for ilCOND, and materializes
           an lvalue/constant to ACC otherwise. Then emit a single deferred
           UZA/U1A to elseLab. */
        prepLoad();
        addInsnAndOffset(macro +
            ((insnList->regsused >> (47-16)) & 1), elseLab);
    }
    forValue = true;
    condChain = insnList;

    /* Build the then-branch sub-chain:
           <then chain> + "UJ endLab; elseLab:"
       prepLoad materializes the then-value into ACC. The combined macro+2
       entry then does two things at commit time: it emits the unconditional
       jump to endLab (so the then-path skips over the else-path), and it
       defines elseLab at the current emit position so the earlier UZA/U1A
       forward jump can be patched here. */
    curExpr = altExpr->expr1;
    genFullExpr(curExpr);
    prepLoad();
    addInsnAndOffset(macro + 2, (endLab << 12) + elseLab);
    thenChain = insnList;

    /* Build the else-branch sub-chain:
           <else chain> + "endLab:"
       prepLoad materializes the else-value into ACC. macro+21 is a pure
       label-definition marker: it requires findLabel to find an existing
       label record for endLab (the macro+2 above already created it via
       addJumpInsn) and patches the UJ jump to land here. */
    curExpr = altExpr->expr2;
    genFullExpr(curExpr);
    prepLoad();
    addInsnAndOffset(macro + 21, endLab);

    /* Concatenate the three sub-chains head-to-tail in evaluation order:
       cond -> then -> else. After this, condChain is the single chain
       that represents the complete deferred ternary computation. */
    condChain->tail->next = thenChain->head;
    condChain->tail = thenChain->tail;
    condChain->tail->next = insnList->head;
    condChain->tail = insnList->tail;

    /* Union the regsused sets of all three sub-chains so the surrounding
       expression sees the full set of registers the ternary touches, and add
       reg 0 (ACC) since the result lives there.  Bit 16 is the
       condition-polarity flag, and each sub-chain's own is spent by
       the time it is folded in -- the condition's by the UZA/U1A selected
       above, an arm's by the prepLoad that materialized its value.  Carrying
       one into the composite would tell the consumer that this ilRVAL is a
       negated condition, and prepLoad or formOperator(BRANCH) would invert
       the ternary's value.  genBoolAnd and genComparison mask it off here for
       the same reason. */
    condChain->regsused = (condChain->regsused | thenChain->regsused
                          | insnList->regsused | [0]) & (~[16]);

    /* Finalize the result insnList as an ilRVAL (rvalue-in-ACC). Both branches
       leave their value in ACC and the chains rejoin at endLab, so the
       composite chain already meets the ilRVAL contract without any extra
       PUSH/POP. tryFlip / genCopy / genEntry integrate this value into
       the surrounding expression exactly like any other ilRVAL chain, spilling
       ACC to the hardware stack only when actually needed. */
    insnList = condChain;
    insnList->typ = exprToGen->typ;
    insnList->ilm = ilRVAL;
    insnList->st = stWORD;
} /* genCondOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCheapLval(eptr e) {
/* An lvalue whose address is reached without touching the accumulator and
   without side effects: a plain variable, a dereference of one, a field of
   such an lvalue, or an element at a variable index.  genRMWAssign may walk
   one of these twice instead of materializing its address on the stack.
   The element case does not look at the base for the same reason the field
   case does not add code: reaching it only adjusts the displacement.
   A pinned base (NOOP) is the cheapest of all -- genFullExpr answers it with
   a bare descriptor, and at most a WTC/VTM reload for a base sharing the
   fallback register, neither of which touches the accumulator -- but only on
   that path: the arm that finds the register no longer live rebuilds the
   address from expr2, which does cost instructions and the accumulator. */
int idxOffset;
    switch (e->op) {
    case GETVAR:   return true;
    case DEREF:    return e->expr1->op == GETVAR;
    case GETFIELD: return isCheapLval(e->expr1);
    case GETELT:   return stripIdx(e->expr2, &idxOffset)->op == GETVAR;
    case NOOP:     return (e->typ.p.psize != 0) | has(liveRegs, e->typ.p.pad);
    default:       return false;
    }
} /* isCheapLval */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genRMWAssign() {
/* Code-gen for RMWASSIGN(lhs, inner-op(rhs, NULL)): a read-modify-write
   assignment (compound op-assign such as `lhs += rhs`, or pre-++/--).
   The naked AST lowering ASSIGNOP(lhs, op(lhs, rhs)) evaluates `lhs`
   twice, which is wrong when computing its address has side effects
   (or even just clobbers ACC).
   Strategy: compute lhs's address exactly once (walking the lvalue
   subtree only once), push that address onto the BESM-6 stack TWICE,
   then synthesise ASSIGNOP(stklval, op(stklval, rhs)) where stklval
   is a sentinel STKLVAL node.  Each visit to STKLVAL (one for the
   inner read, one for the outer write) emits `WTC SP' to pop one copy
   of the address into the working tag, after which prepLoad/prepStore
   append `XTA 0' / `ATX 0' to do the actual transfer.  Pushing twice
   (rather than peeking SP-1) works around the BESM-6 not having a
   non-popping SP-relative read.
   For trivial lvalues that don't touch ACC (see isCheapLval) the
   synthetic AST may share the original lvalue node directly -- re-
   walking is cheap and side-effect free, and skips the push/pop
   traffic entirely. */
eptr innerNode, rhsExpr, lhsExpr, rmwLhs;
eptr synthOp, synthAsn;
operator innerOp;
    lhsExpr = exprToGen->expr1;
    innerNode = exprToGen->expr2;
    innerOp = innerNode->op;
    rhsExpr = innerNode->expr1;

    if (!isCheapLval(lhsExpr)) {
        rhsMode = false;
        genFullExpr(lhsExpr);
        rhsMode = true;
        if (insnList->st != stWORD) {
            error(errVarTooComplex);
            return;
        }
        setAddrTo(14);
        addToInsnList(KITA + 14);
        addToInsnList(macro + mcPUSH);
        addToInsnList(KITA + 14);
        addToInsnList(macro + mcPUSH);
        genOneOp();
        insnList = NULL;
        rmwLhs  =  mkExpr(STKLVAL, lhsExpr->typ, NULL, NULL);
    } else {
        rmwLhs = lhsExpr;
    }

    synthOp = mkExpr(innerOp, innerNode->typ, rmwLhs, rhsExpr);
    synthAsn = mkExpr(ASSIGNOP, exprToGen->typ, rmwLhs, synthOp);

    genFullExpr(synthAsn);
} /* genRMWAssign */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    if (exprToGen == NULL)
        return;
    if (exprToGen->op == DEREF && isCharPtr(exprToGen->expr1->typ))
        exprToGen = flatMemAt(exprToGen->expr1);
L7567:
    curOP  =  exprToGen->op;
    if (curOP == CONDOP) {
        genCondOp();
        return;
    }
    if (curOP == RMWASSIGN) {
        genRMWAssign();
        return;
    }
    if (curOP == COMMAOP) {
        /* What the comma answers is the right operand; the left one is kept
           for its effects.  Those go in front of the right operand's own
           instructions, in the list the caller will emit -- not out through
           genOneOp, which would put them where the tree is being built rather
           than where its value is wanted, and so outside the arm of a ternary
           or the short circuit of && and ||. */
        genFullExpr(exprToGen->expr1);
        otherIns  =  insnList;
        genFullExpr(exprToGen->expr2);
        if (otherIns->tail) {
            /* A constant answers with a value and no instructions at all, and
               a consumer may fold it without ever emitting the list; load it
               first, so that the effects on the left cannot go with it. */
            if (insnList->ilm == ilCONST)
                prepLoad();
            if (insnList->tail == NULL) {
                insnList->head  =  otherIns->head;
                insnList->tail  =  otherIns->tail;
            } else {
                otherIns->tail->next  =  insnList->head;
                insnList->head  =  otherIns->head;
            }
            insnList->regsused  =  insnList->regsused | otherIns->regsused;
        }
        return;
    }
    if (curOP < GETELT) {
        genFullExpr(exprToGen->expr2);
        otherIns  =  insnList;
        if (curOP == ASSIGNOP)
            rhsMode  =  false;
        genFullExpr(exprToGen->expr1);
        if (curOP == ASSIGNOP)
            rhsMode  =  true;
        if (insnList->ilm == ilCONST) {
            arg1Const  =  true;
            arg1Val.i  =  insnList->payload;
        } else
            arg1Const  =  false;
        if (otherIns->ilm == ilCONST) {
            arg2Const  =  true;
            arg2Val.i  =  otherIns->payload;
        } else
            arg2Const  =  false;
        if (has([NEOP, EQOP, LTOP, GEOP, GTOP, LEOP], curOP)) {
            genComparison();
        } else {
            /* a foldable op with two constant operands is already folded to
               GETENUM at construction (mkExprFold), so only the non-constant
               codegen path remains here. */
                insnMode  =  opToMode[curOP];
                nextInsn  =  opToInsn[curOP];
                switch (opFlags[curOP]) {
                case opfCOMM:
                    tryFlip(has([MUL,PLUSOP,SETOR,SETAND,INTPLUS,IMULOP], curOP));
                    break;
                case opfHELP:
                    genHelper();
                    break;
                case opfASSN:
                    genCopy();
                    if (insnList == NULL)
                        return;
                    { register insnltyp *il = insnList;
                        il->typ  =  exprToGen->typ;
                        il->regsused  =  il->regsused | E48;
                        il->ilm  =  ilRVAL;
                        il->st  =  stWORD;
                    }
                    return;
                case opfAND:
                    genBoolAnd();
                    return;
                case opfOR:
                    negateCond();
                    saved  =  insnList;
                    insnList  =  otherIns;
                    negateCond();
                    otherIns  =  insnList;
                    insnList  =  saved;
                    genBoolAnd();
                    negateCond();
                    return;
                /* Division by a constant, inline.  The reciprocal is a real
                   in [0.5,1) and KMUL keeps the high half of the product,
                   which is a shift by 40; ASN takes the rest of it.  No sign
                   arises anywhere, because only an unsigned operand and a
                   divisor above zero are admitted here -- either operand
                   unsigned asks for this, the way either asks IMULOP for the
                   unsigned multiply, and everything else takes C/DI or C/MD.

                   The signed sequences cost five instructions against these
                   two, which is too much to spend inline; a signed divide
                   goes to C/DI instead.  They are written out here because
                   they are what truncation costs if it is ever wanted, and
                   they are also where a negative divisor would belong --
                   there the magnitude would divide and one closing negation
                   would carry the divisor's sign, which is meaningless while
                   the dividend is unsigned.  KMUL's high half is an
                   arithmetic shift and carries the sign, ASN does not, so the
                   residual shift becomes a second multiply by an exact
                   negative power of two, and what it leaves is the floor.
                   Truncation is one step up from that wherever the dividend
                   is negative, and which step depends on whether the
                   reciprocal is exact:

                     |c| = 2^k   the reciprocal is exact, so the floor is a
                                 floor and the dividend is biased by |c|-1
                                 where it is negative.  The bias also keeps it
                                 off the range minimum, whose magnitude has
                                 nowhere to go.

                         ATX SP+1 ; MUL 2^-40 ; AAX |c|-1 ; ADD SP+1 ; MUL 2^-k

                     otherwise   the reciprocal is rounded up, and that
                                 overshoot drops a negative quotient exactly
                                 one below its truncation, so the sign is
                                 added back at the end.  The floor is negative
                                 exactly where the dividend was, so it is its
                                 own sign mask and the dividend never has to
                                 be kept.

                         MUL magic ; MUL 2^-k ; ATX SP+1 ; MUL 2^-40 ; RSUB SP+1

                   The sign mask either shape wants is one more multiply:
                   2^-40 keeps only the sign bit, giving 0 or -1.  Nothing in
                   either branches, and the word above the stack top is the
                   only scratch. */
                case opfMOD:
                case opfDIV:
                    /* recip says which of three things the divisor is: 0 for
                       one not to be divided by inline, 1 for a power of two,
                       where the shift alone divides and no reciprocal is
                       wanted, and otherwise the mantissa of 1.0/c, which is
                       ceil(2^(40+k)/c) with k the index of c's top bit.  That
                       mantissa is never below 2^39, so it cannot be taken for
                       either of the other two.

                       The division rounds either way and the product says
                       which: below 1.0 the mantissa came back short and is
                       stepped up to the ceiling.  That is the one place the
                       two compilers meet by different routes, base.cc
                       dividing in a host double and this on the machine.

                       Rounding up is what makes the reciprocal usable and
                       also what limits it: the mantissa overshoots
                       2^(40+k)/c by some e, and the quotient it yields is one
                       too high once a*e reaches 2^(40+k).  A dividend stops
                       below 2^40, so the sequence holds exactly while
                       e <= 2^k: the largest product it can then face is
                       (2^40 - 1) * 2^k, which is 2^k short of reaching.
                       Nothing reconstructs e -- m*c is 2^(40+k) + e and 40+k
                       is at least 41, so the low half of that product is e
                       alone, which is the half an unsigned multiply keeps. */
                    recip  =  0;
                    if (arg2Const && arg2Val.i > 0 &&
                        (exprToGen->expr1->typ == uintType ||
                         exprToGen->expr2->typ == uintType)) {
                        if (card(arg2Val.i) == 1)
                            recip  =  1;
                        else {
                            curVal.r  =  1.0 / arg2Val.i;
                            recip  =  curVal.r * arg2Val.i < 1.0;
                            curVal.i  =  (curVal.i & [7..47]) + recip;
                            recip  =  0;
                            if ((unsigned)curVal.i * (unsigned)arg2Val.i <=
                                1 << (47 - minel(arg2Val.i)))
                                recip  =  curVal.i;
                        }
                    }
                    if (recip == 0) {
                        genHelper();
                        break;
                    }
                    prepLoad();
                    insnMode  =  1;
                    if (curOP == IMODOP) {
                        if (recip == 1) {
                            /* what is left over a power of two is a mask
                               away, and wants no quotient at all */
                            curVal.i  =  arg2Val.i - 1;
                            addToInsnList(KAAX+I8 +getFCSToffset());
                            insnMode  =  0;
                            break;
                        }
                        /* the dividend is wanted again once the quotient is
                           in, so it goes on the stack first */
                        addToInsnList(macro + mcPUSH);
                    }
                    if (recip != 1) {
                        curVal.i  =  recip | E48;
                        addToInsnList(KMUL+I8 + getFCSToffset());
                    }
                    addToInsnList(ASN64+47-minel(arg2Val.i));
                    if (curOP == IMODOP) {
                        /* what is left is the dividend less the quotient
                           times the divisor */
                        insnList->tail->mode  =  1;
                        curVal.i  =  arg2Val.i & (~[1, 3]) | [0];
                        addToInsnList(KMUL+I8 + getFCSToffset());
                        addToInsnList(KYTA+64);
                        addToInsnList(KRSUB+SP);
                    }
                    break;
                case opfMULMSK:
                    if (arg1Const) {
                        insnList->payload  =  (arg1Val.i | [0]) & (~[1, 3]);
                    } else {
                        if (arg2Const) {
                            otherIns->payload  =  (arg2Val.i | [0]) & (~[1, 3]);
                        } else {
                            prepLoad();
                            addToInsnList(KAEX+MSB);
                        }
                    }
                    tryFlip(true);
                    insnList->tail->mode  =  1;
                    /* The unsigned product takes what the m- mode takes:
                       the low half of it, with no P/MI fixup. */
                    addToInsnList(exprToGen->typ == uintType
                                  ? KYTA + 64 : macro + mcMULTI);
                    break;
                case opfSHIFT:
                    if (!arg2Const) {
                        genHelper();
                    } else {
                        prepLoad();
                        addToInsnList(curOP == SHRIGHT ?
                                      ASN64+arg2Val.i :
                                      ASN64-arg2Val.i);
                    }
                    break;
                } /* switch 10122 */
L10122:         insnList->tail->mode  =  insnMode;
        }
    } else if (DEREF >= curOP) {
        if (curOP == GETVAR) {
            insnList = malloc(sizeof(insnltyp));
            curIdRec  =  exprToGen->id1;
            { register insnltyp *il = insnList;
                il->tail  =  NULL;
                il->head  =  NULL;
                il->regsused  =  0U;
                il->ilm  =  ilLVAL;
                /* A static's offset field still names its lexical scope for
                   lookDef/exitScope; its address is based on M6, the module's
                   private common. */
                il->payload  =  curIdRec->pck.p.cl == STATICID ?
                               moduleRegTemplate : curIdRec->pck.p.offset;
                il->disp  =  curIdRec->high;
                il->st  =  stWORD;
                il->addrmd  =  18;
            }
            if (curIdRec->pck.p.cl == ROUTINEID) {
                insnList->disp  =  3;
                insnList->payload  =  (insnList->payload + frameRegTemplate);
            } else if (insnList->disp >= 074000) {
                addToInsnList(KUTC + insnList->disp);
                insnList->disp  =  0;
                insnList->addrmd  =  17;
                insnList->payload  =  0;
            }
        } else if (curOP == GETFIELD) {
            genFullExpr(exprToGen->expr1);
            curIdRec  =  exprToGen->id2;
            { register insnltyp *il = insnList;
                il->disp += curIdRec->pck.p.offset;
                if (curIdRec->fpk.p.pckfield) {
                    switch (il->st) {
                    case stWORD: {
                        il->shift  =  curIdRec->fpk.p.shift;
                        break;
                    }
                    case stSLICE: {
                        il->shift += curIdRec->fpk.p.shift;
                        if (! curIdRec->uptype.rep->lsbord)
                            il->shift  =  il->shift +
                                       typeBits(curIdRec->uptype) - 48;
                        break;
                    }
                    case stPACKED:
                        if (! rhsMode)
                            error(errUsingVarAfterIndexingPackedArray);
                        else {
                            startLVal();
                            insnList->shift  =  curIdRec->fpk.p.shift;
                        }
                    }
                    insnList->width  =  curIdRec->fpk.p.width;
                    insnList->st  =  stSLICE;
                    insnList->regsused  =  insnList->regsused | E48;
                }
            }
        } else if (curOP == GETELT)
            genGetElt();
        else if (curOP == DEREF) {
            genFullExpr(exprToGen->expr1);
            genDeref();
        } else if (curOP == GETENUM)
            startInsnList();
    } else if (curOP == STKLVAL) {
        /* Synthetic lvalue produced by genRMWAssign.  The address
           of the real lvalue has been pushed onto the BESM-6 stack
           TWICE by the RMW prologue, once for the rvalue read and
           once for the lvalue write.  Each STKLVAL evaluation pops
           one copy via `WTC SP' into the working tag M14, and the
           standard prepLoad/prepStore appends `XTA 0' (load) or
           `ATX 0' (store) so that the memory transfer uses that
           popped address.  Pushing twice keeps stack accounting
           trivial (each visit pops exactly one slot) and sidesteps
           BESM-6's lack of true non-popping SP-relative addressing
           for `WTC'. */
        insnList = malloc(sizeof(insnltyp));
        { register insnltyp *il = insnList;
            il->tail = NULL;
            il->head = NULL;
            il->typ = exprToGen->typ;
            il->regsused = [];
            il->ilm = ilLVAL;
            il->st = stWORD;
            il->addrmd = 16;
            il->payload = 0;
            il->disp = 0;
            il->width = 0;
            il->shift = 0;
        }
        addToInsnList(KWTC + SP);
    } else if (curOP == PROCADDR) {
        /* A function designator: its entry address as a value.  VTM lands
           the address the loader relocates into the instruction in the tag
           register, ITA turns it into an integer word. */
        insnList = malloc(sizeof(insnltyp));
        { register insnltyp *il = insnList;
            il->tail = NULL;
            il->head = NULL;
            il->typ = exprToGen->typ;
            il->regsused = E48;
            il->ilm = ilRVAL;
            il->st = stWORD;
            il->addrmd = 18;
            il->payload = 0;
            il->disp = 0;
            il->width = 0;
            il->shift = 0;
        }
        addToInsnList(allocGlobalObject(exprToGen->id2) + (KVTM+I14));
        addToInsnList(KITA+14);
    } else if (curOP == ADDROF) {
        /* An lvalue's address as a value: setAddrTo lands the address in the
           tag register and ITA turns it into an integer word, as just above
           for a routine's entry. */
        genFullExpr(exprToGen->expr1);
        if (insnList->ilm == ilCONST &&
           exprToGen->expr1->typ.p.pk != kindArray)
            error(201);
        setAddrTo(14);
        addToInsnList(KITA+14);
        { register insnltyp *il = insnList;
            il->ilm  =  ilRVAL;
            il->regsused |= E48;
        }
    } else if (curOP == ALNUM || curOP == INDCALL)
        genEntry();
    else if (has([TOREAL..BITNEGOP], curOP)) {
        genFullExpr(exprToGen->expr1);
        /* a unary op with a constant operand is already folded at construction
           (mkUnaryFold/castToReal), so there is no ilCONST case here. */
        if (curOP == NOTOP) {
            negateCond();
        } else {
            prepLoad();
            if (curOP == TOREAL) {
                addToInsnList(KAOX+ZERO);
                addToInsnList(KAVX);
                insnMode  =  3;
                goto L10122;
            } else if (curOP == TOINT) {
                /* Real to integer truncates toward zero, in C/TR (libc);
                   the helper returns with the machine in integer mode. */
                insnMode  =  2;
                addToInsnList(getHelperProc(15)); /* "C/TR" */
                goto L10122;
            } else if (curOP == TONAME) {
                /* The ordinal indexes the name table, which is laid into
                   the constant pool here, on its first use. */
                dumpEnumNames(exprToGen->expr1->typ);
                addToInsnList(KATI+14);
                addToInsnList(KUTC+I14);
                addToInsnList(KXTA+I8 + exprToGen->expr1->typ.rep->start);
                insnMode = 1;
                goto L10122;
            } else if (curOP == BITNEGOP) {
                addToInsnList(KAEX+ALLONES);
                insnMode = 1;
                goto L10122;
             } else {
                addToInsnList(KAVX+ALLONES);
                insnMode  =  (curOP == RNEGOP) ? 3 : 1;
                goto L10122;
            }
        }
    } else if (curOP == STANDPROC) {
        genFullExpr(exprToGen->expr1);
        work  =  exprToGen->num2;
        if (work == fnMALLOC)
            ++heapCallsCnt;
        if (insnList->ilm == ilCONST) {
            arg1Const  =  true;
            arg1Val.i  =  insnList->payload;
        } else
            arg1Const  =  false;
        arg2Const  =  (insnList->typ == realType);
        if (arg1Const) {
            switch (work) {
            case fnABS:   arg1Val.r  =  abs(arg1Val.r); break;
            case fnCARD:  arg1Val.i  =  card(arg1Val.i); break;
            case fnMINEL: arg1Val.i  =  minel(arg1Val.i); break;
            case fnABSI:  arg1Val.i  =  abs(arg1Val.i); break;
            case fnMALLOC:
                addToInsnList(KVTM+I14 + getValueOrAllocSymtab(arg1Val.i));
                addToInsnList(getHelperProc(13)); /*"C/NW"*/
                { register insnltyp *il = insnList;
                    il->ilm  =  ilRVAL;
                    il->regsused |= E48;
                    il->typ = exprToGen->typ;
                };
                return;
            }
            insnList->payload  =  arg1Val.i;
        } else {
            prepLoad();
            if (work == fnCARD) {
                insnMode  =  0;
            } else if (work == fnABS)
                insnMode  =  3;
            else {
                insnMode  =  1;
            }
            addToInsnList(funcInsn[work]);
            goto L10122;
        }
    } else if (curOP == NOOP) {
        curVal.i  =  exprToGen->typ.p.pad;
        /* A spilled base has a frame slot to come back from, so it needs no
           liveness test. */
        if (exprToGen->typ.p.psize || has(liveRegs, curVal.i)) {
            insnList = malloc(sizeof(insnltyp));
            { register insnltyp *il = insnList;
                il->typ  =  exprToGen->expr2->typ;
                il->head  =  il->tail  =  NULL;
                il->regsused  =  0U;
                il->ilm  =  ilLVAL;
                il->addrmd  =  18;
                il->payload  =  indexreg[curVal.i];
                il->disp  =  0;
                il->st  =  stWORD;
            }
            /* Registers 2..6 hold one pinned base each -- SETREG takes the
               register out of freeRegs -- so M[pad] still holds this one and
               the descriptor above is the whole story.  Above 6 there is only
               the shared fallback, which every base that ran out of registers
               is given: the frame slot is what holds this one, and it has to
               come back before each use, not just after a call.  WTC then VTM
               leave the accumulator alone. */
            if (6 < curVal.i) {
                addInsnAndOffset(curFrameRegTemplate + KWTC,
                                 exprToGen->typ.p.psize - 1);
                addToInsnList(KVTM + indexreg[curVal.i]);
            }
        } else {
            exprToGen->typ.p.pad  =  14;
            exprToGen  =  exprToGen->expr2;
            goto L7567;
        }
        return;
    } else {
        error(220);
    }
    insnList->typ  =  exprToGen->typ;
} /* genFullExpr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formOperator(opgen l3arg1z) { /* formOperator */
int l3int2z;
eptr helpExpr;
int direction;
int noTarget;
int l3var10z, l3var11z;
/* How many instructions SETREG's address took. */
int insnCnt;
/* BRANCH's own target: it starts as the one the caller left in jumpTarget and
   is handed back through it, so the two are exchanged rather than shared. */
int ownTarget;
    rhsMode  =  true;
    if (errors && l3arg1z != SETREG || curExpr == NULL)
        return;
//  if (l3arg1z == DOIT)                        /* see dropPostFixup */
//      curExpr = dropPostFixup(curExpr);
    if (l3arg1z != FORMOP)
        genFullExpr(curExpr);
    switch (l3arg1z) {
    case DOIT:
        genOneOp();
        break;
    case SETREG: {
        { register insnltyp *il = insnList;
            insnCnt  =  insnCount();
            helpExpr = malloc(sizeof(expr));
            helpExpr->expr1  =  pinList;
            pinList  =  helpExpr;
            helpExpr->op  =  NOOP;
            /* The entry holds the index register carrying the record address
               in typ.p.pad, and -- when that address was too costly to
               recompute and went to a frame slot -- the slot number plus one
               in typ.p.psize.  genEntry reloads the register from that slot
               after every call that clobbers it, so a spilled entry's
               register is valid throughout the body. */
            helpExpr->typ.p.psize  =  0;
            switch (il->st) {
            case stWORD:
                if (insnCnt == 0) {
                    l3int2z  =  14;
                } else {
                    l3var10z  =  auxRegs & freeRegs;
                    if (l3var10z) {
                        l3int2z  =  minel(l3var10z);
                    } else {
                        l3int2z  =  14;
                    }
                    if (insnCnt != 1) {
                        setAddrTo(l3int2z);
                        addToInsnList(KITA + l3int2z);
                        addInsnAndOffset(curFrameRegTemplate, localSize);
                        genOneOp();
                        helpExpr->typ.p.psize  =  localSize + 1;
                        ++localSize;
                        if (sizeCount < localSize)
                            sizeCount  =  localSize;
                    } else if (l3int2z != 14) {
                        setAddrTo(l3int2z);
                        genOneOp();
                    }
                    l3var11z  =  (E48 >> l3int2z) & (~[14]);
                    usedRegs &= ~l3var11z;
                    freeRegs &= ~l3var11z;
                    liveRegs |= l3var11z;
                }
                curVal.i  =  l3int2z;
                helpExpr->typ.p.pad  =  l3int2z;
                break;
            case stSLICE:
                curVal.i  =  14;
                helpExpr->typ.p.pad  =  14;
                break;
            case stPACKED:
                error(errVarTooComplex);
            } /* switch */
        } /* register block */
        helpExpr->expr2  =  curExpr;
        break;
    } /* SETREG */
    case STORE:
        prepStore();
        genOneOp();
        break;
    case FORMOP:
        curInsnTemplate  =  curVal.i;
        formOperator(LOAD);
        curInsnTemplate  =  KXTA;
        break;
    case SETREG12:
        /* A bit slice has no address of its own to put in a register. */
        if (insnList->st != stWORD)
            error(errVarTooComplex);
        setAddrTo(12);
        genOneOp();
        break;
    case LOAD:
        prepLoad();
        genOneOp();
        break;
    case BRANCH:
        { register insnltyp *il = insnList;
            noTarget  =  jumpTarget == 0;
            ownTarget  =  jumpTarget;
            if (il->ilm == ilCONST) {
                if (il->payload) {
                    jumpTarget  =  0;
                } else {
                    if (noTarget) {
                        formJump(&jumpTarget);
                    } else {
                        form1Insn(KUJ + jumpTarget);
                    }
                }
            } else {
                /* GETELT..ALNUM is the set whose value reaches the
                   accumulator through a load, so omega already means "is it
                   zero"; anything else needs an AEX to set it, since the omega
                   standing after arithmetic is a sign test.  Look through
                   NOTOP first: a do-while wraps its condition in one to branch
                   back on true, and NOTOP only flips the polarity bit -- what
                   the accumulator holds is decided by what is under it. */
                if (! omegaIsZeroTest(curExpr))
                    addToInsnList(KAEX);
                direction  =  (insnList->regsused >> (47-16)) & 1;
                if (insnList->ilm == ilCOND &&
                    insnList->payload) {
                    genOneOp();
                    if (direction) {
                        if (noTarget)
                            formJump(&ownTarget);
                        else
                            form1Insn(KUJ + ownTarget);
                        fixup(0, jumpTarget);
                        jumpTarget  =  ownTarget;
                    } else {
                        if (! noTarget) {
                            if (objHalfIdx & 1)
                                padToLeft();
                            fixup(ownTarget, jumpTarget);
                        }
                    }
                } else {
                    if (insnList->ilm == ilLVAL) {
                        forValue  =  false;
                        prepLoad();
                        forValue  =  true;
                        /* This load is what sets the omega the jump below
                           reads, so the peephole must not drop it as a repeat
                           of the store before it.  The tail is the right
                           instruction in either mode: the load itself for a
                           whole word, and genSliceExtract's closing AAX for a
                           slice, which is logical and sets omega correctly
                           anyway. */
                        insnList->tail->mode |= mdNoElide;
                    }
                    genOneOp();
                    nextInsn  =  direction ? KU1A : KUZA;
                    if (noTarget) {
                        jumpType  =  nextInsn;
                        formJump(&ownTarget);
                        jumpType  =  KUJ;
                        jumpTarget  =  ownTarget;
                    } else {
                        form1Insn(nextInsn + ownTarget);
                    }
                }
            }
            break;
        } /* BRANCH */
    } /* switch */
} /* formOperator */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// The shared declarator parser below constructs and consumes array
// sizes, and a type nested inside a function is only visible within
// that function's own scope in this codebase's Pascal-style nesting --
// so rangeRec lives here, at programme's own level, declared before
// parseTypeRef so that parseRecordDecl (nested inside it) can also see
// it.
typedef struct {
            int asize;
} rangeRec;
typedef rangeRec rangeList[20];
// Set by a parameter list around its declarator, and there alone, where
// 'int q[]' is legal because the extent is discarded when the parameter
// becomes a pointer.  nameOptional, set at the same two places, will not do:
// readTypeName sets that as well, and a type name with no extent --
// 'sizeof(int[])' -- is as wrong here as it is in C.
int noExtentOk;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// An array size is a const-expression.  parseArrSz evaluates it with
// constExpr, which parses one expression, const-folds it and leaves the value
// in ceVal / its type in ceTyp.  Both are PROGRAMM-level siblings, constExpr
// defined below beside the expression parser it drives, hence the forward
// declaration -- parseArrSz itself was promoted out of parseTypeRef like
// makeArrayType above so readDeclaratorCore can call it at the same level.
void constExpr();
// SY is on the '[' that opens the size; parseArrSz reads past it itself.  A
// size is a constant expression, so it names ordinary identifiers -- a const,
// an enumerator, a type for sizeof -- and never a record field: the lookup
// goes to lookUse for the whole expression and back to the caller's afterwards,
// which is what lets a size inside a record body reach them at all.  lookup2
// must move with lookupMode, since every inSymbol() resets lookupMode from it.
void parseArrSz(int *asize) {
int savedLookup;
    savedLookup  =  lookup2;
    lookup2  =  lookupMode  =  lookUse;
    inSymbol();
    if (noExtentOk && SY == RBRACK) {
        /* 'int q[]': zero marks the missing extent.  A parameter discards
           the array type for a pointer, and a variable takes its size from
           the initializer that has to follow. */
        *asize = 0;
    } else {
        constExpr();
        if (ceTyp.rep && ceTyp.p.pk == kindScalar && SY == RBRACK) {
            *asize = ceVal;
        } else {
            error(64); /* errIncorrectRangeDefinition */
            *asize = 1;
        }
    }
    lookup2  =  lookupMode  =  savedLookup;
} /* parseArrSz */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Unified C declarator parsing: one declarator grammar shared by
// variable/typedef/struct-field declarations (grouped: one type-spec,
// comma-separated declarator list -- each caller inlines its own
// do-while and registration, since this dialect has no closures/
// procedural values to factor a callback through) and routine
// parameters (individual: each comma-separated item carries its own
// type-spec).
tptr parseTypeRef(int skipTarget);

typedef struct {
            int name;
            int bucket;
            int wasDefined;
            irptr foundRec;
            tptr typ;
            /* The declarator applied nothing but '*' ops, so it is a name a
               routine header may use: 'T name', 'T *name'.  An opFun ('T
               (*fp)(args)') or an opArray ('T a[3]') clears it, and those are
               variables.  Set by parseDclAt. */
            int ptrOnly;
} declarator;

/* One declarator operator.  opFun carries the parameter signature its
   '(...)' spelled out; opArray carries its bounds. */
const int opPtr = 0, opArray = 1, opFun = 2;

typedef struct {
            int opKind;
            sigptr sig;
            /* The routine-type flags the parameter list implies: [23] when it
               ended with '...', none otherwise.  Held per operator because
               one declarator can nest several opFun operators, each with a
               list of its own. */
            int sigFlags;
            rangeRec range;
} dclOp;
typedef dclOp dclOpList[24];

dclOpList declOps;
int declOpCount;
// Shared scratch for the TYPEDEFSY/type-name grouped-declarator loops: each
// iteration fills this in via parseOneDeclarator before registering it,
// for the same reason as declOps/declOpCount above -- the body of a
// do-while cannot declare locals of its own.
declarator curDeclarator;
int formalNames[MAXFORMALS];
int formalBkts[MAXFORMALS];
int formalCnt;
int moreDecls;
// Set by parseParameters and parseSignature around their parseOneDeclarator
// calls: in a parameter list the declarator may be abstract, i.e. carry no
// name at all.  A global, so parseOneDeclarator's other call sites, none of
// which can accept an abstract declarator, stay as they are.
int nameOptional;
// parseSignature's second result, a P2C routine having only one: the flags
// its list implies, for the caller to store in the operator it is filling.
// Written last thing before the return, so a nested signature's value cannot
// outlive the one that encloses it.
int sigVarFlag;
// Scratch for the unified TYPESY/PACKEDSY/STRUCTSY/ENUMSY declaration-
// dispatch loop in programme's own body: same reasoning as above.
int declIsRoutine;

// The parameter list of a function declarator, as a signature: types and
// nothing else, the names (if any) discarded.  Defined below, after
// parseOneDeclarator, which it calls for each parameter.
sigptr parseSignature();

// '*'* ('(' declarator ')' | IDENT) ('[' range ']' | '(' signature ')')*
// Collects pointer/array/function operators into the shared declOps/
// declOpCount while descending; parseOneDeclarator applies them in reverse
// so precedence matches C: 'int *a[10]' is an array of pointers (the array
// op is pushed by the inner IDENT case before the enclosing '*' case
// pushes its own op on the way back out); 'int (*row)[3]' is a pointer
// to an array (the parens make the '*' push before the outer '[3]' does),
// and 'int (*f)(char)' is a pointer to a routine, the '*' likewise pushed
// before the function op.
// The '(' suffix is taken only after a parenthesized declarator, which is
// exactly where C puts it: in 'int f(char)' and 'int *f(char)' the '(' binds
// to the name and declares a routine, whose parameter list belongs to
// parseParameters (it gives the parameters records of their own), while in
// 'int (*f)(char)' it binds to the group and is part of a type.
void readDeclaratorCore(declarator *d) {
rangeRec r;
int wasGroup;
    wasGroup  =  false;
    if (charClass == MUL) {
        inSymbol();
        readDeclaratorCore(d);
        declOps[declOpCount].opKind  =  opPtr;
        ++declOpCount;
    } else if (SY == LPAREN) {
        inSymbol();
        readDeclaratorCore(d);
        checkSymAndRead(RPAREN);
        wasGroup  =  true;
    } else if (SY == IDENT) {
        d->name  =  curIdent;
        d->bucket  =  bucket;
        d->wasDefined  =  isDefined ||
            ((lookupMode == lookDef) &&
             ((curIdent == t' *INPUT*') || (curIdent == t'*OUTPUT*')));
        d->foundRec  =  hashTravPtr;
        inSymbol();
    } else if (nameOptional && has([RPAREN, COMMA, LBRACK], SY)) {
        /* Abstract declarator: a formal parameter's name is optional
           ('int', 'int *', 'int [3]').  curDeclarator is a global, so
           the fields the name would have filled are cleared here; the
           previous declarator's values would otherwise persist. */
        { register declarator *dcl = d;
          dcl->name = dcl->bucket = dcl->wasDefined = 0;
          dcl->foundRec  =  NULL; }
    } else {
        error(errNoIdent);
        d->name  =  0;
    }
    while ((SY == LBRACK) || (wasGroup && (SY == LPAREN))) {
        if (SY == LPAREN) {
            declOps[declOpCount].opKind  =  opFun;
            /* parseSignature takes declOpCount as its own stack base, so this
               entry's slot is claimed before the call rather than after. */
            ++declOpCount;
            declOps[declOpCount-1].sig  =  parseSignature();
            declOps[declOpCount-1].sigFlags  =  sigVarFlag;
        } else {
            parseArrSz(&r.asize);
            checkSymAndRead(RBRACK);
            declOps[declOpCount].opKind  =  opArray;
            declOps[declOpCount].range  =  r;
            ++declOpCount;
        }
    }
} /* readDeclaratorCore */

// packedFlag mirrors parseTypeRef's own array-suffix handling ('TYPE
// [size]', its curDim==0 case): only the outermost array dimension of
// a multi-dim declarator (e.g. int matrix[2][3]'s [2]) carries it, since
// makeArrayType's flag describes how elements of the final array are
// packed, not
// each nesting level. declOps is applied innermost-first (index
// declOpCount-1 down to base, i.e. reverse of source order), so the
// outermost dimension is declOps[base], processed last.
//
// isForwardRef: baseType is already the forward-reference placeholder
// pointer itself (see parseTypeRef's isForwardRef output above) --
// applying getPtrType on top would compact-encode a second, bogus
// pointer-to-pointer layer that never gets patched when the real type
// is later defined. Only the very first op can be this case (index
// declOpCount-1, applied directly to baseType).
// Out-param, not return-by-value: 'declarator' is a multi-word struct,
// and P2C routines (like the Pascal they're translated from) can only
// return a single-word result.
// A function declarator's parameter list is itself parsed by this routine,
// so declOps is a stack, not a plain array: each invocation works above the
// entries its caller has already collected and leaves declOpCount where it
// found it.
// base is where this declarator's own ops start.  It is a parameter and not
// the incoming value of declOpCount, so that the outermost declarator always
// begins with an empty stack: declOpCount is a global, and carrying a stale
// value into declOps[] indexes straight out of the array and overwrites
// whatever globals follow it.
void parseDclAt(declarator *d, tptr baseType, int packedFlag,
                   int isForwardRef, int base) {
int i;
    declOpCount  =  base;
    readDeclaratorCore(d);
    d->typ  =  baseType;
    d->ptrOnly  =  true;
    for (i = declOpCount - 1; i >= base; --i) {
        /* A switch loads the indexed field once per operator and turns each
           kind into a label. */
        switch (declOps[i].opKind) {
        case opPtr:
            if (! ((i == declOpCount - 1) && isForwardRef))
                d->typ  =  getPtrType(d->typ);
            break;
        case opFun:
            d->typ  =  mkRoutineTyp(d->typ, declOps[i].sig,
                                   declOps[i].sigFlags);
            d->ptrOnly  =  false;
            break;
        default:
            d->typ  =  makeArrayType(declOps[i].range.asize, d->typ,
                                    packedFlag && (i == base));
            d->ptrOnly  =  false;
        }
    }
    declOpCount  =  base;
} /* parseDclAt */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// A declarator that is not nested inside another one's parameter list.
void parseOneDeclarator(declarator *d, tptr baseType, int packedFlag, int isForwardRef) {
    parseDclAt(d, baseType, packedFlag, isForwardRef, 0);
} /* parseOneDeclarator */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// A type name: a type-spec and an abstract declarator, the pair a parameter
// list takes, so 'char *', 'int **', 'int (*)(char)' and 'int[4]' all name
// a type.  A cast reads one, and so do sizeof and offsetof.
// Entered with SY on the TYPESY that opens the name; leaves SY on the token
// that follows it, which the caller checks -- ')' for a cast or sizeof, ',' or
// ')' for offsetof.
// The declarator lives here rather than in factor, whose frame every level of
// expression nesting pays for.  The operator stack base is declOpCount, whose
// value the enclosing declarator (if any) set: parseArrSz evaluates a constant
// bound where it stands, so a type name can be read while a declarator is
// still open, and its operators must go above the ones already collected.
// nameOptional is restored rather than cleared, for that same reason.
tptr readTypeName() {
declarator d;
tptr nameBase;
int wasOptional;
    nameBase  =  symType;
    inSymbol();
    wasOptional  =  nameOptional;
    nameOptional  =  true;
    parseDclAt(&d, nameBase, false, false, declOpCount);
    nameOptional  =  wasOptional;
    return d.typ;
} /* readTypeName */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// '(' (typeref declarator (',' typeref declarator)*)? ')', with SY at the
// '(': the parameter list of a function declarator.  Only the types reach
// the signature; a name spelled out here is read and dropped, since these
// parameters have no storage and no scope to be visible in.  Every entry is
// VARID -- a parameter taken by address is not expressible in a type.
sigptr parseSignature() {
declarator sigDecl;
sigptr head, last, cur;
tptr paramType;
int packedFlag, noComma, flags;
    head  =  NULL;
    last  =  NULL;
    flags  =  0;
    inSymbol();
    if (SY != RPAREN) {
        do {
            if (SY == ELLIPSIS) {
                /* The tail marker, under the same rules as in a parameter
                   list: written last, and never the only item.  Breaking out
                   leaves checkSymAndRead(RPAREN) to insist it was last. */
                if (head == NULL)
                    error(errBadSymbol);
                cur  =  mkEllipsisSig(0);
                if (last == NULL)
                    head  =  cur;
                else
                    last->next  =  cur;
                flags  =  [23];
                inSymbol();
                break;
            }
            paramType = parseTypeRef(skipToSet | [IDENT,RPAREN,COMMA]);
            packedFlag  =  isPacked;
            nameOptional  =  true;
            noExtentOk  =  true;
            parseDclAt(&sigDecl, paramType, packedFlag, isForwardRef, declOpCount);
            nameOptional  =  false;
            noExtentOk  =  false;
            if (sigDecl.typ.p.pk == kindArray)
                sigDecl.typ  =  getPtrType(sigDecl.typ.rep->base);
            cur = malloc(sizeof(sigrec));
            { register sigrec *sg = cur;
                sg->s1.p.pclass  =  VARID;
                sg->ptyp  =  sigDecl.typ;
                sg->next  =  NULL;
            }
            if (last == NULL)
                head  =  cur;
            else
                last->next  =  cur;
            last  =  cur;
            noComma  =  (SY != COMMA);
            if (! noComma)
                inSymbol();
        } while (! noComma);
    }
    checkSymAndRead(RPAREN);
    sigVarFlag  =  flags;
    return head;
} /* parseSignature */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr parseTypeRef(int skipTarget) {
typedef struct {
            int first, second;
} pair;
typedef pair pair7[7];
typedef struct {
            int size, count;
            pair7 pairs;
} caserec;
int cond;
int typeIsUnion;
caserec cases;
int numBits, l3int22z, span, rangeCnt, curDim;
int nextEnum, hasExplicit, enumName, enumBucket;
irptr curEnum, curField;
tptr arrayType, nestedType, tempType, curType;
rangeList ranges;
rangeRec curRange;
irptr l3idr31z;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void definePtrType(tptr toType) {
    /* Heap-allocated pointer descriptor (forward-placeholder, patched in
       place when the real pointee type is later defined). */
    curType.rep = malloc(offsetof(types, szPtr));
    curType.rep->base = toType;
    curType.p.psize = 1;
    curType.p.bits = 15;
    curType.p.pk = kindPtr;
    curEnum = malloc(offsetof(identrec, szBase));
    { register identrec *ir = curEnum;
        ir->pck.next  =  typelist;
        ir->id  =  curIdent;
        ir->typ  =  curType;
    }
    curEnum->pck.p.offset  =  lineCnt;
    curEnum->pck.p.cl  =  TYPEID;
    typelist  =  curEnum;
} /* definePtrType */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Assigns curField's offset (and, in a __packed struct, its bit
// shift/width) within the enclosing record's shared bit-packing state
// (cases), then bumps that state past it. Operates on curField (not a
// parameter) so packFieldChain below can call it in a loop exactly like
// the original Pascal-derived packFields()/ctypes-branch packFields()
// did -- see packFieldChain's own comment for why this stayed a
// once-per-GROUP call with an internal loop, rather than one call per
// individual declarator.  recIsLsb is a parameter, not a read of the enclosing
// scope: this routine is parseRecordDecl's sibling, which keeps it at nesting
// 4, and parseRecordDecl recurses for a nested struct, so its locals cannot be
// promoted.
void packOneField(int recIsLsb) {
int fieldWidth, pairIdx, minFirst, scanIdx, curFirst;
int placed, wholeWord;
pair *curSlot;
    wholeWord  =  true;
    if (isPacked) {
        fieldWidth  =  typeBits(curField->typ);
        curField->fpk.p.width  =  fieldWidth;
        if (fieldWidth != 48) {
            wholeWord  =  false;
            placed  =  false;
            while (! placed) {
                pairIdx  =  0;
                while ((pairIdx < cases.count) && (! placed)) {
                    curSlot  =  &cases.pairs[pairIdx];
                    if (curSlot->first >= fieldWidth) {
                        curField->fpk.p.shift  =  48 - curSlot->first;
                        curField->pck.p.offset  =  curSlot->second;
                        if (! recIsLsb)
                            curField->fpk.p.shift  =  48 - curField->fpk.p.width -
                                                      curField->fpk.p.shift;
                        curSlot->first  =  curSlot->first - fieldWidth;
                        if (curSlot->first == 0) {
                            --cases.count;
                            cases.pairs[pairIdx]  =
                                cases.pairs[cases.count];
                        }
                        placed  =  true;
                    }
                    ++pairIdx;
                }
                if (! placed) {
                    if (cases.count != 7) {
                        pairIdx  =  cases.count;
                        ++cases.count;
                    } else {
                        minFirst  =  48;
                        for (scanIdx = 0; scanIdx < 7; ++scanIdx) {
                            curFirst  =  cases.pairs[scanIdx].first;
                            if (curFirst < minFirst) {
                                minFirst  =  curFirst;
                                pairIdx  =  scanIdx;
                            }
                        } /* for */
                    }
                    { register pair *prp = &cases.pairs[pairIdx];
                        prp->first  =  48;
                        prp->second  =  cases.size;
                    }
                    ++cases.size;
                }
            }
        }
    }
    if (wholeWord) {
        curField->fpk.p.pckfield  =  false;
        curField->pck.p.offset  =  cases.size;
        cases.size += typeSize(curField->typ);
    }
    if (PASINFOR.listMode == 3) {
        printf("%16c", ' ');
        if (curField->fpk.p.pckfield)
            printf("PACKED");
        printf(" FIELD  %t.OFFSET=%05oB", curField->id, curField->pck.p.offset);
        if (curField->fpk.p.pckfield) {
            printf(".<<=SHIFT=%2d. WIDTH=%2d BITS",
                   curField->fpk.p.shift,
                   curField->fpk.p.width);
        } else {
