//
/* Backing storage is zero-based; symTabPos and all references stored in the
   compiler's records remain BESM symbol-table addresses starting at 074000. */
int symTab[01501];
int longSymCnt;
int longSym[90];
int longSyms[90];
int objBuffer[1025];
char iso2text[128-'*'];
int maxHeap;
ifcb fcst, initbuf;
extern ifcb pasinput, _child_;
//
typedef struct {
    /*0*/ int listMode;
    /*1*/ int *errors;
    /*2*/ entries *entryptr;
    /*3*/ int startOffset;
  /*4-6*/ charmap *a0, *a1, *a4;
    /*7*/ textmap *a3;
 /*8-17*/ int sizes[10];
   /*18*/ int flags;
} pasinfotyp;
extern pasinfotyp pasinfor;
/* One word of six characters, in storage the runtime owns, so it cannot be
   pointed elsewhere: the constant goes in as the word it is. */
extern int paseofcd;
//
// %%%%%%%%%%%% Libc functions %%%%%%%%%%%
//
int mapai(int) assembler;
void longjmp(int jmpbuf, int val) assembler;
int setjmp(int *jmpbuf) assembler;
int setup() assembler;
void rollup(int addr) assembler;
typedef ifcb *pfcb;
// An external has no body to name its parameters from, so these leave the
// declarators abstract -- the types alone are what the call sites check.
void fopen(pfcb, int, int) assembler;
void fclose(pfcb) assembler;
void ftruncate(pfcb) assembler;
void frewind(pfcb) assembler;
int feof(pfcb) assembler;
int fgetc(pfcb) assembler;
int fgetw(pfcb) assembler;
void fputw(int, pfcb) assembler;
int pck(int *) assembler;
