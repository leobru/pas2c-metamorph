//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* Extract the value of a constant expression into curVal.  With folding at
   construction a constant expression is already a GETENUM node, so read it
   directly instead of lowering it through genFullExpr, which saves an
   insnList allocation per constant. */
void takeConstFromExpr() {
    if (errors || curExpr == NULL)
        return;
    if (curExpr->op != GETENUM)
        error(errNoConstant);
    else if (typeSize(curExpr->typ) != 1)
        error(errConstOfOtherTypeNeeded);
    else
        curVal.i  =  curExpr->num1;
} /* takeConstFromExpr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void markTypeSym() {
    if (SY == IDENT) {
        curVal.i  =  curIdent & hashMask;
        bucket = mapAI(curVal.i);
        hashTravPtr  =  symHash[bucket];
        while ((hashTravPtr != NULL) && (hashTravPtr->id != curIdent))
            hashTravPtr  =  hashTravPtr->pck.p.next;
        if ((hashTravPtr != NULL) && (hashTravPtr->pck.p.cl == TYPEID)) {
            SY  =  TYPESY;
            symType  =  hashTravPtr->typ;
        }
    }
} /* markTypeSym */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// The shared declarator parser below constructs and consumes range
// bounds, and a type nested inside a function is only visible within
// that function's own scope in this codebase's Pascal-style nesting --
// so rangeRec lives here, at programme's own level, declared before
// parseTypeRef so that parseRecordDecl (nested inside it) can also see
// it.
typedef struct {
            int aleft, aright;
} rangeRec;
typedef rangeRec rangeList[1..20];
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Array bounds are const-expressions.  parseRange evaluates each bound
// with the shared const-expression evaluator: statement() run in ceRegs
// mode parses one expression, const-folds it, and leaves the value in
// ceVal / its type in ceTyp (the freeRegs==ceRegs branch of statement();
// parseConstDeclValue drives it the same way).  statement() is a
// PROGRAMM-level sibling of parseRange, hence the forward declaration --
// promoted out of parseTypeRef like makeArrayType above so
// readDeclaratorCore can call it at the same level.
void statement();
void parseRange(int *aleft, int *aright) {
    freeRegs = ceRegs;
    statement();
    if (ceTyp.rep != NULL && ceTyp.p.pk == kindScalar) {
        *aleft = ceVal;
        if (SY != COLON) {
// Handle a single value N as a range 0..N-1
            *aright = *aleft - 1;
            *aleft = 0;
            return;
        }
        inSymbol();
        statement();
        if (ceTyp.rep != NULL && ceTyp.p.pk == kindScalar) {
            *aright = ceVal;
            return;
        }
    }
    error(64); /* errIncorrectRangeDefinition */
    *aleft = 0;
    *aright = 0;
} /* parseRange */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Unified C declarator parsing: one declarator grammar shared by
// variable/typedef/struct-field declarations (grouped: one type-spec,
// comma-separated declarator list -- each caller inlines its own
// do-while and registration, since this dialect has no closures/
// procedural values to factor a callback through) and routine
// parameters (individual: each comma-separated item carries its own
// type-spec).
tptr parseTypeRef(setofsys skipTarget);

typedef struct {
            int name;
            int bucket;
            int wasDefined;
            irptr foundRec;
            tptr typ;
            /* The declarator applied nothing but '*' ops, so it is a name a
               routine header may use: 'T name', 'T *name'.  An opFun ('T
               (*fp)(args)') or an opArray ('T a[3]') clears it, and those are
               variables.  Set by parseDclAt. */
            int ptrOnly;
} declarator;

/* One declarator operator.  opFun carries the parameter signature its
   '(...)' spelled out; opArray carries its bounds. */
const opPtr = 0;
const opArray = 1;
const opFun = 2;

typedef struct {
            int opKind;
            sigptr sig;
            rangeRec range;
} dclOp;
typedef dclOp dclOpList[1..24];

dclOpList declOps;
int declOpCount;
// Shared scratch for the TYPEDEFSY/type-name grouped-declarator loops: each
// iteration fills this in via parseOneDeclarator before registering it,
// for the same reason as declOps/declOpCount above -- the body of a
// do-while cannot declare locals of its own.
declarator curDeclarator;
int moreDecls;
// Set by parseParameters and parseSignature around their parseOneDeclarator
// calls: in a parameter list the declarator may be abstract, i.e. carry no
// name at all.  A global, so parseOneDeclarator's other call sites, none of
// which can accept an abstract declarator, stay as they are.
int nameOptional;
// Scratch for the unified TYPESY/PACKEDSY/STRUCTSY/ENUMSY declaration-
// dispatch loop in programme's own body: same reasoning as above.
int declIsRoutine;

// The parameter list of a function declarator, as a signature: types and
// nothing else, the names (if any) discarded.  Defined below, after
// parseOneDeclarator, which it calls for each parameter.
sigptr parseSignature();

// '*'* ('(' declarator ')' | IDENT) ('[' range ']' | '(' signature ')')*
// Collects pointer/array/function operators into the shared declOps/
// declOpCount while descending; parseOneDeclarator applies them in reverse
// so precedence matches C: 'int *a[10]' is an array of pointers (the array
// op is pushed by the inner IDENT case before the enclosing '*' case
// pushes its own op on the way back out); 'int (*row)[3]' is a pointer
// to an array (the parens make the '*' push before the outer '[3]' does),
// and 'int (*f)(char)' is a pointer to a routine, the '*' likewise pushed
// before the function op.
// The '(' suffix is taken only after a parenthesized declarator, which is
// exactly where C puts it: in 'int f(char)' and 'int *f(char)' the '(' binds
// to the name and declares a routine, whose parameter list belongs to
// parseParameters (it gives the parameters records of their own), while in
// 'int (*f)(char)' it binds to the group and is part of a type.
void readDeclaratorCore(declarator *d) {
rangeRec r;
int wasGroup;
    wasGroup  =  false;
    if (charClass == MUL) {
        inSymbol();
        readDeclaratorCore(d);
        ++declOpCount;
        declOps[declOpCount].opKind  =  opPtr;
    } else if (SY == LPAREN) {
        inSymbol();
        readDeclaratorCore(d);
        checkSymAndRead(RPAREN);
        wasGroup  =  true;
    } else if (SY == IDENT) {
        d->name  =  curIdent;
        d->bucket  =  bucket;
        d->wasDefined  =  isDefined ||
            ((lookupMode == lookDef) &&
             ((curIdent == litInput) || (curIdent == litOutput)));
        d->foundRec  =  hashTravPtr;
        inSymbol();
    } else if (nameOptional && (SY IN [RPAREN, COMMA, LBRACK])) {
        /* Abstract declarator: a formal parameter's name is optional
           ('int', 'int *', 'int [0..2]').  curDeclarator is a global, so
           the fields the name would have filled are cleared here; the
           previous declarator's values would otherwise persist. */
        { register declarator *dcl = d;
          dcl->name = dcl->bucket = dcl->wasDefined = 0;
          dcl->foundRec  =  NULL; }
    } else {
        error(errNoIdent);
        d->name  =  0;
    }
    while ((SY == LBRACK) || (wasGroup && (SY == LPAREN))) {
        if (SY == LPAREN) {
            ++declOpCount;
            declOps[declOpCount].opKind  =  opFun;
            declOps[declOpCount].sig  =  parseSignature();
        } else {
            inSymbol();
            parseRange(&r.aleft, &r.aright);
            checkSymAndRead(RBRACK);
            ++declOpCount;
            declOps[declOpCount].opKind  =  opArray;
            declOps[declOpCount].range  =  r;
        }
    }
} /* readDeclaratorCore */

// packedFlag mirrors parseTypeRef's own array-suffix handling ('TYPE
// [range]', its curDim==1 case): only the outermost array dimension of
// a multi-dim declarator (e.g. int matrix[2][3]'s [2]) carries it, since
// makeArrayType's flag describes how elements of the final array are
// packed, not
// each nesting level. declOps is applied innermost-first (index
// declOpCount down to base+1, i.e. reverse of source order), so the
// outermost dimension is declOps[base+1], processed last.
//
// isForwardRef: baseType is already the forward-reference placeholder
// pointer itself (see parseTypeRef's isForwardRef output above) --
// applying getPtrType on top would compact-encode a second, bogus
// pointer-to-pointer layer that never gets patched when the real type
// is later defined. Only the very first op can be this case (index
// declOpCount, applied directly to baseType).
// Out-param, not return-by-value: 'declarator' is a multi-word struct,
// and P2C routines (like the Pascal they're translated from) can only
// return a single-word result.
// A function declarator's parameter list is itself parsed by this routine,
// so declOps is a stack, not a plain array: each invocation works above the
// entries its caller has already collected and leaves declOpCount where it
// found it.
// base is where this declarator's own ops start.  It is a parameter and not
// the incoming value of declOpCount, so that the outermost declarator always
// begins with an empty stack: declOpCount is a global, and carrying a stale
// value into declOps[] indexes straight out of the array and overwrites
// whatever globals follow it.
void parseDclAt(declarator *d, tptr baseType, int packedFlag,
                   int isForwardRef, int base) {
int i;
    declOpCount  =  base;
    readDeclaratorCore(d);
    d->typ  =  baseType;
    d->ptrOnly  =  true;
    for (i = declOpCount; i > base; --i) {
        /* A switch loads the indexed field once per operator and turns each
           kind into a label. */
        switch (declOps[i].opKind) {
        case opPtr:
            if (! ((i == declOpCount) && isForwardRef))
                d->typ  =  getPtrType(d->typ);
            break;
        case opFun:
