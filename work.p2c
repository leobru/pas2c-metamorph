    curVal.i  =  (symTabPos - 070000) << 24;
    for (cnt = 1; cnt <= longSymCnt; ++cnt) {
        idx  =  longSym[cnt];
        symTab[idx]  =  symTab[idx] | curVal.i & [9:23];
        curVal.i += 0100000000;
    }
    --symTabPos;
