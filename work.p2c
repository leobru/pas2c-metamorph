//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    if (insnList == NULL)
         return;
    usedRegs |= insnList->regsused;
    l4oi212z  =  insnList->head;
    l4var9z  =  KNTR+7;
    insnBufIdx  =  1;
    if (l4oi212z == NULL)
        return;
    l4inl6z  =  NULL;
    while (l4oi212z != NULL) {
        tempInsn  =  l4oi212z->code;
        l4var4z  =  tempInsn -  macro;
        curInsn  =  l4oi212z->offset;
        switch (l4oi212z->mode) {
         case 0: break;
         case 1:
             if (arithMode != 1) {
                 addInsnToBuf(KNTR+7);
                 arithMode  =  1;
             }
             break;
         case 2: arithMode  =  1; break;
         case 3:
             if (arithMode != 2) {
                 addInsnToBuf(KNTR);
                 arithMode  =  2;
             }
             break;
         case 4: arithMode  =  2;
        } /* switch */
        l4oi212z  =  l4oi212z->next;
        if (l4var4z >= 0) {
            switch (l4var4z) {
            case 0: addJumpInsn(KUZA); break;
            case 1: addJumpInsn(KU1A); break;
            case 2:
