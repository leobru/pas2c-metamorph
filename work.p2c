eptr curActual, callExpr, argList;
sigptr curSig;
tptr routTyp, formType;
    curSig  =  NULL;
    if (callee == NULL) {
        { register identrec *ir = subroutine;
            if (ir->typ != voidType)
                liveRegs &= ~(ir->flags & ~calleeSaved);
            noArgs  =  1 ^ ((ir->flags >> (47-24)) & 1);
            isVarArg  =  (ir->flags >> (47-23)) & 1;
        }
    } else {
        routTyp  =  ptrBase(callee->typ);
        noArgs  =  1 ^ ((routTyp.rep->rflags >> (47-24)) & 1);
        isVarArg  =  (routTyp.rep->rflags >> (47-23)) & 1;
    }
    callExpr = malloc(sizeof(expr));
    argList  =  callExpr;
    bool48z  =  true;
    { register expr *ex = callExpr;
        if (callee == NULL) {
            ex->typ  =  subroutine->typ;
            ex->op  =  ALNUM;
            ex->id2  =  subroutine;
        } else {
            ex->typ  =  routTyp.rep->rresult;
            ex->op  =  INDCALL;
            ex->expr2  =  callee;
        }
        ex->expr1  =  NULL;
    }
    if (SY == LPAREN) {
        if (noArgs) {
            if (callee == NULL)
                curSig  =  subroutine->r1.sig;
            else
                curSig  =  routTyp.rep->rparams;
            if (curSig == NULL) {
                inSymbol();
                if (SY != RPAREN) {
                    error(errTooManyArguments);
                    badExpr();
                    return;
                }
                curExpr = callExpr;
                inSymbol();
                return;
            }
        }
        do {
            if (noArgs) {
                /* The last node of a variadic signature is the marker: the
                   caller fills that slot with the pointer, not with an
                   actual, so reaching it means the rest is the tail. */
                if (isVarArg && curSig && curSig->next == NULL)
                    curSig  =  NULL;
                tooMany  =  curSig == NULL && ! isVarArg;
                if (curSig)
                    formType  =  curSig->ptyp;
                if (tooMany) {
                    error(errTooManyArguments);
                    badExpr();
                    return;
                }
            }
            expression();
            if (noArgs && curSig == NULL) {
                /* A tail actual answers to no formal, so all that is asked
                   of it is that it be one word, as printf asks. */
                if (curExpr->typ.p.pk == kindArray)
                    curExpr = decayArray(curExpr);
                if (typeSize(curExpr->typ) != 1)
                    error(40); /*errIncompatibleArgumentTypes*/
            } else if (noArgs) {
                /* A pointer formal takes an array actual by decay, as in C. */
                if (formType.p.pk == kindPtr)
                    curExpr = decayArray(curExpr);
                arg1Type  =  curExpr->typ;
                if (arg1Type != voidType) {
                    /* Every formal is taken by value, so an actual converts
                       the way an assignment to it would. */
                    if (!typeCheck(arg1Type, formType) &&
                       ! castArith(formType, &curExpr))
                        error(40); /*errIncompatibleArgumentTypes*/
                }
            }
            curActual = malloc(sizeof(expr));
            { register expr *ex = curActual;
                ex->typ.rep  =  NULL;
                ex->expr1  =  NULL;
                ex->expr2  =  curExpr;
            }
            argList->expr1  =  curActual;
            argList  =  curActual;
            if (noArgs && curSig)
                curSig  =  curSig->next;
        } while (SY == COMMA);
        if (isVarArg && curSig && curSig->next == NULL)
            curSig  =  NULL;      /* every mandatory formal was supplied */
        if (SY != RPAREN || noArgs && curSig)
            error(errNoCommaOrParenOrTooFewArgs);
        else
            inSymbol();
    } else {
        error(42); /*errNoArgList*/
    }
    curExpr  =  callExpr;
} /* parseCallArgs */
