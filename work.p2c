            }
            if ((externDecl && SY == SEMICOLON) ||
                ((SY == IDENT) &&
                 ((curIdent == t' FORTRAN') || (curIdent == t'ASSEMBLE')))) {
                if (externDecl && SY == SEMICOLON) {
                    curVal.i  =  [20];
                } else if (curIdent == t'ASSEMBLE') {
                    curVal.i  =  [20,26];
                } else if (checkFortran) {
                    curVal.i  =  [21,24];
                    checkFortran  =  false;
                } else {
                    curVal.i  =  [21];
                }
                curIdRec->flags  =  curIdRec->flags | curVal.i;
                if (SY != SEMICOLON)
                    inSymbol();
                checkSymAndRead(SEMICOLON);
            } else {
                checkSymAndRead(SEMICOLON);
                { register identrec *ir = curIdRec;
                    if (isPredefined)
                        error(83); /* errRepeatedPredefinition */
                    ir->r2.level  =  l2int18z;
                    ir->r2.preDefLink  =  preDefHead;
                    preDefHead  =  curIdRec;
                }
            }
            /* Nothing to unhash: a formal is entered in the symbol table
               only by makeFormals, above the scope mark, and exitScope has
               already dropped it.  A declaration without a body never made
               one at all. */
L23301:     ;
            curFrameRegTemplate -= indexreg[1];
            --curProcNesting;
        }
        markTypeSym();
        }
    }
    markTypeSym();
    if (CH == '\0' && bodyBlock) {
        requiredSymErr(ENDSY);
        return;
    }
    if (bodyBlock) {
        if (! has(bodyStatSys | blockBegSys, SY) &&
            ! has([TYPESY,PACKEDSY,STRUCTSY,ENUMSY,STATICSY,ENDSY], SY))
            errAndSkip(84 /* errErrorInDeclarations */,
                       skipToSet | bodyStatSys | blockBegSys | [ENDSY]);
    } else if (CH != '\0' && (SY != BEGINSY) &&
       ! has([TYPESY,PACKEDSY,STRUCTSY,ENUMSY,STATICSY], SY) &&
       ! has(blockBegSys, SY))
        errAndSkip(84 /* errErrorInDeclarations */, skipToSet);
    } while (! ((bodyBlock && (has(bodyStatSys, SY) ||
                               has([TYPESY,PACKEDSY,STRUCTSY,ENUMSY,
                                    STATICSY,ENDSY], SY))) ||
                (! bodyBlock && ((CH == '\0') || has(statBegSys, SY) ||
                                 has([TYPESY,PACKEDSY,STRUCTSY,ENUMSY,
                                      STATICSY], SY)))));
    // Checked once per programme() call (guarded by curProcNesting==1, so
    // effectively once for the whole compile), not once per do-while
    // iteration: each variable or typedef declaration stands on its own,
    // so a run of N of them is N do-while iterations, not one -- running
    // this check inside the loop re-flagged the same not-yet-declared
    // extern names on every iteration, and the resulting flood of
    // errUndefinedExternFile errors tripped error()'s own "too many
    // errors" abort path (skipToEnd()) mid-file.
    if (curProcNesting == 1) {
        curExternFile  =  externFileList;
        while (curExternFile) {
            if (curExternFile->line == 0) {
                error(80); /* errUndefinedExternFile */
                printTextWord(curExternFile->id);
                putln();
            }
            curExternFile  =  curExternFile->next;
        }
    }
    if (preDefHead != uProcPtr) {
        error(85); /* errNotFullyDefinedVoids */
        while (preDefHead != uProcPtr) {
            printTextWord(preDefHead->id);
            preDefHead  =  preDefHead->r2.preDefLink;
        }
        putln();
    }
    lookup2  =  lookupMode  =  lookUse;
    if (curProcNesting == 1)
        localSize  =  moduleDataSize;
    defineRoutine(bodyBlock);
    if ((curProcNesting > 1) && ! retSeen &&
            (procName->typ != voidType)) {
        printf(" Above function must return a value\n");
        error(200);
    }
    l2bool8z  =  true;
    while (numLabTop > labFence) {
        --numLabTop;
        if (! numLabs[numLabTop].defined) {
            printTextWord(numLabs[numLabTop].id);
            putchar(':');
            l2bool8z  =  false;
        }
    }
    if (! l2bool8z) {
        printTextWord(procName->id);
        error(18); /* errLabelNotDefined */
    }
    *retSizePtr  =  sizeCount;
} /* programme */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void initTables() { /* initTables */
void ftruncate(pfcb) assembler;
int idx, jdx;

//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void initInsnTemplates() {
operator op;
    for (idx = 1; idx < 16; ++idx)
        indexreg[idx]  =  idx << 20;
    jumpType  =  KUJ;
    for (op = MUL; op <= ASSIGNOP; ++op) {
        if (has([MUL, RDIVOP, PLUSOP, MINUSOP], op)) {
            opToMode[op]  =  3;
        } else if (has([IDIVOP, IMODOP], op)) {
            opToMode[op]  =  2;
        } else if (has([IMULOP, INTPLUS, INTMINUS], op)) {
            opToMode[op]  =  1;
        } else {
            opToMode[op]  =  0;
        }
    }
} /* initInsnTemplates */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void regKeywords() { /* regKeywords */
static int resWordName[20] = {
        t'   CONST',
        t' TYPEDEF',
        t'    ENUM',
        t'**PACKED',
        t'  STRUCT',
        t'      IF',
        t'  SWITCH',
        t'   WHILE',
        t'     FOR',
        t'    GOTO',
        t'    ELSE',
        t'      DO',
        t'  EXTERN',
        t'   BREAK',
        t'CONTINUE',
        t'    CASE',
        t' DEFAULT',
        t'   UNION',
        t'  RETURN',
        t'  STATIC' };
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    SY  =  CONSTSY;
    charClass  =  NOOP;
    /* CONSTSY..STATICSY are the consecutive reserved-word table.  TYPESY
       sits before CONSTSY, outside this range; predefined type names are
       registered as TYPESY keywords later, by mainProgram. */
    for (idx = 0; idx <= 19; ++idx) {
        regResWord(resWordName[idx]);
        ++SY;
    }
} /* regKeywords */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    FcstCnt  =  0;
    FcstCount  =  0;
    initInsnTemplates();
    skipToSet  =  blockBegSys | statBegSys & (~[SWITCHSY]);
    unpackt(pasinfor.a3, &iso2text, 128 - '*');
    iso2text['_'-'*'] = t'*';
    ftruncate(&_CHILD_);
    for (jdx = 1; jdx <= 10; ++jdx)
        fputw(0, &_CHILD_);
    regKeywords();
    internHead  =  NULL;
    numLabTop  =  0;
    totalErrors  =  0;
    heapCallsCnt  =  0;
    objHalfIdx  =  2;
    readNext  =  true;
    curFrameRegTemplate  =  frameRegTemplate;
    curProcNesting  =  1;
} /* initTables */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void finalize() {
void fclose(pfcb) assembler;
int idx, cnt;
    pasinfor.sizes[0]  =  1;
    pasinfor.sizes[1]  =  symTabPos - 074000 - 1;
    pasinfor.sizes[4]  =  longSymCnt;
    pasinfor.sizes[5]  =  moduleOffset - 040000;
    pasinfor.sizes[7]  =  FcstCnt;
    pasinfor.sizes[2]  =
    pasinfor.sizes[3]  =
    pasinfor.sizes[6]  =  0;
    pasinfor.sizes[8]  =  lookup2;
    pasinfor.sizes[9]  =  lookupMode;
    curVal.i  =  moduleOffset - 040000;
    symTab[1]  =  [24,29] | curVal.i;
    symTab[staticBlk - 074000]  =  symTab[staticBlk - 074000] | staticSize;
    frewind(&FCST);
    while (! feof(&FCST)) {
        fputw(fgetw(&FCST), &_CHILD_);
    }
    curVal.i  =  (symTabPos - 070000) << 24;
    for (cnt = 0; cnt < longSymCnt; ++cnt) {
        idx  =  longSym[cnt] - 074000;
        symTab[idx]  =  symTab[idx] | curVal.i & [9:23];
        curVal.i += 0100000000;
    }
    --symTabPos;
    for (cnt  =  0; cnt <= symTabPos - 074000; ++cnt)
        fputw(symTab[cnt], &_CHILD_);
    for (cnt = 0; cnt < longSymCnt; ++cnt)
        fputw(longSyms[cnt], &_CHILD_);
    fclose(&_CHILD_);
    if (PASINFOR.listMode) {
        printf(
"     MODULE HEADER:   HDR REL    0    0 LSYM NCODE   0 CONST DATA SETS\n%6d LINES STRUCTURE ",
            lineCnt - 1);
        for (idx = 0; idx <= 9; ++idx)
            printf("%*d ", idx?4:1, pasinfor.sizes[idx]);
        putln();
    }
    entryPtTable[entryPtCnt]  =  0U;
    /* The table goes in the block the runtime owns and reads it from, so
       the pointer cannot simply be pointed here; the terminator entryPtCnt
       names is the last word that matters. */
    for (idx = 0; idx <= entryPtCnt; ++idx)
        (*pasinfor.entryptr)[idx]  =  entryPtTable[idx];
} /* finalize */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void initOptions() {
    pasinfor.startOffset  =  (pasinfor.startOffset & ~[0..6]) - 16384;
    commentModeCH  =  ' ';
    lineNesting  =  0;
    CH  =  ' ';
    linePos  =  -1;
    prevErrPos  =
    errsInLine  =  0;
    lineCnt  =  1;
    eofOverreads  =  0;
    lexMemPtr  =  NULL;
    checkFortran  =
    abort  =  false;
    lookup2  =  lookupMode  =  lookUse;
    lineStartOffset  =  moduleOffset  =  040000;
    condLabCnt  =  1;
    heapSize  =  100;
    forValue  =  true;
    atEOL  =  false;
    checkTypes  =  true;
    enableStdInput  =
    errors  =  false;
    fileBufSize  =  1;
    longSymCnt  =  0;
    *pasinfor.errors  =  true;
    symTabCnt  =  0;
    paseofcd  =  '*copy:';
} /* initOptions */
//
void main() {
    void puts(char *) assembler;
    fopen(&PASINPUT, 010000100010, t'PASINPUT');
    fopen(&_CHILD_, 010000100000, t'*CHILD* ');
    if (PASINFOR.listMode)
        puts(boilerplate);
    printf(" INITHEAP = %05o\n", setup());
    if (setjmp(jb9999)) goto L9999;
    initOptions();
    curInsnTemplate  =  0;
    initTables();
    fopen(&FCST, 010000100000, 0);
    fopen(&INITBUF, 010000100000, 0);
    programme(&curInsnTemplate, hashTravPtr, false);
    if (errors) {
L9999:  printf(" IN %d LINES %d ERRORS\n", lineCnt-1, totalErrors);
    } else {
        finalize();
        *PASINFOR.errors  =  false;
        printf(" MAXHEAP = %05o\n", maxHeap);
    }
}
