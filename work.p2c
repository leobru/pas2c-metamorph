typedef struct {
    int id;
    int line;
    int offset;
    int defined;
} numLabel;
/*=l3*/
typedef __packed __lsb struct {
    irptr   next;
    int:24  offset;
    idclass cl;
} idpckp;
typedef union {
    /* One word: the whole-word arm reads/writes next as a plain pointer
       (its 15 address bits are the LSBs, so it stays directly dereferenceable
       and a whole-word store clears offset/cl); the packed arm carries
       next(15)/offset(24)/cl in that same word.  Mirrors tptr/pckrep.  Chain
       traversal reads pck.p.next (masked) so a terminator's offset/cl don't
       spoil the NULL test. */
    irptr  next;
    idpckp p;
} idpck;
/* A packed field's placement, one word instead of three: pckfield says the
   member is packed at all, shift and width describe the slice.  Both run
   0..48, so six bits each.  Only read when pckfield is set, and a fresh
   record is zero, which is what a 48-bit packed member (whose shift is never
   assigned) relies on. */
typedef __packed __lsb struct {
    int:1   pckfield;
    int:6   shift;
    int:6   width;
} fldpckp;
typedef union {
    int     w;
    fldpckp p;
} fldpck;
/* A routine record's four small fields, two words instead of four.  Both
   pointers sit at the bottom of their word so a dereference costs nothing
   extra (see genDeref's shift == 0 case).  pos is a symbol-table position,
   level the frame size the definition inherits from the declaration -- 8 or
   9 -- and both are dead space at full width. */
typedef __packed __lsb struct {
    sigptr  sig;
    int:24  pos;
} rtnpck1;
typedef __packed __lsb struct {
    irptr   preDefLink;
    int:9   level;
} rtnpck2;
typedef struct {
    idpck pck;
    int id;
    tptr typ;
    union {
        /* A TYPEID owns nothing past typ -- list and value both belong to
           other arms -- so it is allocated at szBase, three words. */
        struct { int szBase; };
        struct { irptr list; int value; int szIdent; };
        struct { int maybeUnused;
                tptr uptype;
                fldpck fpk; int szField; };
        struct { int low, high;
                rtnpck1 r1; rtnpck2 r2;
                int flags; int szRoutine; };
        struct { int sysnum; int szSys; };
    };
} identrec;
