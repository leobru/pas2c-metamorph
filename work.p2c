                 curInsn /= 4096;
                 l4var213z  =   findLabel();
                 l4inl8z  =  l4inl7z;
                 curInsn  =  tempInsn;
                 l4var213z  =  l4var213z && findLabel();
                 if (l4var213z)
                    { register oneinsn *oi = l4inl7z;
                        oi->code  =  macro;
                        oi->offset  =  int(l4inl8z);
