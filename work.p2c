//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parseLval() {
    curExpr  =  mkExpr(GETVAR, hashTravPtr->typ, (eptr)hashTravPtr, NULL);
    inSymbol();
    parsePostfix();
