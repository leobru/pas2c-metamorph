//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int sameRoutineType(tptr type1, tptr type2) {
sigptr p1, p2;
    /* Only the flags that shape a call are part of the type: 21 fortran,
       24 all-by-reference, 26 assembler.  Bit 20 (extern) is linkage, and
       including it would keep every declared function pointer type (flags 0)
       from ever accepting an extern routine. */
    if ((type1.rep->rflags & [21,24,26]) !=
        (type2.rep->rflags & [21,24,26])) {
        return false;
    }
    if (type1.rep->rresult != type2.rep->rresult &&
        (type1.rep->rresult.rep == NULL || type2.rep->rresult.rep == NULL ||
         ! typeCheck(type1.rep->rresult, type2.rep->rresult))) {
        return false;
    }
    p1  =  type1.rep->rparams;
    p2  =  type2.rep->rparams;
    while (p1 && p2) {
        if (p1->s1.p.pclass != p2->s1.p.pclass)
            return false;
        if (p1->ptyp != p2->ptyp &&
            (p1->ptyp.rep == NULL || p2->ptyp.rep == NULL ||
             ! typeCheck(p1->ptyp, p2->ptyp))) {
            return false;
        }
        p1  =  p1->next;
        p2  =  p2->next;
    }
    return p1 == NULL && p2 == NULL;
} /* sameRoutineType */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int typeCheck(tptr type1, tptr type2) { /* typeCheck */
int baseMatch;
kind kind1, kind2;
irptr enums1, enums2;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    if (!checkTypes || type1 == type2)
L1:     return true;
        { register types *ty = (type1.rep);
            kind1  =  type1.p.pk;
            kind2  =  type2.p.pk;
            if (kind1 == kind2) {
                switch (kind1) {
                case kindReal:
                    /* empty */ break;
                case kindScalar:
                /* Two enums must be identical,
                 * all other combinations are okay.
                 */
                    if (type1.rep->enums == NULL || type2.rep->enums == NULL) {
                        goto L1;
                    }
                    break;
                case kindPtr:
                    if (type1 == voidPtr || type2 == voidPtr ||
                        typeCheck(ptrBase(type1), ptrBase(type2)))
                        goto L1;
                    break;
                case kindArray:
                    if (typeCheck(type1.rep->base, type2.rep->base) &&
                       (type1.rep->asize == type2.rep->asize) &&
                       (type1.p.pad == type2.p.pad))
                        goto L1;
                    break;
                case kindRoutine:
                    if (sameRoutineType(type1, type2))
                        goto L1;
                    break;
                } /* switch */
            }
            return false;
        }
} /* typeCheck */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
eptr mkExpr(operator oper, tptr resTyp, eptr e1, eptr e2) {
    eptr n;
    n = malloc(sizeof(expr));
    { register expr *ex = n;
        ex->typ = resTyp;
        ex->op = oper;
        ex->expr1 = e1;
        ex->expr2 = e2;
    }
    return n;
} /* mkExpr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
eptr mkIntLit(int val) {
    eptr n;
    n = malloc(sizeof(expr));
    { register expr *ex = n;
        ex->typ = intType;
        ex->op = GETENUM;
        ex->num1 = val;
    }
    return n;
} /* mkIntLit */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* Construct a binary op-node, but if both operands are already constants
   (GETENUM), fold at construction and reuse the left operand's node in place
   as the result — no new allocation.  Construction is the only place folding
   happens, so constant expressions collapse to a literal for downstream sites
   that require op == GETENUM.  Divide/modulo by a zero constant is left as an
   op-node so codegen keeps its behaviour. */
eptr mkExprFold(operator op, tptr resTyp, eptr e1, eptr e2) {
    word v, r;
    if ((e1->op == GETENUM) && (e2->op == GETENUM) &&
        ! (((op == IDIVOP) || (op == IMODOP) || (op == RDIVOP)) &&
           (e2->num1 == 0))) {
        v.i = e1->num1;
        r.i = e2->num1;
        switch (op) {
        case MUL:      v.r = v.r * r.r; break;
        case RDIVOP:   v.r = v.r / r.r; break;
        case ANDOP:    v.i = v.i && r.i; break;
        case IDIVOP:   v.i = v.i / r.i; break;
        case IMODOP:   v.i = v.i % r.i; break;
        case PLUSOP:   v.r = v.r + r.r; break;
        case MINUSOP:  v.r = v.r - r.r; break;
        case OROP:     v.i = v.i || r.i; break;
        case IMULOP:   v.i = v.i * r.i; break;
        case SETAND:   v.i = v.i & r.i; break;
        case SETXOR:   v.i = v.i ^ r.i; break;
        case INTPLUS:  v.i = v.i + r.i; break;
        case INTMINUS: v.i = v.i - r.i; break;
        case SETOR:    v.i = v.i | r.i; break;
        case SHLEFT:   v.i = v.i << r.i; break;
        case SHRIGHT:  v.i = v.i >> r.i; break;
        default:
            return mkExpr(op, resTyp, e1, e2);   /* not a foldable op */
        }
        e1->num1 = v.i;    /* e1 is already GETENUM; reuse it in place */
        e1->typ = resTyp;
        return e1;
    }
    return mkExpr(op, resTyp, e1, e2);
} /* mkExprFold */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* Unary counterpart of mkExprFold.  Only ever called with a foldable unary
   operator, so a GETENUM operand is always folded — mutated in place and
   reused. */
eptr mkUnaryFold(operator op, tptr resTyp, eptr e) {
    word v;
    if (e->op == GETENUM) {
        v.i = e->num1;
        switch (op) {
        case TOREAL:   v.r = v.i; break;
        case TOINT:    v.i = v.r; break;
        case NOTOP:    v.i = !v.i; break;
        case RNEGOP:   v.r = -v.r; break;
        case INEGOP:   v.i = -v.i; break;
        case BITNEGOP: v.i = ~v.i; break;
        } /* switch */
        e->num1 = v.i;
        e->typ = resTyp;
        return e;
    }
    return mkExpr(op, resTyp, e, NULL);
} /* mkUnaryFold */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
eptr flatMemAt(eptr idx) {
    idx->typ = intType;
    return mkExpr(GETELT, charType,
                  mkExpr(GETVAR, flatMemType, (eptr)flatMemVar, NULL), idx);
} /* flatMemAt */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The address of an lvalue, typed by the caller: a pointer to the lvalue's
   type where that is what is wanted, an int where the address is about to
   take part in byte arithmetic. */
eptr mkRef(eptr lval, tptr typ) {
    return mkExpr(ADDROF, typ, lval, NULL);
} /* mkRef */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* An index or offset in pointee units, converted to words. */
eptr scaleIdx(eptr n, int step) {
    if (step == 1)
        return n;
    return mkExprFold(IMULOP, intType, n, mkIntLit(step));
} /* scaleIdx */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr getPtrType(tptr toType) {
tptr t;
    if (toType == voidType)
        return voidPtr;
    if (isCompactP(toType)) {
        t = toType;
        if (t.p.pad < 0370) {
            t.p.pad = t.p.pad + 010;
            return t;
        }
    } else if (toType.p.pad == 0) {
        t = toType;
        t.p.pad = 010 + (int)toType.p.pk;
        t.p.pk = kindPtr;
        return t;
    }
    /* Fallback: heap-allocated pointer descriptor, for bases the compact
       form cannot carry, i.e. pointer depth overflowing the pad field. */
    t.rep = malloc(offsetof(types, szPtr));
    t.rep->base = toType;
    t.p.psize = 1;
    t.p.bits = 15;
    t.p.pk = kindPtr;
    return t;
} /* getPtrType */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* An array used as a value is the address of its first element, as in C.
   Anything else comes back as it stands, so a call site may apply this
   unconditionally.  The shapes are the ones the '&' arm builds for '&a[0]':
   a char array yields a byte index into flat memory, six bytes to a word,
   the unpacked case pointing at the rightmost byte of the element's own
   word.  An array that is not an lvalue -- the result of a cast -- has no
   address to take and is left for the caller's type check to refuse. */
eptr decayArray(eptr e) {
eptr addr;
    if (e->typ.p.pk != kindArray || ! (e->op IN lvalOpSet))
        return e;
    if (! isCharArray(e->typ))
        return mkRef(e, getPtrType(e->typ.rep->base));
    addr  =  mkExpr(IMULOP, charPtrType, mkRef(e, intType), mkIntLit(6));
    if (e->typ.p.pad)
        return addr;
    return mkExpr(INTPLUS, charPtrType, addr, mkIntLit(5));
} /* decayArray */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
eptr bldIncDec(eptr lval, int isInc, int isPost) {
eptr one, rmw;
operator op;
tptr t;
int step;
    /* A pointer steps by its pointee, and keeps its type; anything else is
       an integer step of one. */
    step  =  eltStep(lval->typ);
    if (step == 0) {
        t  =  intType;
        step  =  1;
    } else
        t  =  lval->typ;
    op = isInc ? INTPLUS : INTMINUS;
    one = mkIntLit(step);
    rmw = mkExpr(RMWASSIGN, t, lval, mkExpr(op, t, one, NULL));
    if (! isPost)
        return rmw;
    return mkExpr(INTPLUS + INTMINUS - op, t, rmw, one);
} /* bldIncDec */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Not enabled -- to switch it on, uncomment this and its call in
// formOperator.  It saves one A-X per discarded ++/-- in a compiled
// program, and costs more object words than that in this compiler, whose
// own source spells every discarded step as a prefix ++.
//
// The value of a post-increment is the lvalue's old value, which bldIncDec
// forms by undoing the step afterwards: the inverse operator applied to the
// RMWASSIGN, stepping by the very literal node the RMWASSIGN steps by.
// Where the value is discarded -- an expression statement, a for's step --
// that undo is dead code, so hand back the RMWASSIGN alone.  The shared
// literal node is what identifies the pair.
//
// eptr dropPostFixup(eptr e) {
// eptr rmw, step;
//     if (e->op != INTPLUS && e->op != INTMINUS)
//         return e;
//     rmw = e->expr1;
//     if (rmw->op != RMWASSIGN)
//         return e;
//     step = rmw->expr2;
//     // The inner operator is the outer one's inverse, so it is the other
//     // member of the same pair.
//     if (step->op == e->op || step->op != INTPLUS && step->op != INTMINUS)
//         return e;
//     if (step->expr1 != e->expr2)
//         return e;
//     return rmw;
// } /* dropPostFixup */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formFileInit() {
int fileAddr;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void fcloseFile(irptr fileSym) {
    fileAddr  =  fileSym->value;
    if (fileAddr < 074000) {
        form1Insn(getValueOrAllocSymtab(fileAddr) + KUTC + I7);
        fileAddr  =  0;
    }
    form1Insn(KVTM+I14 + fileAddr);
    form1Insn(KITS+14);
    formAndAlign(getHelperProc(36)); /*"FCLOSE   "*/
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    form2Insn(KITS+13, KATX+SP);
    if (inputFile) {
        fcloseFile(inputFile);
        form1Insn(KXTA+SP);  // remove FCLOSE's stacked FCB argument
    }
    if (outputFile)
        fcloseFile(outputFile);
    form1Insn(getHelperProc(42)/*"P/IT"*/ + (KUJ-KVJM-I13));
    padToLeft();
} /* formFileInit */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* Extract the value of a constant expression into curVal.  With folding at
   construction a constant expression is already a GETENUM node, so read it
   directly instead of lowering it through genFullExpr, which saves an
   insnList allocation per constant. */
void takeConstFromExpr() {
    if (errors || curExpr == NULL)
        return;
    if (curExpr->op != GETENUM)
        error(errNoConstant);
    else if (typeSize(curExpr->typ) != 1)
        error(errConstOfOtherTypeNeeded);
    else
        curVal.i  =  curExpr->num1;
} /* takeConstFromExpr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void markTypeSym() {
    if (SY == IDENT) {
        curVal.i  =  curIdent & hashMask;
        bucket = mapAI(curVal.i);
        hashTravPtr  =  symHash[bucket];
        while (hashTravPtr && hashTravPtr->id != curIdent)
            hashTravPtr  =  hashTravPtr->pck.p.next;
        if (hashTravPtr && hashTravPtr->pck.p.cl == TYPEID) {
            SY  =  TYPESY;
            symType  =  hashTravPtr->typ;
        }
    }
} /* markTypeSym */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void dumpEnumNames(tptr l3arg1z) {
irptr l3var1z;
    if (l3arg1z.rep->start == 0) {
        l3arg1z.rep->start  =  FcstCnt;
        l3var1z  =  l3arg1z.rep->enums;
        while (l3var1z) {
            curVal.i  =  l3var1z->id;
            l3var1z  =  l3var1z->list;
            toFCST();
        }
    }
} /* dumpEnumNames */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void fopenFile(irptr fileSym, extfilerec *extFileP) {
int fileAddr;
    fileAddr  =  fileSym->value;
    if (fileAddr < 074000) {
        form1Insn(getValueOrAllocSymtab(fileAddr) + KUTC + I7);
        fileAddr  =  0;
    }
    form1Insn(KVTM+I14 + fileAddr);
    form1Insn(KITS+14);
// The only files opened this way are *INPUT* and *OUTPUT*
// with known characteristics (1 word, 8 bits).
    curVal.i  =  fileBufSize * 010000000000 + 0100010;
    form1Insn(KXTS+I8 + getFCSToffset());
    if (extFileP == NULL) {
        form1Insn(KXTS);
    } else {
        curVal.i  =  extFileP->location;
        if (curVal.i == 512)
            curVal.i  =  extFileP->offset;
        form1Insn(KXTS+I8 + getFCSToffset());
    }
    formAndAlign(getHelperProc(35)); /*"FOPEN   "*/
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* Recovery for an error that leaves nothing to build a value from: skip to a
   token a statement can end on, and stand an undefined-variable node in for
   the value.  The caller reports the error and returns, so the expression
   finishes with a well-typed placeholder and the parse carries on from the
   terminator. */
void badExpr() {
    skip(skipToSet | statEndSys);
    curExpr  =  uVarPtr;
} /* badExpr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void castToReal(eptr *value) {
    /* Fold at construction when the operand is already constant, so a mixed
       int/real constant expression collapses to a single GETENUM node (the
       one case bldArithOp routes through here). */
    *value = mkUnaryFold(TOREAL, realType, *value);
} /* castToReal */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* C's assignment conversions between integer and real, applied wherever a
   value is assigned to a destination of the other type: plain assignment,
   an actual passed by value to a formal, and return.  Widening goes through
   castToReal; narrowing drops the fraction.  Returns false if the mismatch
   is not one of those,
   leaving the caller to report it. */
int castArith(tptr dest, eptr *value) {
eptr arg;
    arg  =  *value;
    if (dest == realType && typeCheck(intType, arg->typ)) {
        castToReal(value);
        return true;
    }
    if ((arg->typ != realType) || ! typeCheck(intType, dest))
        return false;
    /* mkUnaryFold folds a constant real in place, the way it does for
       castToReal's TOREAL. */
    *value = mkUnaryFold(TOINT, intType, arg);
    return true;
} /* castArith */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int areTypesCompatible(eptr *l4arg1z) {
    if (arg1Type == realType) {
        if (typeCheck(intType, arg2Type)) {
            castToReal(&curExpr);
            return true;
        }
    } else if ((arg2Type == realType) &&
               typeCheck(intType, arg1Type)) {
        castToReal(l4arg1z);
        return true;
    }
    return false;
} /* areTypesCompatible */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldBitOp(operator oper, eptr leftArg) {
    if (arg1Type.p.pk != kindScalar || arg2Type.p.pk != kindScalar) {
        error(errNeedOtherTypesOfOperands);
        curExpr = uVarPtr;
        return;
    }
    curExpr = mkExprFold(oper, arg2Type, leftArg, curExpr);
} /* bldBitOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldArithOp(operator oper, eptr leftExpr, int match) {
kind k1, k2;
operator resOp;
tptr resTyp;
int lstep, rstep;
    /* An array in an arithmetic context is the address of its first element,
       as in C, whatever stands on the other side.  A decayed char array is a
       char pointer, so it takes the byte-unit branch just below, and
       decayArray leaves anything that is not an array as it is. */
    leftExpr = decayArray(leftExpr);
    arg1Type = leftExpr->typ;
    curExpr = decayArray(curExpr);
    arg2Type = curExpr->typ;
    k1 = arg1Type.p.pk;
    k2 = arg2Type.p.pk;
    /* A char pointer is a byte index into flat memory: the byte is already
       its unit, so a count applies as it stands, and either operand may be
       the pointer.  The operands stay in source order, which an op-assign
       depends on -- it drops this node's expr1 and takes expr2 as the
       right-hand side. */
    if ((isCharPtr(arg1Type) && typeCheck(intType, arg2Type)) ||
        (isCharPtr(arg2Type) && typeCheck(intType, arg1Type))) {
        curExpr = mkExpr(oper + (oper != IMODOP), charPtrType, leftExpr, curExpr);
        return;
    }
    /* Pointer arithmetic steps in pointee units: the integer operand is
       scaled to words here, so codegen sees an ordinary integer add.  Any
       combination not taken apart below -- a scaling operator, 'int - ptr',
       a sum of two pointers -- falls into the rejection that follows. */
    lstep  =  eltStep(arg1Type);
    rstep  =  eltStep(arg2Type);
    if (lstep && rstep) {
        if (oper == MINUSOP && typeCheck(arg1Type, arg2Type)) {
            curExpr = mkExpr(INTMINUS, intType, leftExpr, curExpr);
            if (lstep != 1)
                curExpr = mkExprFold(IDIVOP, intType, curExpr, mkIntLit(lstep));
            return;
        }
    } else if (lstep) {
        if ((oper == PLUSOP || oper == MINUSOP) &&
            typeCheck(intType, arg2Type)) {
            /* Only PLUSOP and MINUSOP reach here, so the step is plain. */
            curExpr = mkExpr(oper + 1, arg1Type,
                             leftExpr, scaleIdx(curExpr, lstep));
            return;
        }
    } else if (rstep && oper == PLUSOP &&
               typeCheck(intType, arg1Type)) {
        curExpr = mkExpr(INTPLUS, arg2Type,
                         scaleIdx(leftExpr, rstep), curExpr);
        return;
    }
    if (k1 > kindScalar || k2 > kindScalar) {
        error(errNeedOtherTypesOfOperands);
L1:     curExpr = uVarPtr;
        return;
    }
    if (k1 == kindReal || k2 == kindReal) {
        if (oper == IMODOP) {
            error(62); // errIntNeeded
            goto L1;
        }
        if (k1 != kindReal)
            castToReal(&leftExpr);
        if (k2 != kindReal)
            castToReal(&curExpr);
        resOp = oper;
        resTyp = realType;
    } else {
        resOp = oper + (oper != IMODOP);
        /* One integer, but not one multiply: a product with an unsigned
           operand is the unsigned one, and says so in its own type, so a
           chain of them stays unsigned. */
        resTyp = intType;
        if (resOp == IMULOP &&
            (arg1Type == uintType || arg2Type == uintType))
            resTyp = uintType;
    }
    curExpr = mkExprFold(resOp, resTyp, leftExpr, curExpr);
} /* bldArithOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldRelOp(operator oper, eptr ex2) {
operator resOp;
    /* A compared array is its first element's address, as in C, whatever
       stands on the other side: two arrays compare those addresses, not
       their contents.  decayArray leaves anything else as it is. */
    ex2 = decayArray(ex2);
    arg1Type = ex2->typ;
    curExpr = decayArray(curExpr);
    arg2Type = curExpr->typ;
    if (typeCheck(arg1Type, arg2Type)) {
        /* A multi-word value compares only for equality; ordering it would
           need the P/EQ family to report which way.  The ordering operators
           are the ones from LTOP up, which genComparison relies on too. */
        if ((typeSize(arg1Type) != 1) &&
            (oper >= LTOP) &&
            !isCharArray(arg1Type)) {
L1:         error(errNeedOtherTypesOfOperands);
            curExpr = uVarPtr;
            return;
        }
    } else  {
        if (!areTypesCompatible(&ex2) &&
            (!isIntTyp(arg2Type) ||
             (arg1Type.p.pk != kindScalar) ||
            (oper != INOP))) {
            goto L1;
        }
    }
    if (oper IN [GTOP, LEOP]) {
        resOp = (oper == GTOP) ? LTOP : GEOP;
        curExpr = mkExpr(resOp, boolType, curExpr, ex2);
    } else {
        curExpr = mkExpr(oper, boolType, ex2, curExpr);
    }
} /* bldRelOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldLogOp(operator oper, eptr leftExpr, int match) {
/* Each operand is a condition in its own right -- genBoolAnd branches on each
   and short-circuits between them -- so each has only to be branchable, by the
   same kind test ifWhileStatement and bldCondOp use.  They need not be
   compatible with one another, which is why match, the typeCheck of one
   against the other, is not consulted: it would keep a packed field, whose
   int:N is a type of its own, out of an && with an int, which is exactly the
   mismatch the kind test exists to end. */
    if (arg1Type.p.pk > kindPtr || arg2Type.p.pk > kindPtr) {
        error(errNeedOtherTypesOfOperands);
        curExpr = uVarPtr;
    } else {
        curExpr = mkExprFold(oper, boolType, leftExpr, curExpr);
    }
} /* bldLogOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldCondOp(eptr condExpr, eptr thenExpr) {
tptr resType;
eptr altExpr;
    if (condExpr->typ.p.pk > kindPtr) {
        error(errBooleanNeeded);
        return;
    }
    arg1Type = thenExpr->typ;
    arg2Type = curExpr->typ;
    if (!typeCheck(arg1Type, arg2Type)) {
        error(errNeedOtherTypesOfOperands);
        return;
    }
    resType = arg1Type;
    if (typeSize(resType) != 1) {
        error(errNeedOtherTypesOfOperands);
        return;
    }
    altExpr = mkExpr(ALTERN, resType, thenExpr, curExpr);
    curExpr = mkExpr(CONDOP, resType, condExpr, altExpr);
} /* bldCondOp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void outputObjFile() {
int idx;
    padToLeft();
    for (idx = 1; idx < objBufIdx; ++idx)
        fputw(objBuffer[idx], &_CHILD_);
    lineStartOffset  =  moduleOffset;
    prevOpcode  =  0;
} /* outputObjFile */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genOneOp() { /* genOneOp */
int insnBufIdx;
int noElide, bufMark;
int i, l4var3z, l4var4z;
oiptr l4inl6z, l4inl7z, l4inl8z;
int l4var9z;
int insnBuf[201];
int curInsn;
int tempInsn;
oiptr l4oi212z;
int l4var213z;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void addInsnToBuf(int insn) {
    insnBuf[insnBufIdx]  =  insn;
    ++insnBufIdx;
} /* addInsnToBuf */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void add2InsnsToBuf(int insn1, int insn2) {
    insnBuf[insnBufIdx]  =  insn1;
    insnBuf[insnBufIdx+1]  =  insn2;
    insnBufIdx += 2;
} /* add2InsnsToBuf */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int findLabel() {
    l4inl7z  =  l4inl6z;
    while (l4inl7z) {
        if (l4inl7z->mode == curInsn) {
