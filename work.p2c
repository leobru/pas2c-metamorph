                curIdRec = malloc(offsetof(identrec, szRoutine));
                { register identrec *ir = curIdRec;
                    ir->id  =  curIdent;
                    ir->pck.p.offset  =  curFrameRegTemplate;
                    ir->pck.p.next  =  symHash[bucket];
                    ir->typ  =  voidType;
                    symHash[bucket]  =  curIdRec;
