//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void processInsn() {
        curInsn  =  insnBuf[l4var4z];
        tempInsn  =  curInsn & [23:32];
        if (tempInsn == KATX+SP) {
            i  =  l4var4z + 1;
            while (insnBufIdx + 1 != i) {
                curVal.i  =  insnBuf[i] & [23, 28:35];
                tempInsn  =  curVal.i & [23, 28:32];
                if (curVal.i == KXTA) {
