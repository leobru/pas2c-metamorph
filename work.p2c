//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              PrintErrMsg               %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void printErrMsg(int errno) { /* PrintErrMsg */
typedef __packed textchar errtxt[101];
typedef errtxt *perrtxt;
perrtxt errptr;
textchar errtext[101];
int i;
char c;
//
    perrtxt pasmitxt(int errno) fortran;
//
    char pasisoxt(textchar txtchar) fortran;
//
    write(' ');
    if (errno >= 200)
        write('system=', errno:0);
    else {
        if (errno > 88)
            printErrMsg(86);
        else if (errno in [16..17, 20]) {
            if (errno == 20)
                errno  =  (sy == ident)*2 + 1;
            else
                write(curToken.i:0,' ');
        }
        errptr  =  pasmitxt(errno);
        unpack(*errptr, errtext, 0);
        for (i = 0; i <= 100; ++i) {
            c  =  pasisoxt(errtext[i]);
            if (c == '*')
                break;
            write(c);
        }
        write(' ');
        if (errno in [17, 22])
            if (errno == 17)
                write(errLine:0);
            else
                write(stmtName);
    }
    if (errno != 86)
        writeln;
} /* PrintErrMsg */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              printTextWord             %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void printTextWord(int val) { /* printTextWord */
//
    void PASTPR(int val) extern;
//
    write(' ');
    PASTPR(val);
} /* printTextWord */
