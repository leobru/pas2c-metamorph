    l4var5z  =  insnList->typ.p.pk;
    isSimple  =  l4var5z < kindArray ||
                (l4var5z == kindStruct && insnList->typ.rep->lsbord);
    sh  =  insnList->shift;
    wd  =  insnList->width;
    ends  =  sh + wd;
    if (isSimple) {
// The commented out optimization is specific to the original BESM-6
// without a barrel shifter; it is not needed here.
//      if (30 < sh) {
//          addToInsnList(ASN64-48 + sh);
//          addToInsnList(KYTA);
//      } else {
            if (sh)
                addToInsnList(ASN64 + sh);
//      }
        if (ends != 48) {
            curVal.i  =  all1 >> (48 - wd);
            addToInsnList(KAAX+I8 + getFCSToffset());
        }
