void labCheckAndDefine(int isDef) {
int labIdx;
    labIdx  =  numLabTop - 1;
    while ((labIdx >= labFence) && (numLabs[labIdx].id != curToken.i))
        --labIdx;
    if (labIdx < labFence) {
            if (numLabTop >= 20) {
                error(50); /* errSymbolTableOverflow */
                return;
            }
            { register numLabel *nlp = &numLabs[numLabTop];
                nlp->id  =  curToken.i;
                nlp->offset  =  0;
                nlp->line  =  lineCnt;
                nlp->defined  =  false;
            }
            labIdx  =  numLabTop;
            ++numLabTop;
    }
    { register numLabel *nlp = &numLabs[labIdx];
        if (isDef) {
            if (nlp->defined) {
                errLine  =  nlp->line;
                error(17); /* errLblAlreadyDefinedInLine */
                return;
            }
            nlp->line  =  lineCnt;
            nlp->defined  =  true;
            if (nlp->offset == 0) {
                /* empty */
            } else if (nlp->offset >= 074000) {
                curVal.i  =  moduleOffset - 040000;
                symTab[nlp->offset - 074000]  =
                    [24,29] | (curVal.i & 077777U);
            } else
                fixup(0, nlp->offset);
            nlp->offset  =  moduleOffset;
        } else {
                if (nlp->offset >= 040000)
                    form1Insn(KUJ + nlp->offset);
                else
                    formJump(&nlp->offset);
        }
    }
} /* labCheckAndDefine */
