//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The type of an already declared routine, from its parameter records. */
tptr makeRoutineType(irptr routine) {
irptr srcParam;
sigptr newParam, lastParam, head;
    head  =  NULL;
    lastParam  =  NULL;
    srcParam  =  routine->argList;
    if (srcParam != NULL)
