    curExternFile = malloc(sizeof(extFileRec));
    { register extfilerec *efp = curExternFile;
        efp->id  =  curIdent;
        efp->next  =  externFileList;
        efp->line  =  extLine;
        efp->offset  =  aligned;
    }
    if (extLine != 0) {
        if (curIdent == litOutput)
            fileForOutput  =  curExternFile;
        else
            fileForInput  =  curExternFile;
    }
    externFileList  =  curExternFile;
    curExternFile->location  =  512;
}

