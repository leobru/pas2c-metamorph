/* A jmp_buf is six words: the caller's frame and the setjmp return address
   packed into one, then M2-M6.  A longjmp does not pass through C/E, so the
   display registers come back from there. */
void longjmp(int *jmpbuf, int val) assembler;
int setjmp(int *jmpbuf) assembler;
int setup() assembler;
void rollup(int addr) assembler;
int heaptop() assembler;
void settop(int top) assembler;
int talloc(int words) assembler;
typedef ifcb *pfcb;
// An external has no body to name its parameters from, so these leave the
// declarators abstract -- the types alone are what the call sites check.
void fopen(pfcb, int, int) assembler;
void frewind(pfcb) assembler;
int feof(pfcb) assembler;
int fgetc(pfcb) assembler;
int fgetw(pfcb) assembler;
void fputw(int, pfcb) assembler;
int pck(int *) assembler;
void unpck(int, int *) assembler;
void unpackt(void *, void *, int) assembler;
int has(int, int) assembler;
void putln() assembler;
void putchar(char) assembler;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              printTextWord             %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void printTextWord(int val) {
    printf(" %t", val);
} /* printTextWord */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              PrintErrMsg               %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void printErrMsg(int errno) { /* PrintErrMsg */
typedef __packed textchar errtxt[101];
typedef errtxt *perrtxt;
perrtxt errptr;
textchar errtext[101];
int i;
char c;
//
    perrtxt pasmitxt(int errno) fortran;
//
    char pasisoxt(textchar txtchar) fortran;
//
    putchar(' ');
    if (errno >= 200)
        printf("system=%d", errno);
    else {
        if (errno > 88)
            printErrMsg(86);
        else if (errno == 20)
            errno  =  (sy == ident)*2 + 1;
        else if (errno == 17) {
            printTextWord(curToken.i);
            putchar(' ');
        }
        errptr  =  pasmitxt(errno);
        unpackt(errptr, &errtext, 101);
        for (i = 0; i <= 100; ++i) {
            c  =  pasisoxt(errtext[i]);
            if (c == '*')
                break;
            putchar(c);
        }
        putchar(' ');
        if (has([17, 22], errno))
            if (errno == 17)
                printf("%d", errLine);
            else
                printf("%a", stmtName);
    }
    if (errno != 86)
        putln();
} /* PrintErrMsg */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              addToHashTab              %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void addToHashTab(irptr arg) {
    curVal.i = mapai(arg->id & hashMask);
    arg->pck.p.next  =  symHash[curval.i];
    symHash[curval.i]  =  arg;
} /* addToHashTab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void toFCST() {
    fputw(curVal.i, &FCST);
    ++FcstCnt;
} /* toFCST */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Lay the buffered string into the constant pool; answer where it starts.
int strToFCST() {
int i, start;
    start  =  FcstCnt;
    for (i = 0; i < strWords; ++i) {
        curVal.i  =  strBuf[i];
        toFCST();
    }
    return start;
} /* strToFCST */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int addCurValToFCST() {
const int MAXLIT = 500;
int low, high, mid;
static int constVals[MAXLIT], constNums[MAXLIT];
    low  =  0;
    if (FcstCountTo500 == 0) {
        FcstCountTo500  =  1;
        constVals[0]  =  curVal.i;
        constNums[0]  =  FcstCnt;
    } else {
        high  =  FcstCountTo500 - 1;
        do {
            mid  =  (low + high) / 2U;
            if (curVal.i == constVals[mid]) {
                return constNums[mid];
            }
            if ((uword)curval.i < (uword)constVals[mid])
                high  =  mid - 1;
            else
                low  =  mid + 1;
        } while (high >= low);
        if (FcstCountTo500 != MAXLIT) {
            high  =  (uword)curval.i < (uword)constVals[mid] ? mid : mid + 1;
            for (mid  =  FcstCountTo500 - 1; mid >= high; --mid) {
                low  =  mid + 1;
                constVals[low]  =  constVals[mid];
                constNums[low]  =  constNums[mid];
            }
            ++FcstCountTo500;
            constVals[high]  =  curVal.i;
            constNums[high]  =  FcstCnt;
        }
    }
    toFCST();
    return FcstCnt - 1;
} /* addCurValToFCST */
//
void error(int errno);
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void endOfLine() {
int err, errPos, prevPos, listMode,
    startPos, lastErr;
    listMode  =  pasinfor.listMode;
    if (listMode || errsInLine) {
        printf(" %05o%5d%3d%c", lineStartOffset + PASINFOR.startOffset,
              lineCnt, lineNesting, commentModeCH);
        startPos  =  12;
        do
            --linePos;
        while (linePos >= 0 && lineBuf[linePos] == ' ');
        for (err = 0; err <= linePos; ++err) {
            putchar(linebuf[err]);
        }
        putln();
        if (errsInLine) {
            // lineBuf is indexed from 0, so a position field of errMap[0]
            // columns is one short of what the marker needs; the format
            // carries the column, as it carries the '0'.
            printf("%*s  %*c0", startPos, "*****", errMap[0], ' ');
            lastErr  =  errsInLine - 1;
            for (err = 1; err <= lastErr; ++err) {
                errPos  =  errMap[err];
                prevPos  =  errMap[err-1];
                if (errPos != prevPos) {
                    if (prevPos + 1 != errPos)
                        printf("%*c", errPos-prevPos-1, ' ');
                    putchar((char)(err + '0'));
                }
            }
            putln();
            errsInLine  =  0;
            prevErrPos  =  0;
        }
    }
    lineStartOffset  =  moduleOffset;
    linePos  =  -1;
    ++lineCnt;
} /* endOfLine */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              form1Insn                 %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form1Insn(int arg) {
int insn, opcode;
int half1, half2;
int pos;
int noElide;
static int prevInsn;
    noElide  =  arg & insnNoElide;
    insn  =  arg & ~insnNoElide;
    opcode = insn & 077700000;
    if (opcode == KUJ) {
        if (prevOpcode == opcode)
            return; /* no use in UJ after UJ */
        if (! (objHalfIdx & 1) && prevOpcode == 1) {
            pos  =  objHalfIdx - 2;
            if ((objBuffer.halves[pos] & 077700000) == KVJM+I13) {
                prevOpcode  =  opcode;
                half1 = insn & 077777U;
                half2 = objBuffer.halves[pos] & 077777U;
                objBuffer.halves[pos]  =  KVTM+I13 | half1;
                objBuffer.halves[pos+1]  =  KUJ | half2;
                return;
            }
        }
    } else if (!noElide && prevOpcode > 1 && insn & 07777 &&
        (insn ^ prevInsn) == (KATX ^ KXTA) /* maybe ATX/XTA */) {
// Load after store; if the load reg/off is the same as the store,
// and the store was not a stack push, there is no need to do the read.
// Not when the load is marked: it is feeding a branch, and dropping it would
// leave the branch reading whatever omega the body computed with -- after an
// additive op that is a sign test, not "is it zero".
        if (prevInsn != KATX+SP &&
            (prevInsn & 02770000) == KATX /* but still ATX */)
            return; /* skip the XTA */
    }
    prevOpcode  =  opcode;
    prevInsn  =  insn;
    objBuffer.halves[objHalfIdx]  =  insn & halfWord;
    ++objHalfIdx;
    if (! (objHalfIdx & 1)) {
        ++moduleOffset;
        if (objHalfIdx == 2050) {
            error(49); /* errTooManyInsnsInBlock */
            objHalfIdx  =  2;
        }
    }
} /* form1Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form2Insn(int i1, int i2) {
    form1Insn(i1);
    form1Insn(i2);
} /* form2Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form3Insn(int i1, int i2, int i3) {
    form2Insn(i1, i2);
    form1Insn(i3);
} /* form3Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void disableNorm() {
const int disNormTemplate = KNTR+7;
    if (arithMode != 1) {
        form1Insn(disNormTemplate);
        arithMode  =  1;
    }
} /* disableNorm */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formJump(int *arg) {
int pos;
    if (prevOpcode != KUJ) {
        pos  =  objHalfIdx;
        form1Insn(jumpType + *arg);
        if (objHalfIdx == pos)
            pos -= 2;
        *arg  =  pos;
    }
} /* formJump */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void padToLeft() {
    if (objHalfIdx & 1)
        form1Insn(KUTC);
    prevOpcode  =  0;
} /* padToLeft */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formAndAlign(int arg) {
    form1Insn(arg);
    padToLeft();
    prevOpcode  =  1;
} /* formAndAlign */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCharArray(tptr arg) {
    return arg.p.pk == kindArray && arg.rep->base == charType;
} /* isCharArray */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCompactP(tptr t) {
/* An ordinary pointer type encoded wholly in the tptr word: rep, psize
 * and bits carry the ultimate non-pointer base, pad packs depth*8 plus
 * the base kind.  Base kind 0 is never encoded (pointer-to-void is the
 * voidPtr singleton), so a heap-allocated pointer descriptor, whose pad
 * is 0, is not mistaken for a compact pointer. */
    return t.p.pk == kindPtr && (t.p.pad & 7) != 0;
} /* isCompactP */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int typeBits(tptr typtr) {
    if (isCompactP(typtr))
        return 15;
    return typtr.p.bits;
} /* typeBits */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
unsigned typeSize(tptr typtr) {
    if (isCompactP(typtr))
        return 1;
    return typtr.p.psize;
} /* typeSize */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr ptrBase(tptr t) {
/* Pointee of a pointer type: compact words reconstruct it in place,
 * heap-allocated descriptors read the record. */
tptr b;
    if (!isCompactP(t))
        return t.rep->base;
    b = t;
    if (t.p.pad >= 020) {
        b.p.pad = t.p.pad - 010;
    } else {
        b.p.pk = (kind)(t.p.pad & 7);
        b.p.pad = 0;
    }
    return b;
} /* ptrBase */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCharPtr(tptr arg) {
    return arg.p.pk == kindPtr && typeSize(arg) == 1 &&
           ptrBase(arg) == charType;
} /* isCharPtr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* A pointer to a routine, i.e. a function pointer.  getPtrType always
   compact-encodes one (a routine type leaves pad 0), so the test is on the
   encoding itself: calling ptrBase here would read the pointee descriptor,
   which a pointer with no descriptor of its own -- voidPtr -- does not
   have. */
int isRoutinePtr(tptr arg) {
    return isCompactP(arg) && (arg.p.pad == 010 + (int)kindRoutine);
} /* isRoutinePtr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The step for pointer arithmetic: the pointee's size in words.  A step of
   0 bars the arithmetic; it covers a void pointer, which is what '&x' and
   NULL are here, and a pointer to a routine, whose value is an entry
   address. */
int eltStep(tptr t) {
    if (t.p.pk != kindPtr || t == voidPtr || isRoutinePtr(t))
        return 0;
    return typeSize(ptrBase(t));
} /* eltStep */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void putToSymTab(int arg) {
    symTab[symTabPos - 074000]  =  arg;
    if (symTabPos == 075500) {
        error(50); /* errSymbolTableOverflow */
        symTabPos  =  074000;
    } else
        ++symTabPos;
} /* putToSymTab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int allocExtSymbol(int sym) {
int i;
    if (curVal.i & halfWord) {
        for (i = 0; i < longSymCnt; ++i)
            if (curVal.i == longSyms[i]) {
                return longSym[i];
            }
        if (longSymCnt >= 90) {
            error(51); /* errLongSymbolOverflow */
            longSymCnt  =  0;
        }
        longSym[longSymCnt]  =  symTabPos;
        longSyms[longSymCnt]  =  curVal.i;
        ++longSymCnt;
        sym  |=  020000000U;
    } else
        sym  |=  curVal.i;
    putToSymTab(sym);
    return symTabPos - 1;
} /* allocExtSymbol */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getHelperProc(int l3arg1z) {
/* The external symbol allocated for each helper, remembered so that a helper
   named twice costs one symbol.  Nothing else reads it, and it has to survive
   the call, so it is this routine's own static. */
static int helperMap[30] = 0:30;
    if (helperMap[l3arg1z] == 0) {
        curVal.i  =  helperNames[l3arg1z];
        helperMap[l3arg1z]  =  allocExtSymbol(extSymMask);
    }
    return  helperMap[l3arg1z] + (KVJM+I13);
} /*getHelperProc */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int allocSymtab(int arg) {
const int SYMTAB_MAX = 80;
int low, high, mid, ret;
word value;
static word symTabArray[SYMTAB_MAX];
static int symtbidx[SYMTAB_MAX];
    low  =  0;
    value.i  =  arg;
    if (symTabCnt == 0) {
        ret  =  symTabPos;
        symTabCnt  =  1;
        symTabArray[0].i  =  arg;
        symtbidx[0]  =  symTabPos;
    } else {
        high  =  symTabCnt;
        do {
            mid  =  (low + high) / 2U;
            if (value == symTabArray[mid]) {
                return symtbidx[mid];
            }
            if ((uword)value.i < (uword)symTabArray[mid].i)
                 high  =  mid;
            else
                 low  =  mid + 1;
        } while (high > low);
        ret  =  symTabPos;
        if (symTabCnt != SYMTAB_MAX) {
            high  =  (uword)value.i < (uword)symTabArray[mid].i ? mid : mid + 1;
            for (low  =  symTabCnt; low > high; --low) {
                mid  =  low - 1;
                symTabArray[low]  =  symTabArray[mid];
                symtbidx[low]  =  symtbidx[mid];
            }
            ++symTabCnt;
            symTabArray[high]  =  value;
            symtbidx[high]  =  symTabPos;
        }
    }
    putToSymTab(value.i);
    return ret;
} /* allocSymtab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getFCSToffset() {
int offset;
    offset  =  addCurValToFCST();
    if (offset < 2048) {
        return offset;
    } else if (offset >= 4096)
        error(204);
    else {
        return allocSymtab(offset | 040000000U) - 070000;
    }
} /* getFCSToffset */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr mkIntScl(int bitWid) {
tptr res;
inptr icand;
    if (bitWid < 1 || 40 < bitWid) {
        error(errNumberTooLarge);
        return intType;
    }
    icand = internHead;
    while (icand) {
        res = icand->ityp;
        if (res.p.pk == kindScalar && res.p.bits == bitWid)
            return res;
        icand = icand->inext;
    }
    res.rep = malloc(offsetof(types, szScalar));
    { register types *ty = (res.rep);
        ty->start = -1;
        ty->enums = NULL;
        ty->numen = 1 << bitWid;
    }
    res.p.psize  =  1;
    res.p.bits  =  bitWid;
    res.p.pk  =  kindScalar;
    icand = malloc(sizeof(internrec));
    icand->ityp = res;
    icand->inext = internHead;
    internHead = icand;
    return res;
} /* mkIntScl */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getValueOrAllocSymtab(int value) {
    curVal.i  =  value & 077777;
    return (040000 >= curVal.i) ? curVal.i
        : allocSymtab((curVal.i | 040000000U) & halfWord);
} /* getValueOrAllocSymtab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// fixup -- address-fixup helper.  mode 0 starts a chain at moduleOffset,
// and the other modes patch a pending chain; see the arms below.
void fixup(int mode, int arg) {
int addr, insn;
int work, offset;
    if (mode == 0) {
        padToLeft();
        curVal.i  =  moduleOffset;
L1:     addr  =  curval.i & 077777U;
        while (arg) {
            insn  =  objBuffer.halves[arg];
            curVal.i  =  insn & 077777U;
            objBuffer.halves[arg]  =  insn & 077700000 | addr;
            arg  =  curVal.i;
        }
        return;
    } else if (mode == 2) {
        form1Insn(KVTM+I14 + curVal.i);
        if (curVal.i == 074001)
            form1Insn(KUTM+I14 + FcstCnt);
        form3Insn(KITA+14, KASN + arg, KAOX+I7+1);
        form1Insn(KATX+I7+1);
        return;
    } else if (mode < -2) {
        arg  -=  curVal.i;
        offset  =  getFCSToffset();
        work  =  -mode;
        curVal.i  =  arg;
        arg  =  getFCSToffset();
        form3Insn(KATX+SP+1, KSUB+I8 + offset, work);
        form3Insn(KRSUB+I8 + arg, work, KXTA+SP+1);
        return;
    } else if (mode == -1) {
        form1Insn(KVTM+I14 + lineCnt);
        formAndAlign(getHelperProc(arg));
        return;
    }
    curVal.i  =  mode;
    goto L1;
} /* fixup */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void requiredSymErr(symbol sym) {
    if (linePos != prevErrPos) {
        error(sym + 88);
    }
} /* requiredSymErr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void readToPos80() {
int c;
    while (linePos < 80) {
        ++linePos;
        c  =  fgetc(&PASINPUT);
        lineBuf[linePos]  =  c;
    }
    endOfLine();
} /* readToPos80 */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void nextCH() {
    /* An inserted source fragment belongs to the current physical source
       position.  Read it without touching the line buffer or EOF accounting,
       and put the file character which was current at insertion back when the
       terminating zero is reached. */
    if (lexMemPtr != NULL) {
        CH  =  *lexMemPtr;
        ++lexMemPtr;
        if (CH == 0) {
            lexMemPtr  =  NULL;
            CH  =  lexSaveCH;
            atEOL  =  lexSaveEOL;
        } else {
            if (CH == '\n')
                CH  =  ' ';
            atEOL  =  false;
        }
        return;
    }
    if (CH == 0) {
        ++eofOverreads;
        if (eofOverreads > maxLineLen) {
            error(errEOFEncountered);
            longjmp(jb9999, 1);
        }
        atEOL  =  true;
        if (linePos < maxLineLen-1)
            ++linePos;
        return;
    }
    /* Columns past lineBuf are dropped, not stored: keep reading them until
       the line ends, so that CH comes back at the line's end and neither
       linePos nor the stores leave the buffer. */
    do {
        CH  =  fgetc(&PASINPUT);
        atEOL  =  CH == '\n' || CH == 0;
        if (linePos < maxLineLen-1) {
            ++linePos;
            lineBuf[linePos]  =  CH;
            return;
        } 
    } while (! atEOL);
} /* nextCH */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void lexFromString(char *text) {
    lexSaveCH  =  CH;
    lexSaveEOL  =  atEOL;
    lexMemPtr  =  text;
    nextCH();
} /* lexFromString */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parseComment() { /* parseComment */
int badOpt, flag;
char c;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int readOptVal(int limit) {
int t;
    nextCH();
    t  =  0;
    while (('9' >= CH) && (CH >= '0')) {
        t  =  10 * t + CH - '0';
        nextCH();
        badOpt  =  false;
    }
    if (limit < t)  badOpt  =  true;
    return t;
} /* readOptVal */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void readOptFlag(int *res) {
    nextCH();
    if (CH == '-' || CH == '+') {
        *res  =  CH == '+';
        badOpt  =  false;
    }
    nextCH();
} /* readOptFlag */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    nextCH();
    if (CH == '=') {
        do {
        nextCH();
        badOpt  =  true;
        switch (CH) {
        case 'F': readOptFlag(&checkFortran); break;
        case 'I': readOptFlag(&enableStdInput); break;
        case 'L': PASINFOR.listMode = readOptVal(3); break;
        case 'C': readOptFlag(&checkTypes); break;
        case 'B': fileBufSize = readOptVal(4); break;
        case 'K': heapSize = readOptVal(23); break;
        }
        if (badOpt) {
            error(54); /* errErrorInPseudoComment */
        }
        } while (CH == ',');
    }
    do {
        while (CH != '*') {
            if (CH == 0) {
                error(errEOFEncountered);
                longjmp(jb9999, 1);
            }
            c  =  commentModeCH;
            commentModeCH  =  '*';
            if (atEOL)
                endOfLine();
            nextCH();
            commentModeCH  =  c;
        }
        nextCH();
    } while (CH != '/');
    nextCH();
} /* parseComment */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int skipSp() {
     while ((CH == ' ' || CH == '\t') && !atEOL)
         nextCH();
     if (CH == 0)
         return false;
     if (atEOL) {
         endOfLine();
         nextCH();
         return true;
     }
     return false;
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void inSymbol() { /* inSymbol */
/* Six characters more than doCharConst's 125 and its six-word lead-in: the
   padding word is unpacked past the last character, and a string filling its
   last word exactly is packed one word beyond that for the terminator. */
int localBuf[137];
/* The class each character lexes as.  charSym, declared beside it, says which
   symbol; that one is read elsewhere too, this one only here. */
static operator chrClass['\200'] = {
    NOOP:128,
    ['0']=ALNUM:10, ['A']=ALNUM:26, ['Ю']=ALNUM:31, ['_']=ALNUM,
    ['+']=PLUSOP, ['-']=MINUSOP, ['|']=SETOR, ['*']=MUL, ['/']=RDIVOP,
    ['%']=IMODOP, ['^']=SETXOR, ['=']=ASSIGNOP, ['&']=SETAND,
    ['>']=GTOP, ['<']=LTOP, ['!']=NOTOP, ['~']=BITNEGOP, ['?']=CONDOP };
int tokenLen, tokenIdx;
int expSign;
irptr chain;
float expMultiple, expValue;
char curChar;
char litQuote;
kword *keywordHashPtr;
char prevCH;
word numstr[17];
int expLiteral, expMagnitude;
int charBits, charMask;
int val;
int jb1473[6];
int literalEncoding;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void doCharConst(char lim) {
// Set of characters that are not themselves after \
// 0123 4567 89:; <=>? @ABC DEFG HIJK LMNO PQRS TUVW XYZ
// ++++ ++++            ++    +         +    +  + +
//             11 1111 1111 2222 2222 2233 3333 3333 4444 4444
//             01 2345 6789 0123 4567 8901 2345 6789 0123 4567
const int escSet = 0xFF0062022A00,
          escMap = 007101412151113;
int advanced;
   advanced  =  false;
   for (tokenIdx = 6; tokenIdx <= 130; ++tokenIdx) {
       if (! advanced)
           nextCH();
       advanced  =  false;
       if (CH == lim) {
           nextCH();
           return;
       }
       if (atEOL) {
