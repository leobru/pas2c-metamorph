//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void genConstDiv() {
float r;
    if (card(arg2val.i) > 1) {
        curVal.r = 1.0 / arg2Val.i;
        r = curVal.r * arg2Val.i;
        curVal.i = curVal.i & [7..47];
        if (r < 1.0)
            curVal.i = curVal.i + 1;
        curVal.i = curVal.i | E48;
        addToInsnList(KMUL+I8 + getFCSToffset());
