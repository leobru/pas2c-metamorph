            if (lastParam == NULL)
                head  =  newParam;
            else
                lastParam->next  =  newParam;
            lastParam  =  newParam;
            srcParam  =  srcParam->list;
        }
    return mkRoutineTyp(routine->typ, head, routine->flags);
} /* makeRoutineType */
