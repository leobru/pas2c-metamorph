//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldCondOp(eptr condExpr, eptr thenExpr) {
tptr resType;
eptr altExpr;
    if (condExpr->typ.p.pk > kindPtr) {
        error(errBooleanNeeded);
        return;
    }
    arg1Type = thenExpr->typ;
    arg2Type = curExpr->typ;
    if (!typeCheck(arg1Type, arg2Type)) {
        error(errNeedOtherTypesOfOperands);
        return;
    }
    resType = arg1Type;
    if (typeSize(resType) != 1) {
        error(errNeedOtherTypesOfOperands);
        return;
    }
    altExpr = mkExpr(ALTERN, resType, thenExpr, curExpr);
    curExpr = mkExpr(CONDOP, resType, condExpr, altExpr);
} /* bldCondOp */
