//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The routine type proper: a result type and a parameter signature.  The
   whole-word assignment to .rep clears the descriptor metadata, so pad comes
   out 0 and getPtrType can compact-encode a pointer to this type. */
tptr mkRoutineTyp(tptr result, sigptr params, int flags) {
tptr resultTyp;
    resultTyp.rep = malloc(offsetof(types, szRtype));
    { register types *ty = (resultTyp.rep);
        ty->rresult  =  result;
        ty->rparams  =  params;
        ty->rflags  =  flags;
    }
    resultTyp.p.psize  =  1;
    resultTyp.p.bits  =  15;
    resultTyp.p.pk  =  kindRoutine;
    return resultTyp;
} /* mkRoutineTyp */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The type of an already declared routine, from its parameter records. */
tptr makeRoutineType(irptr routine) {
/* The type of an already declared routine.  Its signature is kept from the
   declaration, so there is nothing to rebuild. */
    return mkRoutineTyp(routine->typ, routine->r1.sig, routine->flags);
} /* makeRoutineType */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int leftAlign(int val) {
    while ((val & [0..5]) == 0U) {
        val <<= 6;
    }
    return val;
} /* leftAlign */
