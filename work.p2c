//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Declaration-site initializers (C-style).  Each global '= initializer' is
// buffered into the INITBUF scratch file as a stream of 3-word entries --
// (0, base, 0) opens a target segment and (1, value, count) is an item, a
// string wider than a word being as many items as it has words -- and
// materialized once, at program end, by flushInitializers as the contiguous
// trailing data region of FCST (which must follow the whole constant pool:
// finalize describes it only by length+count).
void putInitEntry(int k, int a, int b) {
    fputw(k, &INITBUF);
    fputw(a, &INITBUF);
    fputw(b, &INITBUF);
} /* putInitEntry */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Materialize all buffered initializers as the contiguous trailing data region
// of FCST.  Called at program end, after the whole constant pool has been laid
// down; replays the INITBUF stream with one-entry lookahead so 'hasNext' drives
// the list/fill record emission (consecutive single values coalesce into one
// record; a 'value:count' is a fill).
void flushInitializers() {
