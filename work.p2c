//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void factor() { /* factor */
int l4var1z, l4var3z, l4var4z;
eptr l4exp5z, newExpr, l4var7z, l4var8z;
irptr routine;
tptr l4typ11z;
int l4var12z;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void stdCall() {
operator l5op1z;
tptr l5var2z;
int asBitset;
int stProcNo, checkMode, resultValue;
int hasFields;
    stProcNo  =  routine->low;
    if (SY != LPAREN) {
        requiredSymErr(LPAREN);
        badExpr();
        return;
    }
    if (has([fnSIZEOF, fnOFFSETOF], stProcNo)) {
        lookupMode = lookUse;
        inSymbol();
        if (SY == TYPESY) {
            /* A whole type name, declarator and all: sizeof(char *),
               sizeof(int[4]), offsetof(rec, f). */
            l5var2z = readTypeName();
        } else {
            if (stProcNo == fnSIZEOF) {
                readNext = false;
                expression();
                l5var2z = curExpr->typ;
            } else {
                error(errNotAType);
                l5var2z = intType;
                if (SY == IDENT)
                    inSymbol();
            }
        }
        if (stProcNo == fnOFFSETOF) {
            /* Only a record has fields.  Error 22 names the construct it is
               reporting on, since stmtName otherwise still holds whatever
               operator set it last. */
            hasFields  =  l5var2z.p.pk == kindStruct;
            if (! hasFields) {
                stmtName  =  'OFFSET';
                error(errWrongVarTypeBefore);
            }
            if (SY != COMMA)
                requiredSymErr(COMMA);
            else {
                typ121z = l5var2z;
                lookupMode = lookField;
                inSymbol();
            }
            resultValue = 0;
            if (SY != IDENT) {
                error(errNoIdent);
            } else {
                /* The name is read either way, to keep the parse in step, but
                   looked up only where a field could be found. */
                if (hasFields) {
                    if (hashTravPtr == NULL)
                        error(errNotDefined);
                    else
                        resultValue = hashTravPtr->pck.p.offset;
                }
                inSymbol();
            }
        } else {
            resultValue = typeSize(l5var2z);
        }
        curExpr = mkIntLit(resultValue);
        checkSymAndRead(RPAREN);
        return;
    }
    expression();
    arg1Type  =  curExpr->typ;
    /* The set of functions this argument type admits.  Every type outside
       these two admits none: the address-of operator is not one of them. */
    if (arg1Type == realType)
        checkMode  =  [fnABS];
    else if (isIntTyp(arg1Type))
        checkMode  =  [fnABS, fnMALLOC, fnCARD, fnMINEL];
    else
        checkMode  =  0U;
    asBitset  =  E48 >> stProcNo;
    if ((stProcNo != fnSIZEOF) && ((asBitset & checkMode) == 0U))
        error(errNeedOtherTypesOfOperands);
    if ((asBitset & (E48>>fnABS | E48>>fnSIZEOF)) == 0U) {
        arg1Type  =  routine->typ;
    } else if (isIntTyp(arg1Type) && (stProcNo == fnABS)) {
        stProcNo  =  fnABSI;
    }
    if (stProcNo == fnSIZEOF)
      curExpr  =  mkIntLit(typeSize(arg1Type));
   else
      curExpr  =  mkExpr(STANDPROC, arg1Type, curExpr, (eptr)stProcNo);
    checkSymAndRead(RPAREN);
} /* stdCall */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    switch (SY) {
    case IDENT:
        if (hashTravPtr == NULL) {
            error(errNotDefined);
            curExpr  =  uVarPtr;
            inSymbol();
        } else
            switch (hashTravPtr->pck.p.cl) {
            case ENUMID:
                curExpr = malloc(sizeof(expr));
                { register expr *ex = curExpr;
                    ex->typ  =  hashTravPtr->typ;
                    ex->op  =  GETENUM;
                    ex->num1  =  hashTravPtr->value;
                    ex->num2  =  0;
                }
                inSymbol();
                break;
            case ROUTINEID:
                routine  =  hashTravPtr;
                inSymbol();
                if (routine->pck.p.offset == 0) {
                    if ((routine->typ != voidType) &&
                       (SY == LPAREN)) {
                        stdCall();
                    } else {
                        error(44); /* errIncorrectUsageOfStandProcOrFunc */
                        curExpr  =  uVarPtr;
                    }
                } else if (SY == LPAREN) {
                    parseCallArgs(routine, NULL);
                } else {
                    /* A routine named without an argument list is a function
                       designator, and is worth its entry address; a '&' in
                       front of it is the identity, as in C. */
                    if (routine->pck.p.offset != frameRegTemplate) {
                        /* A nested routine needs a display an indirect call
                           has no way to set up. */
                        error(81); /* errProcNestingTooDeep */
                        curExpr  =  uVarPtr;
                    } else {
                        /* The routine's type is built here, on demand, and
                           not kept in its record: a stored one would cost
                           every routine a heap record, and this compiler has
                           barely any heap to spare when compiling itself. */
                        curExpr  =  mkExpr(PROCADDR,
                                           getPtrType(makeRoutineType(routine)),
                                           NULL, (eptr)routine);
                    }
                }
                break;
            case VARID: case REGID: case STATICID:
                parseLval();
            } /* switch */
        break;
    case LPAREN:
        inSymbol();
        if (SY == TYPESY) {
            /* '(' type-name ')' cast-expression.  int and float differ in
               representation, so a cast between the two converts, the way an
               assignment does; any other pair of types of the same size is a
               reinterpretation, and costs nothing. */
            l4typ11z  =  readTypeName();
            checkSymAndRead(RPAREN);
            parseUnaryExpression();
            /* An enumeration whose enumerators were left to run in sequence
               carries a table of their names; a cast of one to a text word
               answers the name rather than the ordinal, which is what %t
               writes.  Not folded even for a constant enumerator: the name
               lives in the constant pool, so it is read there. */
            if (isTextWord(l4typ11z) &&
                curExpr->typ.p.pk == kindScalar &&
                curExpr->typ.rep->start != -1)
                curExpr = mkExpr(TONAME, l4typ11z, curExpr, NULL);
            castArith(l4typ11z, &curExpr);
            if (typeSize(curExpr->typ) != typeSize(l4typ11z))
                error(errNeedOtherTypesOfOperands);
            curExpr->typ  =  l4typ11z;
        } else {
            readNext  =  false;
            fullExpression();
            checkSymAndRead(RPAREN);
        }
        break;
    case INTCONST: case REALCONST: case CHARCONST: case STRINGSY:
        curExpr = malloc(sizeof(expr));
        curExpr->typ = parseLiteral(&curExpr->num1, false);
        curExpr->num2  =  (int)numFormat;
        curExpr->op  =  GETENUM;
        inSymbol();
        break;
    case LBRACK: {
        curExpr = malloc(sizeof(expr));
        inSymbol();
        l4var8z  =  curExpr;
        l4var1z  =  0U;
        if (SY != RBRACK) {
            l4var12z  =  true;
            readNext  =  false;
            do {
                newExpr  =  curExpr;
                expression();
                if (l4var12z) {
                    l4typ11z  =  curExpr->typ;
                    if (l4typ11z.p.pk != kindScalar)
                        error(23); /* errTypeIdInsteadOfVar */
                } else {
                    if (! typeCheck(l4typ11z, curExpr->typ))
                        error(24); /*errIncompatibleExprsInSetCtor*/
                }
                l4var12z  =  false;
                l4exp5z  =  curExpr;
                if (SY == COLON) {
                    expression();
                    if (! typeCheck(l4typ11z, curExpr->typ))
                        error(24); /*errIncompatibleExprsInSetCtor*/
                    if ((l4exp5z->op != GETENUM) ||
                       (curExpr->op != GETENUM))
                        error(errNoConstant);
                    l4var4z  =  l4exp5z->num1;
                    l4var3z  =  curExpr->num1;
                    l4var1z  =  l4var1z |
                    // [l4var4z..l4var3z];
                    ((all1 >> l4var4z) ^ (all1 >> 1 >> l4var3z));
                    curExpr  =  newExpr;
                    goto L14567;
                } else {
                    if (l4exp5z->op == GETENUM) {
                        l4var4z  =  l4exp5z->num1;
                        l4var1z |= E48 >> l4var4z;
                        curExpr  =  newExpr;
                        goto L14567;
                    }
                    error(errNoConstant);
                }
                curExpr  =  mkExpr(SETOR, intType, newExpr, l4exp5z);
L14567:         ;
            } while (SY == COMMA);
        }
        checkSymAndRead(RBRACK);
        { register expr *ex = l4var8z;
            ex->op  =  GETENUM;
            ex->typ  =  intType;
            ex->num1  =  l4var1z;
        }
        break;
    }; /* LBRACK */
    default:
        error(errBadSymbol);
        badExpr();
        return;
    } /* switch */
    /* Any factor producing an rvalue/lvalue may be followed by postfix
       operators (->field for ptr-to-struct deref+select, .field for struct member,
       [idx] for array element).  parseLval already drained them above;
       parsePostfix is a no-op when SY is not a postfix token. */
    parsePostfix();
    if (charClass == INCROP || charClass == DECROP) {
        if (! has(lvalOpSet, curExpr->op))
            error(27);
        if (! typeCheck(curExpr->typ, intType) && eltStep(curExpr->typ) == 0)
            error(62);
        l4var1z = (charClass == INCROP);
        inSymbol();
        curExpr = bldIncDec(curExpr, l4var1z, true);
