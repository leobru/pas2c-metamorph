    elt = malloc(sizeof(oneinsn));
    { register oneinsn *oi = elt;
        oi->next  =  NULL;
        oi->mode  =  0;
        oi->code  =  insn;
        oi->offset  =  0;
    }
    { register insnltyp *il = insnList;
        if (il->tail == NULL)
            il->head  =  elt;
        else
            il->tail->next  =  elt;
        il->tail  =  elt;
    }
} /* addToInsnList */
