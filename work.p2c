} /* factor */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parseUnaryExpression() {
operator oper;
eptr leftExpr;
    oper = NOOP;
    if (has([PLUSOP, MINUSOP, BITNEGOP, NOTOP, MUL, SETAND, INCROP, DECROP],
            charClass)) {
        if (charClass != PLUSOP)
            oper = charClass;
        inSymbol();
    }
    if (oper != NOOP)
        parseUnaryExpression();
    else
        factor();
    if (oper != NOOP) {
        arg1Type = curExpr->typ;
        switch (oper) {
        case MINUSOP:
            if (arg1Type == realType) {
                curExpr = mkUnaryFold(RNEGOP, realType, curExpr);
            } else if (typeCheck(arg1Type, intType)) {
                curExpr = mkUnaryFold(INEGOP, intType, curExpr);
            } else {
                error(69); /* errUnaryMinusNeedRealOrInteger */
                return;
            }
            break;
        case BITNEGOP:
            if (typeCheck(arg1Type, intType)) {
                curExpr = mkUnaryFold(BITNEGOP, intType, curExpr);
            } else {
                error(62); /* errIntegerNeeded */
                return;
            }
            break;
        case NOTOP:
            if (arg1Type == boolType) {
                curExpr = mkUnaryFold(NOTOP, boolType, curExpr);
            } else if (isIntTyp(arg1Type)) {
                curExpr = mkExpr(EQOP, boolType, curExpr, mkIntLit(0));
            } else {
                error(errNeedOtherTypesOfOperands);
                return;
            }
            break;
        case MUL:
            /* An array is its first element's address here too, so '*a' is
               'a[0]', as in C. */
            if (arg1Type.p.pk == kindArray) {
                curExpr = decayArray(curExpr);
                arg1Type = curExpr->typ;
            }
            if (isCharPtr(arg1Type))
                curExpr = flatMemAt(curExpr);
            else if (arg1Type.p.pk == kindPtr) {
                /* Dereferencing a pointer to a routine yields the routine,
                   which is worth its address again: leave the pointer as it
                   is, so '(*f)(x)' is the same expression as 'f(x)'. */
                if (! isRoutinePtr(arg1Type))
                    curExpr = mkExpr(DEREF, ptrBase(arg1Type),
                                     curExpr, NULL);
            } else {
                stmtName = 'unary*';
                error(errWrongVarTypeBefore);
            }
            break;
        case SETAND:
            if (curExpr->op == PROCADDR)
                break;   /* a function designator is already its address */
            if (! has(lvalOpSet, curExpr->op))
                error(27); /* errExpressionWhereVariableExpected */
            if ((curExpr->op == GETELT) &&
                (curExpr->expr1->op == GETVAR) &&
                (curExpr->expr1->id1 == flatMemVar)) {
                curExpr = curExpr->expr2;
                curExpr->typ = charPtrType;
            } else if (curExpr->op == GETELT &&
                       isCharArray(curExpr->expr1->typ) &&
                       curExpr->expr1->typ.p.pad) {
                /* A packed char array holds six 8-bit bytes to a word, so an
                   element's byte index is the array's word address times six
                   plus the zero-based index. */
                leftExpr = curExpr->expr2;
                curExpr = mkExpr(INTPLUS, charPtrType,
                    mkExpr(IMULOP, intType,
                           mkRef(curExpr->expr1, intType),
                           mkIntLit(6)),
                    leftExpr);
            } else if (arg1Type == charType) {
                /* An unpacked char array's element has a word to itself, and
                   a char value sits in its rightmost byte. */
                curExpr = mkExpr(INTPLUS, charPtrType,
                    mkExpr(IMULOP, intType,
                           mkRef(curExpr, intType), mkIntLit(6)),
                    mkIntLit(5));
            } else {
                /* The address of an lvalue is a pointer to its type. */
                curExpr = mkRef(curExpr, getPtrType(arg1Type));
            }
            break;
        case INCROP:
        case DECROP:
            if (! has(lvalOpSet, curExpr->op)) {
                error(27); /* errExpressionWhereVariableExpected */
                return;
            }
            if (! typeCheck(arg1Type, intType) && eltStep(arg1Type) == 0) {
                error(62); /* errIntegerNeeded */
                return;
            }
            curExpr = bldIncDec(curExpr, oper == INCROP, false);
            break;
        }
    }
} /* parseUnaryExpression */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parsePrc(int minPrec) {
/* Read here and by bldByPrc just below, and nowhere else.  Declared before it
   so the nested routine can see it. */
static int opPrec[ALTERN+1] = {
    precNone:24,
    [CONDOP]=precCond,
    [OROP]=precOr,
    [ANDOP]=precAnd,
    [SETOR]=precBitOr,
    [SETXOR]=precBitXor,
    [SETAND]=precBitAnd,
    [NEOP]=precEq, [EQOP]=precEq,
    [LTOP]=precRel, [GEOP]=precRel, [GTOP]=precRel, [LEOP]=precRel,
    [SHLEFT]=precShift, [SHRIGHT]=precShift,
    [PLUSOP]=precAdd, [MINUSOP]=precAdd,
    [MUL]=precMul, [RDIVOP]=precMul, [IDIVOP]=precMul, [IMODOP]=precMul };
operator oper;
eptr leftExpr, thenExpr;
int curPrec;
int match;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void bldByPrc(int prec) {
    switch (prec) {
    case precMul:
    case precAdd:
        bldArithOp(oper, leftExpr, match);
        break;
    case precRel:
    case precEq:
        bldRelOp(oper, leftExpr);
        break;
    case precShift:
    case precBitAnd:
    case precBitXor:
    case precBitOr:
        bldBitOp(oper, leftExpr);
        break;
    case precAnd:
    case precOr:
        bldLogOp(oper, leftExpr, match);
        break;
    case precComma:
        /* The value and the type are the right operand's; the left one is
           kept for its effects alone.  The one arm that does not read 'oper',
           which is as well: the lexer sets charClass for operator characters
           only, so at a comma it still holds whatever the last operator left
           there. */
        curExpr = mkExpr(COMMAOP, curExpr->typ, leftExpr, curExpr);
        break;
    }
} /* bldByPrc */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    /* Parse left operand with unary operators */
    parseUnaryExpression();

    /* Climb through operators at this precedence level and higher */
    while (true) {
        if (SY == EXPROP)
            curPrec = opPrec[charClass];
        else if (SY == BECOMES)
            curPrec = precAssign;
        else if (SY == COMMA)
            curPrec = precComma;
        else
            curPrec = precNone;

        /* Stop if operator has lower precedence than minimum */
        if (curPrec < minPrec)
            return;

        oper = charClass;
        inSymbol();
        leftExpr = curExpr;

        /* By the precedence, not by 'oper': charClass is set for operator
           characters only, so at a comma it still holds whatever the last
           operator left there -- CONDOP, if the left operand ended in a
           ternary, which would take '(a ? b : c, d)' for one.  precCond is
           opPrec[CONDOP] and nothing else's, so the two tests agree wherever
           charClass means anything at all. */
        if (curPrec == precCond) {
            /* Right-associative ternary: cond ? thenExpr : elseExpr.  The
               middle operand is a full expression, as in C -- a comma is an
               operator there, the ':' ending it either way -- while the third
               is a conditional-expression, which is why the else arm is
               parsed at precCond and an assignment to a ternary binds outside
               it. */
            parsePrc(precComma);
            if (SY != COLON)
                requiredSymErr(COLON);
            else
                inSymbol();
            thenExpr = curExpr;
            parsePrc(precCond);
            bldCondOp(leftExpr, thenExpr);
        } else if (curPrec == precAssign) {
            /* Right-associative assignment: lhs [op]= rhs.  `oper` (captured
               above before inSymbol) is ASSIGNOP for plain `=`; for op-assign
               (+=, -=, *=, /=, %=, &=, |=, ^=, <<=, >>=) it carries the
               underlying operation, lexed as SY=BECOMES + charClass=op.
               Plain `=` yields ASSIGNOP(lhs, rhs).  Op-assign yields
               RMWASSIGN(lhs, inner-op(rhs, NULL)) where inner-op carries
               the operator (e.g. INTPLUS) and the RHS in expr1; expr2 is
               the don't-care slot.  Codegen for RMWASSIGN walks lhs once,
               materialising its address into a spill slot when needed,
               then synthesises the equivalent ASSIGNOP for emission. */
            /* An array is never an lvalue: its name in a value context is
               an address, so there is nothing to assign to. */
            if (! has(lvalOpSet, leftExpr->op) ||
                leftExpr->typ.p.pk == kindArray)
                error(27); /* errExpressionWhereVariableExpected */
            parsePrc(precAssign);
            arg1Type = leftExpr->typ;
            arg2Type = curExpr->typ;
            if (oper != ASSIGNOP) {
                /* Reuse bldArithOp/bldBitOp/bldLogOp for operator selection
                   (PLUSOP vs INTPLUS, etc.) and type promotion, then drop
                   the leftExpr slot of the result so it stores op(rhs, NULL)
                   ready for RMWASSIGN.expr2.  RMWASSIGN.expr1 carries the
                   original lvalue subtree, evaluated once at codegen time. */
                match = typeCheck(arg1Type, arg2Type);
                bldByPrc(opPrec[oper]);
                curExpr->expr1 = curExpr->expr2;
                curExpr->expr2 = NULL;
                arg2Type = curExpr->typ;
            }
            if (leftExpr && leftExpr->op == DEREF &&
                isCharPtr(leftExpr->expr1->typ))
                leftExpr = flatMemAt(leftExpr->expr1);
            /* An array assigned to a pointer decays, as in C.  An array is
               not assignable at all, again as in C: it is not a modifiable
               lvalue, and its name in a value context is an address. */
            if (arg1Type.p.pk == kindPtr) {
                curExpr = decayArray(curExpr);
                arg2Type = curExpr->typ;
            }
            if (arg1Type.p.pk == kindArray)
                arg2Type  =  arg1Type;   /* refused above; one report, not two */
            if (! typeCheck(arg1Type, arg2Type)) {
                if (castArith(arg1Type, &curExpr)) {
                    /* int <-> real, converted as C does */
                } else if (isCharPtr(arg1Type) &&
                         isCharPtr(arg2Type))
                    curExpr = curExpr;
                else
                    error(33); /* errIllegalTypesForAssignment */
            }
            curExpr = mkExpr(oper != ASSIGNOP ? RMWASSIGN : ASSIGNOP,
                             arg1Type, leftExpr, curExpr);
        } else {
            /* Recursively parse right operand with higher precedence */
            /* For left-associative: use curPrec + 1 */
            parsePrc(curPrec + 1);

            /* Build AST node based on operator type */
            arg1Type = leftExpr->typ;
            arg2Type = curExpr->typ;
            match = typeCheck(arg1Type, arg2Type);

            bldByPrc(curPrec);
        }
    }
} /* parsePrc */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parentExpression() {
    if (readNext)
        inSymbol();
    checkSymAndRead(LPAREN);
    readNext  =  false;
    fullExpression();
    checkSymAndRead(RPAREN);
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void expression() {
    if (readNext)
        inSymbol();
    else
        readNext  =  true;
    parsePrc(precAssign);
} /* expression */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* C's full expression -- the only place a comma is an operator rather than a
   separator.  Everywhere else an expression is an assignment-expression, which
   is why an initializer, an actual argument and a case label still split on
   the comma. */
void fullExpression() {
    if (readNext)
        inSymbol();
    else
        readNext  =  true;
    parsePrc(precComma);
} /* fullExpression */
//
