           spilling and demotion behaviour is the existing one. */
        curExpr  =  mkExpr(DEREF, regBase, curExpr, NULL);
        formOperator(SETREG);
        claimed  =  (claimed | (E48 >> curVal.i)) & auxRegs;
        regIdRec = malloc(offsetof(identrec, szIdent));
        { register identrec *ir = regIdRec;
            ir->id  =  regDecl.name;
            ir->pck.p.offset  =  curFrameRegTemplate;
            ir->pck.p.cl  =  REGID;
            ir->pck.p.next  =  NULL;
            ir->typ  =  regDecl.typ;
            /* the pinList entry this name stands for */
            ir->value  =  (int)pinList;
            /* chain of this block's own names, for the unlinking below */
            ir->list  =  *decls;
        }
        *decls  =  regIdRec;
        addToHashTab(regIdRec);
        checkSymAndRead(SEMICOLON);
