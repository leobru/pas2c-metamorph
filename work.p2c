typedef __packed __lsb struct {
        int k:6;
        int hhh:18;
        types *ppp;
        int pad:6;
} strhash;

typedef int:6 textchar;
typedef union {
    int i;
    float r;
    __packed textchar t[8];
    char c;
    idclass cl;
    tptr tp;
    strhash s;
} word;
typedef union {
    /* Word 0 is unused.  For zero-based code word w, halves[2*w+2] is its
       left instruction and halves[2*w+3] its right instruction. */
    int words[1025];
    __packed int:24 halves[2050];
} objbuf;
