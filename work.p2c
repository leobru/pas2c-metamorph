            } else {
                l4var213z  =  false;
            }
            curVal.i  =  l4var213z;
            i  =  addCurValToFCST();
            curVal.i  =  l4var213z ^ 1;
            tempInsn  =  addCurValToFCST() - i;
            if (curInsn == 0) {
