void genComparison() {
int negate;
int l5set2z;
int mode, size;
    l3int3z  =  curOP - NEOP;
    negate  =  l3int3z & 1U;
    if (l3int3z == 6) {     /* IN */
        if (arg1Const) {
            if (arg2Const) {
                insnList->payload  =  arg1Val.i IN arg2Val.i;
            } else {
                l5set2z  =  E48 >> arg1Val.i;
                if (l5set2z == 0U) {
                    insnList->payload  =  false;
                } else {
                    insnList  =  otherIns;
                    prepLoad();
                    curVal.i  =  l5set2z;
                    addToInsnList(KAAX+I8 + getFCSToffset());
                    insnList->payload  =  0;
                    insnList->ilm  =  ilCOND;
