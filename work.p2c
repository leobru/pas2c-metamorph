// check for a repeated formal against the chain instead of the array:
//
//       sg->s1.p.poffset  =  l2int18z;
//       sg->pname  =  curDeclarator.name;
//   ...
//       if (curDeclarator.name) {
//           if (curDeclarator.wasDefined)
//               error(errIdentAlreadyDefined);
//           for (dup = curIdRec->r1.sig; dup != NULL; dup = dup->next)
//               if ((dup != newSig) && (dup->pname == curDeclarator.name))
//                   error(errIdentAlreadyDefined);
//       }
