       parsePostfix is a no-op when SY is not a postfix token. */
    parsePostfix();
    if (charClass == INCROP || charClass == DECROP) {
        if (! (curExpr->op IN lvalOpSet))
            error(27);
        if (! typeCheck(curExpr->typ, intType) && eltStep(curExpr->typ) == 0)
            error(62);
        l4var1z = (charClass == INCROP);
        inSymbol();
        curExpr = bldIncDec(curExpr, l4var1z, true);
    }
} /* factor */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parseUnaryExpression() {
operator oper;
eptr leftExpr;
    oper = NOOP;
    if (charClass IN [PLUSOP, MINUSOP, BITNEGOP, NOTOP, MUL, SETAND, INCROP, DECROP]) {
        if (charClass != PLUSOP)
            oper = charClass;
        inSymbol();
    }
    if (oper != NOOP)
        parseUnaryExpression();
    else
        factor();
    if (oper != NOOP) {
        arg1Type = curExpr->typ;
        switch (oper) {
        case MINUSOP:
            if (arg1Type == realType) {
                curExpr = mkUnaryFold(RNEGOP, realType, curExpr);
            } else if (typeCheck(arg1Type, intType)) {
                curExpr = mkUnaryFold(INEGOP, intType, curExpr);
            } else {
                error(69); /* errUnaryMinusNeedRealOrInteger */
                return;
            }
            break;
        case BITNEGOP:
            if (typeCheck(arg1Type, intType)) {
                curExpr = mkUnaryFold(BITNEGOP, intType, curExpr);
            } else {
                error(62); /* errIntegerNeeded */
                return;
            }
            break;
        case NOTOP:
            if (arg1Type == boolType) {
                curExpr = mkUnaryFold(NOTOP, boolType, curExpr);
            } else if (arg1Type == intType) {
                curExpr = mkExpr(EQOP, boolType, curExpr, mkIntLit(0));
            } else {
                error(errNeedOtherTypesOfOperands);
                return;
            }
            break;
        case MUL:
            if (isCharPtr(arg1Type))
                curExpr = flatMemAt(curExpr);
            else if (arg1Type.p.pk == kindPtr) {
                /* Dereferencing a pointer to a routine yields the routine,
                   which is worth its address again: leave the pointer as it
                   is, so '(*f)(x)' is the same expression as 'f(x)'. */
                if (! isRoutinePtr(arg1Type))
                    curExpr = mkExpr(DEREF, ptrBase(arg1Type),
                                     curExpr, NULL);
            } else {
                stmtName = "unary*";
                error(errWrongVarTypeBefore);
            }
            break;
        case SETAND:
            if (curExpr->op == PROCADDR)
                break;   /* a function designator is already its address */
            if (! (curExpr->op IN lvalOpSet))
                error(27); /* errExpressionWhereVariableExpected */
            if ((curExpr->op == GETELT) &&
                (curExpr->expr1->op == GETVAR) &&
                (curExpr->expr1->id1 == flatMemVar)) {
                curExpr = curExpr->expr2;
                curExpr->typ = charPtrType;
            } else if ((curExpr->op == GETELT) &&
                       isCharArray(curExpr->expr1->typ) &&
                       curExpr->expr1->typ.rep->pck) {
                /* A packed char array holds six 8-bit bytes to a word, so an
                   element's byte index is the array's word address times six
                   plus the index, counted from the array's lower bound. */
                leftExpr = curExpr->expr2;
                if (curExpr->expr1->typ.rep->aleft != 0)
                    leftExpr = mkExprFold(INTMINUS, intType, leftExpr,
                                 mkIntLit(curExpr->expr1->typ.rep->aleft));
                curExpr = mkExpr(INTPLUS, charPtrType,
                    mkExpr(IMULOP, intType,
                           mkCastInt(mkRef(curExpr->expr1)),
                           mkIntLit(6)),
                    leftExpr);
            } else if (arg1Type == charType) {
                /* An unpacked char array's element has a word to itself, and
                   a char value sits in its rightmost byte. */
                curExpr = mkExpr(INTPLUS, charPtrType,
                    mkExpr(IMULOP, intType,
                           mkCastInt(mkRef(curExpr)), mkIntLit(6)),
                    mkIntLit(5));
            } else {
                /* The address of an lvalue is a pointer to its type. */
                curExpr = mkRef(curExpr);
                curExpr->typ = getPtrType(arg1Type);
            }
            break;
        case INCROP:
        case DECROP:
            if (! (curExpr->op IN lvalOpSet)) {
                error(27); /* errExpressionWhereVariableExpected */
                return;
            }
            if (! typeCheck(arg1Type, intType) && eltStep(arg1Type) == 0) {
                error(62); /* errIntegerNeeded */
                return;
            }
            curExpr = bldIncDec(curExpr, oper == INCROP, false);
            break;
        }
    }
} /* parseUnaryExpression */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parsePrc(int minPrec) {
operator oper;
eptr leftExpr, thenExpr;
int curPrec;
int match;
    /* Parse left operand with unary operators */
    parseUnaryExpression();

    /* Climb through operators at this precedence level and higher */
    while (true) {
        if (SY == EXPROP)
            curPrec = opPrec[charClass];
        else if (SY == BECOMES)
            curPrec = precAssign;
        else
            curPrec = precNone;

        /* Stop if operator has lower precedence than minimum */
        if (curPrec < minPrec)
            return;

        oper = charClass;
        inSymbol();
        leftExpr = curExpr;

        if (oper == CONDOP) {
            /* Right-associative ternary: cond ? thenExpr : elseExpr */
            parsePrc(precAssign);
            if (SY != COLON)
                requiredSymErr(COLON);
            else
                inSymbol();
            thenExpr = curExpr;
            parsePrc(precCond);
            bldCondOp(leftExpr, thenExpr);
        } else if (curPrec == precAssign) {
            /* Right-associative assignment: lhs [op]= rhs.  `oper` (captured
               above before inSymbol) is ASSIGNOP for plain `=`; for op-assign
               (+=, -=, *=, /=, %=, &=, |=, ^=, <<=, >>=) it carries the
               underlying operation, lexed as SY=BECOMES + charClass=op.
               Plain `=` yields ASSIGNOP(lhs, rhs).  Op-assign yields
               RMWASSIGN(lhs, inner-op(rhs, NULL)) where inner-op carries
               the operator (e.g. INTPLUS) and the RHS in expr1; expr2 is
               the don't-care slot.  Codegen for RMWASSIGN walks lhs once,
               materialising its address into a spill slot when needed,
               then synthesises the equivalent ASSIGNOP for emission. */
            if (! (leftExpr->op IN lvalOpSet))
                error(27); /* errExpressionWhereVariableExpected */
            parsePrc(precAssign);
            arg1Type = leftExpr->typ;
            arg2Type = curExpr->typ;
            if (oper != ASSIGNOP) {
                /* Reuse bldArithOp/bldBitOp/bldLogOp for operator selection
                   (PLUSOP vs INTPLUS, etc.) and type promotion, then drop
                   the leftExpr slot of the result so it stores op(rhs, NULL)
                   ready for RMWASSIGN.expr2.  RMWASSIGN.expr1 carries the
                   original lvalue subtree, evaluated once at codegen time. */
                match = typeCheck(arg1Type, arg2Type);
                switch (opPrec[oper]) {
                case precMul:
                case precAdd:
                    bldArithOp(oper, leftExpr, match);
                    break;
                case precShift:
                case precBitAnd:
                case precBitXor:
                case precBitOr:
                    bldBitOp(oper, leftExpr);
                    break;
                case precAnd:
                case precOr:
                    bldLogOp(oper, leftExpr, match);
                    break;
                }
                curExpr->expr1 = curExpr->expr2;
                curExpr->expr2 = NULL;
                arg2Type = curExpr->typ;
            }
            if (leftExpr != NULL && leftExpr->op == DEREF &&
                isCharPtr(leftExpr->expr1->typ))
                leftExpr = flatMemAt(leftExpr->expr1);
            if (! typeCheck(arg1Type, arg2Type)) {
                if (castArith(arg1Type, &curExpr)) {
                    /* int <-> real, converted as C does */
                } else if (isCharPtr(arg1Type) &&
                         isCharPtr(arg2Type))
                    curExpr = curExpr;
                else
                    error(33); /* errIllegalTypesForAssignment */
            }
            curExpr = mkExpr(oper != ASSIGNOP ? RMWASSIGN : ASSIGNOP,
                             arg1Type, leftExpr, curExpr);
        } else {
            /* Recursively parse right operand with higher precedence */
            /* For left-associative: use curPrec + 1 */
            parsePrc(curPrec + 1);

            /* Build AST node based on operator type */
            arg1Type = leftExpr->typ;
            arg2Type = curExpr->typ;
            match = typeCheck(arg1Type, arg2Type);

            switch (curPrec) {
            case precMul:
            case precAdd:
                bldArithOp(oper, leftExpr, match);
                break;
            case precRel:
            case precEq:
                bldRelOp(oper, leftExpr);
                break;
            case precShift:
            case precBitAnd:
            case precBitXor:
            case precBitOr:
                bldBitOp(oper, leftExpr);
                break;
            case precAnd:
            case precOr:
                bldLogOp(oper, leftExpr, match);
            }
        }
    }
} /* parsePrc */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parentExpression() {
    if (readNext)
        inSymbol();
    checkSymAndRead(LPAREN);
    readNext  =  false;
    expression();
    checkSymAndRead(RPAREN);
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void expression() {
    if (readNext)
        inSymbol();
    else
        readNext  =  true;
    parsePrc(precAssign);
} /* expression */
//
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void setStrLab(int id) {
    strLabPtr = malloc(sizeof(strLabel));
    padToLeft();
    disableNorm();
    { register strLabel *slp = strLabPtr;
        slp->next  =  strLabList;
        slp->ident  =  id;
        slp->target  =  0;
    }
    strLabList  =  strLabPtr;
} /* setStrLab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void setBrCont() {
    /*=A3*/
    setStrLab('   BREAK');
    setStrLab('CONTINUE');
    /*=A2*/
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void brContTarget() {
    /* assigning target for break/continue if used */
    { register strLabel *slp = strLabList;
      if (slp->target != 0) {
          fixup(0, slp->target);
      } }
    strLabList  =  strLabList->next; /* removing break/continue */
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void forStatement() {
int toLoop, leave;
eptr loopExpr;
    inSymbol();
    checkSymAndRead(LPAREN);
    if (SY != SEMICOLON) {
        readNext = false;
        expression();
        formOperator(DOIT);
    }
    checkSymAndRead(SEMICOLON);
    padToLeft();
    toLoop = moduleOffset;
    leave = 0;
    if (SY != SEMICOLON) {
        readNext = false;
        expression();
        jumpTarget = 0;
        formOperator(BRANCH);
        leave = jumpTarget;
    }
    checkSymAndRead(SEMICOLON);
    loopExpr = NULL;
    if (SY != RPAREN) {
        readNext = false;
        expression();
        loopExpr = curExpr;
    }
    checkSymAndRead(RPAREN);
    setBrCont();
    statement();
    brContTarget();
    if (loopExpr != NULL) {
        curExpr = loopExpr;
        formOperator(DOIT);
    }
    formJump(&toLoop);
    if (leave != 0) {
        padToLeft();
        fixup(0, leave);
    }
    brContTarget();
} /* forStatement */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// 'register TYPE *name = expr;' at the head of a block: name is a pointer
// whose value is pinned in an index register until the block ends, so that
// 'name->field' costs the one instruction a `with` field costs.  It is that
// same machinery: SETREG on a DEREF of the initializer allocates the
// register, spills it when the address is dear to recompute, and pushes the
// entry genEntry reloads after a call that clobbers it.  The declared name
// merely gives the entry something to be reached by, in place of `with`'s
// implicit field lookup.
//
// Returns the registers claimed, for the caller to fold into usedRegs; the
// records themselves come back on the chain headed by *decls, to be unlinked
// from the symbol table when the block closes.
int registerDecls(irptr *decls) {
declarator regDecl;
irptr regIdRec;
tptr regType, regBase;
int claimed, regOk;
    claimed  =  0U;
    while ((SY == IDENT) && (curIdent == litRegister)) {
        inSymbol();
        regType = parseTypeRef(skipToSet | [IDENT, SEMICOLON]);
        parseOneDeclarator(&regDecl, regType, isPacked, isForwardRef);
        /* The pointee goes through regBase because it is needed again
           below, for the DEREF node. */
        regOk  =  regDecl.typ.p.pk == kindPtr;
        if (regOk) {
            regBase  =  ptrBase(regDecl.typ);
            regOk  =  regBase.p.pk == kindStruct;
        }
        if (! regOk) {
            error(71); /* errRegPtrNotToStruct */
            regDecl.typ  =  voidPtr;
            regBase  =  voidType;
        }
        checkSymAndRead(BECOMES);
        /* SY already sits on the initializer's first token. */
        readNext = false;
        expression();
        if (! typeCheck(regDecl.typ, curExpr->typ))
            error(33); /* errIllegalTypesForAssignment */
        /* Exactly what `with *e do` builds, so the register allocation,
           spilling and demotion behaviour is the existing one. */
        curExpr  =  mkExpr(DEREF, regBase, curExpr, NULL);
        formOperator(SETREG);
        claimed  =  (claimed | (E48 >> curVal.i)) & auxRegs;
        regIdRec = malloc(offsetof(identrec, szIdent));
        { register identrec *ir = regIdRec;
            ir->id  =  regDecl.name;
            ir->pck.p.offset  =  curFrameRegTemplate;
            ir->pck.p.cl  =  REGID;
            ir->pck.p.next  =  NULL;
            ir->typ  =  regDecl.typ;
            /* the pinList entry this name stands for */
            ir->value  =  int(pinList);
            /* chain of this block's own names, for the unlinking below */
            ir->list  =  *decls;
        }
        *decls  =  regIdRec;
        addToHashTab(regIdRec);
        checkSymAndRead(SEMICOLON);
    }
    return claimed;
} /* registerDecls */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// '{' register-declarations? statement* '}'.  Whatever the declarations
// pinned is released here, at the closing brace.
void blockStatement() {
irptr blockDecls, nextDecl, unlinked;
eptr oldWithList;
int oldLocalSize, oldFreeRegs, blockRegs;
    inSymbol();
    blockDecls  =  NULL;
    oldWithList  =  pinList;
    oldLocalSize  =  localSize;
    oldFreeRegs  =  freeRegs;
    blockRegs  =  registerDecls(&blockDecls);
    while ((SY != ENDSY) && (CH != '\0')) {
        statement();
    }
    if (blockDecls != NULL) {
        while (blockDecls != NULL) {
            nextDecl  =  blockDecls->list;
            unlinked  =  hash(NULL, blockDecls);
            blockDecls  =  nextDecl;
        }
        pinList  =  oldWithList;
        localSize  =  oldLocalSize;
        freeRegs  =  oldFreeRegs;
        /* The registers this block claimed are clobbered as far as our
           callers are concerned: they must reach the routine's flags mask. */
        usedRegs |= blockRegs;
    }
    inSymbol();
} /* blockStatement */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void reportStmtType() {
    writeln(' STATEMENT ', stmtname:0, " IN ", startLine:0, " LINE");
} /* reportStmtType */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void structBranch() {
strLabel *curLab;
    curLab  =  strLabList;
    while (curLab != NULL) {
        if (curLab->ident == curIdent) {
            formJump(&curLab->target);
            return;
        }
        curLab  =  curLab->next;
    }
    error(errNotDefined);
    longjmp(jb8888, 1);
} /* structBranch */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void caseStatement() { /* caseStatement */
typedef struct {
        casechain *next;
        word value;
        int offset;
} casechain;
casechain *allClauses, *curClause, *clause, *chain;
int otherSeen;
int otherOffset;
int itemsEnded, goodMode;
tptr firstType, itemtype, exprtype;
int itemvalue;
int itemSpan;
int nClauses;
word expected;
int startLine, decoder, endOfStmt;
word minValue, maxValue;

    startLine  =  lineCnt;
    parentExpression();
    exprtype  =  curExpr->typ;
    otherSeen  =  false;
    if (exprtype.p.pk == kindScalar)
        formOperator(LOAD);
    else
        error(25); /* errExprNotOfADiscreteType */
    disableNorm();
    decoder  =  0;
    endOfStmt  =  0;
    allClauses  =  NULL;
    formJump(&decoder);
    checkSymAndRead(BEGINSY);
    firstType.rep = NULL;
    goodMode  =  true;
    do {
        if (! (SY IN [SEMICOLON, ENDSY])) {
            padToLeft();
            arithMode  =  1;
            if (SY == DEFAULTSY) {
                if (otherSeen)
                    error(73); /* errCaseLabelsIdentical */
                inSymbol();
                otherSeen  =  true;
                otherOffset  =  moduleOffset;
            } else {
                if (SY != CASESY) {
                    requiredSymErr(CASESY);
                    /* No CASESY was consumed, so the label's own first token
                       is the current SY.  readNext := false keeps it for
                       expression(); skipping it instead derails the arm and
                       leaves the next CASESY/DEFAULTSY in statement context,
                       where the routine-body loop spins on a symbol
                       statement() will not consume. */
                    readNext = false;
                }
                expression();
                takeConstFromExpr();
                itemvalue = curVal.i;
                itemType = curExpr->typ;
                if (itemtype.rep != NULL) {
                    if (firstType.rep == NULL) {
                        firstType  =  itemtype;
                    } else {
                        if (! typeCheck(itemtype, firstType))
                            error(errConstOfOtherTypeNeeded);
                    }
                    clause = malloc(sizeof(casechain));
                    clause->value.i  =  itemvalue;
                    clause->offset  =  moduleOffset;
                    curClause  =  allClauses;
                    while (curClause != NULL) {
                        if (itemvalue == curClause->value.i) {
                            error(73); /* errCaseLabelsIdentical */
                            break;
                        } else if (itemvalue < curClause->value.i) {
                            break;
                        } else {
                            chain  =  curClause;
                            curClause  =  curClause->next;
                        }
                    }
                    if (curClause == allClauses) {
                        clause->next  =  allClauses;
                        allClauses  =  clause;
                    } else {
                        clause->next  =  curClause;
                        chain->next  =  clause;
                    }
                }
            }
            checkSymAndRead(COLON);
            while (!(SY in [CASESY,DEFAULTSY,ENDSY]))
                statement();
            goodMode  =  goodMode && (arithMode == 1);
        }
        itemsEnded  =  SY == ENDSY;
        if (SY == SEMICOLON)
            inSymbol();
    } while (! itemsEnded);
    if (SY != ENDSY) {
        requiredSymErr(ENDSY);
        stmtName  =  "SWITCH";
        reportStmtType();
    } else
        inSymbol();
    if (! typeCheck(firstType, exprtype)) {
        error(74); /* errDifferentTypesOfLabelsAndExpr */;
        return;
    }
    formJump(&endOfStmt);
    padToLeft();
    if (allClauses != NULL) {
        expected  =  allClauses->value;
        minValue  =  expected;
        curClause  =  allClauses;
        nClauses  =  0;
        while (curClause != NULL) {
            if (expected != curClause->value)
                goto 16140;         /* a gap in the labels: compare them */
            maxValue  =  expected;
            ++expected.i;
            ++nClauses;
            curClause  =  curClause->next;
        } /* while 16142 */
        /* An indexed jump carries a ten-instruction prologue whatever the
           label count is, so it earns that back from caseTabMin clauses up.
           Below it, comparing the labels one by one is shorter and needs no
           range check. */
        if (nClauses < caseTabMin)
            goto 16140;
        if (! otherSeen) {
            otherOffset  =  moduleOffset;
            formJump(&endOfStmt);
        }
        fixup(0, decoder);
        curVal  =  minValue;
        fixup(-(KU1A+otherOffset), maxValue.i);
        curVal.i  =  minValue.i / 2;
        form3Insn(ASN64+1, KATI+14, KYTA);
        curVal.i  =  moduleOffset + 1 - curVal.i;
        if (curVal.i < 040000) {
            curVal.i -= 040000;
            curVal.i  =  allocSymtab(041000000U | (curVal.i & 077777U));
        }
        form1Insn(KUJ+I14 + curVal.i);
        padToLeft();
        if (minValue.i % 2) {
            form1Insn(KUTC);
            decoder = KUJ;
        } else
            decoder = KUZA;
        while (allClauses != NULL) {
            form1Insn(decoder + allClauses->offset);
            allClauses  =  allClauses->next;
            decoder = KUZA ^ KUJ ^ decoder;
        }
        goto 16211;
        16140:
        itemSpan  =  34000;
        fixup(0, decoder);
        if (firstType.p.pk == kindScalar)
            itemSpan  =  firstType.rep->numen;
        itemsEnded  =  itemSpan < 32000;
        if (itemsEnded)
            form1Insn(KATI+14);
        /* Both chains walk the labels by the difference from the one before,
           so each step needs a single instruction to reach the next label:
           an index register counts down through KUTM, and the accumulator
           holds the subject XOR-ed with the label reached so far, AEX being
           its own inverse. */
        minValue.i  =  0;
        while (allClauses != NULL) {
            if (itemsEnded) {
                curVal.i  =  minValue.i - allClauses->value.i;
                /* KVZM reads the index register, so a step of zero -- a
                   first label of zero -- needs no instruction of its own.
                   The accumulator chain below keeps its KAEX even then: it
                   is what leaves omega logical, which an arithmetic subject
                   expression may not have done. */
                if (curVal.i != 0)
                    form1Insn(getValueOrAllocSymtab(curVal.i) +
                              (KUTM+I14));
                form1Insn(KVZM+I14 + allClauses->offset);
            } else {
                curVal.i  =  minValue.i ^ allClauses->value.i;
                form2Insn(KAEX + I8 + getFCSToffset(),
                          KUZA + allClauses->offset);
            }
            minValue  =  allClauses->value;
            allClauses  =  allClauses->next;
        }
        if (otherSeen)
            form1Insn(KUJ + otherOffset);
        16211:
        fixup(0, endOfStmt);
        if (! goodMode)
           disableNorm();
    }
} /* caseStatement */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void ifWhileStatement() {
    disableNorm();
    parentExpression();
    if ((curExpr->typ != boolType) && (curExpr->typ != intType))
        error(errBooleanNeeded);
    else {
        jumpTarget  =  0;
        formOperator(BRANCH);
        ifWhlTarget  =  jumpTarget;
    }
    statement();
} /* ifWhileStatement */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int allocDataRef(int l6arg1z) {
    if (l6arg1z >= 2048) {
        curVal.i  =  l6arg1z;
        return allocSymtab((curVal.i | 040000000U) & halfWord);
    } else {
        return l6arg1z;
    }
} /* allocDataRef */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Declaration-site initializers (C-style).  Each global '= initializer' is
// buffered into the INITBUF scratch file as a stream of 3-word entries --
// (0, base, 0) opens a target segment, (1, value, count) is an item -- and
// materialized once, at program end, by flushInitializers as the contiguous
// trailing data region of FCST (which must follow the whole constant pool:
// finalize describes it only by length+count).
void putInitEntry(int k, int a, int b) {
    fputw(k, &INITBUF);
    fputw(a, &INITBUF);
    fputw(b, &INITBUF);
} /* putInitEntry */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Open a new destination segment: 'var' bare (offset 0) or, when 'designator',
// 'var[index]...' (SY at '['; parsePostfix builds the GETELT chain, leaving SY
// at '=').  formOperator(SETREG9) yields the base-register template with no
// module/FCST side effect (it builds only into the object buffer).
void beginInitSeg(irptr var, int designator) {
    curExpr  =  mkExpr(GETVAR, var->typ, eptr(var), NULL);
    if (designator)
        parsePostfix();
    putLeft  =  true;
    objBufIdx  =  1;
    formOperator(SETREG9);
    if (objBufIdx != 1)
        error(errVarTooComplex);
    putInitEntry(0, leftInsn & (07777U << 24), 0);
} /* beginInitSeg */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Parse (but do not emit) one global's '= initializer', buffering it.  A
// '[index]=' designator opens a new segment; bare items and 'value:count'
// fills accumulate into the current segment.  An unbraced initializer is a
// single scalar (',' separates declarators, not items).
void parseInitializer(irptr var) {
eptr boundary;
int braced, count, v;
    inSymbol();                       /* consume '=' */
