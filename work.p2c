                if (hadParens)
                    parseParameters(NULL);
                /* The result type comes from the declarator, ahead of the
                   name; there is no ':TYPE' suffix. */
                if (! l2bool8z) {
                    curIdRec->typ = typedRetType;
                    if (typeSize(curIdRec->typ) != 1)
                        error(errTypeMustNotBeFile);
                }
            } else {
                { register identrec *ir = hashTravPtr;
                    l2int18z  =  ir->r2.level;
                    curFrameRegTemplate += indexreg[1];
                    ++curProcNesting;
                    if (preDefHead == hashTravPtr) {
                        preDefHead  =  ir->r2.preDefLink;
                    } else {
                        curIdRec  =  preDefHead;
                        while (hashTravPtr != curIdRec) {
                            workidr  =  curIdRec;
                            curIdRec  =  curIdRec->r2.preDefLink;
                        }
                        workidr->r2.preDefLink  =  hashTravPtr->r2.preDefLink;
                    }
                }
                hashTravPtr->r2.preDefLink  =  NULL;
                curIdRec  =  hashTravPtr;
                /* The definition restates the parameter list; it is matched
                   against the signature the declaration left behind, which
                   also settled the frame layout. */
                hadParens  =  (SY == LPAREN);
                if (hadParens)
                    parseParameters(curIdRec->r1.sig);
            }
            if (SY == BEGINSY) {
                if (! hadParens)
                    error(42); /* errNoParamList */
                scopeBound = (irptr)setup();
                makeFormals();
                inSymbol();
                programme(&l2int18z, curIdRec, true);
                /* The formals are above the mark now, so the hash buckets
                   have to be walked before the rollback releases them. */
                exitScope(0);
                exitScope(1);
                myrollup((int)scopeBound);
                goto L23301;
            }
            if ((SY == EXTERNSY) ||
                ((SY == IDENT) &&
                 ((curIdent == litFortran) || (curIdent == litAssembler)))) {
                if (SY == EXTERNSY) {
                    curVal.i  =  [20];
                } else if (curIdent == litAssembler) {
                    curVal.i  =  [20,26];
                } else if (checkFortran) {
                    curVal.i  =  [21,24];
                    checkFortran  =  false;
                } else {
                    curVal.i  =  [21];
                }
                curIdRec->flags  =  curIdRec->flags | curVal.i;
                inSymbol();
                checkSymAndRead(SEMICOLON);
            } else {
                checkSymAndRead(SEMICOLON);
                { register identrec *ir = curIdRec;
                    if (isPredefined)
                        error(83); /* errRepeatedPredefinition */
                    ir->r2.level  =  l2int18z;
                    ir->r2.preDefLink  =  preDefHead;
                    preDefHead  =  curIdRec;
                }
            }
