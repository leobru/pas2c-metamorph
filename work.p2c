// MAXFORMALS test that guards it.  makeFormals then walks the signature
// alone -- no index, no count -- and lets addToHashTab work the bucket out:
//
//   void makeFormals() {
//   irptr np;
//   sigptr curSig;
//       curSig  =  curIdRec->r1.sig;
//       while (curSig) {
//           np = malloc(offsetof(identrec, szIdent));
//           { register identrec *ir = np;
//               ir->id  =  curSig->pname;
//               ir->pck.p.offset  =  curFrameRegTemplate;
//               ir->pck.p.cl  =  curSig->s1.p.pclass;
//               ir->pck.p.next  =  NULL;
//               ir->typ  =  curSig->ptyp;
//               ir->list  =  NULL;
//               ir->value  =  curSig->s1.p.poffset;
//           }
//           if (np->id)
//               addToHashTab(np);
//           curSig  =  curSig->next;
//       }
//   } /* makeFormals */
//
// base.cc mirrors it, with pname a plain int64_t beside ptyp.  Cost: one
// word per formal that never goes away, against a bound nothing has hit.
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The formals themselves, made once the caller has taken the scope mark so
   that myrollup reclaims them with the body.  Names come from the list just
   read, everything else from the signature, which is the record of record. */
void makeFormals() {
irptr np;
sigptr curSig;
int ii;
    curSig  =  curIdRec->r1.sig;
    ii  =  0;
    while (ii < formalCnt && curSig) {
        np = malloc(offsetof(identrec, szIdent));
        { register identrec *ir = np;
            ir->id  =  formalNames[ii];
            ir->pck.p.offset  =  curFrameRegTemplate;
            ir->pck.p.cl  =  curSig->s1.p.pclass;
            ir->pck.p.next  =  NULL;
            ir->typ  =  curSig->ptyp;
            /* Nothing chains the formals: the signature is the list. */
            ir->list  =  NULL;
            ir->value  =  curSig->s1.p.poffset;
        }
        /* An unnamed parameter takes its argument slot like any other.  It
           never enters the symbol table, so the body has no way to name
           it. */
        if (formalNames[ii]) {
            np->pck.p.next  =  symHash[formalBkts[ii]];
            symHash[formalBkts[ii]]  =  np;
        }
        curSig  =  curSig->next;
        ++ii;
    }
} /* makeFormals */
