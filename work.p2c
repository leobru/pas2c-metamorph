//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              addToHashTab              %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void addToHashTab(irptr arg) {
    curVal.i  =  arg->id & hashMask;
    curVal.i = mapai(curVal.i);
    arg->pck.p.next  =  symHash[curval.i];
    symHash[curval.i]  =  arg;
} /* addToHashTab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void toFCST() {
    fputw(curVal.i, &FCST);
    ++FcstCnt;
} /* toFCST */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int addCurValToFCST() {
int low, high, mid;
    low  =  1;
    if (FcstCountTo500 == 0) {
        FcstCountTo500  =  1;
        constVals[1]  =  curVal.i;
        constNums[1]  =  FcstCnt;
    } else {
        high  =  FcstCountTo500;
        do {
            mid  =  (low + high) / 2;
            if (curVal.i == constVals[mid]) {
                return constNums[mid];
            }
            if (uword(curval.i) < uword(constVals[mid]))
                high  =  mid - 1;
            else
                low  =  mid + 1;
        } while (high >= low);
        if (FcstCountTo500 != 500) {
            high  =  uword(curval.i) < uword(constVals[mid]) ? mid : mid + 1;
            for (mid  =  FcstCountTo500; mid >= high; --mid) {
                low  =  mid + 1;
                constVals[low]  =  constVals[mid];
                constNums[low]  =  constNums[mid];
            }
            ++FcstCountTo500;
            constVals[high]  =  curVal.i;
            constNums[high]  =  FcstCnt;
        }
    }
    toFCST();
    return FcstCnt - 1;
} /* addCurValToFCST */
//
void error(int errno);
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void endOfLine() {
int err, errPos, prevPos, listMode,
    startPos, lastErr;
    listMode  =  pasinfor.listMode;
    if (listMode || errsInLine) {
        write(' ', (lineStartOffset + PASINFOR.startOffset):5 oct,
              lineCnt:5, lineNesting:3, commentModeCH);
        startPos  =  13;
        do
            --linePos;
        while (lineBuf[linePos]  == ' ' && linePos >= 0);
        for (err = 0; err <= linePos; ++err) {
            write(linebuf[err]);
        }
        writeln;
        if (errsInLine) {
            write("*****":startPos, ' ':errMap[0]+1, '0');
            lastErr  =  errsInLine - 1;
            for (err = 1; err <= lastErr; ++err) {
                errPos  =  errMap[err];
                prevPos  =  errMap[err-1];
                if (errPos != prevPos) {
                    if (prevPos + 1 != errPos)
                        write(' ':(errPos-prevPos-1));
                    write(char(err + '0'));
                }
            }
            writeln;
            errsInLine  =  0;
            prevErrPos  =  0;
        }
    }
    lineStartOffset  =  moduleOffset;
    linePos  =  -1;
    ++lineCnt;
    if (feof(&pasinput)) {
//        error(errEOFEncountered);
        writeln('EOF reached');
        halt;
    }
} /* endOfLine */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              storeObjWord              %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void storeObjWord(int insn) {
    objBuffer[objBufIdx]  =  insn;
    ++moduleOffset;
    if (objBufIdx == 1024) {
        error(49); /* errTooManyInsnsInBlock */
        objBufIdx  =  1;
    } else
        ++objBufIdx;
} /* storeObjWord */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//              form1Insn                 %
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form1Insn(int arg) {
int insn, opcode;
int half1, half2;
int pos;
    insn  =  arg;
    opcode = insn & 077700000;
    if (opcode == KUJ) {
        if (prevOpcode == opcode)
            return; /* no use in UJ after UJ */
        if (putLeft && prevOpcode == 1) {
            pos  =  objBufIdx - 1;
            if ((objBuffer[pos] & (077700000 << 24)) == (KVJM+I13) << 24) {
                prevOpcode  =  opcode;
                half1 = (insn & 077777U) << 24;
                half2 = (objBuffer[pos] >> 24) & 077777U;
                objBuffer[pos]  =  (KVTM+I13) << 24 | KUJ | half1 | half2;
                return;
            }
        }
    } else if (prevOpcode > 1 && insn & 07777 &&
        (insn ^ prevInsn) == (KATX ^ KXTA) /* maybe ATX/XTA */) {
// Load after store; if the load reg/off is the same as the store,
// and the store was not a stack push, there is no need to do the read.
        if (prevInsn != KATX+SP &&
            (prevInsn & 02770000) == KATX /* but still ATX */)
            return; /* skip the XTA */
    }
    prevOpcode  =  opcode;
    prevInsn  =  insn;
    if (putLeft) {
        leftInsn  =  (insn & halfWord) << 24;
        putLeft  =  false;
    } else {
        putLeft  =  true;
        storeObjWord(leftInsn | (insn & halfWord));
    }
} /* form1Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form2Insn(int i1, int i2) {
    form1Insn(i1);
    form1Insn(i2);
} /* form2Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void form3Insn(int i1, int i2, int i3) {
    form2Insn(i1, i2);
    form1Insn(i3);
} /* form3Insn */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void disableNorm() {
    if (arithMode != 1) {
        form1Insn(disNormTemplate);
        arithMode  =  1;
    }
} /* disableNorm */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formJump(int *arg) {
int pos;
int isLeft;
    if (prevOpcode != KUJ) {
        pos  =  putLeft ? objBufIdx + 4096 : objBufIdx;
        isLeft  =  putLeft;
        form1Insn(jumpType + *arg);
        if (putLeft == isLeft)
            --pos;
        *arg  =  pos;
    }
} /* formJump */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void padToLeft() {
    if (!putLeft)
        form1Insn(KUTC);
    prevOpcode  =  0;
} /* padToLeft */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void formAndAlign(int arg) {
    form1Insn(arg);
    padToLeft();
    prevOpcode  =  1;
} /* formAndAlign */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCharArray(tptr arg) {
    return arg.p.pk == kindArray && arg.rep->base == charType;
} /* isCharArray */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCompactP(tptr t) {
/* An ordinary pointer type encoded wholly in the tptr word: rep, psize
 * and bits carry the ultimate non-pointer base, pad packs depth*8 plus
 * the base kind.  Base kind 0 is never encoded (pointer-to-void is the
 * voidPtr singleton), so a heap-allocated pointer descriptor, whose pad
 * is 0, is not mistaken for a compact pointer. */
    return t.p.pk == kindPtr && (t.p.pad & 7) != 0;
} /* isCompactP */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int typeBits(tptr typtr) {
    if (isCompactP(typtr))
        return 15;
    return typtr.p.bits;
} /* typeBits */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int typeSize(tptr typtr) {
    if (isCompactP(typtr))
        return 1;
    return typtr.p.psize;
} /* typeSize */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr ptrBase(tptr t) {
/* Pointee of a pointer type: compact words reconstruct it in place,
 * heap-allocated descriptors read the record. */
tptr b;
    if (!isCompactP(t))
        return t.rep->base;
    b = t;
    if (t.p.pad >= 020) {
        b.p.pad = t.p.pad - 010;
    } else {
        b.p.pk = kind(t.p.pad & 7);
        b.p.pad = 0;
    }
    return b;
} /* ptrBase */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int isCharPtr(tptr arg) {
    return arg.p.pk == kindPtr && typeSize(arg) == 1 &&
           ptrBase(arg) == charType;
} /* isCharPtr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* A pointer to a routine, i.e. a function pointer.  getPtrType always
   compact-encodes one (a routine type leaves pad 0), so the test is on the
   encoding itself: calling ptrBase here would read the pointee descriptor,
   which a pointer with no descriptor of its own -- voidPtr -- does not
   have. */
int isRoutinePtr(tptr arg) {
    return isCompactP(arg) && (arg.p.pad == 010 + int(kindRoutine));
} /* isRoutinePtr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
/* The step for pointer arithmetic: the pointee's size in words.  A step of
   0 bars the arithmetic; it covers a void pointer, which is what '&x' and
   NULL are here, and a pointer to a routine, whose value is an entry
   address. */
int eltStep(tptr t) {
    if (t.p.pk != kindPtr || t == voidPtr || isRoutinePtr(t))
        return 0;
    return typeSize(ptrBase(t));
} /* eltStep */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void putToSymTab(int arg) {
    symTab[symTabPos]  =  arg;
    if (symTabPos == 075500) {
        error(50); /* errSymbolTableOverflow */
        symTabPos  =  074000;
    } else
        ++symTabPos;
} /* putToSymTab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int allocExtSymbol(int sym) {
int i;
    if (curVal.i & halfWord) {
        for (i = 1; i <= longSymCnt; ++i)
            if (curVal.i == longSyms[i]) {
                return longSym[i];
            }
        ++longSymCnt;
        if (longSymCnt >= 90) {
            error(51); /* errLongSymbolOverflow */
            longSymCnt  =  1;
        }
        longSym[longSymCnt]  =  symTabPos;
        longSyms[longSymCnt]  =  curVal.i;
        sym  |=  020000000U;
    } else
        sym  |=  curVal.i;
    putToSymTab(sym);
    return symTabPos - 1;
} /* allocExtSymbol */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getHelperProc(int l3arg1z) {
    if (helperMap[l3arg1z] == 0) {
        curVal.i  =  helperNames[l3arg1z];
        helperMap[l3arg1z]  =  allocExtSymbol(extSymMask);
    }
    return  helperMap[l3arg1z] + (KVJM+I13);
} /*getHelperProc */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int allocSymtab(int arg) {
int low, high, mid, ret;
word value;
    low  =  0;
    value.i  =  arg;
    if (symTabCnt == 0) {
        ret  =  symTabPos;
        symTabCnt  =  1;
        symTabArray[0].i  =  arg;
        symtbidx[0]  =  symTabPos;
    } else {
        high  =  symTabCnt;
        do {
            mid  =  (low + high) / 2;
            if (value == symTabArray[mid]) {
                return symtbidx[mid];
            }
            if (uword(value.i) < uword(symTabArray[mid].i))
                 high  =  mid;
            else
                 low  =  mid + 1;
        } while (high > low);
        ret  =  symTabPos;
        if (symTabCnt != 80) {
            high  =  uword(value.i) < uword(symTabArray[mid].i) ? mid : mid + 1;
            for (low  =  symTabCnt; low > high; --low) {
                mid  =  low - 1;
                symTabArray[low]  =  symTabArray[mid];
                symtbidx[low]  =  symtbidx[mid];
            }
            ++symTabCnt;
            symTabArray[high]  =  value;
            symtbidx[high]  =  symTabPos;
        }
    }
    putToSymTab(value.i);
    return ret;
} /* allocSymtab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getFCSToffset() {
int offset;
    offset  =  addCurValToFCST();
    if (offset < 2048) {
        return offset;
    } else if (offset >= 4096)
        error(204);
    else {
        return allocSymtab(offset | 040000000U) - 070000;
    }
} /* getFCSToffset */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
tptr mkIntScl(int bitWid) {
tptr res;
inptr icand;
    if (bitWid < 1 || 40 < bitWid) {
        error(errNumberTooLarge);
        return intType;
    }
    icand = internHead;
    while (icand != NULL) {
        res = icand->ityp;
        if (res.p.pk == kindScalar && res.p.bits == bitWid)
            return res;
        icand = icand->inext;
    }
    res.rep = malloc(offsetof(types, szScalar));
    { register types *ty = (res.rep);
        ty->start = -1;
        ty->enums = NULL;
        ty->numen = 1 << bitWid;
    }
    res.p.psize  =  1;
    res.p.bits  =  bitWid;
    res.p.pk  =  kindScalar;
    icand = malloc(sizeof(internrec));
    icand->ityp = res;
    icand->inext = internHead;
    internHead = icand;
    return res;
} /* mkIntScl */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int getValueOrAllocSymtab(int value) {
    curVal.i  =  value & 077777;
    return (040000 >= curVal.i) ? curVal.i
        : allocSymtab((curVal.i | 040000000U) & halfWord);
} /* getValueOrAllocSymtab */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// fixup -- address-fixup helper.  mode 0 starts a chain at moduleOffset,
// and the other modes patch a pending chain; see the arms below.
void fixup(int mode, int arg) {
int addr, insn, leftHalf;
int isLarge;
int work, offset;
    if (mode == 0) {
        padToLeft();
        curVal.i  =  moduleOffset;
1:      addr  =  curval.i & 077777U;
        leftHalf = curVal.i << 24;
        while (arg) {
            if (4096 < arg) {
                isLarge  =  true;
                arg  -=  4096;
            } else isLarge  =  false;
            insn  =  objBuffer[arg];
            if (isLarge) {
                curVal.i  = (insn >> 24) & 077777U;
                insn  =  insn & 07770000077777777U | leftHalf;
            } else {
                curVal.i  =  insn & 077777U;
                insn  =  insn & 07777777777700000U | addr;
            }
            objBuffer[arg]  =  insn;
            arg  =  curVal.i;
        }
        return;
    } else if (mode == 2) {
        form1Insn(KVTM+I14 + curVal.i);
        if (curVal.i == 074001)
            form1Insn(KUTM+I14 + FcstCnt);
        form3Insn(KITA+14, KASN + arg, KAOX+I7+1);
        form1Insn(KATX+I7+1);
        return;
    } else if (mode < -2) {
        arg  -=  curVal.i;
        offset  =  getFCSToffset();
        work  =  -mode;
        curVal.i  =  arg;
        arg  =  getFCSToffset();
        form3Insn(KATX+SP+1, KSUB+I8 + offset, work);
        form3Insn(KRSUB+I8 + arg, work, KXTA+SP+1);
        return;
    } else if (mode == -1) {
        form1Insn(KVTM+I14 + lineCnt);
        formAndAlign(getHelperProc(arg));
        return;
    }
    curVal.i  =  mode;
    goto 1;
} /* fixup */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void requiredSymErr(symbol sym) {
    if (linePos != prevErrPos) {
        error(sym + 88);
    }
} /* requiredSymErr */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void readToPos80() {
int c;
    while (linePos < 80) {
        ++linePos;
        c  =  fgetc(&PASINPUT);
        lineBuf[linePos]  =  c;
    }
    endOfLine();
} /* readToPos80 */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void nextCH() {
    /* Columns past lineBuf are dropped, not stored: keep reading them until
       the line ends, so that CH comes back at the line's end and neither
       linePos nor the stores leave the buffer. */
    do {
        CH  =  fgetc(&PASINPUT);
        atEOL  =  CH == '\n' || CH == 0;
        if (linePos < maxLineLen-1) {
            ++linePos;
            lineBuf[linePos]  =  CH;
            return;
        } 
    } while (! atEOL);
} /* nextCH */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void parseComment() { /* parseComment */
int badOpt, flag;
char c;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int readOptVal(int limit) {
int t;
    nextCH();
    t  =  0;
    while (('9' >= CH) && (CH >= '0')) {
        t  =  10 * t + CH - '0';
        nextCH();
        badOpt  =  false;
    }
    if (limit < t)  badOpt  =  true;
    return t;
} /* readOptVal */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void readOptFlag(int *res) {
    nextCH();
    if (CH == '-' || CH == '+') {
        *res  =  CH == '+';
        badOpt  =  false;
    }
    nextCH();
} /* readOptFlag */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    nextCH();
    if (CH == '=') {
        do {
        nextCH();
        badOpt  =  true;
        switch (CH) {
        case 'D':
            curVal.i = readOptVal(15);
            optSflags  =  optSflags & [0..40] | curVal.i & [41..47];
            break;
        case 'Y': readOptFlag(&allowCompat); break; // just for LINES STRUCTURE
        case 'E': readOptFlag(&declEntry); break;
        case 'S':
            curVal.i = readOptVal(8);
            if (curVal.i == 3)  lineCnt  =  1;
            else if (curVal.i in [4..7])
                optSflags  |=  E48 >> (curVal.i - 3);
            break;
        case 'F': readOptFlag(&checkFortran); break;
        case 'I': readOptFlag(&enableStdInput); break;
        case 'L': PASINFOR.listMode = readOptVal(3); break;
        case 'A': charEncoding = readOptVal(3); break;
        case 'C': readOptFlag(&checkTypes); break;
        case 'M': readOptFlag(&fixMult); break;
        case 'B': fileBufSize = readOptVal(4); break;
        case 'K': heapSize = readOptVal(23); break;
        }
        if (badOpt) {
            error(54); /* errErrorInPseudoComment */
        }
        } while (CH == ',');
    }
    do {
        while (CH != '*') {
            if (CH == 0) {
                error(errEOFEncountered);
                longjmp(jb9999, 1);
            }
            c  =  commentModeCH;
            commentModeCH  =  '*';
            if (atEOL)
                endOfLine();
            nextCH();
            commentModeCH  =  c;
        }
        nextCH();
    } while (CH != '/');
    nextCH();
} /* parseComment */
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
int skipSp() {
     while ((CH == ' ' || CH == '\t') && !atEOL)
         nextCH();
     if (CH == 0)
         return false;
     if (atEOL) {
         endOfLine();
         nextCH();
         return true;
     }
     return false;
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void inSymbol() { /* inSymbol */
int localBuf[131];
int tokenLen, tokenIdx;
int expSign;
irptr chain;
float expMultiple, expValue;
char curChar;
char litQuote;
word numstr[17];
int expLiteral, expMagnitude;
int val;
int jb1473;
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void doCharConst(char lim) {
// Set of characters that are not themselves after \
// 0123 4567 89:; <=>? @ABC DEFG HIJK LMNO PQRS TUVW XYZ
// ++++ ++++            ++    +         +    +  + +
//             11 1111 1111 2222 2222 2233 3333 3333 4444 4444
//             01 2345 6789 0123 4567 8901 2345 6789 0123 4567
const escSet = 0xFF0062022A00;
escMap = 007101412151113;
int advanced;
   advanced  =  false;
   for (tokenIdx = 6; tokenIdx <= 130; ++tokenIdx) {
       if (! advanced)
           nextCH();
       advanced  =  false;
       if (CH == lim) {
           nextCH();
           return;
       }
       if (atEOL) {
2175:      error(59); /* errEOLNInStringLiteral */
            return;
        } else if (CH == BACKSLASH) {
            nextCH();
            if (CH-'0' IN escSet) {
                if (CH <= '7') {
                    expLiteral  =  0;
                    tokenLen  =  0;
                    do {
                        expLiteral  =  8*expLiteral + CH - '0';
                        ++tokenLen;
                        nextCH();
                        if ((tokenLen == 3) || (CH < '0') || ('7' < CH)) {
                            advanced  =  true;
                            break;
                        }
                    } while (true);
                    if (255 < expLiteral) {
                        error(errFirstDigitInCharLiteralGreaterThan3);
                    }
                    localBuf[tokenIdx]  =  expLiteral;
                } else {
                    val = card(escSet << (CH-'0')) - 1;
                    localBuf[tokenIdx]  =  (escMap >> (6*val)) & 077;
                }
            } else {
                goto 2233;
            }
        } else
2233:       {
                if (charEncoding == 3) {
                    if (ch < '*' || '\176' < CH)
                        curChar  =  '\0';
                    else {
                        curChar  =  iso2text[CH];
                    }
                } else {
                    curChar  =  CH;
                }
                localBuf[tokenIdx]  =  curChar;
            }
    }
    goto 2175
}
//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void lexer() {
    switch (SY) {
    case IDENT: {
        curToken.i  = 0U;
        tokenLen  =  1;
        do {
            curVal.c  =  iso2text[CH];
            nextCH();
            if (8 >= tokenLen) {
                ++tokenLen;
                curToken.i  =  (curToken.i << 6) | curVal.i;
            }
        } while (chrClass[CH] == ALNUM);
        curVal.i  =  curToken.i & hashMask;
        bucket = mapAI(curVal.i);
        curIdent  =  curToken.i;
        keywordHashPtr  =  kwordHash[bucket];
        while (keywordHashPtr != NULL) {
            if (keywordHashPtr->w == curToken.i) {
                SY  =  keywordHashPtr->sym;
                if (SY == TYPESY)
                    symType  =  keywordHashPtr->typ;
                else
                    charClass  =  keywordHashPtr->op;
                return;
            }
            keywordHashPtr  =  keywordHashPtr->next;
        }
        isDefined  =  false;
        SY  =  IDENT;
        switch (lookupMode) {
        case lookDef:
            hashTravPtr  =  symHash[bucket];
            while (hashTravPtr != NULL) {
                if (hashTravPtr->pck.p.offset == curFrameRegTemplate) {
                    if (hashTravPtr->id != curIdent)
                        hashTravPtr  =  hashTravPtr->pck.p.next;
                    else {
                        isDefined  =  true;
                        return;
                    }
                } else
                    return;
            }
            break;
        case lookUse:
            hashTravPtr  =  symHash[bucket];
            while (hashTravPtr != NULL) {
                if (hashTravPtr->id != curIdent)
                    hashTravPtr  =  hashTravPtr->pck.p.next;
                else {
                    if (hashTravPtr->pck.p.cl == TYPEID) {
                        SY  =  TYPESY;
                        symType  =  hashTravPtr->typ;
                    }
                    return;
                }
            }
            break;
        case lookField:
            hashTravPtr  =  fieldHash[bucket];
            while (hashTravPtr != NULL) {
                { register identrec *ir = hashTravPtr;
                    if ((ir->id == curIdent) &&
                       (typ121z == ir->uptype))
                        return;
                    hashTravPtr  =  ir->pck.p.next;
               }
           }
        }
        break;
    } /* IDENT */
    case INTCONST: { /*=m-*/
        SY  =  INTCONST;
        tokenLen  =  -1;
        do {
            ++tokenLen;
            if (tokenLen <= 16)
                numstr[tokenLen].i  =  CH - '0';
            else {
                error(55); /* errMoreThan16DigitsInNumber */
                tokenLen  =  1;
            }
            nextCH();
        } while (charSym[CH] == INTCONST);
        do {
            if ((numstr[0].i == 0) && (CH != '.')) {
                if (tokenLen == 0 && CH == 'X') {
                    /* Hex literal: 0Xhhh[U] */
                    numFormat = hex;
                    nextCH();
                    curToken.i = 0;
                    while (charSym[CH] == INTCONST
                       || ('A' <= CH) && (CH <= 'F')) {
                        curToken.i = curToken.i << 4 |
                            CH - (charSym[CH] == INTCONST ? 48 : 55);
                        nextCH();
                    };
                    if (CH == 'U')
                        nextCH();
                    return;
                };
