//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
void finalize() {
int idx, cnt;
int sizes[10];
    sizes[0]  =  1;
    sizes[1]  =  symTabPos - 074000 - 1;
    sizes[4]  =  longSymCnt;
    sizes[5]  =  moduleOffset - 040000;
    sizes[7]  =  FcstCnt;
    sizes[2]  =
    sizes[3]  =
    sizes[6]  =  0;
    sizes[8]  =  lookup2;
    sizes[9]  =  lookupMode;
    curVal.i  =  moduleOffset - 040000;
    symTab[074001]  =  [24,29] | curVal.i;
    frewind(&FCST);
