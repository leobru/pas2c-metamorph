//
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// Materialize all buffered initializers as the contiguous trailing data region
// of FCST.  Called at program end, after the whole constant pool has been laid
// down; replays the INITBUF stream with one-entry lookahead so 'hasNext' drives
// the list/fill record emission (consecutive single values coalesce into one
// record; a 'value:count' is a fill).
void flushInitializers() {
int dsize, setcount, dataLoc, length, dataSegLen, base;
int ck, ca, cb, nk, na, nb;
int curEnd, nextEnd, rep, hasNext;
word savedVal;
ifcb F;
//
void putDataRec(int cnt) {
int rec;
    rec  =  allocDataRef(length) << 36;
    if (FcstCnt == dataLoc) {
        curVal  =  savedVal;
        curVal.i  =  addCurValToFCST();
    } else {
        curVal.i  =  dataLoc;
    }
    rec  =  rec | (07777U & allocSymtab(0400100000000U | curVal.i & halfWord)) << 24;
    rec  =  rec | allocDataRef(cnt) << 12;
    if (dataSegLen == 0) {
        curVal.i  =  base >> 24;
    } else {
        curVal.i  =  allocSymtab(base | dataSegLen & halfWord);
    }
    rec  =  rec | curVal.i & 07777U;
    dataSegLen  =  cnt * length + dataSegLen;
    fputw(rec, &F);
    ++setcount;
    length  =  0;
    dataLoc  =  FcstCnt;
} /* putDataRec */
//
    fopen(&F, 010000100000, 0);
    frewind(&INITBUF);
    dsize  =  FcstCnt;
    setcount  =  0;
    length  =  0;
    dataSegLen  =  0;
    dataLoc  =  FcstCnt;
    base  =  0;
    curEnd  =  feof(&INITBUF);
    if (! curEnd) {
        ck  =  fgetw(&INITBUF);
        ca  =  fgetw(&INITBUF);
        cb  =  fgetw(&INITBUF);
    }
    while (! curEnd) {
        nextEnd  =  feof(&INITBUF);
        if (! nextEnd) {
            nk  =  fgetw(&INITBUF);
            na  =  fgetw(&INITBUF);
            nb  =  fgetw(&INITBUF);
        }
        if (ck == 0) {
            base  =  ca;
            dataLoc  =  FcstCnt;
            length  =  0;
            dataSegLen  =  0;
        } else {
            savedVal.i  =  ca;
            rep  =  cb;
            hasNext  =  (! nextEnd) && (nk == 1);
            if (rep != 1) {
                if (length != 0)
                    putDataRec(1);
                length  =  1;
                putDataRec(rep);
            } else {
                ++length;
                if (hasNext) {
                    curVal  =  savedVal;
                    toFCST();
                } else {
                    if (length != 1) {
                        curVal  =  savedVal;
                        toFCST();
                    }
                    putDataRec(1);
                }
            }
        }
        ck  =  nk;  ca  =  na;  cb  =  nb;
        curEnd  =  nextEnd;
    }
    frewind(&F);
    while (! feof(&F)) {
        fputw(fgetw(&F), &FCST);
    }
    lookup2  =  FcstCnt - dsize;
    FcstCnt  =  dsize;
    lookupMode  =  setcount;
} /* flushInitializers */
