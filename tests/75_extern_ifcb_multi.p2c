typedef struct { int *data; int rest[29]; } ifcb;
extern ifcb _child_, pasinput;
int i;

void fopen(ifcb *fcb, int sizes, int name) assembler;
void fclose(ifcb *fcb) assembler;
void ftruncate(ifcb *fcb) assembler;
void fputw(int value, ifcb *f) assembler;

void main() {
    fopen(&_child_, 010000100000, t'*CHILD* ');
    ftruncate(&_child_);
    for (i = 0; i < 3; i = i + 1) {
        fputw(i + 1, &_child_);
    }
    fclose(&_child_);
    printf("%d\n", i);
}
