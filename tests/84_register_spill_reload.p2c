/*=k9,l0*/
//
// A pinned base whose address costs more than one instruction is also spilled
// to a frame slot.  Its normal M2..M6 register is callee-saved, so a call must
// preserve the base without a caller-side reload; the base must stay the one
// computed on entry even when the index changes inside the body.
//
typedef struct {
    int a, b;
} inner;
typedef struct {
    inner pt;
    int tag;
} outer;
outer arr[4];
int i, j, k;
int probe;
//
// Both callees pin a base of their own, exercising the same register set that
// their entry/exit convention must save and restore for the caller.
//
void proc() {
    k = 3;
    { register inner *q = &arr[k].pt;
        q->b = q->b + 1;
    }
    probe = probe + 1;
}
//
int func(int n) {
    k = 3;
    { register inner *q = &arr[k].pt;
        q->b = q->b + 1;
    }
    return n * 2;
}
//
void main() {
    i = 1;
    j = 2;
    arr[1].tag = 100;
    arr[3].tag = 300;
    { register inner *p = &arr[i].pt;
        p->a = 10;
        proc();
        p->b = p->a + 5;
        i = 3;
        p->a = p->a + func(1);
        p->b = p->b + p->a;
        { register inner *q = &arr[j].pt;
            q->a = 70;
            proc();
            q->b = q->a + 1;
        }
        probe = probe + 100;
        p->b = p->b + 1;
    }
    writeln(" A1=", arr[1].pt.a:0, " B1=", arr[1].pt.b:0);
    writeln(" A2=", arr[2].pt.a:0, " B2=", arr[2].pt.b:0);
    writeln(" A3=", arr[3].pt.a:0, " B3=", arr[3].pt.b:0);
    writeln(" TAGS=", arr[1].tag:0, ' ', arr[3].tag:0, " PROBE=", probe:0);
}
