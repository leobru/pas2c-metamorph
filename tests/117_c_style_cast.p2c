/*=k9,l0*/
//
// A cast is written the way C writes it: a type name in parentheses in front
// of a unary expression.  The type name is a type-spec and an abstract
// declarator -- the same pair a parameter list takes -- so a pointer, a
// pointer to a pointer, a pointer to a routine and an array are all named in
// place.
//
// A cast retypes its value and emits no code, so the two types must occupy
// the same number of words.  int and float are the one exception: they differ
// in representation, so a cast between them converts, exactly as an
// assignment between them does.
//
typedef void *anyptr;
typedef void *uword;
typedef struct { int a, b, c, d; } four;
typedef int quad[4];
const anyptr NULL = (anyptr)0;
//
int i, j, k;
char c;
float f;
int *ip;
int **ipp;
anyptr ap;
int (*fp)(int);
four s, r;
quad q;
//
int twice(int n) {
    return n + n;
}
//
void main() {
    // A character and an integer are one word each, so either names the
    // other's value.
    c  =  (char)65;
    printf(" CHAR   %4d%4d\n", (int)c, (int)'B');
    // A pointer casts to a void pointer and back.
    i  =  7;
    ip  =  &i;
    ap  =  (anyptr)ip;
    printf(" PTR    %4d%3d%3d\n", (*(int *)ap), ((int *)ap == ip), (ap == NULL));
    // Two stars in the type name are two levels of pointer.
    ipp  =  &ip;
    printf(" PTRPTR %4d\n", (**(int **)(anyptr)ipp));
    // A parenthesized declarator names a pointer to a routine.
    fp  =  (int (*)(int))twice;
    printf(" FNPTR  %4d\n", fp(21));
    // Ordering follows the type: a pointer type compares its bits.
    i  =  -1;
    j  =  1;
    printf(" ORDER  %3d%3d\n", (i < j), ((uword)i < (uword)j));
    // int and float convert in both directions, and a constant folds.
    i  =  7;
    f  =  (float)i;
    printf(" WIDEN  %9.2f%9.2f\n", f, (float)3);
    f  =  6.75;
    printf(" TRUNC  %4d%4d%4d\n", (int)f, (int)-f, (int)6.75);
    // The cast binds tighter than a binary operator and looser than a
    // postfix one, so the parentheses below say two different things.
    printf(" PREC   %4d%4d\n", ((int)f * 2), ((int)(f * 2)));
    printf(" PRECF  %9.2f%9.2f\n", ((float)i / 2), ((float)(i / 2)));
    // A cast is not limited to one word, and an array type names one: the
    // bound is a constant expression, spelled out here and behind a typedef.
    // An array is not assignable, so the four-word copy lands in the struct.
    printf(" MULTI  %4d%4d\n", sizeof((int[4])s), sizeof((quad)s));
    q[0]  =  10;
    q[1]  =  20;
    q[2]  =  30;
    q[3]  =  40;
    r  =  (four)q;
    printf(" TYPEDEF%4d%4d%4d%4d\n", r.a, r.b, r.c, r.d);
    // Its operand is a unary expression, so a sign, a dereference and an
    // address-of all belong to the operand.
    k  =  3;
    ip  =  &k;
    printf(" UNARY  %4d%6d%4d\n", (int)*ip, (int)-c, (int)*&i);
}
