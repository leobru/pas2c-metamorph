/*=s8,y+,k9,l0*/
//
// Operations on pointers to structures of one, two, three, five and thirty
// words, plus a one-word structure whose fields are narrower than a word.
// The size of the pointee drives several codegen paths at once: a whole-value
// copy is a load/store pair at one word and the VLM block-move loop above it,
// '&arr[i]' scales the index by the element size, and a field's offset decides
// whether the access is a bare index-register reference or a displaced one.
// The pointer itself is one word whatever it points to, so everything else --
// comparison, assignment, passing, returning, indirection through a pointer to
// a pointer -- must be size-independent.
//
typedef void *anyptr;
const NULL = anyptr(074000);
//
typedef struct { int a; } w1;
typedef struct { int a, b; } w2;
typedef struct { int a, b, c; } w3;
typedef struct { int a, b, c, d, e; } w5;
typedef struct { int x[0..29]; } w30;
typedef __packed struct { int:8 lo, mid, hi; } pk1;
typedef struct { int val; node *next; } node;
//
w1 s1, d1;      w1 *p1, *q1;
w2 s2, d2;      w2 *p2, *q2;
w3 s3, d3;      w3 *p3, *q3;
w5 s5, d5;      w5 *p5, *q5;
w30 s30, d30;   w30 *p30, *q30;
pk1 kk;         pk1 *pk;
w3 t3[0..2];
w5 t5[0..2];
w3 *ptab[0..2];
w5 **pp5;
node n1, n2, n3;
node *pn;
int i, k;
//
// A pointer parameter is one word wide however large the pointee is.
void fill5(w5 *d, int base) {
    d->a  =  base;
    d->b  =  base + 1;
    d->c  =  base + 2;
    d->d  =  base + 3;
    d->e  =  base + 4;
}
//
int sum5(w5 *q) {
    return q->a + q->b + q->c + q->d + q->e;
}
//
// A thirty-word copy with both sides reached through pointers.
void copy30(w30 *dst, w30 *src) {
    *dst  =  *src;
}
//
w3 *pick3(int f) {
    return f ? &t3[0] : &t3[2];
}
//
w30 *pick30(int f) {
    return f ? &s30 : &d30;
}
//
void main() {
    writeln(' SIZES ', sizeof(w1):3, sizeof(w2):3, sizeof(w3):3, sizeof(w5):3,
            sizeof(w30):3, sizeof(pk1):3);
    s1.a  =  11;
    s2.a  =  21;  s2.b  =  22;
    s3.a  =  31;  s3.b  =  32;  s3.c  =  33;
    fill5(&s5, 51);
    for (i = 0; i <= 29; i = i + 1)
        s30.x[i]  =  100 + i;
    p1  =  &s1;  p2  =  &s2;  p3  =  &s3;  p5  =  &s5;  p30  =  &s30;
    // The last field of each: offset 0, 1, 2, 4 and 29.
    writeln(' READ  ', p1->a:4, p2->b:4, p3->c:4, p5->e:4, p30->x[29]:4);
    p1->a  =  p1->a + 1;
    p2->b  =  p2->b + 1;
    p3->c  =  p3->c + 1;
    p5->e  =  p5->e + 1;
    p30->x[29]  =  p30->x[29] + 1;
    writeln(' WRITE ', s1.a:4, s2.b:4, s3.c:4, s5.e:4, s30.x[29]:4);
    // Whole-value copy, both sides through pointers.
    q1  =  &d1;  q2  =  &d2;  q3  =  &d3;  q5  =  &d5;  q30  =  &d30;
    *q1  =  *p1;
    *q2  =  *p2;
    *q3  =  *p3;
    *q5  =  *p5;
    copy30(q30, p30);
    writeln(' COPY  ', d1.a:4, d2.b:4, d3.c:4, d5.e:4, d30.x[0]:4, d30.x[29]:4);
    // One side a variable, the other a pointee.
    d3.a  =  0;  d3.b  =  0;  d3.c  =  0;
    d3  =  *p3;
    writeln(' LOAD  ', d3.a:4, d3.b:4, d3.c:4);
    s3.a  =  99;
    *q3  =  s3;
    writeln(' STORE ', d3.a:4, d3.b:4, d3.c:4);
    // '&arr[i]' scales a variable index by the element size.
    for (i = 0; i <= 2; i = i + 1) {
        p3  =  &t3[i];
        p3->a  =  300 + i;
        p3->c  =  310 + i;
        p5  =  &t5[i];
        p5->a  =  500 + i;
        p5->e  =  510 + i;
    }
    writeln(' ELT3  ', t3[0].a:4, t3[2].a:4, t3[0].c:4, t3[2].c:4);
    writeln(' ELT5  ', t5[0].a:4, t5[2].a:4, t5[0].e:4, t5[2].e:4);
    // Comparison is on the one-word pointer, not on the pointee.
    p3  =  &t3[0];
    q3  =  &t3[2];
    writeln(' CMP   ', (p3 == q3):2, (p3 != q3):2, (p3 < q3):2, (q3 > p3):2);
    q3  =  p3;
    writeln(' SAME  ', (p3 == q3):2, (p3 != q3):2, (q3 == NULL):2);
    // A pointer to a pointer to a five-word structure.
    p5  =  &s5;
    pp5  =  &p5;
    (*pp5)->a  =  77;
    writeln(' PP    ', s5.a:4, (*pp5)->e:4);
    // An array of pointers: index, then follow.
    ptab[0]  =  &t3[0];
    ptab[1]  =  &t3[1];
    ptab[2]  =  &t3[2];
    k  =  0;
    for (i = 0; i <= 2; i = i + 1)
        k  =  k + ptab[i]->a;
    writeln(' PTAB  ', k:5, ptab[1]->c:5);
    // Heap objects of one, three and thirty words.
    p1  =  malloc(sizeof(w1));
    p3  =  malloc(sizeof(w3));
    p30  =  malloc(sizeof(w30));
    p1->a  =  1;
    p3->a  =  3;
    p3->c  =  5;
    p30->x[0]  =  30;
    p30->x[29]  =  59;
    writeln(' HEAP  ', p1->a:4, p3->a:4, p3->c:4, p30->x[0]:4, p30->x[29]:4,
            (p1 != NULL):2);
    // Passed to a routine and returned from one.
    fill5(&d5, 60);
    writeln(' PARAM ', sum5(&d5):5, d5.a:4, d5.e:4);
    writeln(' RET   ', pick3(1)->a:4, pick3(0)->a:4, pick30(1)->x[3]:4);
    // Fields narrower than a word, through a pointer.
    pk  =  &kk;
    pk->lo  =  1;
    pk->mid  =  2;
    pk->hi  =  3;
    writeln(' PACK  ', int(pk->lo):4, int(pk->mid):4, int(pk->hi):4);
    // A pinned pointer at both ends of the size range.
    { register w30 *r = &s30;
      writeln(' REG30 ', r->x[0]:4, r->x[29]:4);
    }
    { register w1 *r = &s1;
      writeln(' REG1  ', r->a:4);
    }
    // A pointer field inside the structure it points to.
    n1.val  =  1;  n1.next  =  &n2;
    n2.val  =  2;  n2.next  =  &n3;
    n3.val  =  3;  n3.next  =  NULL;
    k  =  0;
    pn  =  &n1;
    while (pn != NULL) {
        k  =  k + pn->val;
        pn  =  pn->next;
    }
    writeln(' CHAIN ', n1.next->val:4, n1.next->next->val:4, k:4);
}
