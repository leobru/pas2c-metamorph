/*=k9,l0*/
//
// Operations on pointers to structures of one, two, three, five and thirty
// words, plus a one-word structure whose fields are narrower than a word.
// The size of the pointee drives several codegen paths at once: a whole-value
// copy is a load/store pair at one word and the VLM block-move loop above it,
// '&arr[i]' scales the index by the element size, and a field's offset decides
// whether the access is a bare index-register reference or a displaced one.
// The pointer itself is one word whatever it points to, so everything else --
// comparison, assignment, passing, returning, indirection through a pointer to
// a pointer -- must be size-independent.
//
typedef void *anyptr;
const anyptr NULL = (anyptr)0;
//
typedef struct { int a; } w1;
typedef struct { int a, b; } w2;
typedef struct { int a, b, c; } w3;
typedef struct { int a, b, c, d, e; } w5;
typedef struct { int x[30]; } w30;
typedef __packed struct { int:8 lo, mid, hi; } pk1;
typedef struct { int val; node *next; } node;
//
w1 s1, d1;      w1 *p1, *q1;
w2 s2, d2;      w2 *p2, *q2;
w3 s3, d3;      w3 *p3, *q3;
w5 s5, d5;      w5 *p5, *q5;
w30 s30, d30;   w30 *p30, *q30;
pk1 kk;         pk1 *pk;
w3 t3[3];
w5 t5[3];
w3 *ptab[3];
w5 **pp5;
node n1, n2, n3;
node *pn;
int i, k;
//
// A pointer parameter is one word wide however large the pointee is.
void fill5(w5 *d, int base) {
    d->a  =  base;
    d->b  =  base + 1;
    d->c  =  base + 2;
    d->d  =  base + 3;
    d->e  =  base + 4;
}
//
int sum5(w5 *q) {
    return q->a + q->b + q->c + q->d + q->e;
}
//
// A thirty-word copy with both sides reached through pointers.
void copy30(w30 *dst, w30 *src) {
    *dst  =  *src;
}
//
w3 *pick3(int f) {
    return f ? &t3[0] : &t3[2];
}
//
w30 *pick30(int f) {
    return f ? &s30 : &d30;
}
//
void main() {
    printf(" SIZES %3d%3d%3d%3d%3d%3d\n", sizeof(w1), sizeof(w2), sizeof(w3), sizeof(w5),
           sizeof(w30), sizeof(pk1));
    s1.a  =  11;
    s2.a  =  21;  s2.b  =  22;
    s3.a  =  31;  s3.b  =  32;  s3.c  =  33;
    fill5(&s5, 51);
    for (i = 0; i <= 29; i = i + 1)
        s30.x[i]  =  100 + i;
    p1  =  &s1;  p2  =  &s2;  p3  =  &s3;  p5  =  &s5;  p30  =  &s30;
    // The last field of each: offset 0, 1, 2, 4 and 29.
    printf(" READ  %4d%4d%4d%4d%4d\n", p1->a, p2->b, p3->c, p5->e, p30->x[29]);
    p1->a  =  p1->a + 1;
    p2->b  =  p2->b + 1;
    p3->c  =  p3->c + 1;
    p5->e  =  p5->e + 1;
    p30->x[29]  =  p30->x[29] + 1;
    printf(" WRITE %4d%4d%4d%4d%4d\n", s1.a, s2.b, s3.c, s5.e, s30.x[29]);
    // Whole-value copy, both sides through pointers.
    q1  =  &d1;  q2  =  &d2;  q3  =  &d3;  q5  =  &d5;  q30  =  &d30;
    *q1  =  *p1;
    *q2  =  *p2;
    *q3  =  *p3;
    *q5  =  *p5;
    copy30(q30, p30);
    printf(" COPY  %4d%4d%4d%4d%4d%4d\n", d1.a, d2.b, d3.c, d5.e, d30.x[0], d30.x[29]);
    // One side a variable, the other a pointee.
    d3.a  =  0;  d3.b  =  0;  d3.c  =  0;
    d3  =  *p3;
    printf(" LOAD  %4d%4d%4d\n", d3.a, d3.b, d3.c);
    s3.a  =  99;
    *q3  =  s3;
    printf(" STORE %4d%4d%4d\n", d3.a, d3.b, d3.c);
    // '&arr[i]' scales a variable index by the element size.
    for (i = 0; i <= 2; i = i + 1) {
        p3  =  &t3[i];
        p3->a  =  300 + i;
        p3->c  =  310 + i;
        p5  =  &t5[i];
        p5->a  =  500 + i;
        p5->e  =  510 + i;
    }
    printf(" ELT3  %4d%4d%4d%4d\n", t3[0].a, t3[2].a, t3[0].c, t3[2].c);
    printf(" ELT5  %4d%4d%4d%4d\n", t5[0].a, t5[2].a, t5[0].e, t5[2].e);
    // Comparison is on the one-word pointer, not on the pointee.
    p3  =  &t3[0];
    q3  =  &t3[2];
    printf(" CMP   %2d%2d%2d%2d\n", (p3 == q3), (p3 != q3), (p3 < q3), (q3 > p3));
    q3  =  p3;
    printf(" SAME  %2d%2d%2d\n", (p3 == q3), (p3 != q3), (q3 == NULL));
    // A pointer to a pointer to a five-word structure.
    p5  =  &s5;
    pp5  =  &p5;
    (*pp5)->a  =  77;
    printf(" PP    %4d%4d\n", s5.a, (*pp5)->e);
    // An array of pointers: index, then follow.
    ptab[0]  =  &t3[0];
    ptab[1]  =  &t3[1];
    ptab[2]  =  &t3[2];
    k  =  0;
    for (i = 0; i <= 2; i = i + 1)
        k  =  k + ptab[i]->a;
    printf(" PTAB  %5d%5d\n", k, ptab[1]->c);
    // Heap objects of one, three and thirty words.
    p1  =  malloc(sizeof(w1));
    p3  =  malloc(sizeof(w3));
    p30  =  malloc(sizeof(w30));
    p1->a  =  1;
    p3->a  =  3;
    p3->c  =  5;
    p30->x[0]  =  30;
    p30->x[29]  =  59;
    printf(" HEAP  %4d%4d%4d%4d%4d%2d\n", p1->a, p3->a, p3->c, p30->x[0], p30->x[29], (p1 != NULL));
    // Passed to a routine and returned from one.
    fill5(&d5, 60);
    printf(" PARAM %5d%4d%4d\n", sum5(&d5), d5.a, d5.e);
    printf(" RET   %4d%4d%4d\n", pick3(1)->a, pick3(0)->a, pick30(1)->x[3]);
    // Fields narrower than a word, through a pointer.
    pk  =  &kk;
    pk->lo  =  1;
    pk->mid  =  2;
    pk->hi  =  3;
    printf(" PACK  %4d%4d%4d\n", (int)pk->lo, (int)pk->mid, (int)pk->hi);
    // A pinned pointer at both ends of the size range.
    { register w30 *r = &s30;
      printf(" REG30 %4d%4d\n", r->x[0], r->x[29]);
    }
    { register w1 *r = &s1;
      printf(" REG1  %4d\n", r->a);
    }
    // A pointer field inside the structure it points to.
    n1.val  =  1;  n1.next  =  &n2;
    n2.val  =  2;  n2.next  =  &n3;
    n3.val  =  3;  n3.next  =  NULL;
    k  =  0;
    pn  =  &n1;
    while (pn != NULL) {
        k  =  k + pn->val;
        pn  =  pn->next;
    }
    printf(" CHAIN %4d%4d%4d\n", n1.next->val, n1.next->next->val, k);
}
