/*=k9,l0*/
//
// Enum bodies with explicit '= constExpr' values; later enumerators
// auto-increment from the last value. Values may reference earlier
// enumerators (const-expressions). For explicit-value enums, name
// printing is suppressed -- the value is written as an integer.
// A word of eight six-bit characters: the shape an identifier is stored in,
// and what %t writes.
typedef __packed int:6 name8[8];
enum { A = 1, B, C = 10, D } e1;
enum { X = 5, Y = X + 3 } e2;
enum { RED, GREEN, BLUE } color;
enum { LO = -2, MID, HI } ev;
int val;
void main() {
    val = A; printf(" A=%d\n", val);
    val = B; printf(" B=%d\n", val);
    val = C; printf(" C=%d\n", val);
    val = D; printf(" D=%d\n", val);
    val = X; printf(" X=%d\n", val);
    val = Y; printf(" Y=%d\n", val);
    ev = MID; printf(" MID=%d\n", ev);
    ev = HI;  printf(" HI=%d\n", ev);
    // A plain (sequential) enum keeps a table of its enumerators' names, and
    // a cast to a text word answers the name of the value rather than its
    // ordinal.  Each ordinal picks its own entry -- the name right-aligned in
    // its eight-character word -- and a width pads that word on the left.
    color = GREEN; printf(" color=%t\n", (name8)color);
    color = RED;   printf(" first=%t\n", (name8)color);
    color = BLUE;  printf(" last =%12t|\n", (name8)color);
    // An explicit-value enum has no name table, so a cast is a plain retype.
    ev = HI;       printf(" ORD  =%d\n", (int)ev);
}
