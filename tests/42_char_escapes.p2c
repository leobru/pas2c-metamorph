int ok;
void main() {
    writeln(' ', '\101':3 oct,
            ' ', '\7':3 oct,
            ' ', '\a':3 oct,
            ' ', '\b':3 oct,
            ' ', '\f':3 oct,
            ' ', '\n':3 oct,
            ' ', '\r':3 oct,
            ' ', '\t':3 oct,
            ' ', '\v':3 oct,
            // Six characters are a word only in single quotes now: double
            // quotes carry a terminator, and 'oct' wants one word.
            ' ', '\0\0\76\0\0\5':10 oct);
}
