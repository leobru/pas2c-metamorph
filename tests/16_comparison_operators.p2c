//
int a, b;
void main() {
    a = 10;
    b = 20;
    
    if (a < b) {
        printf(" 10 < 20: true\n");
    };
    
    if (a <= b) {
        printf(" 10 <= 20: true\n");
    };
    
    if (b > a) {
        printf(" 20 > 10: true\n");
    };
    
    if (b >= a) {
        printf(" 20 >= 10: true\n");
    };
    
    if (a == a) {
        printf(" 10 == 10: true\n");
    };
    
    if (a != b) {
        printf(" 10 != 20: true\n");
    }
}
