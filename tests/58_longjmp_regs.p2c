/*=k9,l0*/
//
// C/2 saves M2-M6 in the frame and C/E restores them, so a normal return
// leaves the caller's display registers as it found them.  A longjmp does not
// pass through C/E: setjmp records M2-M6 in the jmp_buf and longjmp puts them
// back from there.  Known values are planted in M2-M6 with VTM and read back
// with ITA/ATX after two calls that differ only in how they leave: touch()
// returns, inner() longjmps.  Both must keep the planted values.
//
void longjmp(int *jmpbuf, int val) assembler;
int setjmp(int *jmpbuf) assembler;

const int KVTM = 02400000,      // ,VTM, -- M<reg> := address
          KITA = 00420000,      // ,ITA, r -- ACC := M<r>
          KATX = 00000000,      // ,ATX, -- store the accumulator
          I2 = 010000000, I3 = 014000000, I4 = 020000000,
          I5 = 024000000, I6 = 030000000;
const int V2 = 02222, V3 = 03333, V4 = 04444, V5 = 05555, V6 = 06666,
          DIRT = 07777;
const int PLANT2 = KVTM+I2+V2, PLANT3 = KVTM+I3+V3, PLANT4 = KVTM+I4+V4,
          PLANT5 = KVTM+I5+V5, PLANT6 = KVTM+I6+V6;
const int DIRTY2 = KVTM+I2+DIRT, DIRTY3 = KVTM+I3+DIRT, DIRTY4 = KVTM+I4+DIRT,
          DIRTY5 = KVTM+I5+DIRT, DIRTY6 = KVTM+I6+DIRT;
const int READ2 = KITA+2, READ3 = KITA+3, READ4 = KITA+4,
          READ5 = KITA+5, READ6 = KITA+6;

int jb[6], n;   // (frame << 15) | return address, then M2-M6
int ret2, ret3, ret4, ret5, ret6;   // M2-M6 after a normal return
int jmp2, jmp3, jmp4, jmp5, jmp6;   // M2-M6 after the longjmp

void touch() {
    printf(" TOUCH\n");
    besm(DIRTY2, DIRTY3, DIRTY4, DIRTY5, DIRTY6);
}

void inner() {
    printf(" INNER\n");
    besm(DIRTY2, DIRTY3, DIRTY4, DIRTY5, DIRTY6);
    longjmp(jb, 1);
}

void middle() { inner(); }          // two frames for longjmp to unwind

// A bare newline has to come from printf: putchar('\n') ends the line but
// costs the line that follows it.
void report(int reg, int got, int want) {
    if (got == want)
        printf(" M%d KEPT\n", reg);
    else
        printf(" M%d LOST\n", reg);
}

void main() {
    besm(PLANT2, PLANT3, PLANT4, PLANT5, PLANT6);
    touch();
    besm(READ2, KATX : ret2, READ3, KATX : ret3, READ4, KATX : ret4,
         READ5, KATX : ret5, READ6, KATX : ret6);
    besm(PLANT2, PLANT3, PLANT4, PLANT5, PLANT6);
    n = setjmp(jb);
    if (n == 0)
        middle();
    besm(READ2, KATX : jmp2, READ3, KATX : jmp3, READ4, KATX : jmp4,
         READ5, KATX : jmp5, READ6, KATX : jmp6);
    printf(" AFTER A NORMAL RETURN\n");
    report(2, ret2, V2); report(3, ret3, V3); report(4, ret4, V4);
    report(5, ret5, V5); report(6, ret6, V6);
    printf(" AFTER A LONGJMP\n");
    report(2, jmp2, V2); report(3, jmp3, V3); report(4, jmp4, V4);
    report(5, jmp5, V5); report(6, jmp6, V6);
    printf(" SETJMP RETURNED %d\n", n);
}
