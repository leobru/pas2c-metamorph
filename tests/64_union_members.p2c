/*=k9,l0*/
// True-C unions: standalone union type, individual (bare) variable members,
// overlap semantics, and an anonymous union member inside a struct.
//
typedef union {
    int i;
    float r;
} numunion;
typedef struct {
    int tag;
    union { int a, b; };
} tagged;
numunion n;
tagged t;
void main() {
    n.i = 42;
    printf("union i = %d\n", n.i);
    printf("sizeof union = %d\n", sizeof(numunion));
    t.tag = 3;
    t.a = 99;
    printf("overlap: tag=%d a=%d b=%d\n", t.tag, t.a, t.b);
    printf("sizeof tagged = %d\n", sizeof(tagged));
}
