//
// Test P/LDARIN via pointer dereference
typedef int *intptr;
intptr p;
int x, value;
void main() {
    x = 42;
    p = &x;
    value = *p;                // Pointer dereference → st2 → P/LDARIN
    printf("Value via pointer: %d\n", value);
    
    x = 99;
    value = *p;
    printf("Updated value: %d\n", value);
}
