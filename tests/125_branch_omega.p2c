/*=k9,l0*/
//
// A branch reads the omega left by the last instruction that set it.  The
// peephole in form1Insn drops an XTA that repeats the operand of the ATX just
// before it, since the accumulator already holds the value -- but that load is
// also what would have set omega to "is it zero".  Dropping it leaves whatever
// the body computed with: after A-X that is a *sign* test, so the branch asks
// "did it go negative" instead.  Cases A, C and F are the ones that reach it;
// the rest are here so a fix cannot quietly break the shapes that were right,
// including E, where the intervening store to i stops the operands matching.
//
typedef void *anyptr;
const anyptr NULL = (anyptr)0;
typedef __packed __lsb struct { int:1 f; int:6 n; } bits;
typedef struct { rec *nxt; int v; } rec;
bits b;
rec r1, r2, r3;
rec * p;
char c;
int n, i;
void main() {
    // do-while, raw int  -- expect 3 iterations, i = 3+2+1 = 6
    n = 3; i = 0;
    do { i = i + n; n = n - 1; } while (n);
    printf(" A DOINT   %d %d\n", i, n);
    // do-while, comparison form -- expect the same
    n = 3; i = 0;
    do { i = i + n; n = n - 1; } while (n != 0);
    printf(" B DOCMP   %d %d\n", i, n);
    // if after a store -- 2 is nonzero, expect YES
    n = 3; n = n - 1;
    if (n) printf(" C IFINT   YES\n"); else printf(" C IFINT   NO\n");
    // if after a store landing on zero -- expect NO
    n = 1; n = n - 1;
    if (n) printf(" D IFZERO  YES\n"); else printf(" D IFZERO  NO\n");
    // pre-test while after a store -- expect i = 2+1 = 3
    n = 3; n = n - 1; i = 0;
    while (n) { i = i + n; n = n - 1; }
    printf(" E WHINT   %d\n", i);
    // do-while on a char -- 'C' is 3 codes above '@'; expect 3 iterations
    c = '\3'; i = 0;
    do { i = i + 1; c = c - '\1'; } while (c);
    printf(" F DOCHAR  %d\n", i);
    // do-while on a packed field -- expect 3+2+1 = 6
    b.n = 3; i = 0;
    do { i = i + b.n; b.n = b.n - 1; } while (b.n);
    printf(" G DOBITS  %d\n", i);
    // do-while walking a list -- expect 1+2+4 = 7
    r1.v = 1; r1.nxt = &r2; r2.v = 2; r2.nxt = &r3; r3.v = 4; r3.nxt = NULL;
    p = &r1; i = 0;
    do { i = i + p->v; p = p->nxt; } while (p);
    printf(" H DOPTR   %d\n", i);
    // if on a pointer after a store -- expect NO
    p = &r1; p = p->nxt; p = p->nxt; p = p->nxt;
    if (p) printf(" I IFPTR   YES\n"); else printf(" I IFPTR   NO\n");
}
