/*=s8,k9,l0*/
//
// C-style declaration-site load-time initializers for globals and arrays,
// replacing the retired trailing '.data' section:
//   scalar          int x = 5;
//   brace list      int a[0..2] = { 10, 20, 30 };
//   value:count     int b[0..4] = { 7:5 };
//   designators     int c[0..5] = { 0:6, [2]=9, [4]=8 };
int x = 5;
int a[0..2] = { 10, 20, 30 };
int b[0..4] = { 7:5 };
int c[0..5] = { 0:6, [2]=9, [4]=8 };
int i;
void main() {
    writeln(" x=", x:0);
    for (i = 0; i <= 2; i = i + 1)
        writeln(" a", i:0, '=', a[i]:0);
    for (i = 0; i <= 4; i = i + 1)
        writeln(" b", i:0, '=', b[i]:0);
    for (i = 0; i <= 5; i = i + 1)
        writeln(" c", i:0, '=', c[i]:0);
}
