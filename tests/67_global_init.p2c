/*=k9,l0*/
//
// C-style declaration-site load-time initializers for globals and arrays,
// replacing the retired trailing '.data' section:
//   scalar          int x = 5;
//   brace list      int a[3] = { 10, 20, 30 };
//   value:count     int b[5] = { 7:5 };
//   designators     int c[6] = { 0:6, [2]=9, [4]=8 };
int x = 5;
int a[3] = { 10, 20, 30 };
int b[5] = { 7:5 };
int c[6] = { 0:6, [2]=9, [4]=8 };
int i;
void main() {
    printf(" x=%d\n", x);
    for (i = 0; i <= 2; i = i + 1)
        printf(" a%d=%d\n", i, a[i]);
    for (i = 0; i <= 4; i = i + 1)
        printf(" b%d=%d\n", i, b[i]);
    for (i = 0; i <= 5; i = i + 1)
        printf(" c%d=%d\n", i, c[i]);
}
