/*=k9,l0*/
//
// Selecting a field of a function result.  A call leaves its result in the
// accumulator -- an ilRVAL insnList with no address -- and GETFIELD then
// records shift/width on it.  prepLoad used to apply that extraction only in
// its ilLVAL arm, so `f(x).packedfield` silently yielded the whole word.
//
// Every value is printed twice, once through a variable and once straight
// from the call: the two must agree.  A returned struct is always one word
// (a multi-word result is rejected), so the non-packed cases read the word.
//
typedef __packed __lsb struct { int:6 a; int:15 b; int:8 c; } lsbf;
typedef union { int w; lsbf f; } lsbu;
//
// Without __lsb the fields are laid out from the high end, which drives
// genSliceExtract's other branch.
typedef __packed struct { int:6 p; int:15 q; int:8 r; } msbf;
typedef union { int w; msbf f; } msbu;
//
typedef struct { int only; } plain;
typedef struct { int v; } cell;
typedef cell *cellp;
cell c1, c2;
//
lsbu mklsb(int x) {
lsbu t;
    t.w  =  0;
    t.f.a  =  x;
    t.f.b  =  1234;
    t.f.c  =  200;
    return t;
}
//
msbu mkmsb(int x) {
msbu t;
    t.w  =  0;
    t.f.p  =  x;
    t.f.q  =  1234;
    t.f.r  =  200;
    return t;
}
//
plain mkplain(int x) {
plain t;
    t.only  =  x * 3;
    return t;
}
//
cellp pick(int x) {
    return x ? &c1 : &c2;
}
//
int twice(int x) {
    return x + x;
}
//
void main() {
lsbu vl;
msbu vm;
plain vp;
    c1.v  =  11;
    c2.v  =  22;
    vl  =  mklsb(37);
    vm  =  mkmsb(37);
    vp  =  mkplain(5);
    // (int)... only to print in decimal: a sub-word field's own type is a
    // narrow scalar, which write renders in octal.
    printf(" LSB VAR    %5d%6d%5d\n", (int)vl.f.a, (int)vl.f.b, (int)vl.f.c);
    printf(" LSB CALL   %5d%6d%5d\n", (int)mklsb(37).f.a, (int)mklsb(37).f.b, (int)mklsb(37).f.c);
    printf(" MSB VAR    %5d%6d%5d\n", (int)vm.f.p, (int)vm.f.q, (int)vm.f.r);
    printf(" MSB CALL   %5d%6d%5d\n", (int)mkmsb(37).f.p, (int)mkmsb(37).f.q, (int)mkmsb(37).f.r);
    printf(" PLAIN      %5d%5d\n", vp.only, mkplain(5).only);
    // Through a returned pointer: genDeref's business, not prepLoad's.
    printf(" ARROW      %5d%5d\n", pick(1)->v, pick(0)->v);
    // The extraction has to work outside a plain assignment too.
    if (mklsb(9).f.a == 9)
        printf(" COND OK   ");
    else
        printf(" COND BAD  ");
    printf("%5d%5d\n", twice(mklsb(21).f.a), (int)(mklsb(4).f.a + mklsb(6).f.a));
}
