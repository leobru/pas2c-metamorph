/*=k9,l0*/
typedef struct { int x, y; } pair;
int neg[0..7];
int pos[0..7];
int leftc[0..7];
int nested[0..7];
__packed int:8 packed[0..11];
pair wide[0..3];
int matrix[0..2][0..3];
int i, j, total;
void main() {
    i = 2;
    j = 1;
    neg[i-1] = 10;
    total = neg[i-1];
    pos[i+2] = total;
    total = pos[i+2];
    leftc[2+i] += total;
    nested[i+3-4] += total;
    packed[i-1] = total;
    packed[i-1] += 1;
    wide[i-1].x = packed[i-1];
    total += wide[i-1].x;
    matrix[i-1][j+2] = total;
    matrix[i-1][j+2] += 1;
}
