/*=s8,k9,l0*/
// A routine declared and never defined is reported at the end of the block,
// by name.  The pending declarations form a list whose bottom is a marker
// distinct from the link a defined routine keeps, so the first name declared
// is still on the list when the block ends.
int first(int a);
int second(int b);
//
int second(int b) { return b + 1; }
//
void main() { writeln(second(1):0); }
