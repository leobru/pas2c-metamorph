/*=k9,l0*/
//
// '&' yields a pointer to the lvalue's type, as in C.  '&x' on an int is an
// 'int *', '&a[i]' points at the element and '&s.f' at the field, '&p' adds
// a level, and '&a' on a whole array is a pointer to the array, so '*pa' is
// the array again.  Every one of them carries a step, so arithmetic works
// from an address as it does from a pointer variable.
//
// A char lvalue keeps its own rule, a 'char *' being a byte index into flat
// memory: an element of a packed char array, six bytes to a word, is the
// array's word address times six plus the index, while an unpacked array's
// element has a word to itself and
// its value sits in the rightmost byte.
//
typedef struct { int a, b, c; } w3;
//
int x;
int arr[5];
int (*pa)[5];
w3 t3[4];
w3 *p3;
w3 *ptab[4];
w3 **pp;
int *p, *q;
typedef __packed char alfa[6];
alfa al = "ABCDEF";
__packed char s[12];
__packed char t[6];
char un[6];
char *cp;
int i;
//
void putln() assembler;
void main() {
    // A scalar's address, read and written through.
    x  =  41;
    p  =  &x;
    *p  =  *p + 1;
    printf(" SCALAR%4d%4d\n", x, (*p));
    // An element's address steps by the element.
    for (i = 0; i <= 4; i = i + 1)
        arr[i]  =  10 * i;
    p  =  &arr[1];
    q  =  &arr[4];
    printf(" ELT   %4d%4d%4d%3d\n", (*p), (*(p + 1)), (*(q - 1)), (q - p));
    // The same with a variable index, and a difference of two addresses.
    i  =  2;
    p  =  &arr[i] + 1;
    printf(" VARIDX%4d%3d\n", (*p), (&arr[3] - &arr[0]));
    // A field's address, and arithmetic on a structure's address.
    for (i = 0; i <= 3; i = i + 1) {
        t3[i].a  =  100 + i;
        t3[i].c  =  300 + i;
    }
    p  =  &t3[1].a;
    p3  =  &t3[0];
    printf(" STRUCT%5d%5d%3d\n", (*p), (p3 + 2)->c, (&t3[2] - &t3[0]));
    // '&' on a pointer adds a level.
    ptab[0]  =  &t3[0];  ptab[1]  =  &t3[1];  ptab[2]  =  &t3[2];
    pp  =  &ptab[0];
    printf(" PP    %5d%5d%5d\n", (*pp)->a, (*(pp + 2))->a, pp[1]->a);
    // '&' on a whole array is a pointer to the array.
    pa  =  &arr;
    printf(" ARRPTR%4d%3d%3d\n", (*pa)[2], sizeof(*pa), sizeof(pa));
    // An element of a packed char array, read and stored through.
    cp  =  &al[2];
    printf(" ALFA  %c%c%c\n", *cp, cp[1], *(cp - 2));
    *cp  =  'Z';
    printf(" STORE ");
    write(al);
    putln();
    // A packed array wider than a word: index 7 lies in the second word.
    for (i = 0; i <= 11; i = i + 1)
        s[i]  =  (char)(65 + i);
    cp  =  &s[7];
    printf(" WIDE  %c%c%c\n", *cp, *(cp - 1), *(cp + 4));
    // The same address calculation on another packed array.
    for (i = 0; i < 6; i = i + 1)
        t[i]  =  (char)(65 + i);
    cp  =  &t[2];
    printf(" LOWB  %c%c%c\n", *cp, *(cp + 2), *(cp - 2));
    // An unpacked char array still has its elements six bytes apart.
    for (i = 0; i <= 5; i = i + 1)
        un[i]  =  (char)(80 + i);
    cp  =  &un[2];
    printf(" UNPK  %c%c%4d\n", *cp, cp[6], (int)cp[1]);
}
