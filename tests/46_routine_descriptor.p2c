//
typedef int *intptr;
int g;
//
void ping() {
    printf("PING\n");
}
//
int add(int a, int b) {
    return a + b;
}
//
void addto(intptr p, int delta) {
    *p = *p + delta;
}
//
void main() {
    g = 10;
    ping();
    printf("ADD=%d\n", add(2, 3));
    addto(&g, 7);
    printf("G=%d\n", g);
}
