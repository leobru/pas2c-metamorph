/*=k9,l0*/
//
int i;
void main() {
    i = 0X0;
    printf(" 0X0      = %d\n", i);
    i = 0XA;
    printf(" 0XA      = %d\n", i);
    i = 0XFF;
    printf(" 0XFF     = %d\n", i);
    i = 0X100;
    printf(" 0X100    = %d\n", i);
    i = 0XDEAD;
    printf(" 0XDEAD   = %d\n", i);
    i = 0XBEEF;
    printf(" 0XBEEF   = %d\n", i);
    i = 0XABCDEF;
    printf(" 0XABCDEF = %d\n", i);
    i = 0X10 + 0XF;
    printf(" 0X10+0XF = %d\n", i);
    i = 0XFF & 0X0F;
    printf(" 0XFF&0F  = %d\n", i);
    i = 0XFFFFFFFFFFFFU;
    printf(" 0XFFFFFFFFFFFFU  =%o\n", i);
}
