/*=l0*/
typedef __packed char pair[2];

pair s = t"AB";
int t;

void main() {
    t = 7;
    printf(" ID     %d\n", t);
    printf(" CHAR   %d %d %d\n", (int)t'A', (int)T'B', (int)t'\n');
    printf(" WORD   %d %d\n", (t'ABCDEFGH' == 04142434445464750U), (T'ASSEMBLE' == t'ASSEMBLE'));
    // Any length up to a word packs the same way, right-aligned: two
    // characters are the first times 64 plus the second, and the ones below
    // eight simply leave the top of the word empty.
    printf(" SHORT  %d %d %d %d\n", (t'AB' == 04142U), (t'ABC' == 0414243U),
           (t'ABCDEFG' == 041424344454647U), ((t'AB' >> 6) == (int)t'A'));
    printf(" STRING %d %d %d\n", (int)s[0], (int)s[1], sizeof(t"AB"));
}
