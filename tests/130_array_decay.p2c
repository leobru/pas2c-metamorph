/*=k9,l0*/
//
// An array used as a value is the address of its first element, as in C.
// The decay happens at the point of use, so a context that wants the array
// itself -- sizeof, a cast to an array type -- still gets it.  A char array
// decays to a 'char *', a byte index into flat memory: six bytes to a word,
// so a packed array's elements are one byte apart and an unpacked array's
// six.
//
int a[10];
int m[2][3];
int *p, *q;
int (*pr)[3];
__packed char ps[6] = "ABCDEF";
char un[6];
char *cp;
int i;
//
void g(int *x) { i = x[0]; }
int *retarr() { return a; }
//
void main() {
    for (i = 0; i <= 9; i = i + 1)
        a[i] = i * 10;
    m[0][0] = 7; m[0][1] = 8; m[1][0] = 9;
    for (i = 0; i <= 5; i = i + 1)
        un[i] = (char)(80 + i);
    // Assigned to a pointer.
    p  =  a;
    printf(" ASSIGN%4d%4d\n", (*p), p[3]);
    // In pointer arithmetic, either way round, and a difference.
    q  =  a + 2;
    printf(" ARITH %4d%4d%3d\n", (*q), (*(2 + a)), (q - a));
    // Compared against a pointer, either way round.
    printf(" CMP   %2d%2d%2d\n", (p == a), (a == p), (p < a + 1));
    // Behind unary '*'.
    printf(" DEREF %4d\n", (*a));
    // As an actual for a pointer formal, and as a result.
    g(a);
    printf(" ARG   %4d\n", i);
    printf(" RET   %4d\n", (*retarr()));
    // A row of a two-dimensional array decays to a pointer to its element;
    // the whole array decays to a pointer to a row.
    p  =  m[0];
    pr  =  m;
    printf(" ROW   %3d%3d%3d%3d\n", (*p), p[1], (*pr)[1], (*(pr + 1))[0]);
    // A packed char array: elements one byte apart.
    cp  =  ps;
    printf(" PCK   %c%c\n", *cp, cp[2]);
    // An unpacked one: six.
    cp  =  un;
    printf(" UNPK  %c%c\n", *cp, cp[6]);
    // sizeof keeps the array: it is not a value context.
    printf(" SIZE  %3d%3d%3d\n", sizeof(a), sizeof(ps), sizeof(m));
}
