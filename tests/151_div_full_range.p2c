void main() {
    qbad = 0;  rbad = 0;  lbad = 0;
    writeln(" MATRIX  DIVISOR       DIVIDEND        QUOTIENT REMAINDER");
    dP2();
    dP4();
    dP10();
    dP1024();
    dP3();
    dP7();
    dP999983();
    dM2();
    dM1024();
    dM3();
    dM7();
    dM999983();
    writeln(" MATRIX");   tally();
    lP2();
    lP3();
    lP4();
    lP7();
    lP10();
    lP1024();
    lP999983();
    lM3();
    lM7();
    lM1024();
    writeln(" LADDER");   tally();
    uP2();
    uP3();
    uP6();
    uP7();
    uP10();
    uP100();
    uP257();
    uP1024();
    uP999983();
    writeln(" UNSIGN");   tally();
    lo = 1099511627476;
    bP2();
    bP3();
    bP7();
    bP10();
    bP1024();
    bP999983();
    bM3();
    bM7();
    bM1024();
    writeln(" BAND TOP"); tally();
    lo = 549755813888;
    bP2();
    bP3();
    bP7();
    bP10();
    bP1024();
    bP999983();
    bM3();
    bM7();
    bM1024();
    writeln(" BAND MID"); tally();
    lo = 1;
    bP2();
    bP3();
    bP7();
    bP10();
    bP1024();
    bP999983();
    bM3();
    bM7();
    bM1024();
    writeln(" BAND LOW"); tally();
}
