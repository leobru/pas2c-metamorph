        t = -a - 1;  chk(7, t, t / 7, t % 7);
        a = 1099511627775 >> i;
        t = a;  chk(7, t, t / 7, t % 7);
        t = -a;  chk(7, t, t / 7, t % 7);
        t = a - 1;  chk(7, t, t / 7, t % 7);
        t = -a - 1;  chk(7, t, t / 7, t % 7);
    } }
