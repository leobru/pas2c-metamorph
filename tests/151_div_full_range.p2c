//
void uP2() { int i;
    for (i = 0; i < 40; i = i+1) {
        uv = 1 << i;
        chk(2, uv, uv / 2, uv % 2);
        uv = uv - 1;
        chk(2, uv, uv / 2, uv % 2);
    } }
void uP3() { int i;
    for (i = 0; i < 40; i = i+1) {
        uv = 1 << i;
        chk(3, uv, uv / 3, uv % 3);
        uv = uv - 1;
        chk(3, uv, uv / 3, uv % 3);
    } }
