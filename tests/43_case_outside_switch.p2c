/*=k9,l0*/
//
// A switch label with no switch around it is a bad symbol.  It has to be
// reported and consumed whole, colon included: a label left half-eaten spins
// the enclosing 'while (SY != ENDSY) statement()' loop forever, turning a
// diagnostic into a hang.  A label written inside a switch is an ordinary
// label of it however deep it sits -- tests 70 and 72 cover those.
//
int s;
//
void main() {
    s  =  0;
    // A label with no switch anywhere.
    case 1: s  =  1;
    // A label inside a plain block, still with no switch anywhere.
    { case 2: s  =  2; }
    printf(" S %d\n", s);
}
