/*=k9,l0*/
typedef __packed char six[6];
typedef __packed char three[3];
typedef __packed char nine[9];

six a = "ABCDEF";
three b = "XYZ";
nine c = "ABCDEFGHI";

void putln() assembler;
void main() {
    write(a);     putln();
    write(b);     putln();
    write(a:9);   putln();
    write(c);     putln();
    write(c:12);  putln();
}
