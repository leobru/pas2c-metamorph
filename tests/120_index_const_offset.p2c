/*=k9,l0*/
// Constant terms in true-array indices are absorbed into the array's lower
// bound during code generation.  Pointer indexing keeps its existing path.
typedef struct { int x, y, z; } triple;
int neg[0..7], pos[0..7], leftc[0..7], nested[0..7], rev[0..7];
__packed int:8 packed[0..11];
triple wide[0..4];
int matrix[0..3][0..4];
int backing[0..7];
int *ptr;
int i, j;

void main() {
    i = 3;
    j = 1;

    neg[i-1] = 10;
    neg[i-1] += 1;
    pos[i+2] = 20;
    pos[i+2] += 2;
    leftc[2+i] = 30;
    leftc[2+i] += 3;
    nested[i+3-4] = 40;
    nested[i+3-4] += 4;
    rev[5-i] = 50;
    rev[5-i] += 5;
    writeln("plain ", neg[2]:0, ' ', pos[5]:0, ' ', leftc[5]:0,
            ' ', nested[2]:0, ' ', rev[2]:0);

    packed[i-1] = 7;
    packed[i-1] += 5;
    j = packed[2];
    writeln("packed ", j:0);

    wide[i-1].x = 60;
    wide[i-1].y = 6;
    wide[i-1].x += wide[i-1].y;
    writeln("wide ", wide[2].x:0, ' ', wide[2].y:0);

    j = 1;
    matrix[i-1][j+2] = 70;
    matrix[i-1][j+2] += 7;
    writeln("multi ", matrix[2][3]:0);

    ptr = &backing[0];
    ptr[i-1] = 80;
    ptr[i-1] += 8;
    writeln("pointer ", backing[2]:0);
}
