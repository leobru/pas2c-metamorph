/*=k9,l0*/
// Constant terms in true-array indices are absorbed into the array's lower
// bound during code generation.  Pointer indexing keeps its existing path.
typedef struct { int x, y, z; } triple;
int neg[8], pos[8], leftc[8], nested[8], rev[8];
__packed int:8 packed[12];
triple wide[5];
int matrix[4][5];
int backing[8];
int *ptr;
int i, j;

void main() {
    i = 3;
    j = 1;

    neg[i-1] = 10;
    neg[i-1] += 1;
    pos[i+2] = 20;
    pos[i+2] += 2;
    leftc[2+i] = 30;
    leftc[2+i] += 3;
    nested[i+3-4] = 40;
    nested[i+3-4] += 4;
    rev[5-i] = 50;
    rev[5-i] += 5;
    printf("plain %d %d %d %d %d\n", neg[2], pos[5], leftc[5], nested[2], rev[2]);

    packed[i-1] = 7;
    packed[i-1] += 5;
    j = packed[2];
    printf("packed %d\n", j);

    wide[i-1].x = 60;
    wide[i-1].y = 6;
    wide[i-1].x += wide[i-1].y;
    printf("wide %d %d\n", wide[2].x, wide[2].y);

    j = 1;
    matrix[i-1][j+2] = 70;
    matrix[i-1][j+2] += 7;
    printf("multi %d\n", matrix[2][3]);

    ptr = &backing[0];
    ptr[i-1] = 80;
    ptr[i-1] += 8;
    printf("pointer %d\n", backing[2]);
}
