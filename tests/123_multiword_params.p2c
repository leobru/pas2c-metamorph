/*=k9,l0*/
//
// Parameters wider than a word occupy one argument slot per word, and the
// call site fills those slots with the struct's own words.  The signature is
// the only record of that layout once the declaration's body is gone, so a
// routine declared ahead of its definition -- where the declaration settles
// the layout and the definition restates the list -- exercises it from both
// ends.
//
typedef struct { int a, b, c; } rec;
typedef int trip[3];
int sum3(rec r, int k);
int addup(trip t, rec r);
int plain(int x, int y);
//
int sum3(rec r, int k) { return r.a + r.b + r.c + k; }
int addup(trip t, rec r) { return t[0] + t[1] + t[2] + r.a; }
int plain(int x, int y) { return x - y; }
//
// A value parameter is the callee's own copy: writing it must not reach the
// caller's variable.
int bump(rec r) { r.a = r.a + 100; return r.a; }
//
rec g;
trip v;
void main() {
    g.a = 1; g.b = 2; g.c = 3;
    v[0] = 10; v[1] = 20; v[2] = 30;
    printf(" S=%d A=%d P=%d\n", sum3(g, 100), addup(v, g), plain(9, 4));
    g.a = 7;
    printf(" S2=%d A2=%d\n", sum3(g, 0), addup(v, g));
    printf(" B=%d KEPT=%d\n", bump(g), g.a);
}
