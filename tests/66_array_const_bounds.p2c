/*=k9,l0*/
//
// Array sizes given as constant expressions (not just literals or a
// single const identifier) are evaluated by the shared constant-expression
// evaluator.
const int N = 3, M = 2;
int a[N+2];
int b[N*M];
int i;
void main() {
    for (i = 0; i <= N+1; i = i + 1) {
        a[i] = i * 10;
    }
    for (i = 0; i < N*M; i = i + 1) {
        b[i] = i + 1;
    }
    printf(" a[0]=%d\n", a[0]);
    printf(" a[N+1]=%d\n", a[N+1]);
    printf(" b[N*M]=%d\n", b[N*M-1]);
}
