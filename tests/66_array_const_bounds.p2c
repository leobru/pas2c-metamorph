/*=k9,l0*/
//
// Array bounds given as constant expressions (not just literals or a
// single const identifier): parseRange evaluates each bound through the
// shared const-expression evaluator.
const N = 3;
      M = 2;
int a[0..N+1];
int b[1..N*M];
int i;
void main() {
    for (i = 0; i <= N+1; i = i + 1) {
        a[i] = i * 10;
    }
    for (i = 1; i <= N*M; i = i + 1) {
        b[i] = i;
    }
    writeln(" a[0]=", a[0]:0);
    writeln(" a[N+1]=", a[N+1]:0);
    writeln(" b[N*M]=", b[N*M]:0);
}
