/*=s8,y+,k9,l0*/
//
// The `with` statement is retired, and `with` is an ordinary identifier
// again: the reserved-word slot was emptied, though WITHSY keeps its place in
// the symbol enum so that every symbol after it keeps its value (a symbol is
// reported as `sym + 88` against the runtime's message table).
//
typedef struct { int a, b; } rec;
rec r;
int with, x;
//
void main() {
    with = 7;
    x = with + 1;
    { register rec *p = &r;
      p->a = with;
      p->b = x;
    }
    writeln(" WITH=", with:0, " X=", x:0);
    writeln(" A=", r.a:0, " B=", r.b:0);
}
