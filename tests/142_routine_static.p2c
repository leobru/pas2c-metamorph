/*=k9,l0*/
//
// A routine static has the routine's lexical scope but module-lifetime
// storage.  The module data below is deliberately interleaved with routines
// and their statics: every value has to survive without sharing a slot.
//
typedef struct { int x; int y; } pair;

int before = 100;

int counter() {
    static int n = 10;
    n = n + 1;
    return n;
}

int recursive(int depth) {
    static int seen;
    seen = seen + 1;
    if (depth)
        recursive(depth - 1);
    return seen;
}

int left() {
    static int slot = 20;
    slot = slot + 1;
    return slot;
}

int middle = 200;

int right() {
    static int slot = 30;
    slot = slot + 1;
    return slot;
}

int aggregate(int add) {
    static int a[3] = { 1, 2, 3 };
    static int inferred[] = { 8, 9 };
    static pair p = { 4, 5 };
    static int x = 6, y = 7;
    a[0] = a[0] + add;
    a[2] = a[2] + 1;
    inferred[1] = inferred[1] + add;
    p.x = p.x + add;
    x = x + 1;
    y = y + 2;
    return a[0] + a[1] + a[2] + inferred[0] + inferred[1] +
           p.x + p.y + x + y;
}

int outer(int add) {
    static int x = 300;
    int inner(int n) {
        static int y = 400;
        y = y + n;
        return y;
    }
    x = x + add;
    return x + inner(add);
}

int zeroed() {
    static int z;
    z = z + 5;
    return z;
}

int after = 300;

void main() {
    printf(" GLOBAL %d %d %d\n", before, middle, after);
    printf(" COUNT  %d %d\n", counter(), counter());
    printf(" RECUR  %d %d\n", recursive(3), recursive(1));
    printf(" NAMES  %d %d %d %d\n", left(), right(), left(), right());
    printf(" AGGR   %d %d\n", aggregate(1), aggregate(2));
    printf(" NEST   %d %d\n", outer(1), outer(2));
    printf(" ZERO   %d %d\n", zeroed(), zeroed());
    printf(" GLOBAL %d %d %d\n", before, middle, after);
}
