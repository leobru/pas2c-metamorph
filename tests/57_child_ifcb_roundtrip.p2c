/*=a3,s8,y+,l0*/
typedef struct {
    int *data;
    int w1, w2, w3, w4, w5, w6, w7, w8, w9, w10,
    w11, w12, w13, w14, w15, w16, w17, w18, w19, w20,
    w21, w22, w23, w24, w25, w26, w27, w28, w29;
} ifcb;
//
extern ifcb _child_;
int i;

//
void fopen(ifcb *fcb, int sizes, int name) assembler;
void fclose(ifcb *fcb) assembler;
void ftruncate(ifcb *fcb) assembler;
void frewind(ifcb *fcb) assembler;
void fputw(int value, ifcb *f) assembler;
int fgetc(ifcb *fcb) assembler;
//
int valueat(int n) {
    return n * 17 + 123;
}
//
void writechild() {
    fopen(&_child_, 010000100000, '*CHILD* ');
    ftruncate(&_child_);
    for (i = 0; i < 1105; i = i + 1) {
        fputw(valueat(i), &_child_);
    }
    fclose(&_child_);
}
//
void readchild() {
    fopen(&_child_, 010000100000, '*CHILD* ');
    frewind(&_child_);
    for (i = 0; i < 1105; i = i + 1) {
        if (fgetc(&_child_) != valueat(i)) {
            writeln(0 - i - 1:0);
            fclose(&_child_);
            return;
        }
    }
    fclose(&_child_);
    writeln(i:0);
}
//
void main() {
    writechild();
    readchild();
}
