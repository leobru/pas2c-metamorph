/*=l0*/
extern int _child_[30];
int i;

void fopen(int fcb[30], int sizes, int name) assembler;
void fclose(int fcb[30]) assembler;
void ftruncate(int fcb[30]) assembler;
void frewind(int fcb[30]) assembler;
void fputw(int value, int f[30]) assembler;
int fgetc(int fcb[30]) assembler;
//
int valueat(int n) {
    return n * 17 + 123;
}
//
void writechild() {
    fopen(_child_, 010000100000, t'*CHILD* ');
    ftruncate(_child_);
    for (i = 0; i < 1105; i = i + 1) {
        fputw(valueat(i), _child_);
    }
    fclose(_child_);
}
//
void readchild() {
    fopen(_child_, 010000100000, t'*CHILD* ');
    frewind(_child_);
    for (i = 0; i < 1105; i = i + 1) {
        if (fgetc(_child_) != valueat(i)) {
            printf("%d\n", 0 - i - 1);
            fclose(_child_);
            return;
        }
    }
    fclose(_child_);
    printf("%d\n", i);
}
//
void main(int argc, char **argv) {
    writechild();
    readchild();
}
