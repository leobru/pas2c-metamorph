/*=l0*/
//
void fopen(int fcb[30], int sizes, int name) assembler;
void fclose(int fcb[30]) assembler;
void fputw(int value, int fcb[30]) assembler;
void ftruncate(int fcb[30]) assembler;
void frewind(int fcb[30]) assembler;
int fgetw(int fcb[30]) assembler;
//
int f[30];
int w, off;
//
// FILE[19] is the buffer cursor and FILE[12] the buffer start; both are
// absolute addresses that move with the loader map, so what is checked is
// the cursor as an offset from the start.
//
void main(int argc, char **argv) {
    fopen(f, 010000100060, 0);
    printf("open %d %d %d %d\n", f[4], f[18], f[27], f[2]);

    ftruncate(f);
    printf("truncate %d %d %d %d\n", f[4], f[14], f[2], f[16]);

    fputw(1234, f);
    fputw(2345, f);
    fputw(3456, f);
    off = f[19] - f[12];
    printf("put %d %d %d\n", f[2], off, f[27]);

    frewind(f);
    off = f[19] - f[12];
    printf("rewind %d %d %d %d\n", f[4], f[2], off, f[27]);
    w = fgetw(f);
    off = f[19] - f[12];
    printf("get1 %d %d %d %d\n", w, f[2], off, f[27]);
    w = fgetw(f);
    off = f[19] - f[12];
    printf("get2 %d %d %d %d\n", w, f[2], off, f[27]);

    fclose(f);
    off = f[19] - f[12];
    printf("close %d %d %d %d\n", f[4], f[2], off, f[27]);
}
