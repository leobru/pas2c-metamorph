/*=k9,l0*/
//
int a, b, x, y, z;
void main() {
    a = 5;
    b = 10;
    x = (a < b) ? a : b;
    printf(" min(5,10) = %d\n", x);
    y = (a > b) ? a : b;
    printf(" max(5,10) = %d\n", y);
    z = (a == 5) ? 100 : 200;
    printf(" z = %d\n", z);
    z = ((a < b) ? a : b) + ((a > b) ? a : b);
    printf(" sum = %d\n", z);
    z = (a < b) ? ((a == 5) ? 1 : 2) : 3;
    printf(" nested z = %d\n", z);
    z = 100 - ((a < b) ? a : b);
    printf(" rsub = %d\n", z);
    z = ((a == 5) ? 7 : 8) * ((b == 10) ? 3 : 4);
    printf(" mul = %d\n", z);
}
