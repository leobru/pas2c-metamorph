/*=l0*/
//
int a, b, c;
void main() {
    a = 10;
    b = 3;
    c = a + b;
    printf(" 10 + 3 = %d\n", c);
    c = a - b;
    printf(" 10 - 3 = %d\n", c);
    c = a * b;
    printf(" 10 * 3 = %d\n", c);
    c = -a * b;
    printf(" -10 * 3 = %d\n", c);
    c = a * (-b);
    printf(" 10 * -3 = %d\n", c);
    c = a / b;
    printf(" 10 / 3 = %d\n", c);
    c = a % b;
    printf(" 10 %% 3 = %d\n", c);
    c = a << 10; 
    printf(" 10 << 10 = %d\n", c);
    for (b = 1; b <= 10; b = b+1) {
        c = a << b;
        printf(" 10 << %d = %d\n", b, c);
    }
}
