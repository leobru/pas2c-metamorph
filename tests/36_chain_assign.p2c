//
int a, b, c, d;
void main() {
    c = 42;
    a = b = c;
    printf("two %d %d %d\n", a, b, c);

    d = 7;
    a = b = c = d;
    printf("four %d %d %d %d\n", a, b, c, d);

    a = 0;
    b = (a = 5) + 1;
    printf("embed %d %d\n", a, b);

    a = b = 100;
    printf("reuse %d %d\n", a, b);
}
