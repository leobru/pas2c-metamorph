typedef int *intptr1;
typedef int *intptr2;
typedef int arr1[4];
typedef int arr2[4];
typedef __packed char pch1[6];
typedef __packed char pch2[6];
typedef int mat1[2][3];
typedef int mat2[2][3];
intptr1 p;
intptr2 q;
arr1 a;
arr2 b;
pch1 c;
pch2 d;
mat1 m;
mat2 n;
void main() {
    p = malloc(1);
    q = malloc(1);
    *p = 7;
    *q = 9;
    a[1] = *p;
    b[1] = *q;
    c[2] = 'A';
    d[2] = 'B';
    m[0][2] = 13;
    n[1][0] = 21;
    writeln("cache ", a[1]:0, ' ', b[1]:0, ' ', c[2], ' ', d[2]);
    writeln("nest ", m[0][2]:0, ' ', n[1][0]:0);
}
