/*=l0*/
//
// The vararg calling convention, read from the callee's side.  The compiler
// pushes the tail actuals first, then the mandatory ones, and leaves a
// pointer to the first tail word in the accumulator; libc/printf.madlen walks
// from there up to the format's own slot, which is why no count is passed.
//
// printf is predeclared, so nothing is written for it here.  fprintf is the
// same routine entered one word deeper -- the destination is a mandatory
// argument ahead of the format -- and is declared the way any other variadic
// assembler routine is.
//
void fprintf(void *, char *, ...) assembler;
//
int i;
//
// The stack check.  A local of a called routine lives in the frame the call
// opens at the stack pointer of the moment, so the address of one is that
// stack pointer.  The callee pops what was pushed for it -- one word for
// printf, two for fprintf -- and the caller drops the tail; get any of those
// counts wrong and this number drifts a few words per call, which correct
// output alone would never reveal.
void mark(char *tag) {
    int here;
    printf(" STACK %s %d\n", tag, &here);
}
//
// A variadic call from inside another routine's frame, so the tail lands
// below a frame that is not the outermost.  The two marks straddling it are
// also what proves the probe is live rather than a constant: they print a
// deeper stack pointer than main's, and the same one on both sides.
void report(int a, int b) {
    mark("ENTER ");
    printf(" IN ROUTINE %d %d\n", a, b);
    mark("LEAVE ");
}
//
void main() {
    mark("START ");
    // Every line is written twice, once through each entry, so the two must
    // agree character for character.
     printf(" ZERO\n");
    fprintf(&_output_, " ZERO\n");
     printf(" ONE %d\n", 42);
    fprintf(&_output_, " ONE %d\n", 42);
     printf(" THREE %d %d %d\n", 1, 2, 3);
    fprintf(&_output_, " THREE %d %d %d\n", 1, 2, 3);
     printf(" MIXED %d %c %o\n", 7, 'A', 64);
    fprintf(&_output_, " MIXED %d %c %o\n", 7, 'A', 64);
     printf(" STR %s|\n", "ABC");
    fprintf(&_output_, " STR %s|\n", "ABC");
    report(11, 22);
    mark("CALLS ");
    // Twenty calls of three tail words each: a one-word error per call is
    // sixty words of drift by the time the next mark prints.
    printf(" LOOP ");
    for (i = 0; i < 20; i = i + 1)
        fprintf(&_output_, ".", 1, 2, 3);
    printf("\n");
    mark("LOOP  ");
    // A format asking for more than was passed stops when the walk reaches
    // the format's slot, rather than reading past the block.  The line is
    // left open, so the next write continues it.
    printf(" SHORT %d %d\n", 5);
    printf("|\n");
    mark("SHORT ");
}
