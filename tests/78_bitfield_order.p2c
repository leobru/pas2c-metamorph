/*=s8,k9,l0*/
// Bit-field packing order is a property of the struct, marked at the
// declaration: unmarked packs from the high end of the word, '__packed __lsb'
// packs from bit 0 up.  '__lsb' is recognized only after '__packed', so it
// stays an ordinary identifier everywhere else.
typedef __packed struct {
    int:6 a;
    int:18 b;
    int:24 c;
} msbrec;
typedef __packed __lsb struct {
    int:6 a;
    int:18 b;
    int:24 c;
} lsbrec;
typedef union { msbrec r; int w; } msbview;
typedef union { lsbrec r; int w; } lsbview;
//
// A __lsb member inside an unmarked container: the member's own order must
// not leak into the container.
typedef __packed __lsb struct {
    int:6 x;
    int:6 y;
} pairrec;
typedef __packed struct {
    int:12 head;
    pairrec inner;
    int:24 tail;
} outerrec;
typedef union { outerrec r; int w; } outerview;
//
msbview m;
lsbview l;
outerview o;
int lsb;                        // still a perfectly good identifier
//
void main() {
    lsb = 5;
    writeln(" SIZES ", sizeof(msbrec):0, sizeof(lsbrec):0, sizeof(outerrec):0,
            " IDENT ", lsb:0);
    m.w = 0;
    m.r.a = 1;
    writeln(" MSB A=1   ", m.w:17 oct);
    m.w = 0;
    m.r.c = 1;
    writeln(" MSB C=1   ", m.w:17 oct);
    l.w = 0;
    l.r.a = 1;
    writeln(" LSB A=1   ", l.w:17 oct);
    l.w = 0;
    l.r.c = 1;
    writeln(" LSB C=1   ", l.w:17 oct);
    m.w = 0;
    m.r.a = 63;
    m.r.b = 9;
    m.r.c = 7;
    l.w = 0;
    l.r.a = 63;
    l.r.b = 9;
    l.r.c = 7;
    writeln(" READBACK  ", m.r.a:3, m.r.b:3, m.r.c:3,
            " / ", l.r.a:3, l.r.b:3, l.r.c:3);
    o.w = 0;
    o.r.head = 1;
    writeln(" OUT HEAD  ", o.w:17 oct);
    o.w = 0;
    o.r.inner.x = 1;
    writeln(" OUT INNX  ", o.w:17 oct);
    o.w = 0;
    o.r.tail = 1;
    writeln(" OUT TAIL  ", o.w:17 oct);
}
