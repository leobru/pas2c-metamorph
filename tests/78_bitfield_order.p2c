/*=k9,l0*/
// Bit-field packing order is a property of the struct, marked at the
// declaration: unmarked packs from the high end of the word, '__packed __lsb'
// packs from bit 0 up.  '__lsb' is recognized only after '__packed', so it
// stays an ordinary identifier everywhere else.
typedef __packed struct {
    int:6 a;
    int:18 b;
    int:24 c;
} msbrec;
typedef __packed __lsb struct {
    int:6 a;
    int:18 b;
    int:24 c;
} lsbrec;
typedef union { msbrec r; int w; } msbview;
typedef union { lsbrec r; int w; } lsbview;
//
// A __lsb member inside an unmarked container: the member's own order must
// not leak into the container.
typedef __packed __lsb struct {
    int:6 x;
    int:6 y;
} pairrec;
typedef __packed struct {
    int:12 head;
    pairrec inner;
    int:24 tail;
} outerrec;
typedef union { outerrec r; int w; } outerview;
//
msbview m;
lsbview l;
outerview o;
int lsb;                        // still a perfectly good identifier
//
void main() {
    lsb = 5;
    printf(" SIZES %d%d%d IDENT %d\n", sizeof(msbrec), sizeof(lsbrec), sizeof(outerrec), lsb);
    m.w = 0;
    m.r.a = 1;
    printf(" MSB A=1   %17o\n", m.w);
    m.w = 0;
    m.r.c = 1;
    printf(" MSB C=1   %17o\n", m.w);
    l.w = 0;
    l.r.a = 1;
    printf(" LSB A=1   %17o\n", l.w);
    l.w = 0;
    l.r.c = 1;
    printf(" LSB C=1   %17o\n", l.w);
    m.w = 0;
    m.r.a = 63;
    m.r.b = 9;
    m.r.c = 7;
    l.w = 0;
    l.r.a = 63;
    l.r.b = 9;
    l.r.c = 7;
    printf(" READBACK  %3o%3o%3o / %3o%3o%3o\n", m.r.a, m.r.b, m.r.c, l.r.a, l.r.b, l.r.c);
    o.w = 0;
    o.r.head = 1;
    printf(" OUT HEAD  %17o\n", o.w);
    o.w = 0;
    o.r.inner.x = 1;
    printf(" OUT INNX  %17o\n", o.w);
    o.w = 0;
    o.r.tail = 1;
    printf(" OUT TAIL  %17o\n", o.w);
}
