/*=k9,l0*/
//
typedef int *intptr;
typedef struct { int x, y; } rec;
typedef rec *recptr;
int i, j, k, n, a;
int arr[4];
intptr p;
recptr rp;
rec r;
void main() {
    /* simple postfix */
    i = 5;
    j = i++;
    printf(" s01 %d %d\n", j, i);

    /* statement form */
    i = 10;
    i++;
    printf(" s02 %d\n", i);

    /* prefix still works */
    i = 7;
    k = ++i;
    printf(" s03 %d %d\n", k, i);

    /* for-loop step */
    n = 0;
    for (i = 0; i < 3; i++)
        n = n + 1;
    printf(" s04 %d %d\n", n, i);

    /* precedence: postfix binds tighter than + */
    a = 4;
    printf(" s05 %d %d\n", (a++ + 1), a);

    /* array element via variable index */
    arr[0] = 10; arr[1] = 20;
    i = 1;
    j = arr[i]++;
    printf(" a01 %d %d\n", j, arr[1]);

    /* pointer deref */
    n = 50;
    p = &n;
    j = (*p)++;
    printf(" p01 %d %d\n", j, n);

    /* struct field via pointer */
    r.x = 100;
    rp = &r;
    j = rp->x++;
    printf(" r01 %d %d\n", j, r.x);

    /* postfix decrement */
    i = 3;
    j = i--;
    printf(" d01 %d %d\n", j, i);
}
