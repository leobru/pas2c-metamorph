/*=k9,l0*/

int grdval;
int arspan;

// expected words: ceil(arspan * bitW / 48)
int wrdsExp(int bitW) {
    if (bitW > 24)
        return arspan;
    else
        return (arspan * bitW + 47) / 48;
}

int chkWords(int tag, int got, int exp) {
    if (got != exp) {
        printf("FAIL size tag=%d got=%d exp=%d\n", tag, got, exp);
        return 1;
    } else {
        printf("OK size tag=%d words=%d\n", tag, got);
        return 0;
    }
}

int tsz08() {
    __packed int:8 a[12];
    return chkWords(8, sizeof(a), wrdsExp(8));
}

int tsz16() {
    __packed int:16 b[12];
    return chkWords(16, sizeof(b), wrdsExp(16));
}

int tsz24() {
    __packed int:24 c[12];
    return chkWords(24, sizeof(c), wrdsExp(24));
}

int tsz32() {
    __packed int:32 d[12];
    return chkWords(32, sizeof(d), wrdsExp(32));
}

int tsz40() {
    __packed int:40 e[12];
    return chkWords(40, sizeof(e), wrdsExp(40));
}

int trw08() {
    __packed int:8 buf[14];
    int i;
    int lo;
    int hi;
    int fail;
    int:8 v;
    int:8 maxv;
    int:8 g;
    fail = 0;
    lo = 3;
    hi = 9;
    v = 200;
    maxv = 255;
    for (i = 0; i <= arspan + 1; i = i + 1) {
        g = grdval + i;
        buf[i] = g;
    }
    buf[lo] = v;
    if (buf[lo] != v) {
        printf("FAIL int:8 store read back\n");
        fail = 1;
    }
    for (i = 0; i < lo; i = i + 1) {
        g = grdval + i;
        if (buf[i] != g) {
            printf("FAIL int:8 low guard i=%d\n", i);
            fail = 1;
        }
    }
    for (i = lo + 1; i <= arspan + 1; i = i + 1) {
        g = grdval + i;
        if (buf[i] != g) {
            printf("FAIL int:8 high guard i=%d\n", i);
            fail = 1;
        }
    }
    buf[hi] = maxv;
    if (buf[hi] != maxv) {
        printf("FAIL int:8 max at hi\n");
        fail = 1;
    }
    if (buf[lo] != v) {
        printf("FAIL int:8 neighbor after hi write\n");
        fail = 1;
    }
    if (fail == 0) {
        printf("OK int:8 rw guards\n");
    } else {
        return 1;
    }
    return 0;
}

int trw16() {
    __packed int:16 buf[14];
    int i;
    int lo;
    int fail;
    int:16 v;
    int:16 maxv;
    int:16 g;
    fail = 0;
    lo = 5;
    v = 4660;
    maxv = 65535;
    for (i = 0; i <= arspan + 1; i = i + 1) {
        g = grdval + i;
        buf[i] = g;
    }
    buf[lo] = v;
    if (buf[lo] != v) {
        printf("FAIL int:16 store read\n");
        fail = 1;
    }
    buf[lo + 1] = maxv;
    if (buf[lo] != v) {
        printf("FAIL int:16 low corrupted\n");
        fail = 1;
    }
    if (buf[lo + 1] != maxv) {
        printf("FAIL int:16 hi read\n");
        fail = 1;
    }
    for (i = 0; i < lo; i = i + 1) {
        g = grdval + i;
        if (buf[i] != g) {
            printf("FAIL int:16 guard i=%d\n", i);
            fail = 1;
        }
    }
    if (fail == 0) {
        printf("OK int:16 rw guards\n");
    } else {
        return 1;
    }
    return 0;
}

int trw24() {
    __packed int:24 buf[14];
    int i;
    int lo;
    int fail;
    int:24 v;
    int:24 g;
    fail = 0;
    lo = 4;
    v = 1000000;
    for (i = 0; i <= arspan + 1; i = i + 1) {
        g = grdval + i;
        buf[i] = g;
    }
    buf[lo] = v;
    if (buf[lo] != v) {
        printf("FAIL int:24 store read\n");
        fail = 1;
    }
    g = grdval + lo - 1;
    if (buf[lo - 1] != g) {
        printf("FAIL int:24 guard below\n");
        fail = 1;
    }
    g = grdval + lo + 1;
    if (buf[lo + 1] != g) {
        printf("FAIL int:24 guard above\n");
        fail = 1;
    }
    if (fail == 0) {
        printf("OK int:24 rw guards\n");
    } else {
        return 1;
    }
    return 0;
}

int tdense() {
    __packed int:1 a[48];
    int i;
    int fail;
    int:1 one;
    int:1 zero;
    fail = 0;
    one = 1;
    zero = 0;
    if (sizeof(a) != 1) {
        printf("FAIL int:1 dense words got=%d\n", sizeof(a));
        fail = 1;
    }
    for (i = 0; i < 48; i = i + 1) {
        a[i] = one;
    }
    for (i = 0; i < 48; i = i + 1) {
        if (a[i] != one) {
            printf("FAIL int:1 dense at i=%d\n", i);
            fail = 1;
        }
    }
    a[24] = zero;
    if (a[23] != one) {
        printf("FAIL int:1 dense neighbor\n");
        fail = 1;
    }
    if (a[25] != one) {
        printf("FAIL int:1 dense neighbor hi\n");
        fail = 1;
    }
    if (fail == 0) {
        printf("OK int:1 dense 48 x 1 bit\n");
    } else {
        return 1;
    }
    return 0;
}

//
void main() {
    grdval = 100;
    arspan = 12;
    printf("packed int:<bits> tests arspan=%d\n", arspan);
    if (tsz08() != 0) {
        printf("abort sizes\n");
    }
    if (tsz16() != 0) {
        printf("abort sizes\n");
    }
    if (tsz24() != 0) {
        printf("abort sizes\n");
    }
    if (tsz32() != 0) {
        printf("abort sizes\n");
    }
    if (tsz40() != 0) {
        printf("abort sizes\n");
    }
    if (trw08() != 0) {
        printf("abort rw8\n");
    }
    if (trw16() != 0) {
        printf("abort rw16\n");
    }
    if (trw24() != 0) {
        printf("abort rw24\n");
    }
    if (tdense() != 0) {
        printf("abort dense\n");
    }
    printf("done\n");
}
