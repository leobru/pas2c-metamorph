int a, b, c;
void main() {
    a = 10;
    b = 3;
    c = a + b;
    writeln(" 10 + 3 = ", c:0);
    c = a - b;
    writeln(" 10 - 3 = ", c:0);
    c = a * b;
    writeln(" 10 * 3 = ", c:0);
    c = a / b;
    writeln(" 10 / 3 = ", c:0);
    c = a % b;
    writeln(" 10 % 3 = ", c:0);
}
