//
int a, b, c;
void main(int argc, char **argv) {
    a = 10;
    b = 3;
    c = a + b;
    printf(" 10 + 3 = %d\n", c);
    c = a - b;
    printf(" 10 - 3 = %d\n", c);
    c = a * b;
    printf(" 10 * 3 = %d\n", c);
    c = a / b;
    printf(" 10 / 3 = %d\n", c);
    c = a % b;
    printf(" 10 %% 3 = %d\n", c);
}
