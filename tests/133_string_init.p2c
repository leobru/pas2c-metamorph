/*=k9,l0*/
//
// An array is initialized, not assigned.  A string constant wider than a
// word is buffered, not in the constant pool, so it goes into the initializer
// stream as the run of words it is -- on its own, as one item of a brace
// list, and among ordinary scalar globals, whose own storage it must not
// disturb.
//
// How long that run is comes from the length written, (strLen + 5) / 6, which
// is exactly typeSize of the type the constant carries: a length that is an
// exact multiple of the characters in a word takes no word of padding along,
// and a shorter last word is padded with NUL.  A 't' prefix picks TEXT coding
// for the characters, and the type follows that too.
//
typedef __packed char line[18];
typedef __packed char dozen[12];
//
int before = 5;
line one = "HELLO WORLD, HERE!";
line many[2] = { "ABCDEFGHIJKLMNOPQR", "STUVWXYZ0123456789" };
int between = 7;
line mixed[2] = { "SHORT ONE HERE  OK", "AND THE SECOND ONE" };
int after = 9;
// Twelve characters are exactly two words, the case the pool pads.
dozen exact = "ABCDEFGHIJKL";
int guard = 11;
dozen astext = t"ABCDEFGHIJKL";
int last = 13;
int i;
// The other consumer of the same buffered words is an expression, where they
// do go to the pool, an address being what a load needs: a const of string
// type is the one route to that which is not a plain literal.
const __packed char BANNER[] = "A WIDE CONST STRING";
//
void putln() assembler;
void main() {
    printf(" SIZE  %3d%3d%3d\n", sizeof(one), sizeof(many), sizeof(exact));
    write(" ONE   ", one);      putln();
    write(" MANY0 ", many[0]);  putln();
    write(" MANY1 ", many[1]);  putln();
    write(" MIXED ", mixed[1]); putln();
    write(" EXACT ", exact);    putln();
    // The scalars around them keep their own values: no run overran.
    printf(" SCALAR%3d%3d%3d%3d%3d\n", before, between, after, guard, last);
    // A run is indexable like any other packed char array.
    printf(" INDEX ");
    for (i = 0; i <= 7; i = i + 1)
        printf("%c", many[1][i]);
    putln();
    write(" CONST ", BANNER, sizeof(BANNER):3);  putln();
}
