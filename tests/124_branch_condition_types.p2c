/*=k9,l0*/
//
// What a branch may test: anything whose kind is at most kindPtr -- a scalar,
// a pointer, or a packed field of either.  A packed field is a type of its
// own, not intType, which is what made a stricter rule reject `if (b.flag)`
// while the ternary next to it accepted the same expression.
//
typedef void *anyptr;
const anyptr NULL = (anyptr)0;
typedef __packed __lsb struct { int:1 flag; int:6 n; } bits;
typedef struct { rec *nxt; int v; } rec;
bits b;
rec r, r2;
rec * p;
char c;
int i, t, n;
void main() {
    b.flag = 1; b.n = 5; r.v = 9; c = 'A'; i = 0; p = &r;
    if (b.flag) printf(" BITFIELD YES\n"); else printf(" BITFIELD NO\n");
    if (p) printf(" POINTER YES\n"); else printf(" POINTER NO\n");
    if (c) printf(" CHAR YES\n"); else printf(" CHAR NO\n");
    p = NULL;
    if (p) printf(" NULLPTR YES\n"); else printf(" NULLPTR NO\n");
    // The ternary takes the same set, and always did.
    t = b.flag ? 11 : 22;
    printf(" TERNARY=%d\n", t);
    // while, too: ifWhileStatement handles both.
    while (b.n) { i = i + b.n; b.n = b.n - 1; }
    printf(" LOOP=%d\n", i);
    // do...while takes the same set: its NOTOP wrapper only flips the
    // polarity of the list BRANCH reads.
    r.nxt = NULL; r2.v = 4; r2.nxt = NULL; r.v = 1; r.nxt = &r2;
    p = &r; n = 0;
    do { n = n + p->v; p = p->nxt; } while (p);
    printf(" DOPTR=%d\n", n);
    b.n = 3; i = 0;
    do { i = i + b.n; b.n = b.n - 1; } while (b.n);
    printf(" DOBITS=%d\n", i);
    b.flag = 0;
    if (b.flag) printf(" CLEARED YES\n"); else printf(" CLEARED NO\n");
}
