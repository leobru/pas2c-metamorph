/*=k9,l0*/
// Variables of function pointer types.  'T (*name)(params)' declares one;
// a routine named without an argument list is a function designator worth
// its entry address, with '&' in front of it optional, as in C; and a call
// through the pointer takes its whole convention from the pointer's type.
typedef void *anyptr;
const anyptr NULL = (anyptr)0;
//
typedef int (*binop)(int, int);
//
int add2(int a, int b) { return a + b; }
int mul2(int a, int b) { return a * b; }
int negate(int a) { return -a; }
float scale(float x) { return x * 2.0; }
//
int counter;
void bump() { counter = counter + 10; }
//
binop gfn;
void (*gproc)();
int (*tbl[2])(int, int);
void (*ptbl[2])();
binop *pp;
int i;
//
// A function pointer is an ordinary parameter and an ordinary result.
int apply(binop f, int a, int b) {
    return f(a, b);
}
//
binop pick(int which) {
    if (which == 0)
        return add2;
    return mul2;
}
//
void main() {
    binop f;
    int (*g)(int);
    float (*fr)(float);
    f = add2;
    printf(" ADD=%d\n", f(3, 4));
    f = &mul2;
    printf(" MUL=%d\n", f(3, 4));
    // '*' on a pointer to a routine is the identity.
    printf(" STAR=%d\n", (*f)(5, 6));
    g = negate;
    printf(" ONE=%d\n", g(9));
    gfn = add2;
    printf(" GLOB=%d\n", gfn(1, 2));
    printf(" ARG=%d\n", apply(mul2, 3, 5));
    f = pick(0);
    printf(" RET0=%d\n", f(7, 8));
    f = pick(1);
    printf(" RET1=%d\n", f(7, 8));
    counter = 0;
    gproc = bump;
    gproc();
    gproc();
    printf(" PROC=%d\n", counter);
    fr = scale;
    printf(" REAL=%6.2f\n", fr(2.5));
    // An actual is converted the way an assignment would convert it.
    printf(" CONV=%6.2f\n", fr(2));
    tbl[0] = add2;
    tbl[1] = mul2;
    printf(" TBL=%d %d\n", tbl[0](2, 3), tbl[1](2, 3));
    gfn = NULL;
    if (gfn == NULL)
        printf(" NULL=YES\n");
    else
        printf(" NULL=NO\n");
    gfn = mul2;
    if (gfn == NULL)
        printf(" NULL2=YES\n");
    else
        printf(" NULL2=NO\n");
    // A callee that is not directly addressable is marshalled like one more
    // argument: the push takes argument 1 out of the accumulator, STI takes
    // the entry address and pops the argument back.  A variable index, a
    // call's result, a conditional and a dereference all reach it.
    i = 0;  printf(" VARIDX=%d\n", tbl[i](2, 3));
    i = 1;  printf(" VARIDX=%d\n", tbl[i](2, 3));
    printf(" CALLRES=%d\n", pick(1)(7, 8));
    i = 0;  printf(" TERN=%d\n", (i == 0 ? add2 : mul2)(3, 4));
    i = 1;  printf(" TERN=%d\n", (i == 0 ? add2 : mul2)(3, 4));
    pp = &gfn;
    printf(" DEREF=%d\n", (*pp)(6, 7));
    // With no argument there is nothing to pop, and ATI serves instead.
    counter = 0;
    ptbl[0] = bump;  ptbl[1] = bump;
    i = 1;  ptbl[i]();  ptbl[i]();
    printf(" NOARG=%d\n", counter);
}
