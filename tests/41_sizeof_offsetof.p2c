//
typedef struct {
    int x, y;
} point;
typedef __packed struct {
    char a, b;
    int c;
} tiny;
point p;
int words[8];
void main() {
    printf(" size int=%d\n", sizeof(int));
    printf(" size point=%d\n", sizeof(point));
    printf(" size words=%d\n", sizeof(words));
    printf(" off x=%d\n", offsetof(point, x));
    printf(" off y=%d\n", offsetof(point, y));
    printf(" off packed b=%d\n", offsetof(tiny, b));
    printf(" off packed c=%d\n", offsetof(tiny, c));
}
