/*=l0*/
//
typedef struct { int x, y; } point;
typedef point *ptpr;
//
point obj;
ptpr p;
int arr[3];
//
ptpr getp() {
    return p;
}
//
void main() {
    p = &obj;
    p->x = 7;
    p->y = 8;
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;

    /* postfix on parenthesised expression: (p)->x */
    printf("(p)->x   = %d\n", (p)->x);

    /* postfix on the result of a function call: getp()->y */
    printf("getp()->y= %d\n", getp()->y);
}
