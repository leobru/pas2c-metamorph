/*=k9,l0*/
typedef __packed char chars[4];

chars ascii = "A\
B\
CD";
chars text = t"EF\
GH";

void main() {
    writeln(" DOUBLE ", ascii);
    writeln(" SINGLE ", ('A\
\102CD' == 'ABCD'):0);
    writeln(" TEXTW  ", (t'EF\
GH' == t'EFGH'):0);
    writeln(" TEXTS  ",
            ((int)text[0] == (int)t'E'):0, ' ',
            ((int)text[1] == (int)t'F'):0, ' ',
            ((int)text[2] == (int)t'G'):0, ' ',
            ((int)text[3] == (int)t'H'):0);
}
