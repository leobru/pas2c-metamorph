/*=k9,l0*/
//
// Pointer arithmetic steps in pointee units: 'p + 1' advances by one whole
// structure, however many words that is, and 'q - p' counts structures, not
// words.  The scaling is a multiply folded into the expression at
// construction, so codegen sees an ordinary integer add and the pointer
// keeps its type -- '(p + 2)->field', '*(p + 2)' and 'p[i]' all follow.
// Sizes one, two, three, five and thirty words are exercised side by side,
// the size being what the scaling turns on.
//
typedef void *anyptr;
const anyptr NULL = (anyptr)0;
typedef struct { int a; } w1;
typedef struct { int a, b; } w2;
typedef struct { int a, b, c; } w3;
typedef struct { int a, b, c, d, e; } w5;
typedef struct { int x[30]; } w30;
//
w1 t1[4];
w2 t2[4];
w3 t3[4];
w5 t5[4];
w30 t30[4];
w1 *p1, *q1;
w2 *p2, *q2;
w3 *p3, *q3;
w5 *p5, *q5;
w30 *p30, *q30;
w3 *ptab[4];
w3 **pp;
int i, k;
//
void main() {
    for (i = 0; i <= 3; i = i + 1) {
        t1[i].a  =  10 + i;
        t2[i].a  =  20 + i;   t2[i].b  =  200 + i;
        t3[i].a  =  30 + i;   t3[i].c  =  300 + i;
        t5[i].a  =  50 + i;   t5[i].e  =  500 + i;
        t30[i].x[0]  =  70 + i;   t30[i].x[29]  =  700 + i;
    }
    p1  =  &t1[0];  p2  =  &t2[0];  p3  =  &t3[0];
    p5  =  &t5[0];  p30  =  &t30[0];
    // One step of 'p + 2' at each size.
    printf(" ADD   %4d%5d%5d%5d%5d\n", (p1 + 2)->a, (p2 + 2)->b, (p3 + 2)->c, (p5 + 2)->e,
           (p30 + 2)->x[29]);
    printf(" COMM  %4d%4d\n", (2 + p3)->a, (p3 + 2)->a);
    q1  =  p1 + 3;  q2  =  p2 + 3;  q3  =  p3 + 3;
    q5  =  p5 + 3;  q30  =  p30 + 3;
    printf(" SUB   %4d%5d%5d%5d%5d\n", (q1 - 1)->a, (q2 - 1)->b, (q3 - 1)->c, (q5 - 1)->e,
           (q30 - 1)->x[0]);
    // A difference counts elements, whatever the element is.
    printf(" DIFF  %3d%3d%3d%3d%3d\n", (q1 - p1), (q2 - p2), (q3 - p3), (q5 - p5), (q30 - p30));
    printf(" NEGD  %4d\n", (p1 - q1));
    // p[i] is *(p + i), with a constant and with a variable index.
    printf(" IDX   %4d%4d%5d\n", p3[0].a, p3[3].a, p3[2].c);
    i  =  2;
    printf(" IDXV  %4d%5d%5d%5d\n", p3[i].a, p3[i].c, p5[i].e, p30[i].x[29]);
    // Stores through a computed pointer: an element, a whole structure,
    // a field.
    p3[1].a  =  91;
    p5[1].e  =  92;
    *(p3 + 2)  =  t3[0];
    (p3 + 3)->c  =  93;
    printf(" STORE %4d%4d%4d%5d%4d\n", t3[1].a, t5[1].e, t3[2].a, t3[2].c, t3[3].c);
    // Stepping by one, in every spelling.
    p3  =  &t3[0];
    p3++;
    printf(" INC   %4d\n", p3->a);
    ++p3;
    printf(" PREI  %4d\n", p3->a);
    p3--;
    printf(" DEC   %4d\n", p3->a);
    p3  +=  2;
    printf(" PLEQ  %4d\n", p3->a);
    p3  -=  3;
    printf(" MIEQ  %4d\n", p3->a);
    // The value of a step is the pointer before or after it.
    p3  =  &t3[0];
    q3  =  p3++;
    printf(" POST  %4d%4d%3d\n", q3->a, p3->a, (p3 - q3));
    p3  =  &t3[0];
    q3  =  ++p3;
    printf(" PRE   %4d%4d\n", q3->a, p3->a);
    // Walking an array with a pointer.
    p5  =  &t5[0];
    q5  =  &t5[3];
    k  =  0;
    while (p5 <= q5) {
        k  =  k + p5->a;
        p5++;
    }
    printf(" WALK  %5d\n", k);
    // A pointer to a pointer steps one word, whatever it points at.
    ptab[0]  =  &t3[0];  ptab[1]  =  &t3[1];
    ptab[2]  =  &t3[2];  ptab[3]  =  &t3[3];
    pp  =  &ptab[0];
    printf(" PP    %4d%4d%3d\n", (*(pp + 2))->a, pp[1]->a, ((pp + 3) - pp));
    // Heap storage indexed as an array.
    p3  =  malloc(4 * sizeof(w3));
    for (i = 0; i <= 3; i = i + 1)
        p3[i].a  =  40 + i;
    printf(" HEAP  %4d%4d%4d\n", p3[0].a, p3[3].a, (p3 + 3)->a);
}
