/*=k9,l0*/
//
// A parameter declared as an array is a pointer to its element, as in C.
// The callee gets a word rather than a copy of the whole array, so a store
// through the parameter is visible to the caller, sizeof is one word, and
// the parameter itself may be stepped.  An extent may be left out, and an
// array formal and a pointer formal are the same formal.  A struct
// parameter is unaffected: C passes structs by value, and so does this.
//
typedef struct { int x, y, z; } tri;
//
int a[5];
int *p;
int i, n;
tri t;
//
void store(int q[5]) { q[2] = 99; }
int sz(int q[]) { return sizeof(q); }
int walk(int q[]) {
int s;
    s  =  0;
    while (*q != 0) {
        s  =  s + *q;
        q++;
    }
    return s;
}
void ptrf(int *q) { q[0] = 77; }
void arrf(int q[3]) { q[1] = 88; }
int bystruct(tri s) { s.x = 0; return s.y; }
//
void main() {
    for (i = 0; i <= 4; i = i + 1)
        a[i]  =  i + 1;
    store(a);
    printf(" STORE %4d\n", a[2]);
    printf(" SIZEOF%4d\n", sz(a));
    a[4]  =  0;
    printf(" WALK  %4d\n", walk(a));
    ptrf(a);
    printf(" PTRF  %4d\n", a[0]);
    p  =  a;
    arrf(p);
    printf(" ARRF  %4d\n", a[1]);
    t.x = 1; t.y = 2; t.z = 3;
    n  =  bystruct(t);
    printf(" STRUCT%4d%4d\n", n, t.x);
}
