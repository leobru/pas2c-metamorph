/*=k9,l0*/
/*
 * Comprehensive test of integer division and modulo when one operand
 * is a compile-time constant.  The compiler picks among five distinct
 * code paths (see opfDIV / opfMOD in work.p2c):
 *
 *   1. const op const           -> folded at compile time.
 *   2a. expr  /  (1<<k)          -> single shift right (ASN) via the
 *                                  card(arg2)==1 fast path in
 *                                  genConstDiv.
 *   2b. expr  /  const (other)   -> multiplication by a reciprocal worked
 *                                  out at compile time, then the residual
 *                                  shift.  genRecip turns away the
 *                                  divisors whose reciprocal overshoots
 *                                  too far to hold across the range.
 *   3. expr   %  (1<<k)         -> single bitwise AND with the
 *                                  low-k-bit mask via KAAX.
 *   4. expr   %  const (other)  -> the quotient of path 2, then
 *                                  KMUL+KYTA+KRSUB recovers expr - q*const.
 *   5. expr   /  expr           -> the runtime helpers C/DI and C/MD.
 *
 * Paths 2 to 4 want an unsigned operand -- neither the shift nor the mask
 * there carries a sign -- so the B to G sections below, whose dividend is
 * a plain int, reach the constant divisor through path 5.  What they pin
 * is the answer, which is the same either way: all five truncate toward
 * zero, the remainder takes the sign of the dividend, and q*b + r rebuilds
 * a whatever the signs.  tests/151_div_full_range drives paths 2 to 4
 * proper, over an unsigned dividend and to both ends of the range.
 *
 * Labels avoid a leading sign or digit so BESM-6 carriage control
 * does not overstrike successive lines.
 */
int a, b, q, r, n;
void main() {
    /* ---------- A. constant folding (path 1) ---------- */
    q = 100 / 7;          printf(" A01 %d\n", q);
    r = 100 % 7;          printf(" A02 %d\n", r);
    q = 1024 / 32;        printf(" A03 %d\n", q);
    r = 1024 % 32;        printf(" A04 %d\n", r);
    q = 1 / 1;            printf(" A05 %d\n", q);
    r = 1 % 1;            printf(" A06 %d\n", r);
    q = 0 / 7;            printf(" A07 %d\n", q);
    r = 0 % 7;            printf(" A08 %d\n", r);
    q = 999999 / 1000;    printf(" A09 %d\n", q);
    r = 999999 % 1000;    printf(" A10 %d\n", r);
    /* a folded quotient truncates toward zero and the remainder follows the
       dividend */
    q = -100 / 7;         printf(" A11 %d\n", q);
    r = -100 % 7;         printf(" A12 %d\n", r);
    q = -100 / 4;         printf(" A13 %d\n", q);
    r = -100 % 4;         printf(" A14 %d\n", r);

    /* ---------- B. variable / power-of-two constant ---------------- */
    a = 1024;
    q = a / 1;            printf(" B01 %d\n", q);
    q = a / 2;            printf(" B02 %d\n", q);
    q = a / 4;            printf(" B03 %d\n", q);
    q = a / 8;            printf(" B04 %d\n", q);
    q = a / 16;           printf(" B05 %d\n", q);
    q = a / 32;           printf(" B06 %d\n", q);
    q = a / 64;           printf(" B07 %d\n", q);
    q = a / 128;          printf(" B08 %d\n", q);
    q = a / 256;          printf(" B09 %d\n", q);
    q = a / 1024;         printf(" B10 %d\n", q);
    a = 1023;
    q = a / 4;            printf(" B11 %d\n", q);
    q = a / 1024;         printf(" B12 %d\n", q);

    /* ---------- C. variable / non-power-of-two constant ------------- */
    a = 100;
    q = a / 3;            printf(" C01 %d\n", q);
    q = a / 5;            printf(" C02 %d\n", q);
    q = a / 6;            printf(" C03 %d\n", q);
    q = a / 7;            printf(" C04 %d\n", q);
    q = a / 9;            printf(" C05 %d\n", q);
    q = a / 10;           printf(" C06 %d\n", q);
    q = a / 11;           printf(" C07 %d\n", q);
    q = a / 13;           printf(" C08 %d\n", q);
    q = a / 25;           printf(" C09 %d\n", q);
    q = a / 33;           printf(" C10 %d\n", q);
    q = a / 99;           printf(" C11 %d\n", q);
    q = a / 100;          printf(" C12 %d\n", q);
    q = a / 101;          printf(" C13 %d\n", q);
    a = 1000000;
    q = a / 7;            printf(" C14 %d\n", q);
    q = a / 13;           printf(" C15 %d\n", q);
    q = a / 999;          printf(" C16 %d\n", q);

    /* ---------- D. variable % power-of-two constant ----------------- */
    a = 1023;
    r = a % 1;            printf(" D01 %d\n", r);   /* mask = empty   */
    r = a % 2;            printf(" D02 %d\n", r);
    r = a % 4;            printf(" D03 %d\n", r);
    r = a % 8;            printf(" D04 %d\n", r);
    r = a % 16;           printf(" D05 %d\n", r);
    r = a % 32;           printf(" D06 %d\n", r);
    r = a % 64;           printf(" D07 %d\n", r);
    r = a % 128;          printf(" D08 %d\n", r);
    r = a % 256;          printf(" D09 %d\n", r);
    r = a % 512;          printf(" D10 %d\n", r);
    r = a % 1024;         printf(" D11 %d\n", r);
    a = 1024;
    r = a % 1024;         printf(" D12 %d\n", r);
    a = 65;
    r = a % 64;           printf(" D13 %d\n", r);

    /* ---------- E. variable % non-power-of-two constant ------------- */
    a = 100;
    r = a % 3;            printf(" E01 %d\n", r);
    r = a % 5;            printf(" E02 %d\n", r);
    r = a % 6;            printf(" E03 %d\n", r);
    r = a % 7;            printf(" E04 %d\n", r);
    r = a % 9;            printf(" E05 %d\n", r);
    r = a % 10;           printf(" E06 %d\n", r);
    r = a % 11;           printf(" E07 %d\n", r);
    r = a % 13;           printf(" E08 %d\n", r);
    r = a % 25;           printf(" E09 %d\n", r);
    r = a % 33;           printf(" E10 %d\n", r);
    r = a % 99;           printf(" E11 %d\n", r);
    r = a % 100;          printf(" E12 %d\n", r);
    r = a % 101;          printf(" E13 %d\n", r);
    a = 1000000;
    r = a % 7;            printf(" E14 %d\n", r);
    r = a % 13;           printf(" E15 %d\n", r);
    r = a % 999;          printf(" E16 %d\n", r);

    /* ---------- F. positive edge cases ---------- */
    a = 0;
    q = a / 7;            printf(" F01 %d\n", q);
    r = a % 7;            printf(" F02 %d\n", r);
    q = a / 8;            printf(" F03 %d\n", q);
    r = a % 8;            printf(" F04 %d\n", r);
    /* dividend smaller than divisor */
    a = 5;
    q = a / 7;            printf(" F05 %d\n", q);
    r = a % 7;            printf(" F06 %d\n", r);
    q = a / 8;            printf(" F07 %d\n", q);
    r = a % 8;            printf(" F08 %d\n", r);
    /* exact multiple */
    a = 56;
    q = a / 7;            printf(" F09 %d\n", q);
    r = a % 7;            printf(" F10 %d\n", r);
    q = a / 8;            printf(" F11 %d\n", q);
    r = a % 8;            printf(" F12 %d\n", r);
    /* combined / and %: q*n+r should rebuild the dividend */
    a = 12345;
    q = a / 100;
    r = a % 100;
    n = q * 100 + r;      printf(" F13 %d\n", n);
    a = 12345;
    q = a / 128;
    r = a % 128;
    n = q * 128 + r;      printf(" F14 %d\n", n);
    /* chained division collapses across the magic-number path */
    a = 100000;
    q = a / 2 / 5;        printf(" F15 %d\n", q);
    q = a / 5 / 2;        printf(" F16 %d\n", q);
    q = (a / 7) % 11;     printf(" F17 %d\n", q);

    /* ---------- G. op-assign forms ---------- */
    a = 1000;
    a /= 4;               printf(" G01 %d\n", a);
    a /= 5;               printf(" G02 %d\n", a);
    a = 1000;
    a /= 7;               printf(" G03 %d\n", a);
    a = 1000;
    a %= 6;               printf(" G04 %d\n", a);
    a = 1000;
    a %= 8;               printf(" G05 %d\n", a);
    a = 1001;
    a %= 8;               printf(" G06 %d\n", a);

    /* ---------- H. variable / variable (path 5: runtime helper) -----
     * C/DI truncates: q = trunc(a/b), the sign coming back only after the
     * fraction has gone.  C/MD takes that same quotient, so r = a - q*b has
     * the sign of a and 0 <= |r| < |b|.  A constant divisor answers the
     * same, which is what the B..G sections above check against these.
     */
    a = 100;  b = 7;
    q = a / b;            printf(" H01 %d\n", q);
    r = a % b;            printf(" H02 %d\n", r);
    a = 1024; b = 8;
    q = a / b;            printf(" H03 %d\n", q);
    r = a % b;            printf(" H04 %d\n", r);
    a = 1024; b = 1;
    q = a / b;            printf(" H05 %d\n", q);   /* exact via helper */
    a = -100; b = 7;
    q = a / b;            printf(" H06 %d\n", q);
    r = a % b;            printf(" H07 %d\n", r);
    a = -100; b = 4;
    q = a / b;            printf(" H08 %d\n", q);
    r = a % b;            printf(" H09 %d\n", r);
    a = -7;   b = 4;
    q = a / b;            printf(" H10 %d\n", q);
    r = a % b;            printf(" H11 %d\n", r);
}
