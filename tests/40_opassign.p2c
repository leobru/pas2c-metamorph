/*=k9,l0*/
int a, b;
int arr[4];
int k;
void main() {
a = 10;
b = 3;
a += b;     printf(" add %d\n", a);
a -= 1;     printf(" sub %d\n", a);
a *= 2;     printf(" mul %d\n", a);
a /= 4;     printf(" div %d\n", a);
a %= 4;     printf(" mod %d\n", a);
a |= 8;     printf(" or  %d\n", a);
a &= 12;    printf(" and %d\n", a);
a ^= 5;     printf(" xor %d\n", a);
a <<= 2;    printf(" shl %d\n", a);
a >>= 1;    printf(" shr %d\n", a);
k = 1;
arr[k] = 100;
arr[k] += 7;
printf(" arr %d\n", arr[1]);
}
