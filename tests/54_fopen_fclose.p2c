void main(int argc, char **argv) {
    fopen(f, 010000100010, 0);
    printf("open %d %d %d %d %d\n", f[18], f[27], f[1] != 0, f[12] != 0, f[13] != 0);
    fclose(f);
    printf("close %d %d %d\n", f[27], f[23], f[24]);

    fopen(a, 010000100010, 0);
