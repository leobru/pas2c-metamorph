/*=k9,l0*/
//
// Duff's device: the switch dispatches into the middle of a do-while body,
// and the labels are written between the statements of that body rather than
// at the top of the switch.  The remainder decides which label the jump lands
// on, so the first pass through the loop copies fewer than eight elements and
// every pass after it copies all eight.
//
// A wrong entry offset copies the wrong number of elements, which shows up
// both as a source element missing from the destination and as a destination
// element that should still hold its fill.  The check counts both, so every
// count prints 0 when the dispatch lands where it should.
//
int src[24], dst[24];
int i, k, bad;
//
void putln() assembler;
//
void copy(int *to, int *from, int count) {
    int n;
    n  =  (count + 7) / 8;
    switch (count % 8) {
    case 0: do { *to = *from; ++to; ++from;
    case 7:      *to = *from; ++to; ++from;
    case 6:      *to = *from; ++to; ++from;
    case 5:      *to = *from; ++to; ++from;
    case 4:      *to = *from; ++to; ++from;
    case 3:      *to = *from; ++to; ++from;
    case 2:      *to = *from; ++to; ++from;
    case 1:      *to = *from; ++to; ++from;
            } while (--n > 0);
    }
}
//
void main() {
    for (i = 0; i <= 23; i = i + 1)
        src[i]  =  i + 100;
    printf(" DUFF  ");
    for (k = 1; k <= 17; k = k + 1) {
        for (i = 0; i <= 23; i = i + 1)
            dst[i]  =  999;
        copy(dst, src, k);
        bad  =  0;
        for (i = 0; i <= 23; i = i + 1) {
            if (i < k) {
                if (dst[i] != src[i])
                    bad  =  bad + 1;
            } else {
                if (dst[i] != 999)
                    bad  =  bad + 1;
            }
        }
        printf("%2d", bad);
    }
    putln();
    // The copy of thirteen elements, written out: five on the first pass in
    // at case 5, eight on the second.
    for (i = 0; i <= 23; i = i + 1)
        dst[i]  =  999;
    copy(dst, src, 13);
    printf(" THIRT ");
    for (i = 0; i <= 15; i = i + 1)
        printf("%4d", dst[i]);
    putln();
}
