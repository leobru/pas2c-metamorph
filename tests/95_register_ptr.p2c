/*=k9,l0*/
//
// A block may open with 'register TYPE *p = expr;'.  The pointer's value is
// pinned in an index register until the closing brace, so 'p->field' costs
// the one instruction a `with` field costs -- it is the same machinery, with
// a name in place of `with`'s implicit field lookup.
//
typedef struct { int a, b, c; } rec;
typedef struct { rec inner; int tag; } outer;
rec r1, r2;
outer nest;
int probe, register;
//
// A callee that pins a pointer of its own, so its clobber mask covers the
// index registers a caller's register pointer may be using: the caller has to
// reload from the spill slot after the call.
void clobber() {
    { register rec *c = &r2;
        c->a = c->a + 1;
        c->b = c->b + 1;
    }
}
//
int sum3(rec *q) {
    return q->a + q->b + q->c;
}
//
void main() {
    r1.a = 1;  r1.b = 2;  r1.c = 3;
    r2.a = 10; r2.b = 20; r2.c = 30;
    nest.inner.a = 100; nest.inner.b = 200; nest.inner.c = 300;
    nest.tag = 7;
    // Read and write through a register pointer.
    { register rec *p = &r1;
      p->a = p->b + p->c;
      printf(" ONE=%d,%d,%d\n", p->a, p->b, p->c);
    }
    printf(" AFTER=%d\n", r1.a);
    // Two of them, in nested blocks, live at the same time.
    { register rec *p = &r1;
      { register rec *q = &nest.inner;
        q->a = q->a + p->b;
        printf(" TWO=%d,%d\n", p->b, q->a);
      }
      printf(" OUTER=%d TAG=%d\n", p->b, nest.tag);
    }
    // A call in the middle: the register must survive it.
    { register rec *p = &r1;
      probe = p->b;
      clobber();
      clobber();
      printf(" ACROSS=%d,%d R2=%d,%d\n", p->b, probe, r2.a, r2.b);
    }
    // The pointer used on its own, passed by value.
    { register rec *p = &r1;
      printf(" BARE=%d\n", sum3(p));
    }
    // Read-modify-write through a register pointer: the pinned base is the
    // cheapest lvalue there is, so genRMWAssign shares it between the read
    // and the write rather than spilling its address.  The call in the
    // middle covers the other arm, where the register no longer holds the
    // base and the address has to be rebuilt.
    { register rec *p = &r1;
      p->a += 5;
      ++p->b;
      p->c--;
      printf(" RMW=%d,%d,%d\n", p->a, p->b, p->c);
      clobber();
      p->a += 100;
      printf(" RMWX=%d R2=%d\n", p->a, r2.a);
    }
    // 'register' is recognized by spelling, so it stays an ordinary
    // identifier everywhere else.
    register = 42;
    printf(" NAME=%d\n", register);
}
