/*=k9,l0*/
//
int square(int x) {
    return x * x;
}
//
int clamp(int v, int lo, int hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}
//
int early_void(int x) {
//    early_void = -1;
    if (x == 0) return -1;
    return x + 100;
}
//
void main() {
    printf("sq(5)=%d\n", square(5));
    printf("sq(9)=%d\n", square(9));
    printf("cl(7,1,5)=%d\n", clamp(7, 1, 5));
    printf("cl(0,1,5)=%d\n", clamp(0, 1, 5));
    printf("cl(3,1,5)=%d\n", clamp(3, 1, 5));
    printf("ev(0)=%d\n", early_void(0));
    printf("ev(8)=%d\n", early_void(8));
}
