/*=k9,l0*/
//
// A string constant and a declared packed char array are the same
// zero-based type.
typedef __packed char alfa[6];
alfa a = "ABCDEF";
char s[6];
int i;

void main() {
    s[0] = 'A';
    s[5] = 'F';

    writeln(" ALFA ", a[0], ' ', a[5],
            " SIZE ", sizeof(a):0, ' ', sizeof("ABCDEF"):0);

    i = 0;
    write(" VAR ", a[i]);
    i = 5;
    writeln(' ', a[i]);

    writeln(" CHAR ", s[0], ' ', s[5], " SIZE ", sizeof(s):0);
}
