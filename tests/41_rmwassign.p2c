/*=k9,l0*/
/*
 * Exercise op-assign and ++/-- on ACC-using lvalues.  Each lvalue
 * needs the accumulator to compute its address, so the prior AST
 * lowering (ASSIGNOP(lhs, op(lhs, rhs))) would evaluate lhs twice
 * and clobber ACC mid-RMW.  RMWASSIGN materialises the address
 * once in a spill slot and reuses it for load and store.
 * Labels avoid leading +/-/0 to keep BESM-6 carriage control quiet.
 */
typedef int *intptr;
typedef struct { int x, y; } rec;
typedef rec *recptr;
int arr[4];
int mat[3][3];
intptr p;
recptr rp;
rec r;
int n;
int i, j;
void main() {
    /* simple array element via variable index */
    arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
    i = 1;
    arr[i] += 5;        writeln(" a01 ", arr[1]:0);
    arr[i] -= 3;        writeln(" a02 ", arr[1]:0);
    arr[i] *= 2;        writeln(" a03 ", arr[1]:0);
    ++arr[i];           writeln(" a04 ", arr[1]:0);
    --arr[i];           writeln(" a05 ", arr[1]:0);

    /* computed-index access: arr[i+1] */
    arr[i+1] += 100;    writeln(" a06 ", arr[2]:0);
    ++arr[i+1];         writeln(" a07 ", arr[2]:0);

    /* multi-dim subscripting */
    i = 0; j = 0;
    while (i < 3) {
        j = 0;
        while (j < 3) {
            mat[i][j] = (i+1)*10 + j+1;
            ++j;
        };
        ++i;
    };
    mat[1][2] += 7;     writeln(" m01 ", mat[1][2]:0);
    --mat[2][0];        writeln(" m02 ", mat[2][0]:0);

    /* pointer deref */
    n = 50;
    p = &n;
    *p += 4;            writeln(" p01 ", n:0);
    *p -= 1;            writeln(" p02 ", n:0);
    ++(*p);             writeln(" p03 ", n:0);

    /* struct field via pointer */
    r.x = 100; r.y = 200;
    rp = &r;
    rp->x += 11;        writeln(" r01 ", r.x:0);
    rp->y -= 25;        writeln(" r02 ", r.y:0);
    ++rp->x;            writeln(" r03 ", r.x:0);
    --rp->y;            writeln(" r04 ", r.y:0);

    /* bit ops on indexed element */
    arr[0] = 12;
    arr[0] |= 1;        writeln(" b01 ", arr[0]:0);
    arr[0] &= 7;        writeln(" b02 ", arr[0]:0);
    arr[0] ^= 2;        writeln(" b03 ", arr[0]:0);
    arr[0] <<= 1;       writeln(" b04 ", arr[0]:0);
    arr[0] >>= 2;       writeln(" b05 ", arr[0]:0);
}
