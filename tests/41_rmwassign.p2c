/*=k9,l0*/
/*
 * Exercise op-assign and ++/-- on lvalues of every shape.  The naked
 * AST lowering (ASSIGNOP(lhs, op(lhs, rhs))) evaluates lhs twice, so
 * RMWASSIGN materialises the address once in a spill slot and reuses
 * it for load and store wherever reaching the lvalue costs the
 * accumulator: a constant subscript, a computed index, a deref of
 * anything but a plain variable.  The shapes isCheapLval admits --
 * a variable, a deref of one, a field of either, an element at a
 * variable index -- are walked twice instead, and both paths must
 * produce the same values.
 * Labels avoid leading +/-/0 to keep BESM-6 carriage control quiet.
 */
typedef int *intptr;
typedef intptr *intpp;
typedef struct { int x, y; } rec;
typedef rec *recptr;
typedef struct { int v; } part;
typedef struct { part sub; int t; } whole;
int arr[4];
int mat[3][3];
intptr p;
intpp pp;
recptr rp;
rec r;
rec ra[3];
whole o;
int n;
int i, j;
void main() {
    /* simple array element via variable index */
    arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
    i = 1;
    arr[i] += 5;        printf(" a01 %d\n", arr[1]);
    arr[i] -= 3;        printf(" a02 %d\n", arr[1]);
    arr[i] *= 2;        printf(" a03 %d\n", arr[1]);
    ++arr[i];           printf(" a04 %d\n", arr[1]);
    --arr[i];           printf(" a05 %d\n", arr[1]);

    /* computed-index access: arr[i+1] */
    arr[i+1] += 100;    printf(" a06 %d\n", arr[2]);
    ++arr[i+1];         printf(" a07 %d\n", arr[2]);

    /* multi-dim subscripting */
    i = 0; j = 0;
    while (i < 3) {
        j = 0;
        while (j < 3) {
            mat[i][j] = (i+1)*10 + j+1;
            ++j;
        };
        ++i;
    };
    mat[1][2] += 7;     printf(" m01 %d\n", mat[1][2]);
    --mat[2][0];        printf(" m02 %d\n", mat[2][0]);

    /* pointer deref */
    n = 50;
    p = &n;
    *p += 4;            printf(" p01 %d\n", n);
    *p -= 1;            printf(" p02 %d\n", n);
    ++(*p);             printf(" p03 %d\n", n);

    /* struct field via pointer */
    r.x = 100; r.y = 200;
    rp = &r;
    rp->x += 11;        printf(" r01 %d\n", r.x);
    rp->y -= 25;        printf(" r02 %d\n", r.y);
    ++rp->x;            printf(" r03 %d\n", r.x);
    --rp->y;            printf(" r04 %d\n", r.y);

    /* bit ops on indexed element */
    arr[0] = 12;
    arr[0] |= 1;        printf(" b01 %d\n", arr[0]);
    arr[0] &= 7;        printf(" b02 %d\n", arr[0]);
    arr[0] ^= 2;        printf(" b03 %d\n", arr[0]);
    arr[0] <<= 1;       printf(" b04 %d\n", arr[0]);
    arr[0] >>= 2;       printf(" b05 %d\n", arr[0]);

    /* field of a field: no code beyond a displacement, so walked twice */
    o.sub.v = 7; o.t = 1;
    o.sub.v += 3;       printf(" n01 %d\n", o.sub.v);
    ++o.sub.v;          printf(" n02 %d\n", o.sub.v);

    /* field of an element at a variable index: likewise */
    ra[0].x = 1; ra[1].x = 2; ra[2].x = 3;
    i = 2;
    ra[i].x += 6;       printf(" e01 %d\n", ra[2].x);
    --ra[i].x;          printf(" e02 %d\n", ra[2].x);

    /* deref of a deref: the inner one needs ACC, so the address is spilled */
    n = 60;
    p = &n;
    pp = &p;
    **pp += 5;          printf(" d01 %d\n", n);
    ++(**pp);           printf(" d02 %d\n", n);

    /* address arithmetic under the deref: spilled for the same reason */
    arr[0] = 3; arr[1] = 4;
    p = &arr[0];
    *(p+1) += 9;        printf(" d03 %d\n", arr[1]);
}
