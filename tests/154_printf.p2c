/*=k9,l0*/
void main() {
    char *fmt;

    /* The format reaches PRINTF as an ordinary runtime value. */
    fmt = "D=%d O=%017o C=%c A=%a S=%s F=%f E=%e %%\n";
    printf(fmt, -42, 63, 'X', 'ABCDEF', "str", 1.5, 1.5);
    printf("[%5.1S][%4C][%8A][%6D][%06O]\n",
           "xy", 'Q', 'ABCDEF', 7, 8);
    printf("F=[%10.2F] E=[%12.3E] T=[%12T]\n",
           1.5, 2.25, t'ABCDEFGH');
    printf("STAR D=[%*D] F=[%*.*F]\n", 6, 7, 10, 2, 1.5);
    /* An unknown conversion is literal and consumes no actual. */
    printf("unknown=%Q D=%D %%\n", 9);
    printf("unknown-width=%5Q trailing=%");
    printf("\n");
}
