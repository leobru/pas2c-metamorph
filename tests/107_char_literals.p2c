/*=k9,l0*/
//
// The delimiter decides what a literal is.  Single quotes give a character
// constant: one character is a char, and two to six characters -- as many as
// pack into a word -- are that word as an int, right-aligned in it, so the
// literal compares, assigns and labels a case like any other integer.  Double quotes give a
// packed character array of the length written, which is what write takes as
// text and what a one-word packed char array holds.  A string too long for a
// word -- more than six characters in ISO, or eight in TEXT -- is written in
// double quotes; tests/115 has the single-quoted form it refuses.
//
// A multi-character constant is right-aligned, as a single character is: the
// characters sit in the low bytes, so 'AB' is its first character times 256
// plus its second, and shifting it right by eight leaves the first.
//
typedef __packed char alfa[6];
alfa a = "ALFA!!";
int i, k;
char c;
//
void putln() assembler;
void main() {
    i  =  'AB';
    printf(" ASSIGN%2d%2d\n", (i == 'AB'), (i != 'BA'));
    printf(" SHIFT %4d%7d\n", ('AB' >> 8), 'AB');
    printf(" SIZEOF%3d%3d%3d%3d%3d\n", sizeof('AB'), sizeof("AB"), sizeof('A'), sizeof("ABCDEFG"),
           sizeof("ABCDEFGH"));
    // A string of one word and one of more than a word.
    printf(" TEXT   ");
    printf("AB");
    printf("ABCDEFG");
    putln();
    // Six characters in double quotes fill a one-word packed char array.
    printf(" ALFA   ");
    write(a);
    putln();
    // One character is still a char, and an escape is one character.
    c  =  'A';
    printf(" CHAR  %4d%4d%4d%4d\n", (int)c, (int)'A', (int)'\052', (int)'\'');
    // A one-word constant labels a case.
    switch (i) {
    case 'AB':
        printf(" CASE   MATCH\n");
        break;
    default:
        printf(" CASE   MISS\n");
    }
    k  =  0;
    switch (k) {
    case 'AB':
        printf(" CASE2  MATCH\n");
        break;
    default:
        printf(" CASE2  MISS\n");
    }
}
