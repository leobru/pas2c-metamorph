/*=k9,l0*/
void longjmp(int *jmpbuf, int val) assembler;
int setjmp(int *jmpbuf) assembler;
//
int jb[6];       // (frame << 15) | return address, then M2-M6
int n;
//
void inner() {
    printf(" inner: about to longjmp\n");
    longjmp(jb, 1);
    printf(" inner: unreachable\n");
}
//
void middle() {
    printf(" middle: calling inner\n");
    inner();
    printf(" middle: unreachable\n");
}
//
void main() {
    n = setjmp(jb);
    printf(" setjmp returned %d\n", n);
    if (n == 0) {
        middle();
        printf(" main: unreachable\n");
    } else {
        printf(" main: resumed via longjmp\n");
    }
    printf(" done\n");
}
