/*=k9,l0*/
//
int arr[5];
char chars[5];
__packed int:8 packed[14];
int matrix[2][3];
int idx;
void main() {
    arr[2] = 33;
    idx = 2;
    printf("arr %d\n", arr[idx]);

    chars[0] = 'H';
    chars[1] = 'I';
    idx = 1;
    printf("char %c\n", chars[idx]);

    packed[0] = 7;
    packed[13] = 123;
    if (packed[13] == 123)
        printf("packed %d ok\n", sizeof(packed));
    else
        printf("packed fail\n");

    matrix[0][1] = 12;
    matrix[1][2] = 23;
    printf("matrix %d %d size %d\n", matrix[0][1], matrix[1][2], sizeof(matrix));
}
