/*=k9,l0*/
//
int arr[5];
char chars[5];
__packed int:8 packed[14];
int matrix[2][3];
int idx;
void main() {
    arr[2] = 33;
    idx = 2;
    writeln("arr ", arr[idx]:0);

    chars[0] = 'H';
    chars[1] = 'I';
    idx = 1;
    writeln("char ", chars[idx]);

    packed[0] = 7;
    packed[13] = 123;
    if (packed[13] == 123)
        writeln("packed ", sizeof(packed):0, " ok");
    else
        writeln("packed fail");

    matrix[0][1] = 12;
    matrix[1][2] = 23;
    writeln("matrix ", matrix[0][1]:0, ' ', matrix[1][2]:0,
            " size ", sizeof(matrix):0);
}
