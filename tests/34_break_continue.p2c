int i, j;
void main() {
    i = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) continue;
        if (i == 7) break;
        else
        printf("w %d\n", i);
    }
    printf("after-w %d\n", i);

    i = 0;
    do {
        i = i + 1;
        if (i == 2) continue;
        if (i == 5) break;
        printf("d %d\n", i);
    } while (i < 10);
    printf("after-d %d\n", i);

    i = 0;
    while (i < 3) {
        i = i + 1;
        j = 0;
        while (j < 5) {
            j = j + 1;
            if (j == 2) continue;
            if (j == 4) break;
            printf("n %d %d\n", i, j);
        }
    }
}
