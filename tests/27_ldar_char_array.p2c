//
// Test P/LDAR helper: char array with variable index
char chars[5];
int idx;
char ch;
void main() {
    chars[0] = 'A';
    chars[1] = 'B';
    chars[2] = 'C';
    chars[3] = 'D';
    
    idx = 1;
    ch = chars[idx];           // Variable index, char type → P/LDAR
    printf("Character at index 2: %c\n", ch);
    
    idx = 3;
    ch = chars[idx];
    printf("Character at index 4: %c\n", ch);
}
