/*=k9,l0*/
//
typedef struct {
    int x, y;
} point;
typedef point *ppoint;
typedef struct {
    ppoint pstruct;
} holder;
ppoint p;
point obj;
holder h;
void main() {
    p = &obj;
    { register point *rp = p;
        rp->x = 11;
        rp->y = rp->x + 31;
    }
    printf(" X=%d\n", obj.x);
    printf(" Y=%d\n", obj.y);
    h.pstruct = &obj;
    { register point *rp = h.pstruct;
        rp->x = 17;
        rp->y = rp->x + 6;
    }
    printf(" HX=%d\n", obj.x);
    printf(" HY=%d\n", obj.y);
}
