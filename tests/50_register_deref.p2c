/*=s8,k9,l0*/
//
typedef struct {
    int x, y;
} point;
typedef point *ppoint;
typedef struct {
    ppoint pstruct;
} holder;
ppoint p;
point obj;
holder h;
void main() {
    p = &obj;
    { register point *rp = p;
        rp->x = 11;
        rp->y = rp->x + 31;
    }
    writeln(" X=", obj.x:0);
    writeln(" Y=", obj.y:0);
    h.pstruct = &obj;
    { register point *rp = h.pstruct;
        rp->x = 17;
        rp->y = rp->x + 6;
    }
    writeln(" HX=", obj.x:0);
    writeln(" HY=", obj.y:0);
}
