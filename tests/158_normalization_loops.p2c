/*=k9,l0*/
//
// Exercise mode changes at loop headers and back edges.  The while body ends
// in integer mode, the do body ends in real mode before an integer condition,
// and the for body ends in real mode before its integer increment.
//
int i, a, b, c;
float f;

void main() {
    i = 0;
    f = 1.0;
    while (i < 4) {
        f = f * 2.0;
        i = i + 1;
    }
    a = f;

    i = 3;
    f = 0.5;
    do {
        i = i - 1;
        f = f + 0.5;
    } while (i);
    b = f * 4;

    f = 0.0;
    for (i = 0; i < 3; i = i + 1) {
        f = f + 1.25;
    }
    c = f * 4;

    printf(" NORM LOOPS %d %d %d\n", a, b, c);
}
