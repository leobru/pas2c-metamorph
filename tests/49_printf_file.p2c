/*=l0*/
// fprintf takes the destination as the argument before the format: an
// ordinary variadic assembler routine, declared here the way fopen is.  It
// writes to the FILE in M12, so every conversion follows the argument, the
// %s and \n paths included.
//
void fprintf(void *fcb, char *fmt, ...) assembler;
void fopen(int fcb[30], int sizes, int name) assembler;
void fclose(int fcb[30]) assembler;
void ftruncate(int fcb[30]) assembler;
void frewind(int fcb[30]) assembler;
int fgetc(int fcb[30]) assembler;
void putln() assembler;
//
int f[30];
int c;
//
void main(int argc, char **argv) {
    fprintf(stdout, "%s %d\n", "TO OUTPUT", 42);

    fopen(f, 010000100010, 0);
    ftruncate(f);
    fprintf(f, "%s%3d %c\n", "ABC", -7, 'Z');
    // A padded %s reaches the file through STRLEN and C/SP, which leave the
    // destination in M12 alone.
    fprintf(f, "%5s%02o\n", "XY", 9);
    frewind(f);
    c = fgetc(f);
    while (c != 0) {
        printf("%3d", c);
        c = fgetc(f);
    }
    putln();
    fclose(f);
}
