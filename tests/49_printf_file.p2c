/*=l0*/
// PRINTF takes an optional leading file argument: an object of the 30-word
// size of a file is the destination, and the format follows it.
// C/PRINTF writes to the FILE in M12, so every conversion follows the
// argument, the %s and \n paths included.
//
typedef struct {
    int *data;
    int w1, w2, w3, w4, w5, w6, w7, w8, w9, w10,
    w11, w12, w13, w14, w15, w16, w17, w18, w19, w20,
    w21, w22, w23, w24, w25, w26, w27, w28, w29;
} fileblk;
//
void fopen(fileblk *fcb, int sizes, int name) assembler;
void fclose(fileblk *fcb) assembler;
void ftruncate(fileblk *fcb) assembler;
void frewind(fileblk *fcb) assembler;
int fgetc(fileblk *fcb) assembler;
void putln() assembler;
//
fileblk f;
int c;
//
void main() {
    printf(_output_, "%s %d\n", "TO OUTPUT", 42);

    fopen(&f, 010000100010, 0);
    ftruncate(&f);
    printf(f, "%s%3d %c\n", "ABC", -7, 'Z');
    // A padded %s reaches the file through STRLEN and C/SP, which leave the
    // destination in M12 alone.
    printf(f, "%5s%02o\n", "XY", 9);
    frewind(&f);
    c = fgetc(&f);
    while (c != 0) {
        printf("%3d", c);
        c = fgetc(&f);
    }
    putln();
    fclose(&f);
}
