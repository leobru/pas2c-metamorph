//
// Test P/LDARIN helper: integer array with variable index
int arr[10];
int idx, value;
void main() {
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
    arr[4] = 500;
    
    idx = 1;
    value = arr[idx];          // Variable index forces st2 → P/LDARIN
    printf("Value at index 2: %d\n", value);
    
    idx = 4;
    value = arr[idx];
    printf("Value at index 5: %d\n", value);
}
