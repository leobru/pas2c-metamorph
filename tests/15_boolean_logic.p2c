//
int a, b;
void main() {
  for (a = 0; a <= 1 ; a = a + 1) for (b = 0; b <= 1; b = b + 1) {
    if (a && b) {
        printf(" %1d AND %1d is true\n", a, b);
    } else {
        printf(" %1d AND %1d is false\n", a, b);
    };
    
    if (a || b) {
        printf(" %1d OR %1d is true\n", a, b);
    } else {
        printf(" %1d OR %1d is false\n", a, b);
    };
    
    if (! a) {
        printf(" NOT %1d is true\n", a);
    } else {
        printf(" NOT %1d is false\n", a);
    }
 }
}
