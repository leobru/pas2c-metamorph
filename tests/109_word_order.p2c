/*=k9,l0*/
//
// Ordering of a one-word value follows its type.  A scalar is compared
// arithmetically; anything else -- a pointer, a packed array, a struct --
// is compared as an unsigned 48-bit pattern.  Equality is the same
// operation for every type.
//
// 'uword' names the void pointer, so a cast to it orders two words by their
// bits, which is what a sorted table of arbitrary words needs.  A one-word
// packed char array orders the same way once cast.
//
typedef void *uword;
typedef __packed char alfa[6];
//
int w[4];
alfa a = "AAAAAA", b = "ZZZZZZ";
int i, j;
//
void main() {
    // Four words in ascending order of their leading byte: 0, then a space
    // (040), then 'A' (0101), then 'Z' (0132).
    w[0]  =  1;
    w[1]  =  '      ';
    w[2]  =  'AAAAAA';
    w[3]  =  'ZZZZZZ';
    printf(" ASC   %2d%2d%2d\n", ((uword)w[0] < (uword)w[1]), ((uword)w[1] < (uword)w[2]),
           ((uword)w[2] < (uword)w[3]));
    printf(" DESC  %2d%2d%2d\n", ((uword)w[1] < (uword)w[0]), ((uword)w[2] < (uword)w[1]),
           ((uword)w[3] < (uword)w[2]));
    // The other orderings, on one pair.
    printf(" REL   %2d%2d%2d\n", ((uword)w[1] <= (uword)w[2]), ((uword)w[2] > (uword)w[1]),
           ((uword)w[1] >= (uword)w[1]));
    // The two orderings differ where the sign bit is set: -1 is below 1 as
    // a number and above it as a bit pattern.
    i  =  -1;
    j  =  1;
    printf(" SIGN  %2d%2d\n", (i < j), ((uword)i < (uword)j));
    // A packed char array is an address in a value context, so ordering
    // its contents takes the same cast a word does.
    printf(" ALFA  %2d%2d%2d%2d\n", ((uword)a < (uword)b), ((uword)b < (uword)a),
           ((uword)a <= (uword)b), ((uword)a == (uword)b));
    // Equality reads the same whatever the spelling.
    i  =  'AAAAAA';
    printf(" EQ    %2d%2d%2d\n", (i == w[2]), ((uword)i == (uword)w[2]), (i != w[3]));
    // Each of them is one word.
    printf(" SIZE  %2d%2d%2d%2d\n", sizeof(int), sizeof(uword), sizeof(alfa), sizeof(a));
}
