/*=k9,l0*/
//
// This machine has one integer, so every C spelling of one names it.
// 'short', 'long' and 'unsigned' are reserved words carrying int, and a run
// of type specifiers collapses to one type: 'unsigned int', 'long long' and
// 'unsigned long long int' are all the same int, and assignment between them
// needs no conversion because there is nothing to convert.
//
// A later specifier that is not int wins, which is what makes 'unsigned char'
// a char.  The declarator after the run is untouched, so a pointer, an array
// and a bit-field all read as they always did.
//
short              a;
long               b;
unsigned           c;
unsigned int       d;
short int          e;
long int           f;
long long          g;
unsigned long long h;
unsigned long long int i;
//
unsigned char      ch;
__packed unsigned char pk[6] = "ABCDEF";
unsigned          *p;
long               tbl[3];
//
typedef __packed struct { unsigned:6 lo; unsigned:18 mid; int:24 hi; } bits;
bits w;
//
int n;
//
// A run works in a parameter list and as a result type.
short twice(unsigned long v) { return v + v; }
//
void main() {
    // One type: every spelling takes a value from every other.
    a = 1;  b = a + 1;  c = b + 1;  d = c + 1;  e = d + 1;
    f = e + 1;  g = f + 1;  h = g + 1;  i = h + 1;
    printf(" CHAIN%3d%3d%3d%3d%3d%3d%3d%3d%3d\n", a, b, c, d, e, f, g, h, i);
    printf(" SIZEOF%3d%3d%3d%3d\n", sizeof(a), sizeof(g), sizeof(i), sizeof(tbl));
    // The declarator after the run is the ordinary one.
    n = 40;  p = &n;  *p = *p + 2;
    tbl[0] = 7;  tbl[1] = 8;  tbl[2] = 9;
    printf(" DECL  %3d%3d%3d%3d\n", n, (*p), tbl[0], tbl[2]);
    // 'unsigned char' is a char: the last specifier wins.
    ch = 'Z';
    printf(" CHAR   %c %c%c%c%c%c%c  SIZEOF%3d%3d\n", ch, pk[0], pk[1], pk[2], pk[3],
           pk[4], pk[5], sizeof(ch), sizeof(pk));
    // 'unsigned:6' is the bit-field 'int:6' is (a narrow scalar of its own,
    // so these are cast to int).
    w.lo = 63;  w.mid = 7;  w.hi = 5;
    printf(" BITS  %3d%3d%3d%3d\n", (int)w.lo, (int)w.mid, (int)w.hi, sizeof(w));
    printf(" CALL  %3d\n", twice(21));
}
