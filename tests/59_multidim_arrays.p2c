//
int a[5][5];
int i, j, sum;
void main() {
    sum = 0;
    for (i = 0; i < 5; ++i)
        for (j = 0; j < 5; ++j) {
            a[i][j] = i + j;
            sum += a[i][j];
        }
    printf("diag %d %d %d\n", a[0][0], a[2][2], a[4][4]);
    printf("edge %d %d %d\n", a[0][4], a[4][0], a[3][1]);
    printf("sum %d size %d\n", sum, sizeof(a));
}
