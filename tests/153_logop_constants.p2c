/*=k9,l0*/
// A one-constant logical expression still short-circuits in source order and
// produces a normalized Boolean value.  In particular, a constant on the
// right cannot discard evaluation of the left operand.
int calls;

int side(int value) {
    ++calls;
    return value;
}

void main() {
    calls = 0;
    printf("LOR1 %d %d\n", (1 || side(0)), calls);
    calls = 0;
    printf("LOR0 %d %d\n", (0 || side(7)), calls);
    calls = 0;
    printf("LAND0 %d %d\n", (0 && side(7)), calls);
    calls = 0;
    printf("LAND1 %d %d\n", (1 && side(7)), calls);

    calls = 0;
    printf("ROR1 %d %d\n", (side(0) || 1), calls);
    calls = 0;
    printf("ROR0 %d %d\n", (side(7) || 0), calls);
    calls = 0;
    printf("RAND1 %d %d\n", (side(0) && 1), calls);
    calls = 0;
    printf("RAND0 %d %d\n", (side(7) && 0), calls);
}
