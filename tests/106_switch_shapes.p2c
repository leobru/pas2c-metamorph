/*=s8,k9,l0*/
//
// A switch reaches its arms in one of two shapes.  With caseTabMin labels or
// more, running consecutively, the dispatch is an indexed jump into a table
// of two targets per word, guarded by a range check that sends anything
// outside the span to the default arm.  Below that count, and whenever the
// labels have a gap, each label is compared in turn: against an index
// register when the label type is narrow enough to hold in fifteen bits, and
// against the accumulator otherwise.  Every shape is exercised here over its
// whole label set, plus one value below, one above and one in a gap, since a
// dispatch that mis-selects an arm is the way this goes wrong.
//
typedef enum { stWORD, stSLICE, stPACKED } state;
//
state st;
int i, k, calls;
//
// Three consecutive labels: short enough to compare.
int small3(state s) {
    switch (s) {
    case stWORD:   return 10;
    case stSLICE:  return 11;
    case stPACKED: return 12;
    }
    return 99;
}
//
// Three labels with gaps, and no default: falling off the end runs on.
int gap3(int n) {
    switch (n) {
    case 1: return 21;
    case 3: return 23;
    case 4: return 24;
    }
    return 29;
}
//
// Twelve consecutive labels: enough to index.
int wide12(int n) {
    switch (n) {
    case 0:  return 30;
    case 1:  return 31;
    case 2:  return 32;
    case 3:  return 33;
    case 4:  return 34;
    case 5:  return 35;
    case 6:  return 36;
    case 7:  return 37;
    case 8:  return 38;
    case 9:  return 39;
    case 10: return 40;
    case 11: return 41;
    default: return 49;
    }
}
//
// Nine consecutive labels: exactly caseTabMin, the first count that indexes.
int nine(int n) {
    switch (n) {
    case 20: return 50;
    case 21: return 51;
    case 22: return 52;
    case 23: return 53;
    case 24: return 54;
    case 25: return 55;
    case 26: return 56;
    case 27: return 57;
    case 28: return 58;
    default: return 59;
    }
}
//
// Eight consecutive labels: one short of it, so these are compared.
int eight(int n) {
    switch (n) {
    case 20: return 60;
    case 21: return 61;
    case 22: return 62;
    case 23: return 63;
    case 24: return 64;
    case 25: return 65;
    case 26: return 66;
    case 27: return 67;
    default: return 69;
    }
}
//
// Labels beyond fifteen bits and below zero: the accumulator shape.
int wideVals(int n) {
    switch (n) {
    case -70:     return 70;
    case 0:       return 71;
    case 100000:  return 72;
    case 1000000: return 73;
    default:      return 79;
    }
}
//
// The subject is evaluated once, however the dispatch is done.
int bump() {
    calls  =  calls + 1;
    return 2;
}
//
void main() {
    write(" SMALL3 ");
    st  =  stWORD;   write(small3(st):4);
    st  =  stSLICE;  write(small3(st):4);
    st  =  stPACKED; write(small3(st):4);
    writeln;
    write(" GAP3  ");
    for (i = 0; i <= 5; i = i + 1)
        write(gap3(i):4);
    writeln;
    write(" WIDE12");
    for (i = 0; i <= 12; i = i + 1)
        write(wide12(i):4);
    writeln;
    write(" WIDE-1");
    writeln(wide12(-1):4);
    write(" NINE  ");
    for (i = 19; i <= 29; i = i + 1)
        write(nine(i):4);
    writeln;
    write(" EIGHT ");
    for (i = 19; i <= 28; i = i + 1)
        write(eight(i):4);
    writeln;
    write(" WIDEV ");
    write(wideVals(-70):4, wideVals(0):4, wideVals(100000):4);
    write(wideVals(1000000):4, wideVals(-71):4, wideVals(5):4);
    writeln;
    calls  =  0;
    k  =  small3(state(bump()));
    writeln(" ONCE   ", k:4, calls:4);
}
