/*=l0*/
//
// pck(p) packs the six characters at p into one word, the first of them in
// the most significant byte, which is the order %a prints a word in.  A
// character occupies a word of its own, so the six of them are six
// consecutive words and their address is what the routine wants.
//
int pck(int *) assembler;
//
int buf[6];
int packed;
void main() {
    buf[0] = 'A'; buf[1] = 'B'; buf[2] = 'C';
    buf[3] = 'D'; buf[4] = 'E'; buf[5] = 'F';
    packed = pck(&buf[0]);
    printf(" PCK  =%6a\n", packed);
}
