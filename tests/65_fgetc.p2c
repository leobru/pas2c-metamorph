/*=l0*/
//
void fopen(int fcb[30], int sizes, int name) assembler;
void fclose(int fcb[30]) assembler;
void ftruncate(int fcb[30]) assembler;
void frewind(int fcb[30]) assembler;
int fgetc(int fcb[30]) assembler;
void fputw(int value, int fcb[30]) assembler;
//
int f[30];
int a, b, c;
//
void main(int argc, char **argv) {
    fopen(f, 010000100010, 0);
    ftruncate(f);
    fputw('A', f);
    fputw(012, f);

    frewind(f);
    a = fgetc(f);
    b = fgetc(f);
    c = fgetc(f);
    printf("%d %d %d\n", a, b, c);
    fclose(f);
}
